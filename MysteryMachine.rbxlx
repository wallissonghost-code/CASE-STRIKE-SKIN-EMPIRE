<Item class="ReplicatedStorage" referent="RBX000019"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX000018"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX000001"><Properties><string name="Name">EconomyConfig</string><ProtectedString name="Source"><![CDATA[-- Economia, XP e níveis. Todos os valores são lidos pelo servidor; o cliente só exibe.

local EconomyConfig = {}

EconomyConfig.CurrencyName = "Coins"
EconomyConfig.StartingCoins = 250
EconomyConfig.MaxCoins = 1000000000

-- Níveis de colecionador: XP necessário para sair do nível L = Base + PerLevel * (L - 1)
EconomyConfig.Levels = {
	Base = 50,
	PerLevel = 25,
	MaxLevel = 60,
}

-- Moedas pagas ao alcançar um novo nível (uma única vez por nível)
function EconomyConfig.levelReward(level)
	return 25 + 15 * level
end

-- XP por uso de máquina: pequeno e com limite diário (evita XP infinito por repetição)
EconomyConfig.OpenXp = 5
EconomyConfig.OpenXpDailyCap = 150

-- Multiplicador das recompensas em moedas de missões e presentes conforme o nível
-- (para continuarem úteis quando as máquinas ficam caras). O bônus de melhoria soma por cima.
function EconomyConfig.levelScale(level)
	return 1 + 0.08 * (math.max(1, level) - 1)
end

-- Presente diário gratuito (sequência de 7 dias; perder um dia recomeça a sequência)
EconomyConfig.DailyGift = {
	coins = { 60, 80, 100, 140, 180, 240, 400 },
	xp = 25,
}

-- Moedas perdidas pelo parque: atividade gratuita para quem ficou sem saldo
EconomyConfig.Pickups = {
	spots = 8, -- quantas moedas existem ao mesmo tempo no mapa
	respawn = 20, -- segundos até uma moeda reaparecer
	hourlyLimit = 20, -- máximo de moedas coletadas por jogador por hora
	baseCoins = 6,
	perLevel = 2,
	radius = 9, -- distância máxima para validar a coleta
}

function EconomyConfig.pickupValue(level)
	return EconomyConfig.Pickups.baseCoins + EconomyConfig.Pickups.perLevel * math.max(1, level)
end

-- Venda: as raridades com confirmSale (RarityConfig) pedem confirmação.
-- "Vender repetidos" vende as cópias extras destas raridades, mantendo 1 de cada.
EconomyConfig.DuplicateSellRarities = { common = true, uncommon = true }

-- Salvamento e proteção
EconomyConfig.AutosaveInterval = 60
EconomyConfig.SessionLockTimeout = 300
EconomyConfig.OpenCooldown = 0.6

-- Ranking global (OrderedDataStore): escrita e leitura periódicas com cache
EconomyConfig.LeaderboardRefresh = 300
EconomyConfig.LeaderboardWriteInterval = 300
EconomyConfig.LeaderboardSize = 10

return EconomyConfig
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000002"><Properties><string name="Name">ItemDefinitions</string><ProtectedString name="Source"><![CDATA[-- Os 20 objetos colecionáveis. Para adicionar um objeto: crie a entrada aqui (id único e estável,
-- nunca reutilize um id antigo), adicione o modelo em Visual/ItemModels e coloque-o no pool de uma
-- máquina em MachineDefinitions.
-- value: moedas recebidas na venda e valor para o ranking de coleção.

local ItemDefinitions = {}

ItemDefinitions.List = {
	-- Máquina Comum
	{ id = "cup", name = "Copo", rarity = "common", value = 10, machine = "common" },
	{ id = "ball", name = "Bola", rarity = "common", value = 14, machine = "common" },
	{ id = "toy_car", name = "Carrinho de Brinquedo", rarity = "uncommon", value = 30, machine = "common" },
	{ id = "teddy", name = "Urso de Pelúcia", rarity = "rare", value = 70, machine = "common" },
	{ id = "headphones", name = "Fone de Ouvido", rarity = "epic", value = 180, machine = "common" },
	-- Máquina Neon
	{ id = "watch", name = "Relógio Digital", rarity = "common", value = 60, machine = "neon" },
	{ id = "gamepad", name = "Controle de Videogame", rarity = "uncommon", value = 110, machine = "neon" },
	{ id = "phone", name = "Celular", rarity = "rare", value = 240, machine = "neon" },
	{ id = "drone", name = "Drone", rarity = "epic", value = 500, machine = "neon" },
	{ id = "handheld", name = "Console Portátil", rarity = "legendary", value = 1200, machine = "neon" },
	-- Máquina Dourada
	{ id = "robot", name = "Robô de Brinquedo", rarity = "uncommon", value = 320, machine = "golden" },
	{ id = "scooter", name = "Patinete Futurista", rarity = "rare", value = 600, machine = "golden" },
	{ id = "rocket", name = "Mini Foguete", rarity = "rare", value = 900, machine = "golden" },
	{ id = "diamond", name = "Diamante", rarity = "epic", value = 2000, machine = "golden" },
	{ id = "crown", name = "Coroa Dourada", rarity = "legendary", value = 5000, machine = "golden" },
	-- Máquina Misteriosa
	{ id = "crystal_dragon", name = "Dragão de Cristal", rarity = "rare", value = 1500, machine = "mystery" },
	{ id = "cosmic_cube", name = "Cubo Cósmico", rarity = "epic", value = 2600, machine = "mystery" },
	{ id = "ancient_relic", name = "Relíquia Antiga", rarity = "epic", value = 4200, machine = "mystery" },
	{ id = "galactic_star", name = "Estrela Galáctica", rarity = "legendary", value = 7500, machine = "mystery" },
	{ id = "secret_artifact", name = "Artefato Secreto", rarity = "secret", value = 40000, machine = "mystery" },
}

ItemDefinitions.ById = {}
for index, item in ipairs(ItemDefinitions.List) do
	item.index = index
	ItemDefinitions.ById[item.id] = item
end

function ItemDefinitions.get(id)
	if type(id) ~= "string" then
		return nil
	end
	return ItemDefinitions.ById[id]
end

function ItemDefinitions.count()
	return #ItemDefinitions.List
end

return ItemDefinitions
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX000008"><Properties><string name="Name">Logic</string></Properties><Item class="ModuleScript" referent="RBX000003"><Properties><string name="Name">ClientView</string><ProtectedString name="Source"><![CDATA[-- "Fotografia" do perfil enviada ao cliente (DataUpdated). Contém só o que a interface exibe,
-- já com valores calculados no servidor (nível, capacidade, missões, presentes...).

local Shared = script.Parent.Parent
local ItemDefinitions = require(Shared.ItemDefinitions)
local UpgradeConfig = require(Shared.UpgradeConfig)
local MissionDefinitions = require(Shared.MissionDefinitions)
local Levels = require(script.Parent.Levels)
local ProfileOps = require(script.Parent.ProfileOps)

local ClientView = {}

function ClientView.build(p, now)
	ProfileOps.ensureDaily(p, now)
	local level, into, needed = Levels.fromXp(p.xp)

	local daily = {}
	for _, m in ipairs(p.daily.missions) do
		local def = MissionDefinitions.DailyById[m.id]
		table.insert(daily, {
			id = m.id,
			text = def.text,
			progress = m.progress,
			target = def.target,
			claimed = m.claimed,
			coins = ProfileOps.rewardCoins(p, def.coins),
			xp = def.xp,
		})
	end

	local achievements = {}
	for _, def in ipairs(MissionDefinitions.Achievements) do
		table.insert(achievements, {
			id = def.id,
			text = def.text,
			progress = math.min(def.target, ProfileOps.metric(p, def.metric)),
			target = def.target,
			claimed = p.achievements[def.id] == true,
			coins = def.coins,
			xp = def.xp,
		})
	end

	local sets = {}
	for _, set in ipairs(MissionDefinitions.CollectionSets) do
		local have, total = ProfileOps.setProgress(p, set)
		table.insert(sets, { id = set.id, have = have, total = total, claimed = p.sets[set.id] == true })
	end

	local displayed = {}
	for id in pairs(p.inventory) do
		displayed[id] = ProfileOps.displayedCount(p, id)
	end

	local upgrades = {}
	for _, id in ipairs(UpgradeConfig.Order) do
		upgrades[id] = p.upgrades[id]
	end

	return {
		coins = p.coins,
		xp = p.xp,
		level = level,
		xpInto = into,
		xpNeeded = needed,
		inventory = p.inventory,
		favorites = p.favorites,
		displayed = displayed,
		discovered = p.discovered,
		discoveredCount = ProfileOps.discoveredCount(p),
		totalItems = ItemDefinitions.count(),
		showcase = p.showcase,
		showcaseSlots = ProfileOps.showcaseSlots(p),
		itemCount = ProfileOps.itemCount(p),
		capacity = ProfileOps.capacity(p),
		collectionValue = ProfileOps.collectionValue(p),
		upgrades = upgrades,
		openDuration = UpgradeConfig.openDuration(p.upgrades.speed),
		daily = daily,
		achievements = achievements,
		sets = sets,
		gift = ProfileOps.giftStatus(p, now),
		titles = p.titles,
		title = p.title,
		settings = p.settings,
		stats = p.stats,
		pickupsLeft = ProfileOps.pickupsLeft(p, now),
	}
end

return ClientView
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000004"><Properties><string name="Name">Levels</string><ProtectedString name="Source"><![CDATA[-- Curva de níveis de colecionador. O perfil guarda só o XP total; o nível é calculado.

local EconomyConfig = require(script.Parent.Parent.EconomyConfig)

local Levels = {}

function Levels.xpToNext(level)
	return EconomyConfig.Levels.Base + EconomyConfig.Levels.PerLevel * (level - 1)
end

-- XP total necessário para ESTAR no nível `level`
function Levels.totalFor(level)
	local total = 0
	for l = 1, level - 1 do
		total = total + Levels.xpToNext(l)
	end
	return total
end

-- retorna nível, XP dentro do nível e XP necessário para o próximo
function Levels.fromXp(xp)
	xp = math.max(0, math.floor(tonumber(xp) or 0))
	local level = 1
	local maxLevel = EconomyConfig.Levels.MaxLevel
	while level < maxLevel and xp >= Levels.xpToNext(level) do
		xp = xp - Levels.xpToNext(level)
		level = level + 1
	end
	if level >= maxLevel then
		return maxLevel, 0, 0
	end
	return level, xp, Levels.xpToNext(level)
end

function Levels.level(xp)
	local level = Levels.fromXp(xp)
	return level
end

return Levels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000005"><Properties><string name="Name">Odds</string><ProtectedString name="Source"><![CDATA[-- Sorteio das máquinas. Usado SOMENTE pelo servidor para sortear e pela interface para
-- mostrar as chances: os dois leem a mesma tabela de MachineDefinitions.

local Shared = script.Parent.Parent
local MachineDefinitions = require(Shared.MachineDefinitions)
local ItemDefinitions = require(Shared.ItemDefinitions)
local RarityConfig = require(Shared.RarityConfig)

local Odds = {}

function Odds.total(machine)
	local sum = 0
	for _, entry in ipairs(machine.pool) do
		sum = sum + entry.chance
	end
	return sum
end

-- r: número em [0, 1) vindo de Random (servidor). Retorna o id do objeto.
function Odds.pick(machine, r)
	local target = r * Odds.total(machine)
	local acc = 0
	for _, entry in ipairs(machine.pool) do
		acc = acc + entry.chance
		if target < acc then
			return entry.item
		end
	end
	return machine.pool[#machine.pool].item
end

-- lista para a interface: { item, name, rarity, rarityName, chance, value }, da mais rara para a mais comum
function Odds.display(machineId)
	local machine = MachineDefinitions.get(machineId)
	local out = {}
	if not machine then
		return out
	end
	local total = Odds.total(machine)
	for _, entry in ipairs(machine.pool) do
		local item = ItemDefinitions.get(entry.item)
		table.insert(out, {
			item = entry.item,
			name = item.name,
			rarity = item.rarity,
			rarityName = RarityConfig.get(item.rarity).name,
			chance = entry.chance * 100 / total,
			value = item.value,
		})
	end
	table.sort(out, function(a, b)
		local ra, rb = RarityConfig.rank(a.rarity), RarityConfig.rank(b.rarity)
		if ra ~= rb then
			return ra > rb
		end
		return a.chance < b.chance
	end)
	return out
end

-- valor médio de venda por abertura (para balanceamento e testes)
function Odds.expectedValue(machine)
	local total = Odds.total(machine)
	local ev = 0
	for _, entry in ipairs(machine.pool) do
		ev = ev + ItemDefinitions.get(entry.item).value * entry.chance / total
	end
	return ev
end

return Odds
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000006"><Properties><string name="Name">ProfileOps</string><ProtectedString name="Source"><![CDATA[-- Todas as regras que alteram o perfil, como funções puras (sem Roblox, sem rede).
-- O servidor chama estas funções; nenhuma delas confia em valores vindos do cliente.
-- Cada operação valida TUDO antes de alterar qualquer campo, então uma recusa nunca
-- deixa o perfil pela metade. Retorno: { ok = true, ... } ou { ok = false, error, message }.

local Shared = script.Parent.Parent
local EconomyConfig = require(Shared.EconomyConfig)
local ItemDefinitions = require(Shared.ItemDefinitions)
local MachineDefinitions = require(Shared.MachineDefinitions)
local RarityConfig = require(Shared.RarityConfig)
local UpgradeConfig = require(Shared.UpgradeConfig)
local MissionDefinitions = require(Shared.MissionDefinitions)
local Levels = require(script.Parent.Levels)
local Odds = require(script.Parent.Odds)
local TimeUtil = require(Shared.Util.TimeUtil)

local ProfileOps = {}

local function fail(code, message, extra)
	local r = { ok = false, error = code, message = message }
	if extra then
		for k, v in pairs(extra) do
			r[k] = v
		end
	end
	return r
end

---------------------------------------------------------------------------
-- consultas
---------------------------------------------------------------------------
function ProfileOps.level(p)
	return Levels.level(p.xp)
end

function ProfileOps.itemCount(p)
	local n = 0
	for _, c in pairs(p.inventory) do
		n = n + c
	end
	return n
end

function ProfileOps.capacity(p)
	return UpgradeConfig.capacity(p.upgrades.capacity)
end

function ProfileOps.showcaseSlots(p)
	return UpgradeConfig.showcaseSlots(p.upgrades.showcase)
end

function ProfileOps.displayedCount(p, itemId)
	local n = 0
	for i = 1, UpgradeConfig.MaxShowcaseSlots do
		if p.showcase[i] == itemId then
			n = n + 1
		end
	end
	return n
end

-- cópias que podem ser vendidas (fora da vitrine e não favoritas)
function ProfileOps.sellable(p, itemId)
	if p.favorites[itemId] then
		return 0
	end
	return math.max(0, (p.inventory[itemId] or 0) - ProfileOps.displayedCount(p, itemId))
end

function ProfileOps.discoveredCount(p)
	local n = 0
	for _ in pairs(p.discovered) do
		n = n + 1
	end
	return n
end

function ProfileOps.collectionValue(p)
	local total = 0
	for id, c in pairs(p.inventory) do
		total = total + ItemDefinitions.get(id).value * c
	end
	return total
end

function ProfileOps.achievementCount(p)
	local n = 0
	for _ in pairs(p.achievements) do
		n = n + 1
	end
	return n
end

function ProfileOps.setProgress(p, set)
	local have, total = 0, 0
	for _, item in ipairs(ItemDefinitions.List) do
		if set.machine == nil or item.machine == set.machine then
			total = total + 1
			if p.discovered[item.id] then
				have = have + 1
			end
		end
	end
	return have, total
end

function ProfileOps.setComplete(p, set)
	local have, total = ProfileOps.setProgress(p, set)
	return have >= total
end

function ProfileOps.metric(p, name)
	if name == "opens" then
		return p.stats.opens
	elseif name == "sold" then
		return p.stats.sold
	elseif name == "discovered" then
		return ProfileOps.discoveredCount(p)
	elseif name == "level" then
		return ProfileOps.level(p)
	elseif name == "bestRank" then
		return p.stats.bestRank
	elseif name == "displayed" then
		local n = 0
		for i = 1, UpgradeConfig.MaxShowcaseSlots do
			if p.showcase[i] ~= "" then
				n = n + 1
			end
		end
		return n
	elseif name == "setsComplete" then
		local n = 0
		for _, set in ipairs(MissionDefinitions.CollectionSets) do
			if set.machine and ProfileOps.setComplete(p, set) then
				n = n + 1
			end
		end
		return n
	end
	return 0
end

-- Coins de missões/presentes: base × escala por nível × melhoria de recompensas
function ProfileOps.rewardCoins(p, base)
	return math.floor(base * EconomyConfig.levelScale(ProfileOps.level(p)) * UpgradeConfig.missionMultiplier(p.upgrades.missionBonus))
end

---------------------------------------------------------------------------
-- moedas e XP
---------------------------------------------------------------------------
function ProfileOps.addCoins(p, amount)
	amount = math.floor(amount)
	p.coins = math.clamp(p.coins + amount, 0, EconomyConfig.MaxCoins)
	if amount > 0 then
		p.stats.coinsEarned = p.stats.coinsEarned + amount
	end
end

-- Adiciona XP e paga a recompensa de cada nível novo (uma vez por nível).
-- Retorna { levels = { níveis alcançados }, coins = moedas pagas }.
function ProfileOps.addXp(p, amount)
	local before = ProfileOps.level(p)
	p.xp = p.xp + math.max(0, math.floor(amount))
	local after = ProfileOps.level(p)
	local gained = { levels = {}, coins = 0 }
	for level = before + 1, after do
		table.insert(gained.levels, level)
		if level > p.levelRewarded then
			local coins = EconomyConfig.levelReward(level)
			ProfileOps.addCoins(p, coins)
			gained.coins = gained.coins + coins
			p.levelRewarded = level
		end
	end
	return gained
end

---------------------------------------------------------------------------
-- missões diárias
---------------------------------------------------------------------------
-- Escolhe as missões do dia: 1 gratuita (alterna por dia) + sorteio determinístico do restante.
function ProfileOps.dailySelection(p, day)
	local free = MissionDefinitions.DailyFree
	local chosen = { free[(day % #free) + 1].id }
	local allFound = ProfileOps.discoveredCount(p) >= ItemDefinitions.count()
	local candidates = {}
	for _, def in ipairs(MissionDefinitions.DailyPool) do
		if not (def.needsUndiscovered and allFound) then
			table.insert(candidates, def.id)
		end
	end
	-- gerador congruente simples com o dia como semente (igual em todos os servidores)
	local seed = (day * 7919 + 104729) % 2147483647
	while #chosen < MissionDefinitions.DailyCount and #candidates > 0 do
		seed = (seed * 16807) % 2147483647
		local i = (seed % #candidates) + 1
		table.insert(chosen, table.remove(candidates, i))
	end
	return chosen
end

function ProfileOps.ensureDaily(p, now)
	local day = TimeUtil.day(now)
	if p.daily.day == day then
		return false
	end
	local missions = {}
	for _, id in ipairs(ProfileOps.dailySelection(p, day)) do
		table.insert(missions, { id = id, progress = 0, claimed = false })
	end
	p.daily = { day = day, missions = missions, openXp = 0 }
	return true
end

-- Registra uma ação para as missões do dia. Retorna true se alguma missão avançou.
function ProfileOps.track(p, event, amount, now)
	ProfileOps.ensureDaily(p, now)
	local changed = false
	for _, m in ipairs(p.daily.missions) do
		local def = MissionDefinitions.DailyById[m.id]
		if def.event == event and not m.claimed and m.progress < def.target then
			m.progress = math.min(def.target, m.progress + (amount or 1))
			changed = true
		end
	end
	return changed
end

function ProfileOps.claimDaily(p, missionId, now)
	ProfileOps.ensureDaily(p, now)
	for _, m in ipairs(p.daily.missions) do
		if m.id == missionId then
			local def = MissionDefinitions.DailyById[m.id]
			if m.claimed then
				return fail("claimed", "Missão já resgatada hoje.")
			end
			if m.progress < def.target then
				return fail("incomplete", "Missão ainda não concluída.")
			end
			local coins = ProfileOps.rewardCoins(p, def.coins)
			m.claimed = true
			ProfileOps.addCoins(p, coins)
			local gained = ProfileOps.addXp(p, def.xp)
			return { ok = true, coins = coins, xp = def.xp, levels = gained.levels, levelCoins = gained.coins }
		end
	end
	return fail("unknown", "Missão não encontrada.")
end

---------------------------------------------------------------------------
-- máquinas
---------------------------------------------------------------------------
function ProfileOps.canUseMachine(p, machineId)
	local machine = MachineDefinitions.get(machineId)
	if not machine then
		return fail("unknown", "Máquina desconhecida.")
	end
	if ProfileOps.level(p) < machine.level then
		return fail("locked", "Disponível no nível " .. machine.level .. ".")
	end
	if p.coins < machine.price then
		return fail("coins", "Coins insuficientes. Venda objetos, faça missões ou colete moedas no parque.")
	end
	if ProfileOps.itemCount(p) >= ProfileOps.capacity(p) then
		return fail("full", "Inventário cheio. Venda objetos ou compre mais capacidade.")
	end
	return { ok = true, machine = machine }
end

-- r: número aleatório do SERVIDOR em [0, 1). Cobra, sorteia, entrega e registra tudo de uma vez.
function ProfileOps.useMachine(p, machineId, r, now)
	local check = ProfileOps.canUseMachine(p, machineId)
	if not check.ok then
		return check
	end
	local machine = check.machine
	local itemId = Odds.pick(machine, r)
	local item = ItemDefinitions.get(itemId)
	local rarity = RarityConfig.get(item.rarity)

	p.coins = p.coins - machine.price
	p.inventory[itemId] = (p.inventory[itemId] or 0) + 1
	p.stats.opens = p.stats.opens + 1
	p.stats.bestRank = math.max(p.stats.bestRank, rarity.rank)

	ProfileOps.ensureDaily(p, now)
	local isNew = p.discovered[itemId] == nil
	local xp = 0
	if isNew then
		p.discovered[itemId] = now
		xp = xp + rarity.xp
		ProfileOps.track(p, "discover", 1, now)
	end
	local openXp = math.min(EconomyConfig.OpenXp, EconomyConfig.OpenXpDailyCap - p.daily.openXp)
	if openXp > 0 then
		p.daily.openXp = p.daily.openXp + openXp
		xp = xp + openXp
	end
	ProfileOps.track(p, "open", 1, now)
	local gained = ProfileOps.addXp(p, xp)

	return {
		ok = true,
		machineId = machineId,
		itemId = itemId,
		rarity = item.rarity,
		value = item.value,
		isNew = isNew,
		xp = xp,
		price = machine.price,
		levels = gained.levels,
		levelCoins = gained.coins,
		duration = UpgradeConfig.openDuration(p.upgrades.speed),
	}
end

---------------------------------------------------------------------------
-- inventário
---------------------------------------------------------------------------
function ProfileOps.sell(p, itemId, amount, confirmed, now)
	local item = ItemDefinitions.get(itemId)
	if not item or (p.inventory[itemId] or 0) <= 0 then
		return fail("missing", "Você não possui este objeto.")
	end
	if type(amount) ~= "number" or amount ~= amount or amount < 1 or amount ~= math.floor(amount) then
		return fail("amount", "Quantidade inválida.")
	end
	if p.favorites[itemId] then
		return fail("favorite", "Objeto favorito: desfavorite para vender.")
	end
	local available = ProfileOps.sellable(p, itemId)
	if available <= 0 then
		return fail("displayed", "Todas as cópias estão na vitrine.")
	end
	if amount > available then
		return fail("amount", "Você só pode vender " .. available .. ".")
	end
	if RarityConfig.get(item.rarity).confirmSale and confirmed ~= true then
		return fail("confirm", "Confirme a venda de " .. item.name .. ".", { needsConfirm = true })
	end
	local coins = item.value * amount
	p.inventory[itemId] = p.inventory[itemId] - amount
	if p.inventory[itemId] <= 0 then
		p.inventory[itemId] = nil
	end
	ProfileOps.addCoins(p, coins)
	p.stats.sold = p.stats.sold + amount
	ProfileOps.track(p, "sell", amount, now)
	if item.rarity == "common" then
		ProfileOps.track(p, "sell_common", amount, now)
	end
	return { ok = true, coins = coins, amount = amount, itemId = itemId }
end

-- Vende as cópias extras (mantém 1) das raridades de EconomyConfig.DuplicateSellRarities.
-- Favoritos e itens expostos ficam protegidos.
function ProfileOps.sellDuplicates(p, now)
	local plan = {}
	for _, item in ipairs(ItemDefinitions.List) do
		if EconomyConfig.DuplicateSellRarities[item.rarity] then
			local count = p.inventory[item.id] or 0
			local extra = math.min(count - 1, ProfileOps.sellable(p, item.id))
			if extra > 0 then
				table.insert(plan, { item = item, amount = extra })
			end
		end
	end
	if #plan == 0 then
		return fail("none", "Nenhum repetido Comum ou Incomum para vender.")
	end
	local coins, amount, commons = 0, 0, 0
	for _, entry in ipairs(plan) do
		p.inventory[entry.item.id] = p.inventory[entry.item.id] - entry.amount
		coins = coins + entry.item.value * entry.amount
		amount = amount + entry.amount
		if entry.item.rarity == "common" then
			commons = commons + entry.amount
		end
	end
	ProfileOps.addCoins(p, coins)
	p.stats.sold = p.stats.sold + amount
	ProfileOps.track(p, "sell", amount, now)
	if commons > 0 then
		ProfileOps.track(p, "sell_common", commons, now)
	end
	return { ok = true, coins = coins, amount = amount }
end

function ProfileOps.setFavorite(p, itemId, value)
	if not ItemDefinitions.get(itemId) or (p.inventory[itemId] or 0) <= 0 then
		return fail("missing", "Você não possui este objeto.")
	end
	p.favorites[itemId] = value == true or nil
	return { ok = true, favorite = p.favorites[itemId] == true }
end

function ProfileOps.display(p, itemId, slot, now)
	local item = ItemDefinitions.get(itemId)
	if not item or (p.inventory[itemId] or 0) <= 0 then
		return fail("missing", "Você não possui este objeto.")
	end
	local slots = ProfileOps.showcaseSlots(p)
	if slot == nil then
		for i = 1, slots do
			if p.showcase[i] == "" then
				slot = i
				break
			end
		end
		if slot == nil then
			return fail("full", "Todas as vitrines estão ocupadas. Retire um objeto ou compre mais vitrines.")
		end
	end
	if type(slot) ~= "number" or slot ~= math.floor(slot) or slot < 1 or slot > slots then
		return fail("slot", "Vitrine inválida.")
	end
	if p.showcase[slot] == itemId then
		return { ok = true, slot = slot }
	end
	-- o objeto que já estava no espaço volta a ficar livre, então só conta o que fica exposto
	if ProfileOps.displayedCount(p, itemId) >= p.inventory[itemId] then
		return fail("noCopy", "Todas as suas cópias já estão expostas.")
	end
	p.showcase[slot] = itemId
	ProfileOps.track(p, "display", 1, now)
	return { ok = true, slot = slot }
end

function ProfileOps.undisplay(p, slot)
	if type(slot) ~= "number" or slot ~= math.floor(slot) or slot < 1 or slot > UpgradeConfig.MaxShowcaseSlots then
		return fail("slot", "Vitrine inválida.")
	end
	if p.showcase[slot] == "" then
		return fail("empty", "Esta vitrine já está vazia.")
	end
	p.showcase[slot] = ""
	return { ok = true }
end

---------------------------------------------------------------------------
-- melhorias
---------------------------------------------------------------------------
function ProfileOps.buyUpgrade(p, upgradeId)
	if not UpgradeConfig.Upgrades[upgradeId] then
		return fail("unknown", "Melhoria desconhecida.")
	end
	local level = p.upgrades[upgradeId]
	if level >= UpgradeConfig.max(upgradeId) then
		return fail("max", "Melhoria já está no nível máximo.")
	end
	local price = UpgradeConfig.price(upgradeId, level)
	if p.coins < price then
		return fail("coins", "Coins insuficientes.")
	end
	p.coins = p.coins - price
	p.upgrades[upgradeId] = level + 1
	return { ok = true, level = level + 1, price = price }
end

---------------------------------------------------------------------------
-- conquistas, coleção, títulos
---------------------------------------------------------------------------
function ProfileOps.claimAchievement(p, id)
	local def = MissionDefinitions.AchievementById[id]
	if not def then
		return fail("unknown", "Conquista desconhecida.")
	end
	if p.achievements[id] then
		return fail("claimed", "Conquista já resgatada.")
	end
	if ProfileOps.metric(p, def.metric) < def.target then
		return fail("incomplete", "Conquista ainda não alcançada.")
	end
	p.achievements[id] = true
	ProfileOps.addCoins(p, def.coins)
	if def.title then
		p.titles[def.title] = true
	end
	local gained = ProfileOps.addXp(p, def.xp)
	return { ok = true, coins = def.coins, xp = def.xp, title = def.title, levels = gained.levels, levelCoins = gained.coins }
end

function ProfileOps.claimSet(p, setId)
	local set = MissionDefinitions.SetById[setId]
	if not set then
		return fail("unknown", "Coleção desconhecida.")
	end
	if p.sets[setId] then
		return fail("claimed", "Recompensa já resgatada.")
	end
	if not ProfileOps.setComplete(p, set) then
		return fail("incomplete", "Coleção incompleta.")
	end
	p.sets[setId] = true
	ProfileOps.addCoins(p, set.coins)
	if set.title then
		p.titles[set.title] = true
	end
	local gained = ProfileOps.addXp(p, set.xp)
	return { ok = true, coins = set.coins, xp = set.xp, title = set.title, levels = gained.levels, levelCoins = gained.coins }
end

function ProfileOps.setTitle(p, titleId)
	if titleId == "" or titleId == nil then
		p.title = ""
		return { ok = true }
	end
	if type(titleId) ~= "string" or not p.titles[titleId] then
		return fail("locked", "Título ainda não desbloqueado.")
	end
	p.title = titleId
	return { ok = true }
end

---------------------------------------------------------------------------
-- presente diário, moedas perdidas, tempo de jogo, configurações
---------------------------------------------------------------------------
function ProfileOps.giftStatus(p, now)
	local day = TimeUtil.day(now)
	local streak = p.gift.streak
	if p.gift.lastDay ~= day - 1 and p.gift.lastDay ~= day then
		streak = 0
	end
	local nextStreak = (streak % #EconomyConfig.DailyGift.coins) + 1
	return {
		canClaim = p.gift.lastDay ~= day,
		streak = streak,
		nextStreak = nextStreak,
		coins = ProfileOps.rewardCoins(p, EconomyConfig.DailyGift.coins[nextStreak]),
		xp = EconomyConfig.DailyGift.xp,
		secondsLeft = TimeUtil.secondsToNextDay(now),
	}
end

function ProfileOps.claimGift(p, now)
	local status = ProfileOps.giftStatus(p, now)
	if not status.canClaim then
		return fail("claimed", "Presente de hoje já resgatado.")
	end
	p.gift.lastDay = TimeUtil.day(now)
	p.gift.streak = status.nextStreak
	ProfileOps.addCoins(p, status.coins)
	local gained = ProfileOps.addXp(p, status.xp)
	return { ok = true, coins = status.coins, xp = status.xp, streak = status.nextStreak, levels = gained.levels, levelCoins = gained.coins }
end

function ProfileOps.pickupsLeft(p, now)
	if p.pickups.hour ~= TimeUtil.hour(now) then
		return EconomyConfig.Pickups.hourlyLimit
	end
	return math.max(0, EconomyConfig.Pickups.hourlyLimit - p.pickups.count)
end

function ProfileOps.pickup(p, now)
	if ProfileOps.pickupsLeft(p, now) <= 0 then
		return fail("limit", "Você já coletou todas as moedas desta hora.")
	end
	local hour = TimeUtil.hour(now)
	if p.pickups.hour ~= hour then
		p.pickups.hour = hour
		p.pickups.count = 0
	end
	p.pickups.count = p.pickups.count + 1
	local coins = EconomyConfig.pickupValue(ProfileOps.level(p))
	ProfileOps.addCoins(p, coins)
	ProfileOps.track(p, "pickup", 1, now)
	return { ok = true, coins = coins }
end

function ProfileOps.addPlaytime(p, seconds, now)
	return ProfileOps.track(p, "playtime", math.max(0, math.floor(seconds)), now)
end

function ProfileOps.setSetting(p, key, value)
	if type(key) ~= "string" or p.settings[key] == nil or type(value) ~= type(p.settings[key]) then
		return fail("invalid", "Configuração inválida.")
	end
	p.settings[key] = value
	return { ok = true }
end

return ProfileOps
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000007"><Properties><string name="Name">ProfileSchema</string><ProtectedString name="Source"><![CDATA[-- Formato do perfil salvo e reparo de dados antigos/corrompidos.
-- Inventário em pilhas: inventory[itemId] = quantidade. Itens expostos continuam no inventário
-- e ficam reservados (não podem ser vendidos), por isso a vitrine nunca duplica objetos.

local Shared = script.Parent.Parent
local EconomyConfig = require(Shared.EconomyConfig)
local ItemDefinitions = require(Shared.ItemDefinitions)
local UpgradeConfig = require(Shared.UpgradeConfig)
local MissionDefinitions = require(Shared.MissionDefinitions)

local ProfileSchema = {}

ProfileSchema.Version = 1

function ProfileSchema.new()
	local showcase = {}
	for i = 1, UpgradeConfig.MaxShowcaseSlots do
		showcase[i] = ""
	end
	return {
		version = ProfileSchema.Version,
		coins = EconomyConfig.StartingCoins,
		xp = 0,
		levelRewarded = 1,
		inventory = {},
		favorites = {},
		discovered = {},
		showcase = showcase,
		upgrades = { capacity = 0, speed = 0, missionBonus = 0, showcase = 0 },
		stats = { opens = 0, sold = 0, coinsEarned = 0, bestRank = 0 },
		daily = { day = -1, missions = {}, openXp = 0 },
		achievements = {},
		sets = {},
		titles = {},
		title = "",
		gift = { lastDay = -1, streak = 0 },
		pickups = { hour = -1, count = 0 },
		settings = { autoSkip = false, sound = true, effects = true },
	}
end

local function num(v, default, min, max)
	v = tonumber(v)
	if v == nil or v ~= v then
		return default
	end
	if min and v < min then
		v = min
	end
	if max and v > max then
		v = max
	end
	return v
end

local function int(v, default, min, max)
	return math.floor(num(v, default, min, max))
end

-- Corrige o perfil no lugar e retorna a lista de correções feitas (vazia se estava íntegro).
function ProfileSchema.reconcile(p)
	local fixes = {}
	local default = ProfileSchema.new()
	if type(p) ~= "table" then
		return default, { "perfil inválido substituído" }
	end
	local function tableField(key)
		if type(p[key]) ~= "table" then
			p[key] = default[key]
			table.insert(fixes, key)
		end
	end
	for _, key in ipairs({ "inventory", "favorites", "discovered", "showcase", "upgrades", "stats", "daily", "achievements", "sets", "titles", "gift", "pickups", "settings" }) do
		tableField(key)
	end

	local coins = int(p.coins, EconomyConfig.StartingCoins, 0, EconomyConfig.MaxCoins)
	if coins ~= p.coins then
		table.insert(fixes, "coins")
	end
	p.coins = coins
	p.xp = int(p.xp, 0, 0)
	p.levelRewarded = int(p.levelRewarded, 1, 1)
	p.version = ProfileSchema.Version

	-- inventário: só ids conhecidos e quantidades inteiras positivas
	for id, count in pairs(p.inventory) do
		local n = int(count, 0, 0)
		if not ItemDefinitions.get(id) or n <= 0 then
			p.inventory[id] = nil
			table.insert(fixes, "inventory." .. tostring(id))
		elseif n ~= count then
			p.inventory[id] = n
			table.insert(fixes, "inventory." .. tostring(id))
		end
	end
	for id, v in pairs(p.favorites) do
		if not ItemDefinitions.get(id) or v ~= true then
			p.favorites[id] = nil
		end
	end
	for id, v in pairs(p.discovered) do
		if not ItemDefinitions.get(id) then
			p.discovered[id] = nil
		elseif type(v) ~= "number" then
			p.discovered[id] = 0
		end
	end
	-- todo objeto possuído conta como descoberto
	for id in pairs(p.inventory) do
		if not p.discovered[id] then
			p.discovered[id] = 0
		end
	end

	-- vitrine: lista fixa; nenhum objeto exposto além da quantidade possuída
	local showcase = {}
	local used = {}
	for i = 1, UpgradeConfig.MaxShowcaseSlots do
		local id = p.showcase[i]
		if type(id) == "string" and id ~= "" and ItemDefinitions.get(id) and (used[id] or 0) < (p.inventory[id] or 0) then
			used[id] = (used[id] or 0) + 1
			showcase[i] = id
		else
			if id ~= nil and id ~= "" then
				table.insert(fixes, "showcase." .. i)
			end
			showcase[i] = ""
		end
	end
	p.showcase = showcase

	for _, id in ipairs(UpgradeConfig.Order) do
		p.upgrades[id] = int(p.upgrades[id], 0, 0, UpgradeConfig.max(id))
	end
	for key in pairs(p.upgrades) do
		if not UpgradeConfig.Upgrades[key] then
			p.upgrades[key] = nil
		end
	end
	-- vitrines que deixaram de existir (nível de melhoria menor) são esvaziadas
	local slots = UpgradeConfig.showcaseSlots(p.upgrades.showcase)
	for i = slots + 1, UpgradeConfig.MaxShowcaseSlots do
		p.showcase[i] = ""
	end

	local s = p.stats
	s.opens = int(s.opens, 0, 0)
	s.sold = int(s.sold, 0, 0)
	s.coinsEarned = int(s.coinsEarned, 0, 0)
	s.bestRank = int(s.bestRank, 0, 0, 6)

	local d = p.daily
	d.day = int(d.day, -1)
	d.openXp = int(d.openXp, 0, 0)
	if type(d.missions) ~= "table" then
		d.missions = {}
		d.day = -1
	end
	for i = #d.missions, 1, -1 do
		local m = d.missions[i]
		if type(m) ~= "table" or not MissionDefinitions.DailyById[m.id] then
			table.remove(d.missions, i)
			d.day = -1 -- refaz as missões do dia
		else
			m.progress = int(m.progress, 0, 0)
			m.claimed = m.claimed == true
		end
	end

	for id, v in pairs(p.achievements) do
		if not MissionDefinitions.AchievementById[id] or v ~= true then
			p.achievements[id] = nil
		end
	end
	for id, v in pairs(p.sets) do
		if not MissionDefinitions.SetById[id] or v ~= true then
			p.sets[id] = nil
		end
	end
	for id, v in pairs(p.titles) do
		if not MissionDefinitions.Titles[id] or v ~= true then
			p.titles[id] = nil
		end
	end
	if type(p.title) ~= "string" or (p.title ~= "" and not p.titles[p.title]) then
		p.title = ""
	end

	p.gift.lastDay = int(p.gift.lastDay, -1)
	p.gift.streak = int(p.gift.streak, 0, 0, #EconomyConfig.DailyGift.coins)
	p.pickups.hour = int(p.pickups.hour, -1)
	p.pickups.count = int(p.pickups.count, 0, 0)

	for key, value in pairs(default.settings) do
		if type(p.settings[key]) ~= type(value) then
			p.settings[key] = value
		end
	end
	for key in pairs(p.settings) do
		if default.settings[key] == nil then
			p.settings[key] = nil
		end
	end
	return p, fixes
end

function ProfileSchema.deepCopy(v)
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in pairs(v) do
		out[k] = ProfileSchema.deepCopy(x)
	end
	return out
end

return ProfileSchema
]]></ProtectedString></Properties></Item>
</Item>
<Item class="ModuleScript" referent="RBX000009"><Properties><string name="Name">MachineDefinitions</string><ProtectedString name="Source"><![CDATA[-- Máquinas misteriosas. Preços, níveis e chances são configuráveis aqui.
-- `pool`: chance de cada objeto em PORCENTAGEM. A soma de cada pool deve dar 100
-- (verificado nos testes). A interface mostra exatamente estes números antes de cada abertura,
-- e o servidor sorteia com eles: não existe nenhum modificador escondido de probabilidade.

local MachineDefinitions = {}

MachineDefinitions.List = {
	{
		id = "common",
		name = "Máquina Comum",
		price = 25,
		level = 1,
		bodyColor = Color3.fromRGB(80, 170, 255),
		accentColor = Color3.fromRGB(255, 255, 255),
		lightColor = Color3.fromRGB(120, 220, 255),
		pool = {
			{ item = "cup", chance = 45 },
			{ item = "ball", chance = 30 },
			{ item = "toy_car", chance = 15 },
			{ item = "teddy", chance = 8 },
			{ item = "headphones", chance = 2 },
		},
	},
	{
		id = "neon",
		name = "Máquina Neon",
		price = 150,
		level = 5,
		bodyColor = Color3.fromRGB(40, 30, 70),
		accentColor = Color3.fromRGB(255, 70, 220),
		lightColor = Color3.fromRGB(0, 255, 210),
		pool = {
			{ item = "watch", chance = 50 },
			{ item = "gamepad", chance = 28 },
			{ item = "phone", chance = 15 },
			{ item = "drone", chance = 6 },
			{ item = "handheld", chance = 1 },
		},
	},
	{
		id = "golden",
		name = "Máquina Dourada",
		price = 750,
		level = 15,
		bodyColor = Color3.fromRGB(230, 175, 40),
		accentColor = Color3.fromRGB(255, 245, 200),
		lightColor = Color3.fromRGB(255, 220, 90),
		pool = {
			{ item = "robot", chance = 48 },
			{ item = "scooter", chance = 28 },
			{ item = "rocket", chance = 15 },
			{ item = "diamond", chance = 7.5 },
			{ item = "crown", chance = 1.5 },
		},
	},
	{
		id = "mystery",
		name = "Máquina Misteriosa",
		price = 3000,
		level = 30,
		bodyColor = Color3.fromRGB(25, 20, 35),
		accentColor = Color3.fromRGB(150, 60, 255),
		lightColor = Color3.fromRGB(255, 60, 80),
		pool = {
			{ item = "crystal_dragon", chance = 50 },
			{ item = "cosmic_cube", chance = 30 },
			{ item = "ancient_relic", chance = 14 },
			{ item = "galactic_star", chance = 5.5 },
			{ item = "secret_artifact", chance = 0.5 },
		},
	},
}

-- distância máxima (studs) entre o jogador e o botão da máquina para usá-la
MachineDefinitions.UseRadius = 16

MachineDefinitions.ById = {}
for index, machine in ipairs(MachineDefinitions.List) do
	machine.index = index
	MachineDefinitions.ById[machine.id] = machine
end

function MachineDefinitions.get(id)
	if type(id) ~= "string" then
		return nil
	end
	return MachineDefinitions.ById[id]
end

function MachineDefinitions.cheapestPrice()
	local best = math.huge
	for _, m in ipairs(MachineDefinitions.List) do
		best = math.min(best, m.price)
	end
	return best
end

return MachineDefinitions
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000010"><Properties><string name="Name">MissionDefinitions</string><ProtectedString name="Source"><![CDATA[-- Missões diárias, conquistas (missões permanentes), recompensas de coleção e títulos.
--
-- Missões diárias: todo dia (UTC) cada jogador recebe 3 missões: 1 gratuita (não exige gastar
-- moedas) + 2 sorteadas pelo número do dia. Cada missão só pode ser resgatada uma vez por dia.
-- `event`: qual ação faz a missão avançar (ver ProfileOps.track).
--
-- Conquistas: resgatáveis uma única vez. `metric` é calculado a partir do perfil (ProfileOps.metric).

local MissionDefinitions = {}

MissionDefinitions.DailyFree = {
	{ id = "d_pickup", text = "Coletar 5 moedas perdidas no parque", event = "pickup", target = 5, coins = 70, xp = 35 },
	{ id = "d_play", text = "Passear 10 minutos pelo parque", event = "playtime", target = 600, coins = 90, xp = 40 },
}

MissionDefinitions.DailyPool = {
	{ id = "d_open3", text = "Abrir 3 máquinas", event = "open", target = 3, coins = 60, xp = 40 },
	{ id = "d_open8", text = "Abrir 8 máquinas", event = "open", target = 8, coins = 150, xp = 70 },
	{ id = "d_sell2", text = "Vender 2 objetos comuns", event = "sell_common", target = 2, coins = 50, xp = 30 },
	{ id = "d_discover", text = "Descobrir 1 objeto novo", event = "discover", target = 1, coins = 100, xp = 60, needsUndiscovered = true },
	{ id = "d_display", text = "Expor 1 objeto na vitrine", event = "display", target = 1, coins = 40, xp = 25 },
	{ id = "d_sell5", text = "Vender 5 objetos", event = "sell", target = 5, coins = 80, xp = 35 },
}

MissionDefinitions.DailyCount = 3

MissionDefinitions.Achievements = {
	{ id = "a_first", text = "Abrir a primeira máquina", metric = "opens", target = 1, coins = 50, xp = 30 },
	{ id = "a_open50", text = "Abrir 50 máquinas", metric = "opens", target = 50, coins = 400, xp = 150 },
	{ id = "a_open250", text = "Abrir 250 máquinas", metric = "opens", target = 250, coins = 2500, xp = 400 },
	{ id = "a_disc5", text = "Descobrir 5 objetos", metric = "discovered", target = 5, coins = 150, xp = 100 },
	{ id = "a_disc10", text = "Descobrir 10 objetos", metric = "discovered", target = 10, coins = 800, xp = 250 },
	{ id = "a_disc15", text = "Descobrir 15 objetos", metric = "discovered", target = 15, coins = 3000, xp = 500 },
	{ id = "a_set", text = "Completar uma parte da coleção", metric = "setsComplete", target = 1, coins = 300, xp = 150 },
	{ id = "a_lvl5", text = "Alcançar o nível 5", metric = "level", target = 5, coins = 200, xp = 0 },
	{ id = "a_lvl10", text = "Alcançar o nível 10", metric = "level", target = 10, coins = 600, xp = 0 },
	{ id = "a_lvl15", text = "Alcançar o nível 15", metric = "level", target = 15, coins = 1500, xp = 0 },
	{ id = "a_lvl30", text = "Alcançar o nível 30", metric = "level", target = 30, coins = 6000, xp = 0 },
	{ id = "a_sell25", text = "Vender 25 objetos", metric = "sold", target = 25, coins = 250, xp = 120 },
	{ id = "a_show3", text = "Expor 3 objetos ao mesmo tempo", metric = "displayed", target = 3, coins = 300, xp = 120 },
	{ id = "a_legend", text = "Conseguir um objeto Lendário", metric = "bestRank", target = 5, coins = 1000, xp = 300 },
	{ id = "a_secret", text = "Encontrar o objeto Secreto", metric = "bestRank", target = 6, coins = 5000, xp = 800, title = "secret_hunter" },
}

-- Partes da coleção: completar todos os objetos de uma máquina (ou todos os 20).
MissionDefinitions.CollectionSets = {
	{ id = "set_common", machine = "common", name = "Coleção Comum", coins = 150, xp = 150, title = "starter" },
	{ id = "set_neon", machine = "neon", name = "Coleção Neon", coins = 1200, xp = 400, title = "neon_king" },
	{ id = "set_golden", machine = "golden", name = "Coleção Dourada", coins = 5000, xp = 800, title = "golden_baron" },
	{ id = "set_mystery", machine = "mystery", name = "Coleção Misteriosa", coins = 15000, xp = 1500, title = "mystery_master" },
	{ id = "set_all", name = "Coleção Completa", coins = 25000, xp = 3000, title = "legend" },
}

-- Títulos cosméticos exibidos acima da cabeça do jogador
MissionDefinitions.Titles = {
	starter = { name = "Colecionador Iniciante", color = Color3.fromRGB(190, 200, 210) },
	neon_king = { name = "Rei do Neon", color = Color3.fromRGB(0, 255, 210) },
	golden_baron = { name = "Barão Dourado", color = Color3.fromRGB(255, 205, 60) },
	mystery_master = { name = "Mestre do Mistério", color = Color3.fromRGB(170, 90, 255) },
	legend = { name = "Lenda da Coleção", color = Color3.fromRGB(255, 120, 40) },
	secret_hunter = { name = "Caçador de Segredos", color = Color3.fromRGB(255, 60, 70) },
}

local function index(list)
	local out = {}
	for _, d in ipairs(list) do
		out[d.id] = d
	end
	return out
end

MissionDefinitions.DailyById = index(MissionDefinitions.DailyPool)
for _, d in ipairs(MissionDefinitions.DailyFree) do
	MissionDefinitions.DailyById[d.id] = d
end
MissionDefinitions.AchievementById = index(MissionDefinitions.Achievements)
MissionDefinitions.SetById = index(MissionDefinitions.CollectionSets)

return MissionDefinitions
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000011"><Properties><string name="Name">RarityConfig</string><ProtectedString name="Source"><![CDATA[-- Raridades do jogo. `rank` ordena da mais comum (1) para a mais rara (6).
-- confirmSale: a venda pede confirmação. effect: efeito especial na abertura.

local RarityConfig = {}

RarityConfig.Order = { "common", "uncommon", "rare", "epic", "legendary", "secret" }

RarityConfig.Rarities = {
	common = { name = "Comum", rank = 1, color = Color3.fromRGB(170, 176, 186), xp = 30 },
	uncommon = { name = "Incomum", rank = 2, color = Color3.fromRGB(88, 204, 98), xp = 50 },
	rare = { name = "Raro", rank = 3, color = Color3.fromRGB(70, 150, 255), xp = 90, confirmSale = true },
	epic = { name = "Épico", rank = 4, color = Color3.fromRGB(176, 92, 255), xp = 150, confirmSale = true },
	legendary = { name = "Lendário", rank = 5, color = Color3.fromRGB(255, 196, 40), xp = 300, confirmSale = true, effect = "legendary", announce = true },
	secret = { name = "Secreto", rank = 6, color = Color3.fromRGB(255, 52, 64), xp = 600, confirmSale = true, effect = "secret", announce = true },
}

function RarityConfig.get(id)
	return RarityConfig.Rarities[id]
end

function RarityConfig.rank(id)
	local r = RarityConfig.Rarities[id]
	return r and r.rank or 0
end

return RarityConfig
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">UpgradeConfig</string><ProtectedString name="Source"><![CDATA[-- Melhorias compradas com Coins. Nenhuma melhoria altera probabilidades de sorteio.
-- prices[n] = preço para ir do nível n-1 ao nível n. max = #prices.

local UpgradeConfig = {}

UpgradeConfig.Order = { "capacity", "speed", "missionBonus", "showcase" }

UpgradeConfig.Upgrades = {
	capacity = {
		name = "Capacidade do inventário",
		icon = "🎒",
		description = "Guarde mais objetos.",
		prices = { 200, 500, 1200, 3000, 7000, 15000 },
		base = 40,
		perLevel = 20,
	},
	speed = {
		name = "Velocidade de abertura",
		icon = "⚡",
		description = "A animação da máquina fica mais curta.",
		prices = { 300, 900, 2500, 6000 },
		durations = { 4.0, 3.4, 2.8, 2.3, 1.8 }, -- índice = nível + 1
	},
	missionBonus = {
		name = "Recompensas de missões",
		icon = "📜",
		description = "+10% de Coins em missões e presentes por nível.",
		prices = { 400, 1000, 2500, 6000, 12000 },
		perLevel = 0.10,
	},
	showcase = {
		name = "Vitrines",
		icon = "🏛️",
		description = "Mais espaços para expor objetos.",
		prices = { 250, 800, 2500, 7000 },
		base = 2,
		perLevel = 1,
	},
}

function UpgradeConfig.max(id)
	local u = UpgradeConfig.Upgrades[id]
	return u and #u.prices or 0
end

function UpgradeConfig.price(id, currentLevel)
	local u = UpgradeConfig.Upgrades[id]
	return u and u.prices[currentLevel + 1] or nil
end

function UpgradeConfig.capacity(level)
	local u = UpgradeConfig.Upgrades.capacity
	return u.base + u.perLevel * (level or 0)
end

function UpgradeConfig.openDuration(level)
	local d = UpgradeConfig.Upgrades.speed.durations
	return d[math.clamp((level or 0) + 1, 1, #d)]
end

function UpgradeConfig.missionMultiplier(level)
	return 1 + UpgradeConfig.Upgrades.missionBonus.perLevel * (level or 0)
end

function UpgradeConfig.showcaseSlots(level)
	local u = UpgradeConfig.Upgrades.showcase
	return u.base + u.perLevel * (level or 0)
end

UpgradeConfig.MaxShowcaseSlots = UpgradeConfig.showcaseSlots(#UpgradeConfig.Upgrades.showcase.prices)

-- Texto "atual → próximo" para a loja
function UpgradeConfig.benefitText(id, level)
	if id == "capacity" then
		return UpgradeConfig.capacity(level) .. " objetos"
	elseif id == "speed" then
		return string.format("%.1f s", UpgradeConfig.openDuration(level))
	elseif id == "missionBonus" then
		return "+" .. math.floor(UpgradeConfig.Upgrades.missionBonus.perLevel * level * 100 + 0.5) .. "%"
	elseif id == "showcase" then
		return UpgradeConfig.showcaseSlots(level) .. " espaços"
	end
	return ""
end

return UpgradeConfig
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX000015"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX000013"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[-- Formatação de números e tempos para a interface.

local Format = {}

-- 1234567 -> "1.234.567"
function Format.int(n)
	n = math.floor(tonumber(n) or 0)
	local negative = n < 0
	local s = string.format("%d", math.abs(n))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1.")))
	if string.sub(out, 1, 1) == "." then
		out = string.sub(out, 2)
	end
	return (negative and "-" or "") .. out
end

-- 1500 -> "1,5 mil"; 2500000 -> "2,5 mi"
function Format.short(n)
	n = tonumber(n) or 0
	local function trim(x)
		local s = string.format("%.1f", x)
		s = string.gsub(s, "%.0$", "")
		return (string.gsub(s, "%.", ","))
	end
	if n >= 1000000 then
		return trim(n / 1000000) .. " mi"
	elseif n >= 10000 then
		return trim(n / 1000) .. " mil"
	end
	return Format.int(n)
end

function Format.percent(p)
	if p >= 10 or p == math.floor(p) then
		return string.format("%d%%", math.floor(p + 0.5))
	end
	local s = string.format("%.2f", p)
	s = string.gsub(s, "0+$", "")
	s = string.gsub(s, "%.$", "")
	return (string.gsub(s, "%.", ",")) .. "%"
end

function Format.duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	end
	return string.format("%dm %02ds", m, s)
end

return Format
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000014"><Properties><string name="Name">TimeUtil</string><ProtectedString name="Source"><![CDATA[-- Relógio único do jogo (UTC). Usar sempre este módulo para datas de missões e presentes.

local TimeUtil = {}

function TimeUtil.now()
	return DateTime.now().UnixTimestamp
end

function TimeUtil.day(t)
	return math.floor((t or TimeUtil.now()) / 86400)
end

function TimeUtil.secondsToNextDay(t)
	t = t or TimeUtil.now()
	return (TimeUtil.day(t) + 1) * 86400 - t
end

function TimeUtil.hour(t)
	return math.floor((t or TimeUtil.now()) / 3600)
end

return TimeUtil
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX000017"><Properties><string name="Name">Visual</string></Properties><Item class="ModuleScript" referent="RBX000016"><Properties><string name="Name">ItemModels</string><ProtectedString name="Source"><![CDATA[-- Modelos 3D estilizados dos 20 objetos, montados só com peças do Roblox (sem IDs externos).
-- Usados no compartimento da máquina, nas vitrines e nos ícones do inventário (ViewportFrame).
-- Cada modelo tem cerca de 2,6 studs, centro em (0,0,0) e PrimaryPart "Root" invisível.

local ItemModels = {}

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local M = Enum.Material
local BALL = Enum.PartType.Ball
local CYL = Enum.PartType.Cylinder

-- peças: { size = {x,y,z}, pos = {x,y,z}, rot = {x,y,z} em graus, color, mat, shape, alpha, wedge }
local function ring(list, radius, count, y, size, color, mat, tiltX)
	for i = 0, count - 1 do
		local a = (i / count) * math.pi * 2
		table.insert(list, {
			size = size,
			pos = { math.cos(a) * radius, y + (tiltX and math.sin(a) * radius * tiltX or 0), math.sin(a) * radius },
			rot = { 0, -math.deg(a), 0 },
			color = color,
			mat = mat,
		})
	end
	return list
end

local Builders = {}

Builders.cup = function()
	return {
		{ size = { 2.0, 1.5, 1.5 }, pos = { 0, 0, 0 }, rot = { 0, 0, 90 }, shape = CYL, color = C(120, 200, 255), mat = M.Glass, alpha = 0.25 },
		{ size = { 0.05, 1.3, 1.3 }, pos = { 0, 0.98, 0 }, rot = { 0, 0, 90 }, shape = CYL, color = C(255, 150, 60) },
		{ size = { 0.25, 1.1, 0.25 }, pos = { 1.05, 0, 0 }, color = C(80, 160, 230) },
		{ size = { 0.4, 0.22, 0.25 }, pos = { 0.85, 0.45, 0 }, color = C(80, 160, 230) },
		{ size = { 0.4, 0.22, 0.25 }, pos = { 0.85, -0.45, 0 }, color = C(80, 160, 230) },
		{ size = { 0.2, 0.2, 0.2 }, pos = { 0.2, 1.3, 0.2 }, rot = { 0, 0, 20 }, color = C(255, 80, 120) },
		{ size = { 0.15, 1.3, 0.15 }, pos = { 0.25, 1.15, 0.15 }, rot = { 0, 0, 20 }, color = C(255, 255, 255) },
	}
end

Builders.ball = function()
	return {
		{ size = { 2.3, 2.3, 2.3 }, pos = { 0, 0, 0 }, shape = BALL, color = C(250, 250, 250) },
		{ size = { 0.35, 2.36, 2.36 }, pos = { 0, 0, 0 }, shape = CYL, color = C(235, 60, 60) },
		{ size = { 0.35, 2.36, 2.36 }, pos = { 0, 0, 0 }, rot = { 0, 90, 0 }, shape = CYL, color = C(50, 110, 235) },
		{ size = { 0.25, 2.34, 2.34 }, pos = { 0, 0, 0 }, rot = { 0, 0, 90 }, shape = CYL, color = C(255, 210, 40) },
	}
end

Builders.toy_car = function()
	local parts = {
		{ size = { 2.6, 0.7, 1.4 }, pos = { 0, -0.2, 0 }, color = C(230, 50, 50) },
		{ size = { 1.4, 0.65, 1.25 }, pos = { -0.2, 0.45, 0 }, color = C(230, 50, 50) },
		{ size = { 1.2, 0.5, 1.28 }, pos = { -0.2, 0.47, 0 }, color = C(170, 220, 255), mat = M.Glass, alpha = 0.2 },
		{ size = { 0.1, 0.2, 0.3 }, pos = { 1.31, -0.1, 0.45 }, color = C(255, 240, 120), mat = M.Neon },
