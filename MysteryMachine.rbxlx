<Item class="ServerScriptService" referent="RBX000037"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX000036"><Properties><string name="Name">Server</string></Properties><Item class="Folder" referent="RBX000022"><Properties><string name="Name">Core</string></Properties><Item class="ModuleScript" referent="RBX000020"><Properties><string name="Name">RateLimiter</string><ProtectedString name="Source"><![CDATA[-- Limite de frequência por jogador e categoria (balde de fichas).

local RateLimiter = {}

RateLimiter.Categories = {
	machine = { rate = 2, burst = 3 },
	inventory = { rate = 6, burst = 10 },
	upgrade = { rate = 3, burst = 5 },
	progress = { rate = 4, burst = 8 },
}

local buckets = {} -- [player][category] = { tokens, at }

function RateLimiter.allow(player, category)
	local cfg = RateLimiter.Categories[category] or RateLimiter.Categories.progress
	local byPlayer = buckets[player]
	if not byPlayer then
		byPlayer = {}
		buckets[player] = byPlayer
	end
	local now = os.clock()
	local b = byPlayer[category]
	if not b then
		b = { tokens = cfg.burst, at = now }
		byPlayer[category] = b
	end
	b.tokens = math.min(cfg.burst, b.tokens + (now - b.at) * cfg.rate)
	b.at = now
	if b.tokens < 1 then
		return false
	end
	b.tokens = b.tokens - 1
	return true
end

function RateLimiter.clear(player)
	buckets[player] = nil
end

return RateLimiter
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000021"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Cria a pasta ReplicatedStorage.Remotes e centraliza o tratamento de pedidos do cliente.
--
-- Todo pedido (RemoteFunction) passa por: perfil carregado → requestId repetido (devolve a mesma
-- resposta sem repetir a operação) → limite de frequência → trava por jogador → operação com
-- cópia de segurança do perfil (restaurada se der erro no meio) → marca o perfil como alterado.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProfileSchema = require(Shared.Logic.ProfileSchema)
local RateLimiter = require(script.Parent.RateLimiter)

local Remotes = {}

Remotes.Functions = { "RequestMachineUse", "InventoryAction", "UpgradeAction", "ProgressAction" }
Remotes.Events = { "MachineResult", "DataUpdated", "Notify", "LeaderboardUpdated" }

local folder
local handlers = {} -- [remoteName][action] = { fn, category }
local recent = {} -- [player] = { ids = {requestId = response}, order = {...} }
local busy = {} -- [player] = true durante uma operação
local dataService -- injetado por init (evita dependência circular)
local afterSuccess = {}

local MAX_RECENT = 30

local function remember(player, requestId, response)
	local r = recent[player]
	if not r then
		r = { ids = {}, order = {} }
		recent[player] = r
	end
	r.ids[requestId] = response
	table.insert(r.order, requestId)
	if #r.order > MAX_RECENT then
		r.ids[table.remove(r.order, 1)] = nil
	end
end

local function dispatch(remoteName, player, payload)
	if type(payload) ~= "table" or type(payload.action) ~= "string" then
		return { ok = false, error = "invalid", message = "Pedido inválido." }
	end
	local entry = handlers[remoteName][payload.action]
	if not entry then
		return { ok = false, error = "invalid", message = "Ação desconhecida." }
	end
	local profile = dataService.getProfile(player)
	if not profile then
		return { ok = false, error = "loading", message = "Carregando seus dados..." }
	end
	local requestId = payload.requestId
	if type(requestId) == "string" and #requestId <= 64 then
		local r = recent[player]
		if r and r.ids[requestId] then
			return r.ids[requestId]
		end
	else
		requestId = nil
	end
	if not RateLimiter.allow(player, entry.category) then
		return { ok = false, error = "rate", message = "Calma! Muitos pedidos seguidos." }
	end
	if busy[player] then
		return { ok = false, error = "busy", message = "Aguarde a ação anterior terminar." }
	end
	busy[player] = true
	local backup = ProfileSchema.deepCopy(profile)
	local ok, result = pcall(entry.fn, player, profile, payload)
	busy[player] = nil
	if not ok then
		warn("[MYSTERY MACHINE] erro em " .. remoteName .. "." .. payload.action .. ": " .. tostring(result))
		dataService.restore(player, backup)
		result = { ok = false, error = "server", message = "Algo deu errado. Nada foi alterado." }
	elseif type(result) ~= "table" then
		result = { ok = false, error = "server", message = "Resposta inválida." }
	end
	if result.ok then
		dataService.markDirty(player)
		for _, fn in ipairs(afterSuccess) do
			fn(player, result)
		end
	end
	if requestId then
		remember(player, requestId, result)
	end
	return result
end

function Remotes.init(playerDataService)
	dataService = playerDataService
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(Remotes.Functions) do
		local rf = Instance.new("RemoteFunction")
		rf.Name = name
		rf.Parent = folder
		handlers[name] = {}
		rf.OnServerInvoke = function(player, payload)
			return dispatch(name, player, payload)
		end
	end
	for _, name in ipairs(Remotes.Events) do
		local re = Instance.new("RemoteEvent")
		re.Name = name
		re.Parent = folder
	end
end

-- registra fn(player, profile, payload) -> resultado para remote/action
function Remotes.handle(remoteName, action, category, fn)
	handlers[remoteName][action] = { fn = fn, category = category }
end

function Remotes.onSuccess(fn)
	table.insert(afterSuccess, fn)
end

function Remotes.event(name)
	return folder:FindFirstChild(name)
end

function Remotes.notify(player, text, kind)
	Remotes.event("Notify"):FireClient(player, { text = text, kind = kind or "info" })
end

function Remotes.notifyAll(text, kind)
	Remotes.event("Notify"):FireAllClients({ text = text, kind = kind or "info" })
end

function Remotes.clear(player)
	recent[player] = nil
	busy[player] = nil
	RateLimiter.clear(player)
end

return Remotes
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Script" referent="RBX000023"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- MYSTERY MACHINE — Máquina Surpresa: inicialização do servidor.
-- Ordem: mapa → remotes → dados → serviços de jogo. Nenhum serviço confia em valores do cliente.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProfileOps = require(Shared.Logic.ProfileOps)
local MachineDefinitions = require(Shared.MachineDefinitions)

local Core = script.Parent.Core
local Services = script.Parent.Services
local Remotes = require(Core.Remotes)
local MapService = require(Services.MapService)
local PlayerDataService = require(Services.PlayerDataService)
local EconomyService = require(Services.EconomyService)
local MachineService = require(Services.MachineService)
local InventoryService = require(Services.InventoryService)
local UpgradeService = require(Services.UpgradeService)
local CollectionService = require(Services.CollectionService)
local MissionService = require(Services.MissionService)
local RewardService = require(Services.RewardService)
local ShowcaseService = require(Services.ShowcaseService)
local LeaderboardService = require(Services.LeaderboardService)

MapService.build()
Remotes.init(PlayerDataService)

-- ações gerais: sincronizar (o cliente pede a fotografia ao iniciar), configurações do jogador e atalhos de teleporte do menu
Remotes.handle("ProgressAction", "sync", "progress", function()
	return { ok = true }
end)
Remotes.handle("ProgressAction", "setSetting", "progress", function(_, profile, payload)
	return ProfileOps.setSetting(profile, payload.key, payload.value)
end)
Remotes.handle("ProgressAction", "goto", "progress", function(player, _, payload)
	local target = payload.target
	local point
	if MachineDefinitions.get(target) then
		point = MapService.machines[target].standPoint
	elseif target == "showcase" then
		point = ShowcaseService.boothPosition(player) or MapService.points.gallery
	elseif type(target) == "string" then
		point = MapService.points[target]
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not point or not root then
		return { ok = false, error = "invalid", message = "Destino indisponível." }
	end
	root.CFrame = CFrame.new(point)
	return { ok = true }
end)

MachineService.start()
InventoryService.start()
UpgradeService.start()
CollectionService.start()
MissionService.start()
RewardService.start()
ShowcaseService.start()
EconomyService.start()
LeaderboardService.start()
PlayerDataService.start()

print("[MYSTERY MACHINE] servidor pronto")
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX000035"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000024"><Properties><string name="Name">CollectionService</string><ProtectedString name="Source"><![CDATA[-- Livro de coleções (não confundir com o CollectionService de tags do Roblox):
-- recompensas por completar partes da coleção, títulos cosméticos e o título acima da cabeça.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MissionDefinitions = require(Shared.MissionDefinitions)
local ProfileOps = require(Shared.Logic.ProfileOps)
local Remotes = require(script.Parent.Parent.Core.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)

local CollectionBook = {}

local shownTitle = {} -- [player] = id do título aplicado ao personagem

local function applyTitle(player, profile)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not head then
		return
	end
	local titleId = profile and profile.title or ""
	local tag = head:FindFirstChild("TitleTag")
	if shownTitle[player] == titleId and (titleId == "") == (tag == nil) then
		return
	end
	shownTitle[player] = titleId
	if tag then
		tag:Destroy()
	end
	local def = MissionDefinitions.Titles[titleId]
	if not def then
		return
	end
	tag = Instance.new("BillboardGui")
	tag.Name = "TitleTag"
	tag.Size = UDim2.new(0, 220, 0, 32)
	tag.StudsOffset = Vector3.new(0, 2.6, 0)
	tag.MaxDistance = 60
	tag.AlwaysOnTop = false
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.new(1, 0, 1, 0)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.Text = "« " .. def.name .. " »"
	text.TextColor3 = def.color
	text.TextStrokeTransparency = 0.3
	text.Parent = tag
	tag.Parent = head
end

function CollectionBook.start()
	Remotes.handle("ProgressAction", "claimSet", "progress", function(_, profile, payload)
		return ProfileOps.claimSet(profile, payload.setId)
	end)
	Remotes.handle("ProgressAction", "setTitle", "progress", function(_, profile, payload)
		return ProfileOps.setTitle(profile, payload.titleId)
	end)
	PlayerDataService.onLoaded(function(player, profile)
		player.CharacterAdded:Connect(function()
			shownTitle[player] = nil
			task.wait(0.5)
			applyTitle(player, PlayerDataService.getProfile(player))
		end)
		applyTitle(player, profile)
	end)
	PlayerDataService.onChanged(applyTitle)
	PlayerDataService.onLeaving(function(player)
		shownTitle[player] = nil
	end)
end

return CollectionBook
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000025"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[-- Coins: leaderstats e "moedas perdidas" pelo parque (atividade gratuita para quem ficou sem saldo).
-- A coleta é validada no servidor: jogador perto da moeda, perfil carregado e limite por hora.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EconomyConfig = require(Shared.EconomyConfig)
local ProfileOps = require(Shared.Logic.ProfileOps)
local TimeUtil = require(Shared.Util.TimeUtil)
local Remotes = require(script.Parent.Parent.Core.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local MapService = require(script.Parent.MapService)

local EconomyService = {}

local active = {} -- [spotIndex] = part
local limitWarned = {} -- [player] = os.clock() do último aviso de limite
local rng = Random.new()

local function updateLeaderstats(player, profile)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		local coins = Instance.new("IntValue")
		coins.Name = "Coins"
		coins.Parent = stats
		local level = Instance.new("IntValue")
		level.Name = "Nível"
		level.Parent = stats
		stats.Parent = player
	end
	stats.Coins.Value = profile.coins
	stats["Nível"].Value = ProfileOps.level(profile)
end

local function playerFromHit(hit)
	local model = hit and hit.Parent
	if not model then
		return nil
	end
	return Players:GetPlayerFromCharacter(model)
end

-- tenta coletar a moeda do ponto `spot` para o jogador (validação completa no servidor)
function EconomyService.collect(player, spot)
	local coin = active[spot]
	if not coin or not coin.Parent then
		return false
	end
	local profile = PlayerDataService.getProfile(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not profile or not root then
		return false
	end
	if (root.Position - coin.Position).Magnitude > EconomyConfig.Pickups.radius then
		return false
	end
	local result = ProfileOps.pickup(profile, TimeUtil.now())
	if not result.ok then
		local last = limitWarned[player]
		if not last or os.clock() - last > 15 then
			limitWarned[player] = os.clock()
			Remotes.notify(player, result.message, "warn")
		end
		return false
	end
	active[spot] = nil
	coin:Destroy()
	PlayerDataService.markDirty(player)
	Remotes.notify(player, "💰 +" .. result.coins .. " Coins (moeda perdida)", "coins")
	task.delay(EconomyConfig.Pickups.respawn, function()
		EconomyService.spawnCoin()
	end)
	return true
end

function EconomyService.spawnCoin()
	local free = {}
	for i = 1, #MapService.pickupSpots do
		if not active[i] then
			table.insert(free, i)
		end
	end
	if #free == 0 then
		return
	end
	local spot = free[rng:NextInteger(1, #free)]
	local pos = MapService.pickupSpots[spot]
	local coin = Instance.new("Part")
	coin.Name = "LostCoin"
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.4, 2.2, 2.2)
	coin.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(90), 0)
	coin.Color = Color3.fromRGB(255, 205, 50)
	coin.Material = Enum.Material.Neon
	coin.Anchored = true
	coin.CanCollide = false
	coin:SetAttribute("Spot", spot)
	coin.Parent = MapService.pickupFolder
	active[spot] = coin
	coin.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if player then
			EconomyService.collect(player, spot)
		end
	end)
	return coin
end

function EconomyService.activeCoins()
	return active
end

function EconomyService.start()
	PlayerDataService.onLoaded(updateLeaderstats)
	PlayerDataService.onChanged(updateLeaderstats)
	PlayerDataService.onLeaving(function(player)
		limitWarned[player] = nil
	end)
	for _ = 1, EconomyConfig.Pickups.spots do
		EconomyService.spawnCoin()
	end
end

return EconomyService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000026"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[-- Ações do inventário: vender, vender repetidos, favoritar, expor e retirar da vitrine.
-- O valor de venda vem sempre de ItemDefinitions (servidor); o cliente só manda id e quantidade.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProfileOps = require(Shared.Logic.ProfileOps)
local TimeUtil = require(Shared.Util.TimeUtil)
local Remotes = require(script.Parent.Parent.Core.Remotes)

local InventoryService = {}

function InventoryService.start()
	Remotes.handle("InventoryAction", "sell", "inventory", function(_, profile, payload)
		return ProfileOps.sell(profile, payload.itemId, payload.amount or 1, payload.confirm == true, TimeUtil.now())
	end)
	Remotes.handle("InventoryAction", "sellDuplicates", "inventory", function(_, profile)
		return ProfileOps.sellDuplicates(profile, TimeUtil.now())
	end)
	Remotes.handle("InventoryAction", "favorite", "inventory", function(_, profile, payload)
		return ProfileOps.setFavorite(profile, payload.itemId, payload.value == true)
	end)
	Remotes.handle("InventoryAction", "display", "inventory", function(_, profile, payload)
		return ProfileOps.display(profile, payload.itemId, payload.slot, TimeUtil.now())
	end)
	Remotes.handle("InventoryAction", "undisplay", "inventory", function(_, profile, payload)
		return ProfileOps.undisplay(profile, payload.slot)
	end)
end

return InventoryService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000027"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[-- Rankings: maior valor de coleção, mais objetos descobertos, maior nível e mais conquistas.
-- * Servidor: calculado da memória a cada 15 s (sem DataStore).
-- * Global: OrderedDataStore com escrita no máximo a cada LeaderboardWriteInterval por jogador
--   (só se o valor mudou) e leitura do top a cada LeaderboardRefresh, guardada em cache.
-- Os clientes recebem o cache por LeaderboardUpdated; o painel 3D do parque usa o mesmo cache.

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EconomyConfig = require(Shared.EconomyConfig)
local ProfileOps = require(Shared.Logic.ProfileOps)
local Format = require(Shared.Util.Format)
local Remotes = require(script.Parent.Parent.Core.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local MapService = require(script.Parent.MapService)

local LeaderboardService = {}

LeaderboardService.Boards = {
	{ id = "value", name = "Valor da coleção", metric = ProfileOps.collectionValue },
	{ id = "discovered", name = "Descobertas", metric = ProfileOps.discoveredCount },
	{ id = "level", name = "Nível", metric = ProfileOps.level },
	{ id = "achievements", name = "Conquistas", metric = ProfileOps.achievementCount },
}
LeaderboardService.ServerRefresh = 15

local cache = { server = {}, global = {}, updatedAt = 0 }
local stores = {}
local lastWrite = {} -- [userId][board] = { value, at }
local names = {} -- [userId] = nome

local function nameOf(userId)
	if names[userId] then
		return names[userId]
	end
	local p = Players:GetPlayerByUserId(userId)
	if p then
		names[userId] = p.DisplayName
		return names[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	names[userId] = ok and name or ("Jogador " .. userId)
	return names[userId]
end

function LeaderboardService.computeServer()
	for _, board in ipairs(LeaderboardService.Boards) do
		local rows = {}
		for _, player in ipairs(PlayerDataService.loadedPlayers()) do
			local profile = PlayerDataService.getProfile(player)
			table.insert(rows, { name = player.DisplayName, value = board.metric(profile), userId = player.UserId })
		end
		table.sort(rows, function(a, b)
			return a.value > b.value
		end)
		while #rows > EconomyConfig.LeaderboardSize do
			table.remove(rows)
		end
		cache.server[board.id] = rows
	end
end

local function writeGlobal(player, profile, force)
	if PlayerDataService.memoryMode then
		return
	end
	local now = os.clock()
	local byBoard = lastWrite[player.UserId] or {}
	lastWrite[player.UserId] = byBoard
	for _, board in ipairs(LeaderboardService.Boards) do
		local value = math.floor(board.metric(profile))
		local last = byBoard[board.id]
		if value > 0 and (not last or (last.value ~= value and (force or now - last.at >= EconomyConfig.LeaderboardWriteInterval))) then
			byBoard[board.id] = { value = value, at = now }
			local ok, err = pcall(function()
				stores[board.id]:SetAsync(tostring(player.UserId), value)
			end)
			if not ok then
				warn("[MYSTERY MACHINE] ranking global: falha ao gravar " .. board.id .. ": " .. tostring(err))
			end
		end
	end
end

function LeaderboardService.refreshGlobal()
	if PlayerDataService.memoryMode then
		return
	end
	for _, board in ipairs(LeaderboardService.Boards) do
		local ok, page = pcall(function()
			return stores[board.id]:GetSortedAsync(false, EconomyConfig.LeaderboardSize):GetCurrentPage()
		end)
		if ok then
			local rows = {}
			for _, entry in ipairs(page) do
				local userId = tonumber(entry.key)
				table.insert(rows, { name = userId and nameOf(userId) or "?", value = entry.value, userId = userId })
			end
			cache.global[board.id] = rows
		end
	end
	cache.updatedAt = os.clock()
end

local function drawBoard()
	local frame = MapService.rankingBoard
	if not frame then
		return
	end
	local old = frame:FindFirstChild("Columns")
	if old then
		old:Destroy()
	end
	local columns = Instance.new("Frame")
	columns.Name = "Columns"
	columns.BackgroundTransparency = 1
	columns.Position = UDim2.new(0, 0, 0.15, 0)
	columns.Size = UDim2.new(1, 0, 0.85, 0)
	columns.Parent = frame
	for i, board in ipairs(LeaderboardService.Boards) do
		local rows = cache.global[board.id]
		if not rows or #rows == 0 then
			rows = cache.server[board.id] or {}
		end
		local col = Instance.new("TextLabel")
		col.BackgroundTransparency = 1
		col.Position = UDim2.new((i - 1) / 4, 6, 0, 0)
		col.Size = UDim2.new(0.25, -12, 1, 0)
		col.Font = Enum.Font.GothamBold
		col.TextScaled = true
		col.TextXAlignment = Enum.TextXAlignment.Left
		col.TextYAlignment = Enum.TextYAlignment.Top
		col.TextColor3 = Color3.fromRGB(255, 255, 255)
		local lines = { board.name }
		for r = 1, math.min(5, #rows) do
			table.insert(lines, r .. ". " .. rows[r].name .. "  " .. Format.short(rows[r].value))
		end
		if #rows == 0 then
			table.insert(lines, "—")
		end
		col.Text = table.concat(lines, "\n")
		col.Parent = columns
	end
end

function LeaderboardService.get()
	return cache
end

function LeaderboardService.broadcast()
	Remotes.event("LeaderboardUpdated"):FireAllClients(cache)
	drawBoard()
end

function LeaderboardService.start()
	for _, board in ipairs(LeaderboardService.Boards) do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore("MysteryMachine_LB_" .. board.id .. "_v1")
		end)
		stores[board.id] = ok and store or nil
	end
	Remotes.handle("ProgressAction", "leaderboard", "progress", function()
		return { ok = true, data = cache }
	end)
	PlayerDataService.onLoaded(function(player)
		Remotes.event("LeaderboardUpdated"):FireClient(player, cache)
	end)
	PlayerDataService.onLeaving(function(player, profile)
		writeGlobal(player, profile, true)
		lastWrite[player.UserId] = nil
	end)
	task.spawn(function()
		local sinceGlobal = math.huge
		while true do
			LeaderboardService.computeServer()
			for _, player in ipairs(PlayerDataService.loadedPlayers()) do
				local profile = PlayerDataService.getProfile(player)
				if profile then
					writeGlobal(player, profile, false)
				end
			end
			if sinceGlobal >= EconomyConfig.LeaderboardRefresh then
				sinceGlobal = 0
				LeaderboardService.refreshGlobal()
			end
			LeaderboardService.broadcast()
			sinceGlobal = sinceGlobal + task.wait(LeaderboardService.ServerRefresh)
		end
	end)
end

return LeaderboardService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000028"><Properties><string name="Name">MachineService</string><ProtectedString name="Source"><![CDATA[-- Uso das máquinas misteriosas. Fluxo no SERVIDOR:
-- 1. confere perfil, intervalo mínimo entre aberturas e se o jogador está perto da máquina;
-- 2. ProfileOps.useMachine confere nível, saldo e espaço, desconta o preço, sorteia com o Random
--    do servidor, entrega o objeto, registra descoberta, XP e missões — tudo de uma vez;
-- 3. avisa todos os clientes (MachineResult) para tocarem a animação daquela máquina.
-- O cliente só envia o id da máquina; preço, chances e resultado nunca vêm dele.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EconomyConfig = require(Shared.EconomyConfig)
local MachineDefinitions = require(Shared.MachineDefinitions)
local ItemDefinitions = require(Shared.ItemDefinitions)
local RarityConfig = require(Shared.RarityConfig)
local ProfileOps = require(Shared.Logic.ProfileOps)
local TimeUtil = require(Shared.Util.TimeUtil)
local Remotes = require(script.Parent.Parent.Core.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local MapService = require(script.Parent.MapService)

local MachineService = {}

MachineService.rng = Random.new()
local lastOpen = {} -- [player] = os.clock()

local function nearMachine(player, machineId)
	local pos = MapService.machinePosition(machineId)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not pos or not root then
		return false
	end
	return (root.Position - pos).Magnitude <= MachineDefinitions.UseRadius
end

function MachineService.use(player, profile, payload)
	local machineId = payload.machineId
	if not MachineDefinitions.get(machineId) then
		return { ok = false, error = "unknown", message = "Máquina desconhecida." }
	end
	local last = lastOpen[player]
	if last and os.clock() - last < EconomyConfig.OpenCooldown then
		return { ok = false, error = "busy", message = "A máquina ainda está entregando o prêmio." }
	end
	if not nearMachine(player, machineId) then
		return { ok = false, error = "far", message = "Chegue perto da máquina para usá-la." }
	end
	local result = ProfileOps.useMachine(profile, machineId, MachineService.rng:NextNumber(), TimeUtil.now())
	if not result.ok then
		return result
	end
	lastOpen[player] = os.clock()
	Remotes.event("MachineResult"):FireAllClients({
		machineId = machineId,
		userId = player.UserId,
		itemId = result.itemId,
		rarity = result.rarity,
		duration = result.duration,
	})
	local rarity = RarityConfig.get(result.rarity)
	if rarity.announce then
		local item = ItemDefinitions.get(result.itemId)
		Remotes.notifyAll((rarity.effect == "secret" and "🔴 " or "🌟 ") .. player.DisplayName .. " conseguiu " .. item.name .. " (" .. rarity.name .. ")!", rarity.effect)
	end
	return result
end

function MachineService.start()
	Remotes.handle("RequestMachineUse", "use", "machine", MachineService.use)
	PlayerDataService.onLeaving(function(player)
		lastOpen[player] = nil
	end)
end

return MachineService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000029"><Properties><string name="Name">MapService</string><ProtectedString name="Source"><![CDATA[-- Constrói o parque (lobby compacto) por código ao iniciar o servidor:
-- praça central com spawn, 4 máquinas físicas ao norte, loja de melhorias a leste, painel de
-- ranking a oeste, galeria de vitrines ao sul, árvores, postes, caminhos e uma área "em breve".
-- Guarda as posições usadas pelos outros serviços (máquinas, vitrines, moedas, pontos de teleporte).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MachineDefinitions = require(Shared.MachineDefinitions)
local UpgradeConfig = require(Shared.UpgradeConfig)
local Format = require(Shared.Util.Format)

local MapService = {}

MapService.machines = {} -- [machineId] = { model, button, position, trayPoint }
MapService.booths = {} -- { { model, slots = { {pedestal, anchor} }, sign, position } }
MapService.pickupSpots = {}
MapService.points = {}
MapService.rankingBoard = nil -- Frame dentro do SurfaceGui do painel

local world

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function part(parent, props)
	local p = Instance.new(props.class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = props.material or Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		if k ~= "class" and k ~= "material" then
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function label(parent, text, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, 0, 1, 0)
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = C(255, 255, 255)
	l.TextStrokeTransparency = 0.4
	l.Text = text
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function surface(partInstance, face, pixelsPerStud)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 40
	gui.LightInfluence = 0
	gui.Parent = partInstance
	return gui
end

local function prompt(parentPart, actionText, objectText, attrs)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = actionText
	pr.ObjectText = objectText
	pr.HoldDuration = 0
	pr.MaxActivationDistance = 12
	pr.RequiresLineOfSight = false
	pr.KeyboardKeyCode = Enum.KeyCode.E
	for k, v in pairs(attrs or {}) do
		pr:SetAttribute(k, v)
	end
	pr.Parent = parentPart
	return pr
end

---------------------------------------------------------------------------
-- máquina
---------------------------------------------------------------------------
local function buildMachine(parent, def, origin)
	local model = Instance.new("Model")
	model.Name = "Machine_" .. def.id
	model:SetAttribute("MachineId", def.id)
	local function at(x, y, z)
		return origin * CFrame.new(x, y, z)
	end
	part(model, { Name = "Base", Size = Vector3.new(7.5, 1, 6.5), CFrame = at(0, 0.5, 0), Color = C(40, 40, 50) })
	local body = part(model, { Name = "Body", Size = Vector3.new(6.4, 9, 5), CFrame = at(0, 5.5, 0), Color = def.bodyColor })
	model.PrimaryPart = body
	part(model, { Name = "Top", Size = Vector3.new(7, 1.4, 5.6), CFrame = at(0, 10.7, 0), Color = def.accentColor })
	part(model, { Name = "TopDome", Size = Vector3.new(4.5, 4.5, 4.5), CFrame = at(0, 11.4, 0), Color = def.accentColor, Shape = Enum.PartType.Ball, material = Enum.Material.Glass, Transparency = 0.35 })
	-- visor transparente com cápsulas dentro
	part(model, { Name = "VisorBack", Size = Vector3.new(4.8, 4.4, 0.3), CFrame = at(0, 7, 1.2), Color = C(25, 25, 35) })
	part(model, { Name = "Visor", Size = Vector3.new(5, 4.6, 0.25), CFrame = at(0, 7, 2.6), Color = C(200, 235, 255), material = Enum.Material.Glass, Transparency = 0.55 })
	part(model, { Name = "VisorFrame", Size = Vector3.new(5.4, 0.35, 0.4), CFrame = at(0, 9.4, 2.55), Color = def.accentColor })
	part(model, { Name = "VisorFrame", Size = Vector3.new(5.4, 0.35, 0.4), CFrame = at(0, 4.6, 2.55), Color = def.accentColor })
	local capsules = folder(model, "Capsules")
	local capsuleColors = { C(255, 90, 90), C(90, 200, 255), C(255, 220, 70), C(140, 255, 120), C(220, 120, 255), C(255, 160, 60) }
	for i = 1, 6 do
		local col = (i - 1) % 3
		local row = math.floor((i - 1) / 3)
		part(capsules, {
			Name = "Capsule",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.1, 1.1, 1.1),
			CFrame = at(-1.4 + col * 1.4, 6.1 + row * 1.6, 1.95),
			Color = capsuleColors[i],
			CanCollide = false,
		})
	end
	local light = Instance.new("PointLight")
	light.Name = "VisorLight"
	light.Color = def.lightColor
	light.Range = 10
	light.Brightness = 1
	light.Parent = model:FindFirstChild("VisorBack")
	-- compartimento de entrega
	part(model, { Name = "Tray", Size = Vector3.new(3.4, 1.8, 1.6), CFrame = at(-0.6, 2.4, 2.6), Color = C(20, 20, 25) })
	part(model, { Name = "TrayLip", Size = Vector3.new(3.6, 0.3, 0.4), CFrame = at(-0.6, 1.4, 3.3), Color = def.accentColor })
	local trayPoint = part(model, { Name = "TrayPoint", Size = Vector3.new(0.5, 0.5, 0.5), CFrame = at(-0.6, 3.0, 4.2), Transparency = 1, CanCollide = false, CanQuery = false })
	-- botão de interação
	local button = part(model, {
		Name = "Button",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 1.3, 1.3),
		CFrame = at(2.1, 3.0, 2.65) * CFrame.Angles(0, math.rad(90), 0),
		Color = C(255, 60, 60),
		material = Enum.Material.Neon,
	})
	part(model, { Name = "ButtonRing", Size = Vector3.new(1.7, 1.7, 0.3), CFrame = at(2.1, 3.0, 2.55), Color = C(240, 240, 240) })
	prompt(button, "Usar máquina", def.name, { MachineId = def.id })
	-- luzes
	local lights = folder(model, "Lights")
	for i = 0, 6 do
		part(lights, { Name = "Light", Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5), CFrame = at(-3 + i, 10.2, 2.85), Color = def.lightColor, material = Enum.Material.Neon, CanCollide = false })
	end
	for i = 0, 4 do
		part(lights, { Name = "Light", Shape = Enum.PartType.Ball, Size = Vector3.new(0.45, 0.45, 0.45), CFrame = at(-3.25, 2 + i * 1.8, 2.55), Color = def.lightColor, material = Enum.Material.Neon, CanCollide = false })
		part(lights, { Name = "Light", Shape = Enum.PartType.Ball, Size = Vector3.new(0.45, 0.45, 0.45), CFrame = at(3.25, 2 + i * 1.8, 2.55), Color = def.lightColor, material = Enum.Material.Neon, CanCollide = false })
	end
	-- placa com nome, preço e nível
	local sign = part(model, { Name = "Sign", Size = Vector3.new(7, 2.2, 0.3), CFrame = at(0, 14.6, 0.5), Color = C(30, 30, 40) })
	local gui = surface(sign, Enum.NormalId.Front, 30)
	label(gui, def.name, { Size = UDim2.new(1, 0, 0.6, 0) })
	label(gui, "💰 " .. Format.int(def.price) .. " Coins  •  Nível " .. def.level .. "+", {
		Size = UDim2.new(1, 0, 0.4, 0),
		Position = UDim2.new(0, 0, 0.6, 0),
		TextColor3 = C(255, 230, 120),
	})
	model.Parent = parent
	return model, button, trayPoint
end

---------------------------------------------------------------------------
-- decoração
---------------------------------------------------------------------------
local function tree(parent, x, z, scale)
	scale = scale or 1
	part(parent, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(5 * scale, 1.4 * scale, 1.4 * scale), CFrame = CFrame.new(x, 2.5 * scale, z) * CFrame.Angles(0, 0, math.rad(90)), Color = C(120, 80, 50), material = Enum.Material.Wood })
	part(parent, { Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(6, 6, 6) * scale, CFrame = CFrame.new(x, 6.5 * scale, z), Color = C(70, 175, 80), material = Enum.Material.Grass, CanCollide = false })
	part(parent, { Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4) * scale, CFrame = CFrame.new(x + 1.2 * scale, 8.6 * scale, z - 0.6 * scale), Color = C(95, 200, 95), material = Enum.Material.Grass, CanCollide = false })
end

local function lamp(parent, x, z, color)
	part(parent, { Name = "Pole", Size = Vector3.new(0.5, 8, 0.5), CFrame = CFrame.new(x, 4, z), Color = C(50, 50, 60), material = Enum.Material.Metal })
	local bulb = part(parent, { Name = "Bulb", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = CFrame.new(x, 8.4, z), Color = color or C(255, 240, 180), material = Enum.Material.Neon, CanCollide = false })
	local light = Instance.new("PointLight")
	light.Range = 14
	light.Brightness = 0.8
	light.Color = color or C(255, 240, 180)
	light.Parent = bulb
end

local function path(parent, from, to, width)
	local mid = (from + to) / 2
	local delta = to - from
	local length = delta.Magnitude
	local size
	if math.abs(delta.X) > math.abs(delta.Z) then
		size = Vector3.new(length, 0.2, width)
	else
		size = Vector3.new(width, 0.2, length)
	end
	part(parent, { Name = "Path", Size = size, CFrame = CFrame.new(mid.X, 0.1, mid.Z), Color = C(235, 215, 175), material = Enum.Material.Sand, CanCollide = true })
end

---------------------------------------------------------------------------
-- áreas
---------------------------------------------------------------------------
local function buildShop(parent)
	local m = Instance.new("Model")
	m.Name = "UpgradeShop"
	local x, z = 58, 0
	part(m, { Name = "Floor", Size = Vector3.new(14, 0.4, 16), CFrame = CFrame.new(x, 0.2, z), Color = C(250, 240, 220) })
	part(m, { Name = "Back", Size = Vector3.new(1, 10, 16), CFrame = CFrame.new(x + 6.5, 5, z), Color = C(90, 60, 160) })
	local counter = part(m, { Name = "Counter", Size = Vector3.new(3, 3.4, 10), CFrame = CFrame.new(x + 1, 1.7, z), Color = C(255, 180, 60) })
	for i = 0, 7 do
		part(m, { Name = "Awning", Size = Vector3.new(8, 0.4, 2), CFrame = CFrame.new(x + 2.5, 10.2, z - 7 + i * 2) * CFrame.Angles(0, 0, math.rad(-12)), Color = (i % 2 == 0) and C(255, 90, 120) or C(255, 255, 255) })
	end
	local sign = part(m, { Name = "Sign", Size = Vector3.new(0.4, 2.6, 12), CFrame = CFrame.new(x - 1.8, 12.2, z), Color = C(40, 30, 70) })
	local gui = surface(sign, Enum.NormalId.Left, 30)
	label(gui, "⚙️ MELHORIAS")
	prompt(counter, "Abrir loja", "Melhorias", { Panel = "Upgrades" })
	m.Parent = parent
	MapService.points.shop = Vector3.new(x - 6, 3, z)
end

local function buildRanking(parent)
	local m = Instance.new("Model")
	m.Name = "RankingBoard"
	local x, z = -58, 0
	part(m, { Name = "Floor", Size = Vector3.new(10, 0.4, 22), CFrame = CFrame.new(x, 0.2, z), Color = C(220, 230, 245) })
	part(m, { Name = "Leg", Size = Vector3.new(1, 6, 1), CFrame = CFrame.new(x - 2, 3, z - 9), Color = C(50, 50, 60) })
	part(m, { Name = "Leg", Size = Vector3.new(1, 6, 1), CFrame = CFrame.new(x - 2, 3, z + 9), Color = C(50, 50, 60) })
	local board = part(m, { Name = "Board", Size = Vector3.new(0.6, 11, 22), CFrame = CFrame.new(x - 2, 11, z), Color = C(25, 25, 40) })
	local gui = surface(board, Enum.NormalId.Right, 25)
	local frame = Instance.new("Frame")
	frame.Name = "Content"
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundTransparency = 1
	frame.Parent = gui
	label(frame, "🏆 RANKING", { Name = "Title", Size = UDim2.new(1, 0, 0.14, 0) })
	MapService.rankingBoard = frame
	prompt(board, "Ver ranking", "Ranking", { Panel = "Ranking" })
	m.Parent = parent
	MapService.points.ranking = Vector3.new(x + 6, 3, z)
end

local function buildGallery(parent)
	local gallery = Instance.new("Model")
	gallery.Name = "Gallery"
	part(gallery, { Name = "Floor", Size = Vector3.new(96, 0.4, 62), CFrame = CFrame.new(0, 0.2, 76), Color = C(240, 235, 250), material = Enum.Material.Marble })
	local arch = part(gallery, { Name = "Arch", Size = Vector3.new(30, 3, 1), CFrame = CFrame.new(0, 12, 45), Color = C(120, 80, 200) })
	part(gallery, { Name = "ArchLeg", Size = Vector3.new(1.5, 12, 1.5), CFrame = CFrame.new(-15, 6, 45), Color = C(120, 80, 200) })
	part(gallery, { Name = "ArchLeg", Size = Vector3.new(1.5, 12, 1.5), CFrame = CFrame.new(15, 6, 45), Color = C(120, 80, 200) })
	label(surface(arch, Enum.NormalId.Back, 25), "🏛️ GALERIA DE VITRINES")
	local index = 0
	for row = 0, 1 do
		for col = 0, 3 do
			index = index + 1
			local cx, cz = -36 + col * 24, 62 + row * 28
			local booth = Instance.new("Model")
			booth.Name = "Booth" .. index
			part(booth, { Name = "Tile", Size = Vector3.new(21, 0.3, 22), CFrame = CFrame.new(cx, 0.55, cz), Color = (index % 2 == 0) and C(220, 210, 245) or C(210, 230, 250) })
			part(booth, { Name = "BackWall", Size = Vector3.new(21, 7, 0.8), CFrame = CFrame.new(cx, 3.9, cz + 10.6), Color = C(110, 90, 170) })
			local sign = part(booth, { Name = "Sign", Size = Vector3.new(14, 2.4, 0.4), CFrame = CFrame.new(cx, 8.6, cz + 10.6), Color = C(40, 30, 60) })
			local signLabel = label(surface(sign, Enum.NormalId.Front, 25), "Vitrine livre", { Name = "Owner" })
			local slots = {}
			for i = 1, UpgradeConfig.MaxShowcaseSlots do
				local sx = cx - 6 + ((i - 1) % 3) * 6
				local sz = cz - 3 + math.floor((i - 1) / 3) * 8
				local pedestal = part(booth, { Name = "Pedestal" .. i, Size = Vector3.new(3, 3, 3), CFrame = CFrame.new(sx, 2.2, sz), Color = C(250, 250, 255), material = Enum.Material.Marble })
				local glass = part(booth, { Name = "Glass" .. i, Size = Vector3.new(3.2, 3.6, 3.2), CFrame = CFrame.new(sx, 5.5, sz), Color = C(210, 240, 255), material = Enum.Material.Glass, Transparency = 0.8, CanCollide = false })
				table.insert(slots, { pedestal = pedestal, glass = glass, anchor = CFrame.new(sx, 5.4, sz) })
			end
			booth.Parent = gallery
			table.insert(MapService.booths, { model = booth, slots = slots, sign = signLabel, position = Vector3.new(cx, 3, cz - 9) })
		end
	end
	gallery.Parent = parent
	MapService.points.gallery = Vector3.new(0, 3, 50)
end

local function buildFutureArea(parent)
	local m = Instance.new("Model")
	m.Name = "FutureArea"
	local x, z = 70, -70
	part(m, { Name = "Ground", Size = Vector3.new(36, 0.3, 36), CFrame = CFrame.new(x, 0.15, z), Color = C(200, 170, 120), material = Enum.Material.Ground })
	for i = 0, 8 do
		local stripe = (i % 2 == 0) and C(255, 200, 0) or C(30, 30, 30)
		part(m, { Name = "Barrier", Size = Vector3.new(4, 1, 0.5), CFrame = CFrame.new(x - 16 + i * 4, 2.5, z + 18), Color = stripe })
		part(m, { Name = "Barrier", Size = Vector3.new(0.5, 1, 4), CFrame = CFrame.new(x - 18, 2.5, z - 16 + i * 4), Color = stripe })
	end
	part(m, { Name = "Wall", Size = Vector3.new(36, 6, 0.5), CFrame = CFrame.new(x, 3, z + 18.5), Transparency = 1 })
	part(m, { Name = "Wall", Size = Vector3.new(0.5, 6, 36), CFrame = CFrame.new(x - 18.5, 3, z), Transparency = 1 })
	local sign = part(m, { Name = "Sign", Size = Vector3.new(12, 3, 0.4), CFrame = CFrame.new(x - 2, 5, z + 19.2) * CFrame.Angles(0, math.rad(180), 0), Color = C(255, 200, 0) })
	label(surface(sign, Enum.NormalId.Back, 25), "🚧 NOVA ÁREA EM BREVE", { TextColor3 = C(30, 30, 30), TextStrokeTransparency = 1 })
	m.Parent = parent
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = C(110, 110, 130)
	Lighting.OutdoorAmbient = C(150, 150, 170)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.5
end

function MapService.build()
	setupLighting()
	world = Instance.new("Folder")
	world.Name = "MysteryPark"
	world.Parent = workspace

	local terrain = folder(world, "Ground")
	part(terrain, { Name = "Grass", Size = Vector3.new(220, 2, 220), CFrame = CFrame.new(0, -1, 0), Color = C(110, 190, 90), material = Enum.Material.Grass })
	part(terrain, { Name = "Plaza", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 56, 56), CFrame = CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = C(245, 225, 190), material = Enum.Material.Pebble })
	part(terrain, { Name = "PlazaRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 20, 20), CFrame = CFrame.new(0, 0.12, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = C(255, 140, 170), material = Enum.Material.SmoothPlastic })
	local spawn = part(world, { class = "SpawnLocation", Name = "Spawn", Size = Vector3.new(8, 0.6, 8), CFrame = CFrame.new(0, 0.5, 8), Color = C(255, 210, 90), material = Enum.Material.Neon })
	spawn.Neutral = true
	spawn.Duration = 0
	MapService.points.plaza = Vector3.new(0, 3, 8)

	-- fonte decorativa no centro
	part(world, { Name = "Fountain", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 9, 9), CFrame = CFrame.new(0, 0.8, -6) * CFrame.Angles(0, 0, math.rad(90)), Color = C(200, 200, 215), material = Enum.Material.Marble })
	part(world, { Name = "Water", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 7.8, 7.8), CFrame = CFrame.new(0, 1.55, -6) * CFrame.Angles(0, 0, math.rad(90)), Color = C(90, 180, 255), material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false })
	part(world, { Name = "FountainOrb", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), CFrame = CFrame.new(0, 3.4, -6), Color = C(255, 120, 200), material = Enum.Material.Neon })

	local paths = folder(world, "Paths")
	path(paths, Vector3.new(0, 0, -26), Vector3.new(0, 0, -44), 10)
	path(paths, Vector3.new(0, 0, 26), Vector3.new(0, 0, 46), 10)
	path(paths, Vector3.new(26, 0, 0), Vector3.new(51, 0, 0), 8)
	path(paths, Vector3.new(-26, 0, 0), Vector3.new(-53, 0, 0), 8)

	-- máquinas lado a lado ao norte, de frente para a praça
	local machinesFolder = folder(world, "Machines")
	part(machinesFolder, { Name = "Platform", Size = Vector3.new(96, 0.6, 22), CFrame = CFrame.new(0, 0.3, -54), Color = C(60, 50, 90) })
	local arch = part(machinesFolder, { Name = "Banner", Size = Vector3.new(40, 4, 0.6), CFrame = CFrame.new(0, 21, -60), Color = C(255, 80, 160) })
	label(surface(arch, Enum.NormalId.Front, 20), "🎰 MYSTERY MACHINE")
	for i, def in ipairs(MachineDefinitions.List) do
		local x = -33 + (i - 1) * 22
		local origin = CFrame.new(x, 0.6, -56)
		local model, button, trayPoint = buildMachine(machinesFolder, def, origin)
		MapService.machines[def.id] = {
			model = model,
			button = button,
			trayPoint = trayPoint,
			position = button.Position,
			standPoint = Vector3.new(x, 3, -46),
		}
	end

	buildShop(world)
	buildRanking(world)
	buildGallery(world)
	buildFutureArea(world)

	local deco = folder(world, "Decoration")
	local trees = {
		{ -80, -80 }, { -60, -88 }, { -88, -50 }, { 88, -40 }, { 92, 10 }, { 80, 40 }, { -86, 20 }, { -90, 60 },
		{ -70, 92 }, { 70, 95 }, { 92, 75 }, { -40, -28 }, { 40, -30 }, { -40, 30 }, { 40, 28 }, { 0, -92 },
	}
	for i, t in ipairs(trees) do
		tree(deco, t[1], t[2], 0.9 + (i % 3) * 0.15)
	end
	for _, l in ipairs({ { -8, -34 }, { 8, -34 }, { -8, 36 }, { 8, 36 }, { 38, -6 }, { 38, 6 }, { -38, -6 }, { -38, 6 } }) do
		lamp(deco, l[1], l[2])
	end
	for _, f in ipairs({ { -18, -18 }, { 18, -18 }, { -18, 18 }, { 18, 18 } }) do
		part(deco, { Name = "Flowerbed", Size = Vector3.new(6, 0.8, 6), CFrame = CFrame.new(f[1], 0.4, f[2]), Color = C(120, 80, 50), material = Enum.Material.Ground })
		part(deco, { Name = "Flowers", Shape = Enum.PartType.Ball, Size = Vector3.new(4.5, 2, 4.5), CFrame = CFrame.new(f[1], 1.2, f[2]), Color = C(255, 120, 170), material = Enum.Material.Grass, CanCollide = false })
	end

	-- pontos onde aparecem as moedas perdidas
	for i = 0, 11 do
		local a = (i / 12) * math.pi * 2
		local r = (i % 2 == 0) and 22 or 34
		table.insert(MapService.pickupSpots, Vector3.new(math.cos(a) * r, 2, math.sin(a) * r))
	end
	MapService.pickupFolder = folder(world, "CoinPickups")
	MapService.showcaseFolder = folder(world, "ShowcaseItems")
	return world
end

function MapService.world()
	return world
end

function MapService.machinePosition(machineId)
	local m = MapService.machines[machineId]
	return m and m.position
end

return MapService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000030"><Properties><string name="Name">MissionService</string><ProtectedString name="Source"><![CDATA[-- Missões diárias (trocam todo dia UTC, resgate único por dia) e conquistas (resgate único).
-- O progresso é registrado pelas próprias operações (ProfileOps.track); aqui ficam os resgates
-- e o contador de tempo de jogo da missão gratuita "passear pelo parque".

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProfileOps = require(Shared.Logic.ProfileOps)
local TimeUtil = require(Shared.Util.TimeUtil)
local Remotes = require(script.Parent.Parent.Core.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)

local MissionService = {}

MissionService.PlaytimeTick = 30

function MissionService.tickPlaytime()
	local now = TimeUtil.now()
	for _, player in ipairs(PlayerDataService.loadedPlayers()) do
		local profile = PlayerDataService.getProfile(player)
		local dayChanged = ProfileOps.ensureDaily(profile, now)
		if ProfileOps.addPlaytime(profile, MissionService.PlaytimeTick, now) or dayChanged then
			PlayerDataService.markDirty(player)
		end
	end
end

function MissionService.start()
	Remotes.handle("ProgressAction", "claimDaily", "progress", function(_, profile, payload)
		return ProfileOps.claimDaily(profile, payload.missionId, TimeUtil.now())
	end)
	Remotes.handle("ProgressAction", "claimAchievement", "progress", function(_, profile, payload)
		return ProfileOps.claimAchievement(profile, payload.achievementId)
	end)
	task.spawn(function()
		while true do
			task.wait(MissionService.PlaytimeTick)
			MissionService.tickPlaytime()
		end
	end)
end

return MissionService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000031"><Properties><string name="Name">PlayerDataService</string><ProtectedString name="Source"><![CDATA[-- Carrega e salva perfis no DataStore com TRAVA DE SESSÃO.
--
-- Registro salvo: { data = perfil, lock = { job, at } | nil, savedAt }.
-- * Carregar: UpdateAsync coloca a trava deste servidor. Se outro servidor tem a trava ativa
--   (renovada há menos de SessionLockTimeout s), espera e tenta de novo; se continuar travado,
--   o jogador é desconectado com aviso, SEM gravar nada.
-- * Falha de carregamento: o jogador é desconectado e o perfil nunca é salvo, então um perfil
--   vazio jamais sobrescreve dados existentes.
-- * Salvar: só grava se a trava ainda for deste servidor. Autosave renova a trava.
-- * Saída/desligamento: salva e libera a trava.
-- Sem acesso a API (Studio sem "Enable Studio Access to API Services") roda em MODO MEMÓRIA.

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EconomyConfig = require(Shared.EconomyConfig)
local ProfileSchema = require(Shared.Logic.ProfileSchema)
local ProfileOps = require(Shared.Logic.ProfileOps)
local ClientView = require(Shared.Logic.ClientView)
local TimeUtil = require(Shared.Util.TimeUtil)
local Remotes = require(script.Parent.Parent.Core.Remotes)

local PlayerDataService = {}

PlayerDataService.StoreName = "MysteryMachine_Profiles_v1"
PlayerDataService.memoryMode = false

local JOB = game.JobId ~= "" and game.JobId or ("studio-" .. tostring(math.random(1, 1000000000)))
local store
local sessions = {} -- [player] = { data, dirty, saving, leaving }
local loadedCallbacks, changedCallbacks, leavingCallbacks = {}, {}, {}
local pendingPush = {}

local function key(userId)
	return "Player_" .. tostring(userId)
end

-- DataStore em memória com a mesma interface usada aqui (modo Studio sem API)
local function memoryStore()
	local data = {}
	return {
		UpdateAsync = function(_, k, fn)
			local result = fn(ProfileSchema.deepCopy(data[k]))
			if result ~= nil then
				data[k] = ProfileSchema.deepCopy(result)
			end
			return result
		end,
	}
end

local function openStore()
	local ok, s = pcall(function()
		return DataStoreService:GetDataStore(PlayerDataService.StoreName)
	end)
	if ok and s then
		local probeOk, err = pcall(function()
			return s:UpdateAsync("__probe", function(old)
				return old
			end)
		end)
		local msg = tostring(err)
		if probeOk or not (string.find(msg, "403") or string.find(msg, "API") or string.find(msg, "publish")) then
			return s
		end
	end
	PlayerDataService.memoryMode = true
	warn("[MYSTERY MACHINE] DataStore indisponível: MODO MEMÓRIA (nada será salvo). No Studio, publique o jogo e ative Game Settings > Security > Enable Studio Access to API Services.")
	return memoryStore()
end

local function lockIsActive(lock, now)
	return type(lock) == "table" and lock.job ~= JOB and type(lock.at) == "number" and now - lock.at < EconomyConfig.SessionLockTimeout
end

-- uma tentativa de carregar; retorna "ok", dados | "locked" | "error", mensagem
local function tryLoad(userId)
	local status, loaded = "error", nil
	local ok, err = pcall(function()
		store:UpdateAsync(key(userId), function(old)
			local now = TimeUtil.now()
			status, loaded = "error", nil
			if type(old) == "table" and lockIsActive(old.lock, now) then
				status = "locked"
				return nil -- não altera o registro do outro servidor
			end
			local record = type(old) == "table" and old or {}
			local data = record.data
			if data == nil then
				data = ProfileSchema.new()
			end
			record.data = data
			record.lock = { job = JOB, at = now }
			status, loaded = "ok", data
			return record
		end)
	end)
	if not ok then
		return "error", tostring(err)
	end
	return status, loaded
end

local function release(player, reason)
	sessions[player] = nil
	Remotes.clear(player)
	if reason and player.Parent then
		player:Kick(reason)
	end
end

local function load(player)
	local userId = player.UserId
	local status, data
	for attempt = 1, 6 do
		status, data = tryLoad(userId)
		if status == "ok" or not player.Parent then
			break
		end
		if status == "locked" then
			warn("[MYSTERY MACHINE] perfil de " .. player.Name .. " travado por outro servidor, aguardando (" .. attempt .. ")")
		else
			warn("[MYSTERY MACHINE] UpdateAsync falhou ao carregar " .. player.Name .. ": " .. tostring(data))
		end
		task.wait(math.min(2 ^ attempt, 8))
	end
	if status ~= "ok" then
		if player.Parent then
			if status == "locked" then
				player:Kick("Seus dados ainda estão abertos em outro servidor. Aguarde um minuto e entre novamente.")
			else
				player:Kick("Não foi possível carregar seus dados agora. Seu progresso está seguro: tente novamente em instantes.")
			end
		end
		return
	end
	local profile, fixes = ProfileSchema.reconcile(data)
	if #fixes > 0 then
		warn("[MYSTERY MACHINE] perfil de " .. player.Name .. " reparado: " .. table.concat(fixes, ", "))
	end
	ProfileOps.ensureDaily(profile, TimeUtil.now())
	local session = { data = profile, dirty = true }
	sessions[player] = session
	if not player.Parent then
		-- saiu durante o carregamento: grava e libera a trava
		PlayerDataService.save(player, true)
		sessions[player] = nil
		return
	end
	for _, fn in ipairs(loadedCallbacks) do
		task.spawn(fn, player, profile)
	end
	PlayerDataService.pushView(player)
end

-- grava o perfil; release = true libera a trava. Retorna true se gravou.
function PlayerDataService.save(player, releaseLock)
	local session = sessions[player]
	if not session then
		return false
	end
	local snapshot = ProfileSchema.deepCopy(session.data)
	local userId = player.UserId
	for attempt = 1, 3 do
		local lost = false
		local ok, err = pcall(function()
			store:UpdateAsync(key(userId), function(old)
				local now = TimeUtil.now()
				lost = false
				if type(old) == "table" and type(old.lock) == "table" and old.lock.job ~= JOB then
					lost = true
					return nil
				end
				return {
					data = snapshot,
					lock = (not releaseLock) and { job = JOB, at = now } or nil,
					savedAt = now,
				}
			end)
		end)
		if ok and lost then
			warn("[MYSTERY MACHINE] trava de " .. player.Name .. " pertence a outro servidor; gravação cancelada")
			if not releaseLock then
				release(player, "Seus dados foram abertos em outro servidor. Entre novamente.")
			end
			return false
		end
		if ok then
			session.dirty = false
			return true
		end
		warn("[MYSTERY MACHINE] UpdateAsync falhou ao salvar " .. player.Name .. " (" .. attempt .. "): " .. tostring(err))
		task.wait(attempt)
	end
	return false
end

function PlayerDataService.getProfile(player)
	local s = sessions[player]
	if s and not s.leaving then
		return s.data
	end
	return nil
end

function PlayerDataService.isLoaded(player)
	return PlayerDataService.getProfile(player) ~= nil
end

function PlayerDataService.loadedPlayers()
	local out = {}
	for player, s in pairs(sessions) do
		if not s.leaving then
			table.insert(out, player)
		end
	end
	return out
end

-- restaura uma cópia (usado quando uma operação falha no meio)
function PlayerDataService.restore(player, backup)
	local s = sessions[player]
	if s then
		for k in pairs(s.data) do
			s.data[k] = nil
		end
		for k, v in pairs(backup) do
			s.data[k] = v
		end
	end
end

function PlayerDataService.pushView(player)
	local profile = PlayerDataService.getProfile(player)
	if profile then
		Remotes.event("DataUpdated"):FireClient(player, ClientView.build(profile, TimeUtil.now()))
	end
end

-- perfil mudou: agenda o envio da fotografia (agrupa várias mudanças) e avisa os serviços
function PlayerDataService.markDirty(player)
	local s = sessions[player]
	if not s then
		return
	end
	s.dirty = true
	if pendingPush[player] then
		return
	end
	pendingPush[player] = true
	task.delay(0.1, function()
		pendingPush[player] = nil
		local profile = PlayerDataService.getProfile(player)
		if profile then
			for _, fn in ipairs(changedCallbacks) do
				fn(player, profile)
			end
			PlayerDataService.pushView(player)
		end
	end)
end

function PlayerDataService.onLoaded(fn)
	table.insert(loadedCallbacks, fn)
end

function PlayerDataService.onChanged(fn)
	table.insert(changedCallbacks, fn)
end

function PlayerDataService.onLeaving(fn)
	table.insert(leavingCallbacks, fn)
end

local function onRemoving(player)
	local s = sessions[player]
	if not s then
		Remotes.clear(player)
		return
	end
	s.leaving = true
	for _, fn in ipairs(leavingCallbacks) do
		pcall(fn, player, s.data)
	end
	PlayerDataService.save(player, true)
	sessions[player] = nil
	Remotes.clear(player)
end

function PlayerDataService.start()
	store = openStore()
	Players.PlayerAdded:Connect(load)
	Players.PlayerRemoving:Connect(onRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(load, player)
	end
	task.spawn(function()
		while true do
			task.wait(EconomyConfig.AutosaveInterval)
			for _, player in ipairs(PlayerDataService.loadedPlayers()) do
				task.spawn(PlayerDataService.save, player, false)
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for player, s in pairs(sessions) do
			if not s.leaving then
				pending = pending + 1
				task.spawn(function()
					s.leaving = true
					PlayerDataService.save(player, true)
					pending = pending - 1
				end)
			end
		end
		local waited = 0
		while pending > 0 and waited < 25 do
			waited = waited + task.wait(0.2)
		end
	end)
	if RunService:IsStudio() and not PlayerDataService.memoryMode then
		print("[MYSTERY MACHINE] DataStore ativo no Studio: o progresso deste teste será salvo.")
	end
end

PlayerDataService.JobId = JOB

return PlayerDataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000032"><Properties><string name="Name">RewardService</string><ProtectedString name="Source"><![CDATA[-- Presente diário gratuito e avisos de recompensas (subida de nível, títulos).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MissionDefinitions = require(Shared.MissionDefinitions)
local MachineDefinitions = require(Shared.MachineDefinitions)
local ProfileOps = require(Shared.Logic.ProfileOps)
local TimeUtil = require(Shared.Util.TimeUtil)
local Format = require(Shared.Util.Format)
local Remotes = require(script.Parent.Parent.Core.Remotes)

local RewardService = {}

-- chamado depois de toda operação bem-sucedida
function RewardService.announce(player, result)
	if type(result.levels) == "table" then
		for _, level in ipairs(result.levels) do
			local text = "⭐ Nível " .. level .. "!"
			for _, m in ipairs(MachineDefinitions.List) do
				if m.level == level then
					text = text .. " " .. m.name .. " desbloqueada!"
				end
			end
			Remotes.notify(player, text, "level")
		end
		if (result.levelCoins or 0) > 0 then
			Remotes.notify(player, "🎁 Recompensa de nível: +" .. Format.int(result.levelCoins) .. " Coins", "coins")
		end
	end
	if result.title and MissionDefinitions.Titles[result.title] then
		Remotes.notify(player, "🏷️ Novo título: " .. MissionDefinitions.Titles[result.title].name, "level")
	end
end

function RewardService.start()
	Remotes.handle("ProgressAction", "claimGift", "progress", function(_, profile)
		return ProfileOps.claimGift(profile, TimeUtil.now())
	end)
	Remotes.onSuccess(RewardService.announce)
end

return RewardService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000033"><Properties><string name="Name">ShowcaseService</string><ProtectedString name="Source"><![CDATA[-- Galeria de vitrines: cada jogador recebe um estande ao entrar e os objetos que escolheu expor
-- aparecem em 3D, com placa de nome, raridade e dono. Qualquer jogador pode visitar.
-- Os modelos são só exibição: o objeto continua UMA cópia do inventário (reservada para venda).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemDefinitions = require(Shared.ItemDefinitions)
local RarityConfig = require(Shared.RarityConfig)
local UpgradeConfig = require(Shared.UpgradeConfig)
local ProfileOps = require(Shared.Logic.ProfileOps)
local ItemModels = require(Shared.Visual.ItemModels)
local Remotes = require(script.Parent.Parent.Core.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local MapService = require(script.Parent.MapService)

local ShowcaseService = {}

local owners = {} -- [boothIndex] = player
local boothOf = {} -- [player] = boothIndex
local rendered = {} -- [boothIndex] = assinatura do que está exibido

local function signature(profile)
	return table.concat(profile.showcase, ",") .. "|" .. ProfileOps.showcaseSlots(profile)
end

local function clearSlot(slot)
	if slot.model then
		slot.model:Destroy()
		slot.model = nil
	end
	if slot.plate then
		slot.plate:Destroy()
		slot.plate = nil
	end
end

local function plate(slot, text, color, sub)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Plate"
	gui.Size = UDim2.new(0, 160, 0, 46)
	gui.MaxDistance = 45
	local function line(t, y, h, c)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, h, 0)
		l.Position = UDim2.new(0, 0, y, 0)
		l.Font = Enum.Font.GothamBold
		l.TextScaled = true
		l.Text = t
		l.TextColor3 = c
		l.TextStrokeTransparency = 0.3
		l.Parent = gui
	end
	line(text, 0, 0.45, Color3.fromRGB(255, 255, 255))
	line(sub, 0.45, 0.3, color)
	gui.Parent = slot.pedestal
	gui.StudsOffsetWorldSpace = Vector3.new(0, 0.2, 0)
	slot.plate = gui
end

function ShowcaseService.render(index)
	local booth = MapService.booths[index]
	local player = owners[index]
	local profile = player and PlayerDataService.getProfile(player)
	local sig = profile and signature(profile) or "empty"
	if rendered[index] == sig then
		return
	end
	rendered[index] = sig
	booth.sign.Text = player and ("🏛️ Vitrine de " .. player.DisplayName) or "Vitrine livre"
	local slots = profile and ProfileOps.showcaseSlots(profile) or 0
	for i, slot in ipairs(booth.slots) do
		clearSlot(slot)
		local itemId = profile and profile.showcase[i] or ""
		local item = ItemDefinitions.get(itemId)
		slot.glass.Transparency = (profile and i <= slots) and 0.8 or 1
		if item and i <= slots then
			local model = ItemModels.build(itemId)
			model:PivotTo(slot.anchor)
			model.Parent = MapService.showcaseFolder
			slot.model = model
			local rarity = RarityConfig.get(item.rarity)
			plate(slot, item.name, rarity.color, rarity.name .. " • de " .. player.DisplayName)
		elseif profile and i > slots then
			plate(slot, "🔒", Color3.fromRGB(200, 200, 200), "Melhoria Vitrines")
		end
	end
end

local function assign(player)
	for i = 1, #MapService.booths do
		if not owners[i] then
			owners[i] = player
			boothOf[player] = i
			ShowcaseService.render(i)
			return i
		end
	end
	Remotes.notify(player, "Todas as vitrines da galeria estão ocupadas neste servidor.", "warn")
	return nil
end

function ShowcaseService.boothOf(player)
	return boothOf[player]
end

function ShowcaseService.boothPosition(player)
	local i = boothOf[player]
	return i and MapService.booths[i].position
end

function ShowcaseService.start()
	PlayerDataService.onLoaded(assign)
	PlayerDataService.onChanged(function(player)
		local i = boothOf[player]
		if i then
			ShowcaseService.render(i)
		end
	end)
	PlayerDataService.onLeaving(function(player)
		local i = boothOf[player]
		if i then
			owners[i] = nil
			boothOf[player] = nil
			ShowcaseService.render(i)
		end
	end)
	assert(#MapService.booths[1].slots == UpgradeConfig.MaxShowcaseSlots)
end

return ShowcaseService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000034"><Properties><string name="Name">UpgradeService</string><ProtectedString name="Source"><![CDATA[-- Loja de melhorias. Preço e efeito vêm de UpgradeConfig no servidor.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProfileOps = require(Shared.Logic.ProfileOps)
local Remotes = require(script.Parent.Parent.Core.Remotes)

local UpgradeService = {}

function UpgradeService.start()
	Remotes.handle("UpgradeAction", "buy", "upgrade", function(_, profile, payload)
		return ProfileOps.buyUpgrade(profile, payload.upgradeId)
	end)
end

return UpgradeService
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX000057"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX000056"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX000055"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX000047"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX000038"><Properties><string name="Name">CollectionController</string><ProtectedString name="Source"><![CDATA[-- Livro de coleções: os 20 objetos agrupados por máquina de origem. Os descobertos aparecem
-- em 3D; os que faltam aparecem como silhuetas com "???". Cada parte completa e a coleção
-- inteira dão uma recompensa (Coins, XP e título). Aba "Títulos" para escolher o título exibido.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemDefinitions = require(Shared.ItemDefinitions)
local MachineDefinitions = require(Shared.MachineDefinitions)
local RarityConfig = require(Shared.RarityConfig)
local MissionDefinitions = require(Shared.MissionDefinitions)
local ItemModels = require(Shared.Visual.ItemModels)
local Format = require(Shared.Util.Format)

local UI = require(script.Parent.Parent.Util.UI)
local Store = require(script.Parent.Parent.Util.Store)
local Net = require(script.Parent.Parent.Util.Net)
local UIController = require(script.Parent.UIController)

local CollectionController = {}

local ui = { tiles = {}, setButtons = {}, setLabels = {}, titleButtons = {} }
local tab = "book"

local function claim(setId)
	local r = Net.call("ProgressAction", { action = "claimSet", setId = setId })
	if r.ok then
		UIController.toast("🎁 Coleção completa! +" .. Format.int(r.coins) .. " Coins e +" .. r.xp .. " XP", "coins")
	else
		UIController.toast(r.message, "warn")
	end
end

local function rewardText(set)
	local t = "🎁 " .. Format.short(set.coins) .. " + " .. set.xp .. " XP"
	if set.title then
		t = t .. " + título"
	end
	return t
end

function CollectionController.refresh(view)
	if not ui.book then
		return
	end
	ui.book.Visible = tab == "book"
	ui.titles.Visible = tab == "titles"
	ui.setProgress(view.discoveredCount / view.totalItems, "Descobertos " .. view.discoveredCount .. "/" .. view.totalItems)
	for _, item in ipairs(ItemDefinitions.List) do
		local tile = ui.tiles[item.id]
		local found = view.discovered[item.id] ~= nil
		local rarity = RarityConfig.get(item.rarity)
		ItemModels.showInViewport(tile.viewport, item.id, not found)
		tile.name.Text = found and item.name or "???"
		tile.rarity.Text = rarity.name
		tile.rarity.TextColor3 = rarity.color
		tile.frame.BackgroundColor3 = found and UI.Theme.cardLight or UI.Theme.bg
	end
	for _, s in ipairs(view.sets) do
		local set = MissionDefinitions.SetById[s.id]
		local button = ui.setButtons[s.id]
		ui.setLabels[s.id].Text = (set.machine and MachineDefinitions.get(set.machine).name or "Coleção completa") .. "  " .. s.have .. "/" .. s.total
		if s.claimed then
			button.Text = "✔ Resgatado"
			UI.setEnabled(button, false)
		elseif s.have >= s.total then
			button.Text = "RESGATAR " .. rewardText(set)
			UI.setEnabled(button, true, UI.Theme.green)
		else
			button.Text = rewardText(set)
			UI.setEnabled(button, false)
		end
	end
	for id, b in pairs(ui.titleButtons) do
		local unlocked = id == "" or view.titles[id] == true
		if view.title == id then
			b.Text = "✔ Usando"
			UI.setEnabled(b, false)
			b.BackgroundColor3 = UI.Theme.green
		elseif unlocked then
			b.Text = "Usar"
			UI.setEnabled(b, true, UI.Theme.blue)
		else
			b.Text = "🔒"
			UI.setEnabled(b, false)
		end
	end
end

local function buildBook(parent)
	local rows = parent
	UI.list(rows, 6)
	for i, set in ipairs(MissionDefinitions.CollectionSets) do
		local row = UI.frame(rows, { Name = set.id, Size = UDim2.new(1, -10, 0, set.machine and 94 or 44), LayoutOrder = i, BackgroundColor3 = UI.Theme.card })
		ui.setLabels[set.id] = UI.label(row, set.name, { Position = UDim2.new(0, 10, 0, 6), Size = UDim2.new(0, 150, 0, 32), Font = Enum.Font.FredokaOne, TextWrapped = true, MaxText = 18 })
		ui.setButtons[set.id] = UI.button(row, "", UI.Theme.grey, function(b)
			if not b:GetAttribute("Disabled") then
				claim(set.id)
			end
		end, { Name = "Claim", Position = UDim2.new(0, 10, 1, -40), Size = UDim2.new(0, set.machine and 150 or 400, 0, 34), MaxText = 13 })
		if set.machine then
			local tiles = UI.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 170, 0, 4), Size = UDim2.new(1, -176, 1, -8), Parent = row })
			UI.list(tiles, 6, true)
			local order = 0
			for _, item in ipairs(ItemDefinitions.List) do
				if item.machine == set.machine then
					order = order + 1
					local tile = {}
					tile.frame = UI.frame(tiles, { Size = UDim2.new(0.2, -5, 1, 0), LayoutOrder = order })
					tile.viewport = UI.viewport(tile.frame, { Position = UDim2.new(0, 4, 0, 2), Size = UDim2.new(1, -8, 0, 46), BackgroundTransparency = 1 })
					tile.name = UI.label(tile.frame, "", { Position = UDim2.new(0, 4, 0, 48), Size = UDim2.new(1, -8, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 12 })
					tile.rarity = UI.label(tile.frame, "", { Position = UDim2.new(0, 4, 0, 66), Size = UDim2.new(1, -8, 0, 14), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 11 })
					ui.tiles[item.id] = tile
				end
			end
		end
	end
end

local function buildTitles(parent)
	local list = UI.scroll(parent, { Size = UDim2.new(1, 0, 1, 0) })
	UI.list(list, 6)
	local entries = { { id = "", name = "Sem título", color = UI.Theme.muted, how = "" } }
	local how = {}
	for _, set in ipairs(MissionDefinitions.CollectionSets) do
		how[set.title] = "Complete: " .. set.name
	end
	for _, a in ipairs(MissionDefinitions.Achievements) do
		if a.title then
			how[a.title] = "Conquista: " .. a.text
		end
	end
	for id, def in pairs(MissionDefinitions.Titles) do
		table.insert(entries, { id = id, name = def.name, color = def.color, how = how[id] or "" })
	end
	table.sort(entries, function(a, b)
		return a.id == "" or (b.id ~= "" and a.name < b.name)
	end)
	for i, e in ipairs(entries) do
		local row = UI.frame(list, { Size = UDim2.new(1, -12, 0, 52), LayoutOrder = i })
		UI.label(row, e.name, { Position = UDim2.new(0, 12, 0, 4), Size = UDim2.new(0.6, 0, 0, 26), TextColor3 = e.color, Font = Enum.Font.FredokaOne, MaxText = 20 })
		UI.label(row, e.how, { Position = UDim2.new(0, 12, 0, 30), Size = UDim2.new(0.7, 0, 0, 18), TextColor3 = UI.Theme.muted, MaxText = 13 })
		ui.titleButtons[e.id] = UI.button(row, "Usar", UI.Theme.blue, function(b)
			if b:GetAttribute("Disabled") then
				return
			end
			local r = Net.call("ProgressAction", { action = "setTitle", titleId = e.id })
			if not r.ok then
				UIController.toast(r.message, "warn")
			end
		end, { Position = UDim2.new(1, -140, 0.5, -20), Size = UDim2.new(0, 128, 0, 40), MaxText = 18 })
	end
end

local function build(content)
	local _, set = UI.progress(content, { Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(0, 300, 0, 30) }, UI.Theme.accent)
	ui.setProgress = set
	local selectTab = UI.tabs(content, { { id = "book", label = "📖 Livro", width = 140 }, { id = "titles", label = "🏷️ Títulos", width = 140 } }, function(id)
		tab = id
		if Store.view then
			CollectionController.refresh(Store.view)
		end
	end, { Position = UDim2.new(1, -292, 0, -4), Size = UDim2.new(0, 292, 0, 38) })
	ui.book = UI.scroll(content, { Name = "Book", Position = UDim2.new(0, 0, 0, 40), Size = UDim2.new(1, 0, 1, -40) })
	buildBook(ui.book)
	ui.titles = UI.make("Frame", { Name = "Titles", BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 40), Size = UDim2.new(1, 0, 1, -40), Visible = false, Parent = content })
	buildTitles(ui.titles)
	ui.selectTab = selectTab
	selectTab("book")
end

function CollectionController.init()
	UIController.register("Collection", {
		screen = "CollectionUI",
		title = "📖 Livro de Coleções",
		build = build,
		refresh = CollectionController.refresh,
		onOpen = function(args)
			if args.tab and ui.selectTab then
				ui.selectTab(args.tab)
			end
		end,
	})
end

return CollectionController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000039"><Properties><string name="Name">HUDController</string><ProtectedString name="Source"><![CDATA[-- HUD compacto: Coins, nível e barra de XP no topo; menu lateral com os 7 atalhos.
-- Os botões do menu mostram "!" quando há recompensa para resgatar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)

local UI = require(script.Parent.Parent.Util.UI)
local Store = require(script.Parent.Parent.Util.Store)
local Net = require(script.Parent.Parent.Util.Net)
local Sounds = require(script.Parent.Parent.Util.Sounds)
local UIController = require(script.Parent.UIController)

local HUDController = {}

HUDController.Menu = {
	{ panel = "Machines", icon = "🎰", label = "Máquinas" },
	{ panel = "Inventory", icon = "🎒", label = "Inventário" },
	{ panel = "Collection", icon = "📖", label = "Coleção" },
	{ panel = "Upgrades", icon = "⚙️", label = "Melhorias" },
	{ panel = "Missions", icon = "📜", label = "Missões" },
	{ panel = "Ranking", icon = "🏆", label = "Ranking" },
	{ panel = "Settings", icon = "🔧", label = "Config." },
}

local coinsLabel, levelLabel, setXp, itemsLabel
local badges = {}
local lastCoins

local function hasClaimable(list)
	for _, m in ipairs(list or {}) do
		if not m.claimed and (m.progress or m.have) >= (m.target or m.total) then
			return true
		end
	end
	return false
end

function HUDController.refresh(view)
	if not coinsLabel or not view then
		return
	end
	coinsLabel.Text = "💰 " .. Format.int(view.coins)
	levelLabel.Text = "Nv " .. view.level
	if view.xpNeeded > 0 then
		setXp(view.xpInto / view.xpNeeded, Format.int(view.xpInto) .. " / " .. Format.int(view.xpNeeded) .. " XP")
	else
		setXp(1, "Nível máximo")
	end
	itemsLabel.Text = "🎒 " .. view.itemCount .. "/" .. view.capacity .. "   📖 " .. view.discoveredCount .. "/" .. view.totalItems
	badges.Missions.Visible = hasClaimable(view.daily) or hasClaimable(view.achievements) or (view.gift and view.gift.canClaim)
	badges.Collection.Visible = hasClaimable(view.sets)
	if lastCoins and view.coins > lastCoins then
		Sounds.play("coins")
	end
	lastCoins = view.coins
end

function HUDController.init()
	local gui = UIController.screen("MainHUD", 1)

	-- topo: Coins | nível + XP
	local top = UI.frame(gui, {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0, 560, 0, 52),
		BackgroundColor3 = UI.Theme.panel,
		BackgroundTransparency = 0.1,
		radius = 14,
	})
	UI.stroke(top, Color3.fromRGB(0, 0, 0), 2)
	local coinPill = UI.frame(top, { Position = UDim2.new(0, 8, 0, 6), Size = UDim2.new(0, 170, 1, -12), BackgroundColor3 = Color3.fromRGB(70, 55, 20) })
	coinsLabel = UI.label(coinPill, "💰 0", { Name = "Coins", Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 1, 0), TextColor3 = UI.Theme.coins, Font = Enum.Font.FredokaOne, MaxText = 28 })
	local badge = UI.frame(top, { Position = UDim2.new(0, 186, 0, 6), Size = UDim2.new(0, 64, 1, -12), BackgroundColor3 = UI.Theme.blue })
	levelLabel = UI.label(badge, "Nv 1", { Name = "Level", Size = UDim2.new(1, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.FredokaOne, MaxText = 26 })
	local _, set = UI.progress(top, { Name = "XpBar", Position = UDim2.new(0, 258, 0, 8), Size = UDim2.new(1, -266, 0, 20) }, UI.Theme.xp)
	setXp = set
	itemsLabel = UI.label(top, "", { Name = "Items", Position = UDim2.new(0, 258, 0, 30), Size = UDim2.new(1, -266, 0, 16), TextColor3 = UI.Theme.muted, MaxText = 14 })

	-- menu lateral
	local menu = UI.make("Frame", {
		Name = "SideMenu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 20),
		Size = UDim2.new(0, 96, 0, 7 * 66),
		Parent = gui,
	})
	UI.list(menu, 6)
	for i, entry in ipairs(HUDController.Menu) do
		local b = UI.button(menu, entry.icon .. "\n" .. entry.label, UI.Theme.panel, function()
			UIController.toggle(entry.panel)
		end, { Name = entry.panel, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = i, MaxText = 16 })
		local dot = UI.frame(b, { Name = "Badge", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -4, 0, 6), Size = UDim2.new(0, 22, 0, 22), BackgroundColor3 = UI.Theme.red, Visible = false, radius = 11 })
		UI.label(dot, "!", { Size = UDim2.new(1, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 16 })
		badges[entry.panel] = dot
	end

	Store.changed:Connect(HUDController.refresh)
	Net.on("Notify", function(data)
		if type(data) == "table" and type(data.text) == "string" then
			UIController.toast(data.text, data.kind)
			if data.kind == "legendary" or data.kind == "secret" then
				Sounds.play("legendary")
			end
		end
	end)
	if Store.view then
		HUDController.refresh(Store.view)
	end
end

return HUDController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000040"><Properties><string name="Name">InventoryController</string><ProtectedString name="Source"><![CDATA[-- Inventário em grade com ícones 3D (ViewportFrame), filtros por raridade, ordenação por
-- valor/nome/raridade, busca por nome e paginação (12 por página, cartões reaproveitados).
-- Ações: favoritar, vender (com confirmação para Raro ou melhor), vender repetidos, expor/retirar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemDefinitions = require(Shared.ItemDefinitions)
local RarityConfig = require(Shared.RarityConfig)
local ItemModels = require(Shared.Visual.ItemModels)
local Format = require(Shared.Util.Format)

local UI = require(script.Parent.Parent.Util.UI)
local Store = require(script.Parent.Parent.Util.Store)
local Net = require(script.Parent.Parent.Util.Net)
local UIController = require(script.Parent.UIController)

local InventoryController = {}

local PAGE_SIZE = 12
local SORTS = {
	{ id = "value", label = "Valor ↓" },
	{ id = "rarity", label = "Raridade ↓" },
	{ id = "name", label = "Nome A-Z" },
}

local filter = { rarity = 0, sort = 1, search = "", page = 1 }
local selectedId
local ui = {}
local cards = {}

-- lista filtrada e ordenada de { item, count }
function InventoryController.entries(view)
	local out = {}
	local rarityFilter = filter.rarity > 0 and RarityConfig.Order[filter.rarity] or nil
	local search = string.lower(filter.search or "")
	for id, count in pairs(view.inventory) do
		local item = ItemDefinitions.get(id)
		if item and count > 0 then
			local okRarity = not rarityFilter or item.rarity == rarityFilter
			local okName = search == "" or string.find(string.lower(item.name), search, 1, true) ~= nil
			if okRarity and okName then
				table.insert(out, { item = item, count = count })
			end
		end
	end
	local sortId = SORTS[filter.sort].id
	table.sort(out, function(a, b)
		if sortId == "name" then
			return a.item.name < b.item.name
		elseif sortId == "rarity" then
			local ra, rb = RarityConfig.rank(a.item.rarity), RarityConfig.rank(b.item.rarity)
			if ra ~= rb then
				return ra > rb
			end
		end
		if a.item.value ~= b.item.value then
			return a.item.value > b.item.value
		end
		return a.item.index < b.item.index
	end)
	return out
end

local function call(payload, okText)
	local r = Net.call("InventoryAction", payload)
	if r.ok and okText then
		UIController.toast(okText(r), "coins")
	elseif not r.ok and not r.needsConfirm then
		UIController.toast(r.message, "warn")
	end
	return r
end

local function sell(itemId, amount)
	local item = ItemDefinitions.get(itemId)
	local function send(confirm)
		local r = call({ action = "sell", itemId = itemId, amount = amount, confirm = confirm }, function(res)
			return "💰 Vendeu " .. res.amount .. "x " .. item.name .. " por " .. Format.int(res.coins) .. " Coins"
		end)
		if r.needsConfirm then
			UIController.confirm("Vender " .. amount .. "x " .. item.name .. " (" .. RarityConfig.get(item.rarity).name .. ") por 💰" .. Format.int(item.value * amount) .. "?", "Vender", function()
				send(true)
			end)
		end
	end
	send(false)
end

local function refreshDetail(view)
	local d = ui.detail
	local item = selectedId and ItemDefinitions.get(selectedId)
	local count = item and view.inventory[selectedId] or 0
	if not item or count <= 0 then
		selectedId = nil
		d.holder.Visible = false
		ui.hint.Visible = true
		return
	end
	ui.hint.Visible = false
	d.holder.Visible = true
	local rarity = RarityConfig.get(item.rarity)
	local displayed = view.displayed[selectedId] or 0
	local fav = view.favorites[selectedId] == true
	ItemModels.showInViewport(d.viewport, selectedId, false)
	d.name.Text = item.name
	d.rarity.Text = rarity.name
	d.rarity.TextColor3 = rarity.color
	d.info.Text = "Valor: 💰" .. Format.int(item.value) .. "\nVocê tem: " .. count .. (displayed > 0 and ("  (" .. displayed .. " na vitrine)") or "")
	d.fav.Text = fav and "★ Favorito" or "☆ Favoritar"
	local sellable = fav and 0 or math.max(0, count - displayed)
	UI.setEnabled(d.sell1, sellable > 0, UI.Theme.coins)
	UI.setEnabled(d.sellAll, sellable > 1, UI.Theme.coins)
	d.sellAll.Text = "Vender " .. sellable
	d.display.Visible = displayed < count
	d.undisplay.Visible = displayed > 0
end

function InventoryController.refresh(view)
	if not ui.grid then
		return
	end
	local entries = InventoryController.entries(view)
	local pages = math.max(1, math.ceil(#entries / PAGE_SIZE))
	filter.page = math.clamp(filter.page, 1, pages)
	for i = 1, PAGE_SIZE do
		local card = cards[i]
		local entry = entries[(filter.page - 1) * PAGE_SIZE + i]
		card.frame.Visible = entry ~= nil
		if entry then
			local rarity = RarityConfig.get(entry.item.rarity)
			card.itemId = entry.item.id
			ItemModels.showInViewport(card.viewport, entry.item.id, false)
			card.name.Text = entry.item.name
			card.value.Text = "💰" .. Format.short(entry.item.value)
			card.count.Text = "x" .. entry.count
			card.strip.BackgroundColor3 = rarity.color
			card.fav.Visible = view.favorites[entry.item.id] == true
			card.shown.Visible = (view.displayed[entry.item.id] or 0) > 0
			card.frame.BackgroundColor3 = (entry.item.id == selectedId) and UI.Theme.cardLight or UI.Theme.card
		end
	end
	ui.empty.Visible = #entries == 0
	ui.empty.Text = next(view.inventory) and "Nenhum objeto com este filtro." or "Inventário vazio. Use uma máquina para ganhar objetos!"
	ui.page.Text = filter.page .. "/" .. pages
	ui.capacity.Text = "🎒 " .. view.itemCount .. "/" .. view.capacity .. " objetos"
	ui.rarityButton.Text = "Raridade: " .. (filter.rarity > 0 and RarityConfig.get(RarityConfig.Order[filter.rarity]).name or "Todas")
	ui.sortButton.Text = "Ordem: " .. SORTS[filter.sort].label
	refreshDetail(view)
end

local function build(content)
	-- filtros
	ui.search = UI.make("TextBox", {
		Name = "Search",
		PlaceholderText = "🔎 Buscar por nome",
		Text = "",
		ClearTextOnFocus = false,
		BackgroundColor3 = UI.Theme.bg,
		TextColor3 = UI.Theme.text,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		Size = UDim2.new(0, 220, 0, 38),
		Parent = content,
	})
	UI.corner(ui.search, 10)
	UI.make("UITextSizeConstraint", { MaxTextSize = 18, Parent = ui.search })
	ui.search:GetPropertyChangedSignal("Text"):Connect(function()
		filter.search = ui.search.Text
		filter.page = 1
		if Store.view then
			InventoryController.refresh(Store.view)
		end
	end)
	ui.rarityButton = UI.button(content, "Raridade: Todas", UI.Theme.cardLight, function()
		filter.rarity = (filter.rarity + 1) % (#RarityConfig.Order + 1)
		filter.page = 1
		InventoryController.refresh(Store.view)
	end, { Position = UDim2.new(0, 228, 0, 0), Size = UDim2.new(0, 200, 0, 38), MaxText = 18 })
	ui.sortButton = UI.button(content, "Ordem: Valor", UI.Theme.cardLight, function()
		filter.sort = (filter.sort % #SORTS) + 1
		InventoryController.refresh(Store.view)
	end, { Position = UDim2.new(0, 434, 0, 0), Size = UDim2.new(0, 180, 0, 38), MaxText = 18 })

	-- grade 4×3
	ui.grid = UI.make("Frame", { Name = "Grid", BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 46), Size = UDim2.new(0, 488, 0, 330), Parent = content })
	UI.make("UIGridLayout", { CellSize = UDim2.new(0, 116, 0, 106), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = ui.grid })
	for i = 1, PAGE_SIZE do
		local card = {}
		card.frame = UI.make("TextButton", { Name = "Card" .. i, Text = "", AutoButtonColor = true, BackgroundColor3 = UI.Theme.card, LayoutOrder = i, Parent = ui.grid })
		UI.corner(card.frame, 10)
		card.strip = UI.frame(card.frame, { Size = UDim2.new(1, 0, 0, 5), radius = 3 })
		card.viewport = UI.viewport(card.frame, { Position = UDim2.new(0, 6, 0, 8), Size = UDim2.new(1, -12, 0, 56), BackgroundTransparency = 1 })
		card.name = UI.label(card.frame, "", { Position = UDim2.new(0, 6, 0, 64), Size = UDim2.new(1, -12, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 13 })
		card.value = UI.label(card.frame, "", { Position = UDim2.new(0, 6, 0, 83), Size = UDim2.new(0.6, -6, 0, 18), TextColor3 = UI.Theme.coins, MaxText = 13 })
		card.count = UI.label(card.frame, "", { Position = UDim2.new(0.6, 0, 0, 83), Size = UDim2.new(0.4, -6, 0, 18), TextXAlignment = Enum.TextXAlignment.Right, MaxText = 14 })
		card.fav = UI.label(card.frame, "★", { Position = UDim2.new(0, 4, 0, 6), Size = UDim2.new(0, 20, 0, 20), TextColor3 = UI.Theme.coins, MaxText = 18 })
		card.shown = UI.label(card.frame, "🏛️", { Position = UDim2.new(1, -24, 0, 6), Size = UDim2.new(0, 20, 0, 20), MaxText = 16 })
		card.frame.Activated:Connect(function()
			selectedId = card.itemId
			InventoryController.refresh(Store.view)
		end)
		cards[i] = card
	end
	ui.empty = UI.label(content, "", { Position = UDim2.new(0, 0, 0, 160), Size = UDim2.new(0, 488, 0, 40), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = UI.Theme.muted, MaxText = 20 })

	-- detalhe do objeto selecionado
	local side = UI.frame(content, { Position = UDim2.new(0, 498, 0, 46), Size = UDim2.new(1, -498, 0, 330), BackgroundColor3 = UI.Theme.bg })
	ui.hint = UI.label(side, "Toque em um objeto para ver as opções.", { Position = UDim2.new(0, 10, 0, 120), Size = UDim2.new(1, -20, 0, 60), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = UI.Theme.muted, MaxText = 18 })
	local d = {}
	d.holder = UI.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Visible = false, Parent = side })
	d.viewport = UI.viewport(d.holder, { Position = UDim2.new(0, 10, 0, 8), Size = UDim2.new(1, -20, 0, 100) })
	d.name = UI.label(d.holder, "", { Position = UDim2.new(0, 10, 0, 110), Size = UDim2.new(1, -20, 0, 26), Font = Enum.Font.FredokaOne, TextXAlignment = Enum.TextXAlignment.Center, MaxText = 22 })
	d.rarity = UI.label(d.holder, "", { Position = UDim2.new(0, 10, 0, 136), Size = UDim2.new(1, -20, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 16 })
	d.info = UI.label(d.holder, "", { Position = UDim2.new(0, 10, 0, 156), Size = UDim2.new(1, -20, 0, 36), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = UI.Theme.muted, MaxText = 14 })
	local half = UDim2.new(0.5, -14, 0, 38)
	d.fav = UI.button(d.holder, "☆ Favoritar", UI.Theme.blue, function()
		call({ action = "favorite", itemId = selectedId, value = not Store.view.favorites[selectedId] })
	end, { Position = UDim2.new(0, 10, 0, 196), Size = UDim2.new(1, -20, 0, 36), MaxText = 18 })
	d.sell1 = UI.button(d.holder, "Vender 1", UI.Theme.coins, function(b)
		if not b:GetAttribute("Disabled") then
			sell(selectedId, 1)
		end
	end, { Position = UDim2.new(0, 10, 0, 238), Size = half, MaxText = 18 })
	d.sellAll = UI.button(d.holder, "Vender todos", UI.Theme.coins, function(b)
		if not b:GetAttribute("Disabled") then
			local v = Store.view
			sell(selectedId, math.max(1, (v.inventory[selectedId] or 0) - (v.displayed[selectedId] or 0)))
		end
	end, { Position = UDim2.new(0.5, 4, 0, 238), Size = half, MaxText = 18 })
	d.display = UI.button(d.holder, "🏛️ Expor", UI.Theme.accent, function()
		call({ action = "display", itemId = selectedId }, function()
			return "🏛️ Exposto na sua vitrine da galeria!"
		end)
	end, { Position = UDim2.new(0, 10, 0, 282), Size = half, MaxText = 18 })
	d.undisplay = UI.button(d.holder, "Retirar", UI.Theme.grey, function()
		local v = Store.view
		for slot, id in ipairs(v.showcase) do
			if id == selectedId then
				call({ action = "undisplay", slot = slot })
				return
			end
		end
	end, { Position = UDim2.new(0.5, 4, 0, 282), Size = half, MaxText = 18 })
	ui.detail = d

	-- rodapé
	ui.capacity = UI.label(content, "", { Position = UDim2.new(0, 0, 1, -40), Size = UDim2.new(0, 190, 0, 36), MaxText = 18 })
	UI.button(content, "Vender repetidos (Comum/Incomum)", UI.Theme.coins, function()
		UIController.confirm("Vender todas as cópias extras de objetos Comuns e Incomuns? Você fica com 1 de cada. Favoritos e itens expostos ficam protegidos.", "Vender", function()
			call({ action = "sellDuplicates" }, function(r)
				return "💰 Vendeu " .. r.amount .. " repetidos por " .. Format.int(r.coins) .. " Coins"
			end)
		end)
	end, { Position = UDim2.new(0, 196, 1, -42), Size = UDim2.new(0, 300, 0, 40), MaxText = 16 })
	UI.button(content, "◀", UI.Theme.cardLight, function()
		filter.page = filter.page - 1
		InventoryController.refresh(Store.view)
	end, { Position = UDim2.new(1, -170, 1, -42), Size = UDim2.new(0, 48, 0, 40) })
	ui.page = UI.label(content, "1/1", { Position = UDim2.new(1, -118, 1, -42), Size = UDim2.new(0, 66, 0, 40), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 20 })
	UI.button(content, "▶", UI.Theme.cardLight, function()
		filter.page = filter.page + 1
		InventoryController.refresh(Store.view)
	end, { Position = UDim2.new(1, -48, 1, -42), Size = UDim2.new(0, 48, 0, 40) })
end

function InventoryController.select(itemId)
	selectedId = itemId
end

function InventoryController.init()
	UIController.register("Inventory", {
		screen = "InventoryUI",
		title = "🎒 Inventário",
		build = build,
		refresh = InventoryController.refresh,
	})
end

return InventoryController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000041"><Properties><string name="Name">LeaderboardController</string><ProtectedString name="Source"><![CDATA[-- Rankings: abas por categoria, com o top do servidor atual e o top global (cache do servidor,
-- atualizado periodicamente; o cliente nunca consulta o DataStore).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)

local UI = require(script.Parent.Parent.Util.UI)
local Store = require(script.Parent.Parent.Util.Store)
local Net = require(script.Parent.Parent.Util.Net)
local UIController = require(script.Parent.UIController)

local LeaderboardController = {}

LeaderboardController.Boards = {
	{ id = "value", label = "💎 Valor", width = 170 },
	{ id = "discovered", label = "📖 Descobertas", width = 190 },
	{ id = "level", label = "⭐ Nível", width = 150 },
	{ id = "achievements", label = "🏅 Conquistas", width = 190 },
}

local board = "value"
local columns = {}

local function fill(column, rows)
	for i, line in ipairs(column.lines) do
		local row = rows and rows[i]
		line.Text = row and (i .. ". " .. row.name .. "   " .. Format.int(row.value)) or (i == 1 and "Sem dados ainda" or "")
		line.TextColor3 = (i == 1 and row) and UI.Theme.coins or UI.Theme.text
	end
end

function LeaderboardController.refresh()
	local data = Store.leaderboard
	if not columns.server then
		return
	end
	fill(columns.server, data and data.server and data.server[board])
	fill(columns.global, data and data.global and data.global[board])
end

local function column(parent, title, x)
	local f = UI.frame(parent, { Position = UDim2.new(x, x > 0 and 6 or 0, 0, 46), Size = UDim2.new(0.5, -6, 1, -46), BackgroundColor3 = UI.Theme.bg })
	UI.label(f, title, { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -24, 0, 30), Font = Enum.Font.FredokaOne, MaxText = 22 })
	local lines = {}
	for i = 1, 10 do
		lines[i] = UI.label(f, "", { Position = UDim2.new(0, 14, 0, 38 + (i - 1) * 33), Size = UDim2.new(1, -28, 0, 30), MaxText = 18 })
	end
	return { frame = f, lines = lines }
end

local function build(content)
	UI.tabs(content, LeaderboardController.Boards, function(id)
		board = id
		LeaderboardController.refresh()
	end)
	columns.server = column(content, "🏠 Neste servidor", 0)
	columns.global = column(content, "🌍 Global (top 10)", 0.5)
end

function LeaderboardController.init()
	UIController.register("Ranking", {
		screen = "RankingUI",
		title = "🏆 Rankings",
		build = build,
		refresh = LeaderboardController.refresh,
		onOpen = function()
			if not Store.leaderboard then
				task.spawn(function()
					local r = Net.call("ProgressAction", { action = "leaderboard" })
					if r.ok then
						Store.setLeaderboard(r.data)
					end
				end)
			end
		end,
	})
	Net.on("LeaderboardUpdated", function(data)
		if type(data) == "table" then
			Store.setLeaderboard(data)
		end
	end)
	Store.leaderboardChanged:Connect(function()
		if UIController.current == "Ranking" then
			LeaderboardController.refresh()
		end
	end)
end

return LeaderboardController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000042"><Properties><string name="Name">MachineController</string><ProtectedString name="Source"><![CDATA[-- Máquinas no cliente:
-- * painel "Machines" (lista das 4 máquinas, status e atalho para ir até elas);
-- * painel "Machine" (máquina selecionada, preço, CHANCES REAIS, botão USAR MÁQUINA e resultado);
-- * animação 3D da máquina (luzes, cápsulas, objeto aparecendo no compartimento) para quem usou
--   e para quem está olhando (MachineResult);
-- * camada RewardUI com brilho/faixa especial para Lendário e Secreto.
-- O resultado chega do servidor ANTES da animação; "PULAR" só adianta a exibição.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MachineDefinitions = require(Shared.MachineDefinitions)
local ItemDefinitions = require(Shared.ItemDefinitions)
local RarityConfig = require(Shared.RarityConfig)
local Odds = require(Shared.Logic.Odds)
local ItemModels = require(Shared.Visual.ItemModels)
local Format = require(Shared.Util.Format)

local UI = require(script.Parent.Parent.Util.UI)
local Store = require(script.Parent.Parent.Util.Store)
local Net = require(script.Parent.Parent.Util.Net)
local Sounds = require(script.Parent.Parent.Util.Sounds)
local UIController = require(script.Parent.UIController)

local MachineController = {}

local localPlayer = Players.LocalPlayer
local selected = "common"
local state = { phase = "idle" } -- idle | rolling | result
local panel = {}
local machineAnims = {} -- [machineId] = { token, skip }

---------------------------------------------------------------------------
-- animação 3D da máquina
---------------------------------------------------------------------------
local function machineModel(machineId)
	local world = workspace:FindFirstChild("MysteryPark")
	local folder = world and world:FindFirstChild("Machines")
	return folder and folder:FindFirstChild("Machine_" .. machineId)
end

local function spawnPrize(model, itemId, rarityId)
	local tray = model:FindFirstChild("TrayPoint")
	if not tray then
		return
	end
	local old = model:FindFirstChild("Prize")
	if old then
		old:Destroy()
	end
	local prize = ItemModels.build(itemId)
	prize.Name = "Prize"
	prize:PivotTo(tray.CFrame)
	local rarity = RarityConfig.get(rarityId)
	if rarity and rarity.effect and Store.setting("effects") ~= false then
		local glow = Instance.new("PointLight")
		glow.Color = rarity.color
		glow.Range = 14
		glow.Brightness = 3
		glow.Parent = prize.PrimaryPart
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Color = ColorSequence.new(rarity.color)
		sparkles.Rate = rarity.effect == "secret" and 30 or 18
		sparkles.Lifetime = NumberRange.new(0.6, 1.2)
		sparkles.Speed = NumberRange.new(2, 5)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.Size = NumberSequence.new(0.3)
		sparkles.LightEmission = 1
		sparkles.Parent = prize.PrimaryPart
	end
	prize.Parent = model
	task.delay(6, function()
		if prize.Parent then
			prize:Destroy()
		end
	end)
	return prize
end

-- toca a animação da máquina; termina sozinha após `duration` ou quando anim.skip = true
function MachineController.animateMachine(machineId, duration, itemId, rarityId)
	local model = machineModel(machineId)
	if not model then
		return nil
	end
	local previous = machineAnims[machineId]
	if previous then
		previous.skip = true
	end
	local anim = { skip = false, done = false }
	machineAnims[machineId] = anim
	local def = MachineDefinitions.get(machineId)
	local lights = model:FindFirstChild("Lights")
	local capsules = model:FindFirstChild("Capsules")
	local visorLight = model:FindFirstChild("VisorBack") and model.VisorBack:FindFirstChild("VisorLight")
	local spinSound = Sounds.playAt("spin", model:FindFirstChild("Body"))
	local capsuleColors = {}
	if capsules then
		for i, c in ipairs(capsules:GetChildren()) do
			capsuleColors[i] = c.Color
		end
	end
	task.spawn(function()
		local elapsed, step = 0, 0
		while elapsed < duration and not anim.skip do
			step = step + 1
			if lights then
				for i, l in ipairs(lights:GetChildren()) do
					l.Color = ((i + step) % 2 == 0) and Color3.fromRGB(255, 255, 255) or def.lightColor
				end
			end
			if capsules then
				local list = capsules:GetChildren()
				for i, c in ipairs(list) do
					c.Color = capsuleColors[((i + step) % #list) + 1]
				end
			end
			if visorLight then
				visorLight.Brightness = (step % 2 == 0) and 3 or 1.5
			end
			elapsed = elapsed + task.wait(0.12)
		end
		if spinSound then
			spinSound:Stop()
		end
		if lights then
			for _, l in ipairs(lights:GetChildren()) do
				l.Color = RarityConfig.get(rarityId) and RarityConfig.get(rarityId).color or def.lightColor
			end
		end
		if visorLight then
			visorLight.Brightness = 1
		end
		spawnPrize(model, itemId, rarityId)
		Sounds.playAt("reveal", model:FindFirstChild("Body"))
		anim.done = true
		task.delay(3, function()
			if machineAnims[machineId] == anim and lights then
				for _, l in ipairs(lights:GetChildren()) do
					l.Color = def.lightColor
				end
			end
		end)
	end)
	return anim
end

---------------------------------------------------------------------------
-- camada de revelação (RewardUI)
---------------------------------------------------------------------------
local rewardGui, flash, banner

local function showReveal(rarityId)
	local rarity = RarityConfig.get(rarityId)
	if not rarity or not rarity.effect or Store.setting("effects") == false then
		return
	end
	if not rewardGui then
		rewardGui = UIController.screen("RewardUI", 10)
		flash = UI.make("Frame", { Name = "Flash", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Parent = rewardGui })
		banner = UI.label(rewardGui, "", {
			Name = "Banner",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.16, 0),
			Size = UDim2.new(0, 700, 0, 70),
			Font = Enum.Font.FredokaOne,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextStrokeTransparency = 0,
			MaxText = 60,
			Visible = false,
		})
	end
	flash.BackgroundColor3 = rarity.color
	flash.BackgroundTransparency = 0.35
	banner.Text = rarity.effect == "secret" and "🔴 OBJETO SECRETO! 🔴" or "🌟 LENDÁRIO! 🌟"
	banner.TextColor3 = rarity.color
	banner.Visible = true
	Sounds.play("legendary")
	task.spawn(function()
		for i = 1, 6 do
			flash.BackgroundTransparency = 0.35 + i * 0.11
			task.wait(0.08)
		end
		flash.BackgroundTransparency = 1
		task.wait(2)
		banner.Visible = false
	end)
end

---------------------------------------------------------------------------
-- painel da máquina
---------------------------------------------------------------------------
local function setResultButtons(visible)
	for _, b in ipairs({ panel.sellButton, panel.favButton, panel.showButton }) do
		b.Visible = visible
	end
end

local function showItem(itemId, silhouette)
	ItemModels.showInViewport(panel.viewport, itemId, silhouette)
end

local function refreshMachinePanel(view)
	local def = MachineDefinitions.get(selected)
	panel.titleLabel.Text = "🎰 " .. def.name
	panel.priceLabel.Text = "Preço: 💰 " .. Format.int(def.price) .. " Coins   •   Nível " .. def.level .. "+"
	local unlocked = view.level >= def.level
	local full = view.itemCount >= view.capacity
	if state.phase == "rolling" then
		panel.useButton.Visible = false
		panel.skipButton.Visible = true
	else
		panel.useButton.Visible = true
		panel.skipButton.Visible = false
		if not unlocked then
			panel.useButton.Text = "🔒 NÍVEL " .. def.level
			UI.setEnabled(panel.useButton, false)
		elseif full then
			panel.useButton.Text = "INVENTÁRIO CHEIO"
			UI.setEnabled(panel.useButton, false)
		else
			panel.useButton.Text = "USAR MÁQUINA  💰" .. Format.int(def.price)
			UI.setEnabled(panel.useButton, view.coins >= def.price, UI.Theme.green)
		end
	end
	panel.footer.Text = "Seus Coins: 💰 " .. Format.int(view.coins) .. "   •   Inventário " .. view.itemCount .. "/" .. view.capacity
	if state.phase == "result" and state.result then
		local itemId = state.result.itemId
		local owned = view.inventory[itemId] or 0
		panel.favButton.Text = view.favorites[itemId] and "★ FAVORITO" or "☆ FAVORITAR"
		panel.sellButton.Text = "VENDER 💰" .. Format.int(ItemDefinitions.get(itemId).value)
		UI.setEnabled(panel.sellButton, owned > 0 and not view.favorites[itemId], UI.Theme.coins)
		UI.setEnabled(panel.favButton, owned > 0, UI.Theme.blue)
		UI.setEnabled(panel.showButton, owned > 0, UI.Theme.accent)
	end
end

local function buildOddsList(machineId)
	for _, c in ipairs(panel.oddsList:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local view = Store.view
	for i, row in ipairs(Odds.display(machineId)) do
		local rarity = RarityConfig.get(row.rarity)
		local f = UI.frame(panel.oddsList, { Name = "Odds_" .. row.item, Size = UDim2.new(1, -6, 0, 52), LayoutOrder = i })
		UI.frame(f, { Size = UDim2.new(0, 8, 1, -12), Position = UDim2.new(0, 6, 0, 6), BackgroundColor3 = rarity.color, radius = 4 })
		local known = view and view.discovered[row.item]
		UI.label(f, (known and "" or "❔ ") .. row.name, { Position = UDim2.new(0, 22, 0, 4), Size = UDim2.new(0.62, -22, 0, 26), MaxText = 20 })
		UI.label(f, rarity.name .. " • 💰" .. Format.int(row.value), { Position = UDim2.new(0, 22, 0, 30), Size = UDim2.new(0.62, -22, 0, 18), TextColor3 = rarity.color, MaxText = 15 })
		UI.label(f, Format.percent(row.chance), { Name = "Chance", Position = UDim2.new(0.62, 0, 0, 0), Size = UDim2.new(0.38, -12, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.FredokaOne, MaxText = 26 })
	end
end

local function finishRoll()
	if state.phase ~= "rolling" then
		return
	end
	local result = state.result
	state.phase = "result"
	if state.anim then
		state.anim.skip = true
	end
	local item = ItemDefinitions.get(result.itemId)
	local rarity = RarityConfig.get(result.rarity)
	showItem(result.itemId, false)
	panel.status.Text = (result.isNew and "✨ NOVO! " or "") .. item.name
	panel.rarityLabel.Text = rarity.name .. "   •   Valor 💰" .. Format.int(item.value)
	panel.rarityLabel.TextColor3 = rarity.color
	setResultButtons(true)
	showReveal(result.rarity)
	Sounds.play("reveal")
	if UIController.current ~= "Machine" then
		UIController.toast("🎁 Você recebeu " .. item.name .. " (" .. rarity.name .. ")", result.rarity == "secret" and "secret" or "info")
	end
	if Store.view then
		refreshMachinePanel(Store.view)
	end
end

function MachineController.skip()
	finishRoll()
end

function MachineController.use()
	if state.phase == "rolling" then
		return
	end
	local machineId = selected
	local response = Net.call("RequestMachineUse", { action = "use", machineId = machineId })
	if not response.ok then
		UIController.toast(response.message or "Não foi possível usar a máquina.", "warn")
		return response
	end
	state = { phase = "rolling", result = response }
	setResultButtons(false)
	panel.status.Text = "Sorteando..."
	panel.rarityLabel.Text = ""
	local duration = Store.setting("autoSkip") and 0.2 or response.duration
	state.anim = MachineController.animateMachine(machineId, duration, response.itemId, response.rarity)
	local myState = state
	if Store.view then
		refreshMachinePanel(Store.view)
	end
	-- "roleta" no visor do painel enquanto a máquina trabalha
	task.spawn(function()
		local pool = MachineDefinitions.get(machineId).pool
		local elapsed, i = 0, 0
		while state == myState and state.phase == "rolling" and elapsed < duration do
			i = i + 1
			showItem(pool[(i % #pool) + 1].item, true)
			elapsed = elapsed + task.wait(0.15)
		end
		if state == myState then
			finishRoll()
		end
	end)
	return response
end

local function buildMachinePanel(content, _, titleLabel)
	panel.titleLabel = titleLabel
	panel.priceLabel = UI.label(content, "", { Size = UDim2.new(1, 0, 0, 26), TextColor3 = UI.Theme.coins, MaxText = 22 })

	local left = UI.frame(content, { Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(0, 360, 1, -70), BackgroundColor3 = UI.Theme.bg })
	UI.label(left, "Chances reais desta máquina", { Position = UDim2.new(0, 10, 0, 6), Size = UDim2.new(1, -20, 0, 24), MaxText = 20 })
	panel.oddsList = UI.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 34), Size = UDim2.new(1, -10, 1, -74), Parent = left })
	UI.list(panel.oddsList, 4)
	UI.label(left, "Sorteio feito no servidor com exatamente estas chances.", {
		Position = UDim2.new(0, 10, 1, -36),
		Size = UDim2.new(1, -20, 0, 30),
		TextColor3 = UI.Theme.muted,
		TextWrapped = true,
		MaxText = 13,
	})

	local right = UI.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 372, 0, 34), Size = UDim2.new(1, -372, 1, -70), Parent = content })
	panel.viewport = UI.viewport(right, { Size = UDim2.new(1, 0, 0, 190) })
	panel.status = UI.label(right, "Pronto para jogar!", { Name = "Status", Position = UDim2.new(0, 0, 0, 196), Size = UDim2.new(1, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.FredokaOne, MaxText = 28 })
	panel.rarityLabel = UI.label(right, "", { Position = UDim2.new(0, 0, 0, 230), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 20 })
	panel.useButton = UI.button(right, "USAR MÁQUINA", UI.Theme.green, function(b)
		if b:GetAttribute("Disabled") then
			return
		end
		MachineController.use()
	end, { Name = "Use", Position = UDim2.new(0, 0, 0, 262), Size = UDim2.new(1, 0, 0, 56), MaxText = 28 })
	panel.skipButton = UI.button(right, "PULAR ⏩", UI.Theme.blue, function()
		MachineController.skip()
	end, { Name = "Skip", Position = UDim2.new(0, 0, 0, 262), Size = UDim2.new(1, 0, 0, 56), Visible = false, MaxText = 28 })
	local actions = UI.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 326), Size = UDim2.new(1, 0, 0, 44), Parent = right })
	UI.list(actions, 6, true)
	panel.sellButton = UI.button(actions, "VENDER", UI.Theme.coins, function(b)
		if b:GetAttribute("Disabled") or not state.result then
			return
		end
		MachineController.sellResult()
	end, { Size = UDim2.new(0.34, -4, 1, 0), LayoutOrder = 1, MaxText = 18 })
	panel.favButton = UI.button(actions, "☆ FAVORITAR", UI.Theme.blue, function(b)
		if b:GetAttribute("Disabled") or not state.result then
			return
		end
		local id = state.result.itemId
		local r = Net.call("InventoryAction", { action = "favorite", itemId = id, value = not Store.view.favorites[id] })
		if not r.ok then
			UIController.toast(r.message, "warn")
		end
	end, { Size = UDim2.new(0.36, -4, 1, 0), LayoutOrder = 2, MaxText = 18 })
	panel.showButton = UI.button(actions, "🏛️ EXPOR", UI.Theme.accent, function(b)
		if b:GetAttribute("Disabled") or not state.result then
			return
		end
		local r = Net.call("InventoryAction", { action = "display", itemId = state.result.itemId })
		UIController.toast(r.ok and "🏛️ Objeto exposto na sua vitrine da galeria!" or r.message, r.ok and "info" or "warn")
	end, { Size = UDim2.new(0.3, -4, 1, 0), LayoutOrder = 3, MaxText = 18 })
	setResultButtons(false)
	panel.footer = UI.label(content, "", { Position = UDim2.new(0, 0, 1, -28), Size = UDim2.new(1, 0, 0, 26), TextColor3 = UI.Theme.muted, MaxText = 18 })
end

function MachineController.sellResult()
	local itemId = state.result.itemId
	local item = ItemDefinitions.get(itemId)
	local function send(confirm)
		local r = Net.call("InventoryAction", { action = "sell", itemId = itemId, amount = 1, confirm = confirm })
		if r.ok then
			UIController.toast("💰 Vendido: " .. item.name .. " por " .. Format.int(r.coins) .. " Coins", "coins")
		elseif r.needsConfirm then
			UIController.confirm("Vender " .. item.name .. " (" .. RarityConfig.get(item.rarity).name .. ") por 💰" .. Format.int(item.value) .. "?", "Vender", function()
				send(true)
			end)
		else
			UIController.toast(r.message, "warn")
		end
	end
	send(false)
end

---------------------------------------------------------------------------
-- painel "Máquinas" (lista)
---------------------------------------------------------------------------
local listRows = {}

local function buildMachinesPanel(content)
	UI.label(content, "Escolha uma máquina. Chegue perto dela e aperte E (ou toque) para usar.", { Size = UDim2.new(1, 0, 0, 24), TextColor3 = UI.Theme.muted, MaxText = 18 })
	local holder = UI.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 32), Size = UDim2.new(1, 0, 1, -32), Parent = content })
	UI.list(holder, 8)
	for i, def in ipairs(MachineDefinitions.List) do
		local row = UI.frame(holder, { Name = def.id, Size = UDim2.new(1, 0, 0, 90), LayoutOrder = i })
		UI.frame(row, { Position = UDim2.new(0, 8, 0, 8), Size = UDim2.new(0, 74, 1, -16), BackgroundColor3 = def.bodyColor })
		UI.label(row, def.name, { Position = UDim2.new(0, 96, 0, 8), Size = UDim2.new(0.45, 0, 0, 30), Font = Enum.Font.FredokaOne, MaxText = 26 })
		local info = UI.label(row, "", { Position = UDim2.new(0, 96, 0, 44), Size = UDim2.new(0.45, 0, 0, 36), TextColor3 = UI.Theme.muted, TextWrapped = true, MaxText = 16 })
		UI.button(row, "VER CHANCES", UI.Theme.blue, function()
			UIController.open("Machine", { machineId = def.id })
		end, { Position = UDim2.new(1, -330, 0.5, -24), Size = UDim2.new(0, 160, 0, 48), MaxText = 18 })
		UI.button(row, "IR ATÉ ➜", UI.Theme.accent, function()
			local r = Net.call("ProgressAction", { action = "goto", target = def.id })
			if r.ok then
				UIController.close()
			else
				UIController.toast(r.message, "warn")
			end
		end, { Position = UDim2.new(1, -160, 0.5, -24), Size = UDim2.new(0, 150, 0, 48), MaxText = 18 })
		listRows[def.id] = info
	end
end

local function refreshMachinesPanel(view)
	for _, def in ipairs(MachineDefinitions.List) do
		local have = 0
		for _, entry in ipairs(def.pool) do
			if view.discovered[entry.item] then
				have = have + 1
			end
		end
		local status = view.level >= def.level and "🔓 Liberada" or ("🔒 Nível " .. def.level)
		listRows[def.id].Text = "💰 " .. Format.int(def.price) .. " Coins   •   " .. status .. "   •   Coleção " .. have .. "/" .. #def.pool
	end
end

---------------------------------------------------------------------------
function MachineController.init()
	UIController.register("Machines", {
		screen = "MachineUI",
		title = "🎰 Máquinas",
		build = buildMachinesPanel,
		refresh = refreshMachinesPanel,
	})
	UIController.register("Machine", {
		screen = "MachineUI",
		title = "Máquina",
		build = buildMachinePanel,
		onOpen = function(args)
			if args.machineId and MachineDefinitions.get(args.machineId) and args.machineId ~= selected then
				selected = args.machineId
				if state.phase ~= "rolling" then
					state = { phase = "idle" }
				end
			end
			if state.phase == "idle" then
				setResultButtons(false)
				panel.status.Text = "Pronto para jogar!"
				panel.rarityLabel.Text = ""
				showItem(nil)
			end
			buildOddsList(selected)
		end,
		refresh = refreshMachinePanel,
		onClose = function()
			if state.phase == "result" then
				state = { phase = "idle" }
			end
		end,
	})

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local machineId = prompt:GetAttribute("MachineId")
		local panelName = prompt:GetAttribute("Panel")
		if machineId then
			UIController.open("Machine", { machineId = machineId })
		elseif panelName then
			UIController.open(panelName)
		end
	end)

	Net.on("MachineResult", function(data)
		if type(data) ~= "table" or data.userId == localPlayer.UserId then
			return -- quem usou já anima pelo próprio pedido
		end
		if MachineDefinitions.get(data.machineId) and ItemDefinitions.get(data.itemId) then
			MachineController.animateMachine(data.machineId, math.min(data.duration or 3, 5), data.itemId, data.rarity)
		end
	end)
end

MachineController.state = function()
	return state
end

return MachineController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000043"><Properties><string name="Name">MissionController</string><ProtectedString name="Source"><![CDATA[-- Missões: presente diário, 3 missões do dia (com progresso) e conquistas permanentes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local EconomyConfig = require(Shared.EconomyConfig)
local Format = require(Shared.Util.Format)

local UI = require(script.Parent.Parent.Util.UI)
local Store = require(script.Parent.Parent.Util.Store)
local Net = require(script.Parent.Parent.Util.Net)
local UIController = require(script.Parent.UIController)

local MissionController = {}

local ui = { daily = {}, achievements = {} }
local tab = "daily"

local function rewardToast(r)
	local text = "🎁 +" .. Format.int(r.coins) .. " Coins"
	if (r.xp or 0) > 0 then
		text = text .. "  +" .. r.xp .. " XP"
	end
	UIController.toast(text, "coins")
end

local function claim(payload)
	local r = Net.call("ProgressAction", payload)
	if r.ok then
		rewardToast(r)
	else
		UIController.toast(r.message, "warn")
	end
	return r
end

local function missionRow(parent, order)
	local row = {}
	row.frame = UI.frame(parent, { Size = UDim2.new(1, -12, 0, 70), LayoutOrder = order })
	row.text = UI.label(row.frame, "", { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -220, 0, 26), MaxText = 19 })
	local _, set = UI.progress(row.frame, { Position = UDim2.new(0, 12, 0, 38), Size = UDim2.new(1, -380, 0, 22) })
	row.setProgress = set
	row.reward = UI.label(row.frame, "", { Position = UDim2.new(1, -360, 0, 38), Size = UDim2.new(0, 150, 0, 22), TextColor3 = UI.Theme.coins, MaxText = 15 })
	row.button = UI.button(row.frame, "RESGATAR", UI.Theme.green, nil, { Position = UDim2.new(1, -196, 0.5, -22), Size = UDim2.new(0, 184, 0, 44), MaxText = 18 })
	return row
end

local function fillRow(row, m, fmtProgress)
	row.text.Text = m.text
	local label = fmtProgress and fmtProgress(m) or (Format.int(m.progress) .. "/" .. Format.int(m.target))
	row.setProgress(m.progress / m.target, label)
	row.reward.Text = "💰" .. Format.short(m.coins) .. ((m.xp or 0) > 0 and ("  ⭐" .. m.xp) or "")
	if m.claimed then
		row.button.Text = "✔ Feito"
		UI.setEnabled(row.button, false)
	elseif m.progress >= m.target then
		row.button.Text = "RESGATAR"
		UI.setEnabled(row.button, true, UI.Theme.green)
	else
		row.button.Text = "Em andamento"
		UI.setEnabled(row.button, false)
	end
end

function MissionController.refresh(view)
	if not ui.dailyPage then
		return
	end
	ui.dailyPage.Visible = tab == "daily"
	ui.achPage.Visible = tab == "achievements"
	local g = view.gift
	if g.canClaim then
		ui.giftText.Text = "🎁 Presente diário — dia " .. g.nextStreak .. "/" .. #EconomyConfig.DailyGift.coins .. ": 💰" .. Format.int(g.coins) .. " + " .. g.xp .. " XP"
		ui.giftButton.Text = "RESGATAR"
		UI.setEnabled(ui.giftButton, true, UI.Theme.green)
	else
		ui.giftText.Text = "🎁 Presente resgatado (sequência " .. g.streak .. "). Próximo em " .. Format.duration(g.secondsLeft)
		ui.giftButton.Text = "✔ Amanhã"
		UI.setEnabled(ui.giftButton, false)
	end
	for i, row in ipairs(ui.daily) do
		local m = view.daily[i]
		row.frame.Visible = m ~= nil
		if m then
			row.id = m.id
			fillRow(row, m, m.id == "d_play" and function(x)
				return math.floor(x.progress / 60) .. "/" .. math.floor(x.target / 60) .. " min"
			end or nil)
		end
	end
	ui.dailyFooter.Text = "Novas missões em " .. Format.duration(g.secondsLeft) .. "  •  Moedas perdidas restantes nesta hora: " .. view.pickupsLeft
	for i, row in ipairs(ui.achievements) do
		local m = view.achievements[i]
		row.frame.Visible = m ~= nil
		if m then
			row.id = m.id
			fillRow(row, m)
		end
	end
end

local function build(content)
	local selectTab = UI.tabs(content, { { id = "daily", label = "📅 Diárias", width = 160 }, { id = "achievements", label = "🏅 Conquistas", width = 180 } }, function(id)
		tab = id
		if Store.view then
			MissionController.refresh(Store.view)
		end
	end)
	ui.dailyPage = UI.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 46), Size = UDim2.new(1, 0, 1, -46), Parent = content })
	local gift = UI.frame(ui.dailyPage, { Size = UDim2.new(1, -12, 0, 64), BackgroundColor3 = Color3.fromRGB(90, 60, 130) })
	ui.giftText = UI.label(gift, "", { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -220, 1, 0), TextWrapped = true, MaxText = 19 })
	ui.giftButton = UI.button(gift, "RESGATAR", UI.Theme.green, function(b)
		if not b:GetAttribute("Disabled") then
			claim({ action = "claimGift" })
		end
	end, { Name = "Gift", Position = UDim2.new(1, -196, 0.5, -22), Size = UDim2.new(0, 184, 0, 44), MaxText = 18 })
	local list = UI.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 74), Size = UDim2.new(1, 0, 1, -110), Parent = ui.dailyPage })
	UI.list(list, 8)
	for i = 1, 3 do
		local row = missionRow(list, i)
		row.button.Activated:Connect(function()
			if row.id and not row.button:GetAttribute("Disabled") then
				claim({ action = "claimDaily", missionId = row.id })
			end
		end)
		ui.daily[i] = row
	end
	ui.dailyFooter = UI.label(ui.dailyPage, "", { Position = UDim2.new(0, 0, 1, -28), Size = UDim2.new(1, 0, 0, 24), TextColor3 = UI.Theme.muted, MaxText = 16 })

	ui.achPage = UI.scroll(content, { Position = UDim2.new(0, 0, 0, 46), Size = UDim2.new(1, 0, 1, -46), Visible = false })
	UI.list(ui.achPage, 8)
	local MissionDefinitions = require(Shared.MissionDefinitions)
	for i = 1, #MissionDefinitions.Achievements do
		local row = missionRow(ui.achPage, i)
		row.button.Activated:Connect(function()
			if row.id and not row.button:GetAttribute("Disabled") then
				claim({ action = "claimAchievement", achievementId = row.id })
			end
		end)
		ui.achievements[i] = row
	end
	ui.selectTab = selectTab
	selectTab("daily")
end

function MissionController.init()
	UIController.register("Missions", {
		screen = "MissionUI",
		title = "📜 Missões e Presentes",
		build = build,
		refresh = MissionController.refresh,
		onOpen = function(args)
			if args.tab and ui.selectTab then
				ui.selectTab(args.tab)
			end
		end,
	})
end

return MissionController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000044"><Properties><string name="Name">SettingsController</string><ProtectedString name="Source"><![CDATA[-- Configurações (salvas no perfil pelo servidor) e atalhos para os lugares do parque.

local UI = require(script.Parent.Parent.Util.UI)
local Net = require(script.Parent.Parent.Util.Net)
local UIController = require(script.Parent.UIController)

local SettingsController = {}

SettingsController.Options = {
	{ key = "autoSkip", label = "Pular animação automaticamente" },
	{ key = "sound", label = "Sons" },
	{ key = "effects", label = "Efeitos visuais (brilhos e partículas)" },
}

SettingsController.Places = {
	{ target = "plaza", label = "⛲ Praça" },
	{ target = "common", label = "🎰 Máquinas" },
	{ target = "shop", label = "⚙️ Loja" },
	{ target = "gallery", label = "🏛️ Galeria" },
	{ target = "showcase", label = "🖼️ Minha vitrine" },
	{ target = "ranking", label = "🏆 Ranking" },
}

local toggles = {}

function SettingsController.refresh(view)
	for key, b in pairs(toggles) do
		local on = view.settings[key] == true
		b.Text = on and "LIGADO" or "DESLIGADO"
		b.BackgroundColor3 = on and UI.Theme.green or UI.Theme.grey
	end
end

local function build(content)
	local list = UI.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 200), Parent = content })
	UI.list(list, 8)
	for i, opt in ipairs(SettingsController.Options) do
		local row = UI.frame(list, { Size = UDim2.new(1, 0, 0, 56), LayoutOrder = i })
		UI.label(row, opt.label, { Position = UDim2.new(0, 14, 0, 0), Size = UDim2.new(1, -220, 1, 0), MaxText = 20 })
		toggles[opt.key] = UI.button(row, "", UI.Theme.grey, function(b)
			local r = Net.call("ProgressAction", { action = "setSetting", key = opt.key, value = b.Text ~= "LIGADO" })
			if not r.ok then
				UIController.toast(r.message, "warn")
			end
		end, { Name = opt.key, Position = UDim2.new(1, -190, 0.5, -21), Size = UDim2.new(0, 176, 0, 42), MaxText = 18 })
	end
	UI.label(content, "Ir para:", { Position = UDim2.new(0, 0, 0, 200), Size = UDim2.new(1, 0, 0, 28), Font = Enum.Font.FredokaOne, MaxText = 22 })
	local places = UI.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 234), Size = UDim2.new(1, 0, 0, 110), Parent = content })
	UI.make("UIGridLayout", { CellSize = UDim2.new(0, 238, 0, 48), CellPadding = UDim2.new(0, 8, 0, 8), Parent = places })
	for _, place in ipairs(SettingsController.Places) do
		UI.button(places, place.label, UI.Theme.blue, function()
			local r = Net.call("ProgressAction", { action = "goto", target = place.target })
			if r.ok then
				UIController.close()
			else
				UIController.toast(r.message, "warn")
			end
		end, { MaxText = 18 })
	end
	UI.label(content, "MYSTERY MACHINE v1.0 — sem compras com Robux, sem apostas. Chances sempre visíveis.", {
		Position = UDim2.new(0, 0, 1, -26),
		Size = UDim2.new(1, 0, 0, 22),
		TextColor3 = UI.Theme.muted,
		MaxText = 14,
	})
end

function SettingsController.init()
	UIController.register("Settings", {
		screen = "SettingsUI",
		title = "🔧 Configurações",
		build = build,
		refresh = SettingsController.refresh,
	})
end

return SettingsController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000045"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[-- Gerencia as telas (ScreenGui) e as janelas. Regras:
-- * só UMA janela grande aberta por vez (abrir outra fecha a atual);
-- * cada janela é montada só na primeira vez que abre (carregamento sob demanda) e reaproveitada;
-- * tudo é desenhado em 1100×650 virtuais e escalado (UIScale) para o tamanho da tela.

local Players = game:GetService("Players")
local UI = require(script.Parent.Parent.Util.UI)
local Store = require(script.Parent.Parent.Util.Store)
local Sounds = require(script.Parent.Parent.Util.Sounds)

local UIController = {}

UIController.current = nil
UIController.panels = {}
UIController.screens = {}
UIController.scale = 1

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local scales = {}

local VIRTUAL_W, VIRTUAL_H = 1100, 650
local WINDOW_W, WINDOW_H = 780, 500

local function computeScale()
	local camera = workspace.CurrentCamera
	local size = camera and camera.ViewportSize or Vector2.new(VIRTUAL_W, VIRTUAL_H)
	return math.clamp(math.min(size.X / VIRTUAL_W, size.Y / VIRTUAL_H), 0.5, 1.3)
end

local function applyScale()
	UIController.scale = computeScale()
	for _, s in ipairs(scales) do
		s.Scale = UIController.scale
	end
end

function UIController.screen(name, displayOrder)
	local gui = UIController.screens[name]
	if gui then
		return gui
	end
	gui = UI.make("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 1,
		Parent = playerGui,
	})
	local scale = UI.make("UIScale", { Scale = UIController.scale, Parent = gui })
	table.insert(scales, scale)
	UIController.screens[name] = gui
	return gui
end

-- janela padrão centralizada: retorna janela, área de conteúdo e título
function UIController.window(screenName, title)
	local gui = UIController.screen(screenName, 5)
	local window = UI.frame(gui, {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 10),
		Size = UDim2.new(0, WINDOW_W, 0, WINDOW_H),
		BackgroundColor3 = UI.Theme.panel,
		Visible = false,
		radius = 16,
	})
	UI.stroke(window, UI.Theme.accent, 3)
	local titleLabel = UI.label(window, title, {
		Name = "Title",
		Font = Enum.Font.FredokaOne,
		Position = UDim2.new(0, 20, 0, 10),
		Size = UDim2.new(1, -90, 0, 38),
		MaxText = 32,
	})
	UI.button(window, "X", UI.Theme.red, function()
		UIController.close()
	end, { Name = "Close", Position = UDim2.new(1, -56, 0, 10), Size = UDim2.new(0, 44, 0, 40) })
	local content = UI.make("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 58),
		Size = UDim2.new(1, -32, 1, -72),
		Parent = window,
	})
	return window, content, titleLabel
end

-- panel = { screen, title, build(content, window, titleLabel), refresh(view), onOpen(args), onClose() }
function UIController.register(name, panel)
	UIController.panels[name] = panel
end

local function ensureBuilt(panel)
	if panel.window then
		return
	end
	local window, content, titleLabel = UIController.window(panel.screen, panel.title)
	panel.window, panel.content, panel.titleLabel = window, content, titleLabel
	panel.build(content, window, titleLabel)
end

function UIController.open(name, args)
	local panel = UIController.panels[name]
	if not panel then
		return
	end
	if UIController.current and UIController.current ~= name then
		UIController.close(true)
	end
	ensureBuilt(panel)
	UIController.current = name
	panel.window.Visible = true
	if panel.onOpen then
		panel.onOpen(args or {})
	end
	if panel.refresh and Store.view then
		panel.refresh(Store.view)
	end
	Sounds.play("click")
end

function UIController.toggle(name, args)
	if UIController.current == name then
		UIController.close()
	else
		UIController.open(name, args)
	end
end

function UIController.close(silent)
	local name = UIController.current
	if not name then
		return
	end
	local panel = UIController.panels[name]
	UIController.current = nil
	if panel.window then
		panel.window.Visible = false
	end
	if panel.onClose then
		panel.onClose()
	end
	if not silent then
		Sounds.play("click")
	end
end

function UIController.refreshCurrent()
	local name = UIController.current
	local panel = name and UIController.panels[name]
	if panel and panel.refresh and Store.view then
		panel.refresh(Store.view)
	end
end

---------------------------------------------------------------------------
-- avisos (toasts) e confirmação
---------------------------------------------------------------------------
local toastHolder
local TOAST_COLORS = {
	info = UI.Theme.card,
	coins = Color3.fromRGB(150, 110, 20),
	warn = Color3.fromRGB(150, 50, 60),
	level = Color3.fromRGB(40, 110, 170),
	legendary = Color3.fromRGB(170, 120, 10),
	secret = Color3.fromRGB(160, 20, 40),
}

function UIController.toast(text, kind)
	if not toastHolder then
		local gui = UIController.screen("Toasts", 20)
		toastHolder = UI.make("Frame", {
			Name = "Holder",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 70),
			Size = UDim2.new(0, 340, 0, 400),
			Parent = gui,
		})
		UI.list(toastHolder, 6)
	end
	local items = {}
	for _, c in ipairs(toastHolder:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(items, c)
		end
	end
	if #items >= 4 then
		items[1]:Destroy()
	end
	local f = UI.frame(toastHolder, { Name = "Toast", Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = TOAST_COLORS[kind] or UI.Theme.card })
	UI.stroke(f, Color3.fromRGB(0, 0, 0), 2)
	UI.label(f, text, { Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(1, -20, 1, -8), TextWrapped = true, MaxText = 18 })
	task.delay(kind == "secret" and 7 or 4, function()
		if f.Parent then
			f:Destroy()
		end
	end)
	return f
end

-- janela pequena de confirmação (não fecha a janela grande atual)
function UIController.confirm(text, yesText, onYes)
	local gui = UIController.screen("Dialogs", 30)
	local old = gui:FindFirstChild("Confirm")
	if old then
		old:Destroy()
	end
	local shade = UI.make("Frame", { Name = "Confirm", BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.new(1, 0, 1, 0), Parent = gui })
	local box = UI.frame(shade, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 420, 0, 200), BackgroundColor3 = UI.Theme.panel })
	UI.stroke(box, UI.Theme.coins, 3)
	UI.label(box, text, { Position = UDim2.new(0, 20, 0, 16), Size = UDim2.new(1, -40, 0, 100), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, MaxText = 22 })
	UI.button(box, "Cancelar", UI.Theme.grey, function()
		shade:Destroy()
	end, { Position = UDim2.new(0, 30, 1, -64), Size = UDim2.new(0, 160, 0, 48) })
	UI.button(box, yesText or "Confirmar", UI.Theme.green, function()
		shade:Destroy()
		onYes()
	end, { Position = UDim2.new(1, -190, 1, -64), Size = UDim2.new(0, 160, 0, 48) })
	return shade
end

function UIController.init()
	applyScale()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
	end
	Store.changed:Connect(function()
		UIController.refreshCurrent()
	end)
end

return UIController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000046"><Properties><string name="Name">UpgradeController</string><ProtectedString name="Source"><![CDATA[-- Loja de melhorias: nível atual, benefício (atual → próximo), preço e limite máximo.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local UpgradeConfig = require(Shared.UpgradeConfig)
local Format = require(Shared.Util.Format)

local UI = require(script.Parent.Parent.Util.UI)
local Net = require(script.Parent.Parent.Util.Net)
local UIController = require(script.Parent.UIController)

local UpgradeController = {}

local rows = {}

function UpgradeController.refresh(view)
	for id, row in pairs(rows) do
		local level = view.upgrades[id]
		local max = UpgradeConfig.max(id)
		row.level.Text = "Nível " .. level .. "/" .. max
		if level >= max then
			row.benefit.Text = UpgradeConfig.benefitText(id, level) .. "  (máximo)"
			row.buy.Text = "MÁXIMO"
			UI.setEnabled(row.buy, false)
		else
			local price = UpgradeConfig.price(id, level)
			row.benefit.Text = UpgradeConfig.benefitText(id, level) .. "  →  " .. UpgradeConfig.benefitText(id, level + 1)
			row.buy.Text = "COMPRAR 💰" .. Format.short(price)
			UI.setEnabled(row.buy, view.coins >= price, UI.Theme.green)
		end
	end
end

local function build(content)
	UI.label(content, "Melhorias permanentes. Nenhuma delas muda as chances das máquinas.", { Size = UDim2.new(1, 0, 0, 22), TextColor3 = UI.Theme.muted, MaxText = 17 })
	local holder = UI.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 30), Size = UDim2.new(1, 0, 1, -30), Parent = content })
	UI.list(holder, 8)
	for i, id in ipairs(UpgradeConfig.Order) do
		local def = UpgradeConfig.Upgrades[id]
		local row = { }
		local f = UI.frame(holder, { Name = id, Size = UDim2.new(1, 0, 0, 92), LayoutOrder = i })
		UI.label(f, def.icon, { Position = UDim2.new(0, 10, 0, 10), Size = UDim2.new(0, 70, 0, 70), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 48 })
		UI.label(f, def.name, { Position = UDim2.new(0, 90, 0, 8), Size = UDim2.new(0.5, 0, 0, 28), Font = Enum.Font.FredokaOne, MaxText = 24 })
		UI.label(f, def.description, { Position = UDim2.new(0, 90, 0, 36), Size = UDim2.new(0.5, 0, 0, 20), TextColor3 = UI.Theme.muted, MaxText = 15 })
		row.benefit = UI.label(f, "", { Position = UDim2.new(0, 90, 0, 60), Size = UDim2.new(0.5, 0, 0, 22), TextColor3 = UI.Theme.xp, MaxText = 17 })
		row.level = UI.label(f, "", { Position = UDim2.new(1, -330, 0, 0), Size = UDim2.new(0, 120, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, MaxText = 20 })
		row.buy = UI.button(f, "COMPRAR", UI.Theme.green, function(b)
			if b:GetAttribute("Disabled") then
				return
			end
			local r = Net.call("UpgradeAction", { action = "buy", upgradeId = id })
			if r.ok then
				UIController.toast("⚙️ " .. def.name .. " agora no nível " .. r.level .. "!", "level")
			else
				UIController.toast(r.message, "warn")
			end
		end, { Name = "Buy", Position = UDim2.new(1, -200, 0.5, -26), Size = UDim2.new(0, 188, 0, 52), MaxText = 20 })
		rows[id] = row
	end
end

function UpgradeController.init()
	UIController.register("Upgrades", {
		screen = "UpgradeUI",
		title = "⚙️ Melhorias",
		build = build,
		refresh = UpgradeController.refresh,
	})
end

return UpgradeController
]]></ProtectedString></Properties></Item>
</Item>
<Item class="LocalScript" referent="RBX000048"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- MYSTERY MACHINE — Máquina Surpresa: inicialização do cliente.
-- O cliente só desenha e envia pedidos; o servidor decide tudo.

local Controllers = script.Parent.Controllers
local Util = script.Parent.Util

local Store = require(Util.Store)
local Net = require(Util.Net)
local UIController = require(Controllers.UIController)
local HUDController = require(Controllers.HUDController)
local MachineController = require(Controllers.MachineController)
local InventoryController = require(Controllers.InventoryController)
local CollectionController = require(Controllers.CollectionController)
local UpgradeController = require(Controllers.UpgradeController)
local MissionController = require(Controllers.MissionController)
local LeaderboardController = require(Controllers.LeaderboardController)
local SettingsController = require(Controllers.SettingsController)

Net.on("DataUpdated", function(view)
	if type(view) == "table" then
		Store.set(view)
	end
end)

UIController.init()
HUDController.init()
MachineController.init()
InventoryController.init()
CollectionController.init()
UpgradeController.init()
MissionController.init()
LeaderboardController.init()
SettingsController.init()

-- pede a fotografia atual (caso o envio inicial do servidor tenha chegado antes do cliente)
task.spawn(function()
	while not Store.view do
		Net.call("ProgressAction", { action = "sync" })
		task.wait(2)
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX000054"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX000049"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Chamadas ao servidor com requestId único (o servidor devolve a mesma resposta se o pedido
-- se repetir, sem cobrar de novo) e trava local por ação para evitar cliques duplos.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Net = {}

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local busy = {}

function Net.remote(name)
	return remotes:WaitForChild(name)
end

-- retorna { ok = true, ... } ou { ok = false, error, message }
function Net.call(remoteName, payload)
	local key = remoteName .. ":" .. tostring(payload.action)
	if busy[key] then
		return { ok = false, error = "busy", message = "Aguarde..." }
	end
	busy[key] = true
	payload.requestId = HttpService:GenerateGUID(false)
	local okCall, response = pcall(function()
		return Net.remote(remoteName):InvokeServer(payload)
	end)
	busy[key] = nil
	if not okCall or type(response) ~= "table" then
		return { ok = false, error = "network", message = "Falha de conexão. Tente novamente." }
	end
	return response
end

function Net.on(eventName, fn)
	return Net.remote(eventName).OnClientEvent:Connect(fn)
end

return Net
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000050"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[-- Sinal simples para eventos locais do cliente.

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ handlers = {} }, Signal)
end

function Signal:Connect(fn)
	table.insert(self.handlers, fn)
	local handlers = self.handlers
	return {
		Disconnect = function()
			local i = table.find(handlers, fn)
			if i then
				table.remove(handlers, i)
			end
		end,
	}
end

function Signal:Fire(...)
	for _, fn in ipairs(self.handlers) do
		task.spawn(fn, ...)
	end
end

return Signal
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000051"><Properties><string name="Name">Sounds</string><ProtectedString name="Source"><![CDATA[-- Efeitos sonoros. Usa apenas sons que já vêm com o Roblox (rbxasset://), sem IDs inventados.
-- Para trocar por sons próprios, substitua os caminhos por "rbxassetid://<id do seu áudio>".

local SoundService = game:GetService("SoundService")
local Store = require(script.Parent.Store)

local Sounds = {}

Sounds.Library = {
	click = { id = "rbxasset://sounds/button.wav", volume = 0.4 },
	spin = { id = "rbxasset://sounds/clickfast.wav", volume = 0.35 },
	reveal = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6 },
	coins = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.4, speed = 1.4 },
	legendary = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.9, speed = 0.7 },
}

local cache = {}

local function get(name)
	if cache[name] then
		return cache[name]
	end
	local def = Sounds.Library[name]
	if not def then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = "SFX_" .. name
	s.SoundId = def.id
	s.Volume = def.volume or 0.5
	s.PlaybackSpeed = def.speed or 1
	s.Parent = SoundService
	cache[name] = s
	return s
end

function Sounds.play(name)
	if Store.setting("sound") == false then
		return
	end
	local s = get(name)
	if s then
		SoundService:PlayLocalSound(s)
	end
end

-- som 3D preso a uma peça (máquina); retorna a instância para poder parar
function Sounds.playAt(name, part)
	if Store.setting("sound") == false or not part then
		return nil
	end
	local def = Sounds.Library[name]
	local s = Instance.new("Sound")
	s.SoundId = def.id
	s.Volume = def.volume or 0.5
	s.PlaybackSpeed = def.speed or 1
	s.RollOffMaxDistance = 60
	s.Parent = part
	s:Play()
	task.delay(6, function()
		s:Destroy()
	end)
	return s
end

return Sounds
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000052"><Properties><string name="Name">Store</string><ProtectedString name="Source"><![CDATA[-- Estado do cliente: última fotografia do perfil enviada pelo servidor e o cache de rankings.
-- O cliente nunca altera estes dados por conta própria; só exibe.

local Signal = require(script.Parent.Signal)

local Store = {}

Store.view = nil
Store.leaderboard = nil
Store.changed = Signal.new()
Store.leaderboardChanged = Signal.new()

function Store.set(view)
	Store.view = view
	Store.changed:Fire(view)
end

function Store.setLeaderboard(data)
	Store.leaderboard = data
	Store.leaderboardChanged:Fire(data)
end

function Store.setting(key)
	local v = Store.view
	if v and v.settings then
		return v.settings[key]
	end
	return nil
end

return Store
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000053"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Construtores de interface com o visual do jogo (cantos arredondados, contorno, cores).
-- Todas as telas são desenhadas numa resolução virtual de 1100×650 e escaladas por UIScale
-- (UIController), então funcionam em PC, celular e tablet.

local UI = {}

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

UI.Theme = {
	bg = C(26, 22, 46),
	panel = C(36, 31, 64),
	card = C(50, 43, 86),
	cardLight = C(66, 58, 110),
	text = C(255, 255, 255),
	muted = C(185, 180, 215),
	accent = C(255, 90, 165),
	coins = C(255, 205, 60),
	green = C(70, 205, 110),
	blue = C(70, 150, 255),
	red = C(235, 70, 80),
	grey = C(110, 105, 140),
	xp = C(120, 200, 255),
}

-- chaves usadas só por estes construtores (não são propriedades do Roblox)
local HELPER_KEYS = { Parent = true, radius = true, MaxText = true }

function UI.make(class, props, children)
	local inst = Instance.new(class)
	if class == "Frame" or class == "ScrollingFrame" then
		inst.BorderSizePixel = 0
	end
	for k, v in pairs(props or {}) do
		if not HELPER_KEYS[k] then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(inst, radius)
	UI.make("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = inst })
	return inst
end

function UI.stroke(inst, color, thickness)
	UI.make("UIStroke", { Color = color or C(0, 0, 0), Thickness = thickness or 2, Transparency = 0.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inst })
	return inst
end

function UI.frame(parent, props)
	props = props or {}
	props.Parent = parent
	if props.BackgroundColor3 == nil then
		props.BackgroundColor3 = UI.Theme.card
	end
	local f = UI.make("Frame", props)
	UI.corner(f, props.radius or 10)
	return f
end

function UI.label(parent, text, props)
	local p = {
		BackgroundTransparency = 1,
		Text = text or "",
		TextColor3 = UI.Theme.text,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	}
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	local l = UI.make("TextLabel", p)
	UI.make("UITextSizeConstraint", { MaxTextSize = p.MaxText or 26, MinTextSize = 8, Parent = l })
	return l
end

-- botão com retorno de clique; props.MaxText limita o tamanho do texto
function UI.button(parent, text, color, onClick, props)
	local p = {
		Text = text,
		BackgroundColor3 = color or UI.Theme.accent,
		TextColor3 = UI.Theme.text,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		AutoButtonColor = true,
		Size = UDim2.new(0, 160, 0, 44),
		Parent = parent,
	}
	for k, v in pairs(props or {}) do
		if k ~= "MaxText" then
			p[k] = v
		end
	end
	local b = UI.make("TextButton", p)
	UI.corner(b, 10)
	UI.stroke(b, C(0, 0, 0), 2)
	UI.make("UITextSizeConstraint", { MaxTextSize = (props and props.MaxText) or 24, MinTextSize = 8, Parent = b })
	UI.make("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = b })
	if onClick then
		b.Activated:Connect(function()
			onClick(b)
		end)
	end
	return b
end

function UI.setEnabled(button, enabled, color)
	button.Active = enabled
	button.AutoButtonColor = enabled
	button.BackgroundColor3 = enabled and (color or UI.Theme.accent) or UI.Theme.grey
	button:SetAttribute("Disabled", not enabled)
end

-- barra de progresso; retorna o frame e a função set(fração, texto)
function UI.progress(parent, props, fillColor)
	local bar = UI.frame(parent, props)
	bar.BackgroundColor3 = UI.Theme.bg
	local fill = UI.frame(bar, { BackgroundColor3 = fillColor or UI.Theme.green, Size = UDim2.new(0, 0, 1, 0) })
	local text = UI.label(bar, "", { Size = UDim2.new(1, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3, MaxText = 18 })
	local function set(frac, label)
		frac = math.clamp(frac or 0, 0, 1)
		fill.Size = UDim2.new(frac, 0, 1, 0)
		fill.Visible = frac > 0
		text.Text = label or ""
	end
	return bar, set
end

function UI.list(parent, padding, horizontal)
	return UI.make("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

function UI.scroll(parent, props)
	local p = {
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	}
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	return UI.make("ScrollingFrame", p)
end

function UI.viewport(parent, props)
	local p = { BackgroundColor3 = UI.Theme.bg, Parent = parent }
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	p.Ambient = C(200, 200, 210)
	p.LightColor = C(255, 255, 255)
	local v = UI.make("ViewportFrame", p)
	UI.corner(v, 10)
	return v
end

-- abas: retorna a função select(nome) e a tabela de botões
function UI.tabs(parent, names, onSelect, props)
	local holder = UI.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), Parent = parent })
	for k, v in pairs(props or {}) do
		holder[k] = v
	end
	UI.list(holder, 6, true)
	local buttons = {}
	local function select(name)
		for n, b in pairs(buttons) do
			b.BackgroundColor3 = (n == name) and UI.Theme.accent or UI.Theme.cardLight
		end
		onSelect(name)
	end
	for i, entry in ipairs(names) do
		local b = UI.button(holder, entry.label, UI.Theme.cardLight, function()
			select(entry.id)
		end, { Size = UDim2.new(0, entry.width or 150, 1, 0), LayoutOrder = i, MaxText = 20 })
		buttons[entry.id] = b
	end
	return select, buttons
end

return UI
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
