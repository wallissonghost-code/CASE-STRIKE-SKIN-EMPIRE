	local offsets = { { 0, 0.42 }, { 0.17, 0.25 }, { -0.17, 0.25 }, { 0, 0.08 } }
	for i, o in ipairs(offsets) do
		table.insert(parts, { size = { 0.16, 0.16, 0.16 }, pos = { 0.75 + o[1], o[2], 0.3 }, shape = BALL, color = colors[i], mat = M.Neon })
	end
