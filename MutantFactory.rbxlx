<Item class="ReplicatedStorage" referent="RBX000020"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX000019"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX000005"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX000001"><Properties><string name="Name">EventConfig</string><ProtectedString name="Source"><![CDATA[-- EventConfig: eventos de mutação do servidor.
-- Agenda fixa em UTC (igual em todos os servidores): a cada 30 minutos começa um evento
-- de 6 minutos, alternando o tipo. Como a agenda é determinística, a renda offline
-- também pode somar corretamente os períodos de "Renda em Dobro".

local EventConfig = {}

EventConfig.Period = 1800
EventConfig.Duration = 360

-- kind: mutation (multiplica o peso de uma mutação), luck (sorte extra), income (multiplica renda),
--       conveyor (esteira mais rápida e com sorte)
EventConfig.Types = {
	{ id = "chuva_dourada", name = "Chuva Dourada", icon = "🌟", kind = "mutation", mutation = "dourada", weightMult = 5, description = "Mutação Dourada 5× mais comum." },
	{ id = "hora_sorte", name = "Hora da Sorte", icon = "🍀", kind = "luck", luck = 0.5, description = "+50% de sorte para todos." },
	{ id = "tempestade_radioativa", name = "Tempestade Radioativa", icon = "☢️", kind = "mutation", mutation = "radioativa", weightMult = 5, description = "Mutação Radioativa 5× mais comum." },
	{ id = "renda_dobro", name = "Renda em Dobro", icon = "💰", kind = "income", incomeMult = 2, description = "Todas as criaturas produzem o dobro." },
	{ id = "eclipse_vazio", name = "Eclipse do Vazio", icon = "🌑", kind = "mutation", mutation = "vazio", weightMult = 4, description = "Mutação Vazio 4× mais comum." },
	{ id = "esteira_turbo", name = "Esteira Turbo", icon = "⚡", kind = "conveyor", intervalMult = 0.5, luck = 0.5, description = "A esteira solta criaturas 2× mais rápido e com mais sorte." },
	{ id = "aurora_arcoiris", name = "Aurora Arco-íris", icon = "🌈", kind = "mutation", mutation = "arcoiris", weightMult = 5, description = "Mutação Arco-íris 5× mais comum." },
}

local function slot(index)
	local t = EventConfig.Types[(index % #EventConfig.Types) + 1]
	local startsAt = index * EventConfig.Period
	return {
		id = t.id,
		name = t.name,
		icon = t.icon,
		kind = t.kind,
		mutation = t.mutation,
		weightMult = t.weightMult,
		luck = t.luck,
		incomeMult = t.incomeMult,
		intervalMult = t.intervalMult,
		description = t.description,
		startsAt = startsAt,
		endsAt = startsAt + EventConfig.Duration,
	}
end

-- teste/servidor pode forçar um evento (ex.: comando de administrador no Studio)
EventConfig.override = nil

function EventConfig.at(now)
	local o = EventConfig.override
	if o and now >= o.startsAt and now < o.endsAt then
		return o
	end
	local s = slot(math.floor(now / EventConfig.Period))
	if now >= s.startsAt and now < s.endsAt then
		return s
	end
	return nil
end

function EventConfig.nextEvent(now)
	local i = math.floor(now / EventConfig.Period)
	local s = slot(i)
	if s.startsAt > now then
		return s
	end
	return slot(i + 1)
end

-- janelas de um tipo (kind) que se sobrepõem a [from, to]
function EventConfig.windows(from, to, kind)
	local out = {}
	if to <= from then
		return out
	end
	local first = math.floor(from / EventConfig.Period)
	local last = math.floor(to / EventConfig.Period)
	if last - first > 2000 then
		first = last - 2000 -- proteção: nunca percorre mais que ~41 dias
	end
	for i = first, last do
		local s = slot(i)
		if s.kind == kind and s.endsAt > from and s.startsAt < to then
			table.insert(out, s)
		end
	end
	local o = EventConfig.override
	if o and o.kind == kind and o.endsAt > from and o.startsAt < to then
		table.insert(out, o)
	end
	return out
end

-- força um evento agora (por id) por `seconds` segundos
function EventConfig.force(id, now, seconds)
	for _, t in ipairs(EventConfig.Types) do
		if t.id == id then
			local s = slot(0)
			for k, v in pairs(t) do
				s[k] = v
			end
			s.startsAt = now
			s.endsAt = now + (seconds or EventConfig.Duration)
			EventConfig.override = s
			return s
		end
	end
	return nil
end

return EventConfig
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000002"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source"><![CDATA[-- GameConfig: TODO o conteúdo e o balanceamento do MUTANT FACTORY ficam aqui.
-- Servidor e cliente leem o mesmo arquivo; a interface nunca tem números fixos.
-- Moeda única: Moedas (gratuita, ganha no jogo). Nada aqui é vendido por Robux.

local GameConfig = {}

GameConfig.StartingCoins = 300
GameConfig.MaxCoins = 1e15
GameConfig.SellRate = 0.5 -- vender devolve 50% do valor da criatura
GameConfig.ValuableConfirmTier = 5 -- vender Lendária ou Mítica exige confirmação

---------------------------------------------------------------------------
-- raridades
---------------------------------------------------------------------------
GameConfig.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }
GameConfig.Rarities = {
	Common = { id = "Common", tier = 1, displayName = "Comum", color = { 170, 178, 190 } },
	Uncommon = { id = "Uncommon", tier = 2, displayName = "Incomum", color = { 80, 210, 110 } },
	Rare = { id = "Rare", tier = 3, displayName = "Rara", color = { 70, 150, 255 } },
	Epic = { id = "Epic", tier = 4, displayName = "Épica", color = { 175, 90, 250 } },
	Legendary = { id = "Legendary", tier = 5, displayName = "Lendária", color = { 255, 190, 50 } },
	Mythic = { id = "Mythic", tier = 6, displayName = "Mítica", color = { 255, 70, 95 } },
}

---------------------------------------------------------------------------
-- espécies (modelos feitos de peças no próprio jogo; nenhum asset externo)
-- shape: blob, spikes, drop, tentacles, ghost, mushroom, eye, dragon, cyclops, octopus, crown, phoenix, titan, core
---------------------------------------------------------------------------
GameConfig.Species = {
	{ id = "gosminha", name = "Gosminha", rarity = "Common", income = 1, price = 25, shape = "blob", color = { 90, 220, 110 } },
	{ id = "bolhudo", name = "Bolhudo", rarity = "Common", income = 2, price = 55, shape = "blob", color = { 80, 180, 255 } },
	{ id = "lodinho", name = "Lodinho", rarity = "Common", income = 3, price = 90, shape = "drop", color = { 140, 120, 80 } },
	{ id = "espinhoso", name = "Espinhoso", rarity = "Uncommon", income = 7, price = 280, shape = "spikes", color = { 255, 150, 60 } },
	{ id = "pingo_acido", name = "Pingo Ácido", rarity = "Uncommon", income = 10, price = 420, shape = "drop", color = { 190, 255, 60 } },
	{ id = "tentaclinho", name = "Tentaclinho", rarity = "Uncommon", income = 13, price = 560, shape = "tentacles", color = { 255, 110, 170 } },
	{ id = "fantasminha", name = "Fantasminha", rarity = "Rare", income = 30, price = 1800, shape = "ghost", color = { 220, 230, 255 } },
	{ id = "cogumelao", name = "Cogumelão", rarity = "Rare", income = 40, price = 2500, shape = "mushroom", color = { 230, 70, 70 } },
	{ id = "olhudo", name = "Olhudo", rarity = "Rare", income = 55, price = 3600, shape = "eye", color = { 120, 90, 230 } },
	{ id = "dragosma", name = "Dragosma", rarity = "Epic", income = 150, price = 13500, shape = "dragon", color = { 60, 200, 150 } },
	{ id = "ciclope_rubi", name = "Ciclope Rubi", rarity = "Epic", income = 200, price = 19000, shape = "cyclops", color = { 220, 40, 80 } },
	{ id = "polvo_neon", name = "Polvo Neon", rarity = "Epic", income = 260, price = 26000, shape = "octopus", color = { 255, 80, 230 } },
	{ id = "rei_gosma", name = "Rei Gosma", rarity = "Legendary", income = 800, price = 120000, shape = "crown", color = { 70, 230, 120 } },
	{ id = "fenix_toxica", name = "Fênix Tóxica", rarity = "Legendary", income = 1100, price = 170000, shape = "phoenix", color = { 255, 120, 40 } },
	{ id = "tita_mutante", name = "Titã Mutante", rarity = "Mythic", income = 4500, price = 1100000, shape = "titan", color = { 110, 120, 140 } },
	{ id = "nucleo_primordial", name = "Núcleo Primordial", rarity = "Mythic", income = 6500, price = 1700000, shape = "core", color = { 60, 255, 220 } },
}
GameConfig.SpeciesById = {}
for i, s in ipairs(GameConfig.Species) do
	s.order = i
	GameConfig.SpeciesById[s.id] = s
end

---------------------------------------------------------------------------
-- mutações (multiplicam renda e valor)
---------------------------------------------------------------------------
GameConfig.MutationOrder = { "normal", "dourada", "diamante", "radioativa", "vazio", "arcoiris" }
GameConfig.Mutations = {
	normal = { id = "normal", name = "Normal", mult = 1, weight = 80, tier = 0 },
	dourada = { id = "dourada", name = "Dourada", mult = 2, weight = 12, tier = 1, color = { 255, 205, 60 } },
	diamante = { id = "diamante", name = "Diamante", mult = 4, weight = 5, tier = 2, color = { 120, 235, 255 } },
	radioativa = { id = "radioativa", name = "Radioativa", mult = 6, weight = 2, tier = 3, color = { 120, 255, 70 } },
	vazio = { id = "vazio", name = "Vazio", mult = 10, weight = 0.8, tier = 4, color = { 120, 50, 200 } },
	arcoiris = { id = "arcoiris", name = "Arco-íris", mult = 20, weight = 0.2, tier = 5, color = { 255, 255, 255 } },
}

---------------------------------------------------------------------------
-- sorte: aumenta o peso das raridades Rara+ e das mutações não normais.
-- As chances finais (já com sorte e eventos) aparecem sempre na interface.
---------------------------------------------------------------------------
GameConfig.Luck = {
	Max = 1.0, -- +100% no máximo
	RarityScale = { [1] = 0, [2] = 0, [3] = 1, [4] = 1.5, [5] = 2, [6] = 2.5 },
	MutationScale = { [0] = 0, [1] = 1, [2] = 1.25, [3] = 1.5, [4] = 1.75, [5] = 2 },
}

---------------------------------------------------------------------------
-- esteira da fábrica (criaturas passam e qualquer jogador pode comprar)
---------------------------------------------------------------------------
GameConfig.Conveyor = {
	SpawnInterval = 3.5, -- segundos entre criaturas
	TravelSeconds = 42, -- tempo para atravessar a esteira
	MaxOnBelt = 14,
	RarityWeights = { Common = 600, Uncommon = 250, Rare = 100, Epic = 38, Legendary = 10, Mythic = 2 },
}

---------------------------------------------------------------------------
-- ovos (quiosques): sorteio pessoal, usa a sorte do jogador
---------------------------------------------------------------------------
GameConfig.EggOrder = { "basico", "raro", "lendario" }
GameConfig.Eggs = {
	basico = {
		id = "basico",
		name = "Ovo Básico",
		price = 300,
		requiredRebirths = 0,
		color = { 120, 220, 120 },
		rarityWeights = { Common = 800, Uncommon = 180, Rare = 18, Epic = 2 },
	},
	raro = {
		id = "raro",
		name = "Ovo Raro",
		price = 10000,
		requiredRebirths = 0,
		color = { 80, 150, 255 },
		rarityWeights = { Uncommon = 450, Rare = 400, Epic = 130, Legendary = 20 },
	},
	lendario = {
		id = "lendario",
		name = "Ovo Lendário",
		price = 100000,
		requiredRebirths = 1,
		color = { 255, 190, 50 },
		rarityWeights = { Rare = 300, Epic = 480, Legendary = 200, Mythic = 20 },
	},
}

---------------------------------------------------------------------------
-- base e melhorias
---------------------------------------------------------------------------
GameConfig.Base = {
	StartSlots = 8,
	MaxSlotsShown = 20,
	StorageSeconds = 1800, -- cada criatura guarda até 30 min de produção (cofre)
	ShieldSeconds = 60, -- escudo da base
	NewcomerShield = 120, -- proteção automática ao entrar
	WalkSpeed = 16,
}
GameConfig.UpgradeOrder = { "slots", "storage", "shield", "speed" }
GameConfig.Upgrades = {
	slots = { id = "slots", name = "Mais pedestais", description = "+2 vagas para criaturas", baseCost = 1500, growth = 4, perLevel = 2, maxLevel = 6 },
	storage = { id = "storage", name = "Cofre maior", description = "+30 min de produção guardada por criatura", baseCost = 800, growth = 3, perLevel = 1800, maxLevel = 7 },
	shield = { id = "shield", name = "Escudo reforçado", description = "+10 s de escudo da base", baseCost = 2500, growth = 3, perLevel = 10, maxLevel = 6 },
	speed = { id = "speed", name = "Tênis turbo", description = "+1 de velocidade ao andar", baseCost = 2000, growth = 2.6, perLevel = 1, maxLevel = 8 },
}

---------------------------------------------------------------------------
-- roubo
---------------------------------------------------------------------------
GameConfig.Steal = {
	HoldSeconds = 1.5, -- segurar o botão para pegar
	MaxCarrySeconds = 45, -- depois disso a criatura volta
	CarrySpeedPenalty = 4, -- quem carrega anda mais devagar
	TagDistance = 7, -- o dono encostar em quem rouba devolve a criatura
	PromptDistance = 9,
	ProtectAfterSteal = 180, -- criatura recém-roubada fica protegida por 3 min
	MinLevelRebirths = 0,
}

---------------------------------------------------------------------------
-- poções (só ganhas no jogo ou compradas com Moedas)
---------------------------------------------------------------------------
GameConfig.PotionOrder = { "sorte", "renda", "velocidade" }
GameConfig.Potions = {
	sorte = { id = "sorte", name = "Poção da Sorte", icon = "🍀", luck = 0.25, duration = 600, maxStack = 3600, coinPrice = 20000, description = "+25% de sorte nos ovos e mutações." },
	renda = { id = "renda", name = "Poção de Renda", icon = "💰", incomeMult = 1.5, duration = 900, maxStack = 5400, coinPrice = 30000, description = "Renda ×1,5 (também enquanto você está fora, até acabar)." },
	velocidade = { id = "velocidade", name = "Poção de Velocidade", icon = "👟", speed = 6, duration = 300, maxStack = 1800, coinPrice = 8000, description = "+6 de velocidade para fugir ou perseguir." },
}

---------------------------------------------------------------------------
-- renascimento
---------------------------------------------------------------------------
GameConfig.Rebirth = {
	MaxRebirths = 20,
	BaseCost = 250000,
	Growth = 4,
	IncomeBonusPer = 0.5, -- +50% de renda por renascimento
	LuckPer = 0.05, -- +5% de sorte por renascimento
	LuckMax = 0.5,
	ConfirmPhrase = "RENASCER",
}
function GameConfig.rebirthCost(n)
	return math.floor(GameConfig.Rebirth.BaseCost * (GameConfig.Rebirth.Growth ^ (n - 1)) + 0.5)
end

---------------------------------------------------------------------------
-- limites de frequência por categoria (balde de fichas por jogador)
---------------------------------------------------------------------------
GameConfig.RateLimits = {
	Data = { capacity = 6, refillPerSecond = 1 },
	Hatch = { capacity = 4, refillPerSecond = 2 },
	Base = { capacity = 10, refillPerSecond = 4 },
	Claim = { capacity = 8, refillPerSecond = 2 },
	Settings = { capacity = 6, refillPerSecond = 1 },
	Ranking = { capacity = 3, refillPerSecond = 0.5 },
}

---------------------------------------------------------------------------
-- utilidades
---------------------------------------------------------------------------
function GameConfig.tier(rarityId)
	local r = GameConfig.Rarities[rarityId]
	return r and r.tier or 0
end

function GameConfig.upgradeCost(id, level)
	local u = GameConfig.Upgrades[id]
	return math.floor(u.baseCost * (u.growth ^ level) + 0.5)
end

return GameConfig
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000003"><Properties><string name="Name">MapConfig</string><ProtectedString name="Source"><![CDATA[-- MapConfig: geometria do mapa (usada pelo servidor para construir e validar posições,
-- e pelo cliente para efeitos locais). Coordenadas em studs; y = 0 é o chão.

local MapConfig = {}

MapConfig.GroundSize = 440
MapConfig.Fence = 205 -- cerca em ±205

-- esteira: atravessa a praça de oeste para leste
MapConfig.Conveyor = {
	startX = -72,
	endX = 72,
	z = 0,
	y = 2.2, -- altura das criaturas sobre a esteira
	width = 10,
}

-- quiosques de ovos e loja de poções
MapConfig.EggKiosks = {
	basico = { x = -26, z = -26 },
	raro = { x = 0, z = -30 },
	lendario = { x = 26, z = -26 },
}
MapConfig.PotionShop = { x = 26, z = 28 }
MapConfig.EventBoard = { x = -26, z = 28 }

-- 6 bases: três ao norte (entrada virada para o sul) e três ao sul (entrada para o norte)
MapConfig.BaseSize = 72
MapConfig.Bases = {
	{ x = -120, z = -122, facing = 1 },
	{ x = 0, z = -122, facing = 1 },
	{ x = 120, z = -122, facing = 1 },
	{ x = -120, z = 122, facing = -1 },
	{ x = 0, z = 122, facing = -1 },
	{ x = 120, z = 122, facing = -1 },
}
MapConfig.BaseColors = {
	{ 90, 220, 110 },
	{ 80, 170, 255 },
	{ 255, 170, 60 },
	{ 230, 90, 200 },
	{ 255, 220, 70 },
	{ 150, 110, 255 },
}

-- coordenadas locais da base: +lz aponta para a entrada (para a praça)
MapConfig.PadColumns = 5
MapConfig.PadSpacing = 12
MapConfig.PadRowsZ = { -24, -12, 0, 12 } -- do fundo para a frente
MapConfig.Terminal = {
	collect = { lx = 14, lz = 28 },
	shield = { lx = -14, lz = 28 },
	spawn = { lx = 0, lz = 22 },
}

function MapConfig.toWorld(baseIndex, lx, lz)
	local b = MapConfig.Bases[baseIndex]
	return b.x + lx * b.facing, b.z + lz * b.facing
end

-- posição (x, z) do pedestal i (1..20)
function MapConfig.padPosition(baseIndex, i)
	local col = (i - 1) % MapConfig.PadColumns
	local row = math.floor((i - 1) / MapConfig.PadColumns) + 1
	local lx = (col - (MapConfig.PadColumns - 1) / 2) * MapConfig.PadSpacing
	local lz = MapConfig.PadRowsZ[row] or 0
	return MapConfig.toWorld(baseIndex, lx, lz)
end

-- índice da base em que o ponto (x, z) está, ou nil
function MapConfig.baseAt(x, z)
	local half = MapConfig.BaseSize / 2
	for i, b in ipairs(MapConfig.Bases) do
		if math.abs(x - b.x) <= half and math.abs(z - b.z) <= half then
			return i
		end
	end
	return nil
end

-- quem rouba entrega a criatura ao entrar na PRÓPRIA base
function MapConfig.inDelivery(baseIndex, x, z)
	return baseIndex ~= nil and MapConfig.baseAt(x, z) == baseIndex
end

return MapConfig
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000004"><Properties><string name="Name">ProgressConfig</string><ProtectedString name="Source"><![CDATA[-- ProgressConfig: missões diárias, presentes diários e marcos do índice.
-- Recompensas em moedas podem escalar com a renda do jogador:
--   coins = max(coins, rendaPorSegundo × 60 × incomeMinutes)
-- assim elas continuam valendo a pena no começo e no fim do jogo.

local ProgressConfig = {}

-- eventos de progresso emitidos pela lógica:
-- conveyorBuy, hatch, collect (quantidade = moedas), discover, sell, steal, defend, shield, upgrade, mutant
ProgressConfig.DailyMissionCount = 3
ProgressConfig.Missions = {
	{ id = "m_conveyor3", description = "Compre 3 criaturas na esteira", event = "conveyorBuy", target = 3, reward = { coins = 300, incomeMinutes = 4 } },
	{ id = "m_hatch3", description = "Abra 3 ovos", event = "hatch", target = 3, reward = { coins = 400, incomeMinutes = 5, potions = { sorte = 1 } } },
	{ id = "m_collect", description = "Colete 2.000 moedas na sua base", event = "collect", target = 2000, reward = { coins = 300, incomeMinutes = 3 } },
	{ id = "m_discover2", description = "Descubra 2 combinações novas no índice", event = "discover", target = 2, reward = { coins = 500, incomeMinutes = 5 } },
	{ id = "m_sell3", description = "Venda 3 criaturas", event = "sell", target = 3, reward = { coins = 200, incomeMinutes = 3 } },
	{ id = "m_steal1", description = "Roube 1 criatura e leve para sua base", event = "steal", target = 1, reward = { coins = 600, incomeMinutes = 6, potions = { velocidade = 1 } } },
	{ id = "m_defend1", description = "Pegue um ladrão na sua base", event = "defend", target = 1, reward = { coins = 600, incomeMinutes = 6, potions = { renda = 1 } } },
	{ id = "m_shield2", description = "Ative o escudo da base 2 vezes", event = "shield", target = 2, reward = { coins = 250, incomeMinutes = 3 } },
	{ id = "m_upgrade1", description = "Compre 1 melhoria da base", event = "upgrade", target = 1, reward = { coins = 400, incomeMinutes = 4 } },
	{ id = "m_mutant1", description = "Consiga 1 criatura mutante (não normal)", event = "mutant", target = 1, reward = { coins = 500, incomeMinutes = 5, potions = { sorte = 1 } } },
}
ProgressConfig.MissionById = {}
for _, m in ipairs(ProgressConfig.Missions) do
	ProgressConfig.MissionById[m.id] = m
end

-- presentes diários (sequência de 7 dias; perder um dia recomeça)
ProgressConfig.DailyGifts = {
	{ coins = 300, incomeMinutes = 5 },
	{ coins = 500, incomeMinutes = 8, potions = { velocidade = 1 } },
	{ coins = 800, incomeMinutes = 10, potions = { sorte = 1 } },
	{ coins = 1200, incomeMinutes = 12 },
	{ coins = 1800, incomeMinutes = 15, potions = { renda = 1 } },
	{ coins = 2500, incomeMinutes = 20, potions = { sorte = 1, velocidade = 1 } },
	{ coins = 5000, incomeMinutes = 30, potions = { sorte = 2, renda = 2 } },
}

-- marcos do índice: quantidade de combinações espécie × mutação descobertas
ProgressConfig.IndexMilestones = {
	{ id = "idx5", count = 5, reward = { coins = 500, potions = { sorte = 1 } } },
	{ id = "idx10", count = 10, reward = { coins = 2000, incomeMinutes = 10 } },
	{ id = "idx20", count = 20, reward = { coins = 8000, incomeMinutes = 20, potions = { sorte = 2 } } },
	{ id = "idx35", count = 35, reward = { coins = 40000, incomeMinutes = 30, potions = { renda = 2 } } },
	{ id = "idx50", count = 50, reward = { coins = 200000, incomeMinutes = 45, potions = { sorte = 3 } } },
	{ id = "idx70", count = 70, reward = { coins = 1000000, incomeMinutes = 60, potions = { sorte = 3, renda = 3 } } },
	{ id = "idx96", count = 96, reward = { coins = 10000000, incomeMinutes = 120, potions = { sorte = 5, renda = 5, velocidade = 5 } } },
}
ProgressConfig.MilestoneById = {}
for _, m in ipairs(ProgressConfig.IndexMilestones) do
	ProgressConfig.MilestoneById[m.id] = m
end

return ProgressConfig
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX000011"><Properties><string name="Name">Logic</string></Properties><Item class="ModuleScript" referent="RBX000006"><Properties><string name="Name">ClientView</string><ProtectedString name="Source"><![CDATA[-- ClientView: fotografia somente-leitura do perfil enviada ao cliente.
-- O cliente nunca envia valores econômicos; ele só mostra o que está aqui.

local Shared = script.Parent.Parent
local GameConfig = require(Shared.Config.GameConfig)
local ProgressConfig = require(Shared.Config.ProgressConfig)
local EventConfig = require(Shared.Config.EventConfig)
local ProfileOps = require(script.Parent.ProfileOps)
local ProfileSchema = require(script.Parent.ProfileSchema)
local Income = require(script.Parent.Income)

local ClientView = {}

local function eventInfo(e)
	if not e then
		return nil
	end
	return { id = e.id, name = e.name, icon = e.icon, kind = e.kind, description = e.description, startsAt = e.startsAt, endsAt = e.endsAt }
end

-- extra = { name, baseIndex, shieldUntil, carrying = { name, speciesId, mutationId, endsAt } }
function ClientView.build(profile, now, extra)
	extra = extra or {}
	ProfileOps.refreshPeriods(profile, now)
	local creatures = {}
	for uid, c in pairs(profile.creatures) do
		table.insert(creatures, {
			uid = uid,
			speciesId = c.s,
			mutationId = c.m,
			pad = c.pad,
			rate = Income.rate(profile, c),
			value = Income.value(c),
			sellPrice = Income.sellPrice(c),
			pending = Income.pending(profile, c, now),
			cap = Income.cap(profile, c),
			origin = c.origin,
			protectedUntil = c.protectedUntil,
		})
	end
	table.sort(creatures, function(a, b)
		return a.pad < b.pad
	end)

	local missions = {}
	for _, id in ipairs(profile.missions.list) do
		local def = ProgressConfig.MissionById[id]
		if def then
			table.insert(missions, {
				id = id,
				description = def.description,
				target = def.target,
				progress = profile.missions.progress[id] or 0,
				claimed = profile.missions.claimed[id] == true,
				rewardCoins = ProfileOps.rewardCoins(profile, def.reward),
				rewardPotions = def.reward.potions,
			})
		end
	end

	local milestones = {}
	local indexCount = ProfileOps.indexCount(profile)
	for _, m in ipairs(ProgressConfig.IndexMilestones) do
		table.insert(milestones, {
			id = m.id,
			count = m.count,
			claimed = profile.milestones[m.id] == true,
			ready = indexCount >= m.count,
			rewardCoins = ProfileOps.rewardCoins(profile, m.reward),
			rewardPotions = m.reward.potions,
		})
	end

	local upgrades = {}
	for _, id in ipairs(GameConfig.UpgradeOrder) do
		local u = GameConfig.Upgrades[id]
		local level = profile.upgrades[id] or 0
		table.insert(upgrades, {
			id = id,
			name = u.name,
			description = u.description,
			level = level,
			maxLevel = u.maxLevel,
			cost = level < u.maxLevel and GameConfig.upgradeCost(id, level) or nil,
		})
	end

	local gifts = ProfileOps.giftStatus(profile, now)
	local giftRewards = {}
	for i, g in ipairs(ProgressConfig.DailyGifts) do
		giftRewards[i] = { coins = ProfileOps.rewardCoins(profile, g), potions = g.potions }
	end
	local luck, luckSources = ProfileOps.luck(profile, now)
	local index = {}
	for k in pairs(profile.index) do
		index[k] = true
	end

	return {
		serverTime = now,
		name = extra.name,
		coins = profile.coins,
		netWorth = Income.netWorth(profile),
		rate = Income.totalRate(profile),
		boost = Income.currentBoost(profile, now),
		pending = Income.totalPending(profile, now),
		storageSeconds = Income.storageSeconds(profile),
		slots = ProfileSchema.slots(profile),
		creatures = creatures,
		upgrades = upgrades,
		potions = profile.potions,
		activePotions = profile.activePotions,
		luck = luck,
		luckSources = luckSources,
		index = index,
		indexCount = indexCount,
		indexTotal = #GameConfig.Species * #GameConfig.MutationOrder,
		milestones = milestones,
		missions = missions,
		missionsResetIn = gifts.resetsIn,
		gifts = gifts,
		giftRewards = giftRewards,
		rebirths = profile.rebirths,
		rebirth = ProfileOps.rebirthInfo(profile),
		incomeMultiplier = Income.multiplier(profile),
		shieldSeconds = ProfileOps.shieldSeconds(profile),
		stats = profile.stats,
		settings = profile.settings,
		baseIndex = extra.baseIndex,
		shieldUntil = extra.shieldUntil or 0,
		carrying = extra.carrying,
		event = eventInfo(EventConfig.at(now)),
		nextEvent = eventInfo(EventConfig.nextEvent(now)),
	}
end

return ClientView
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000007"><Properties><string name="Name">Income</string><ProtectedString name="Source"><![CDATA[-- Income: produção das criaturas calculada por horário (sem laço por segundo).
-- Cada criatura guarda moedas no próprio pedestal desde `since` até o limite do cofre.
-- Funciona igual online e offline: ao voltar, o jogador encontra o que foi produzido
-- (no máximo o tempo do cofre). Relógio voltando no tempo não gera moedas.

local Shared = script.Parent.Parent
local GameConfig = require(Shared.Config.GameConfig)
local EventConfig = require(Shared.Config.EventConfig)

local Income = {}

function Income.upgradeLevel(profile, id)
	return (profile.upgrades and profile.upgrades[id]) or 0
end

function Income.baseIncome(creature)
	local s = GameConfig.SpeciesById[creature.s]
	local m = GameConfig.Mutations[creature.m]
	if not s or not m then
		return 0
	end
	return s.income * m.mult
end

function Income.value(creature)
	local s = GameConfig.SpeciesById[creature.s]
	local m = GameConfig.Mutations[creature.m]
	if not s or not m then
		return 0
	end
	return s.price * m.mult
end

function Income.sellPrice(creature)
	return math.floor(Income.value(creature) * GameConfig.SellRate)
end

-- multiplicador permanente (renascimentos)
function Income.multiplier(profile)
	return 1 + (profile.rebirths or 0) * GameConfig.Rebirth.IncomeBonusPer
end

function Income.rate(profile, creature)
	return Income.baseIncome(creature) * Income.multiplier(profile)
end

function Income.storageSeconds(profile)
	return GameConfig.Base.StorageSeconds + Income.upgradeLevel(profile, "storage") * GameConfig.Upgrades.storage.perLevel
end

local function overlap(a1, a2, b1, b2)
	return math.max(0, math.min(a2, b2) - math.max(a1, b1))
end

-- segundos "efetivos" em [from, to] somando bônus de renda: poção de renda e evento "Renda em Dobro"
function Income.boostedSeconds(profile, from, to)
	local secs = to - from
	if secs <= 0 then
		return 0
	end
	local potionEnd = (profile.activePotions and profile.activePotions.renda) or 0
	if potionEnd > from then
		local potionStart = (profile.potionStarts and profile.potionStarts.renda) or from
		secs = secs + overlap(from, to, potionStart, potionEnd) * (GameConfig.Potions.renda.incomeMult - 1)
	end
	for _, w in ipairs(EventConfig.windows(from, to, "income")) do
		secs = secs + overlap(from, to, w.startsAt, w.endsAt) * (w.incomeMult - 1)
	end
	return secs
end

-- multiplicador de renda neste instante (para mostrar na interface)
function Income.currentBoost(profile, now)
	local mult = 1
	if profile.activePotions and (profile.activePotions.renda or 0) > now then
		mult = mult + (GameConfig.Potions.renda.incomeMult - 1)
	end
	local ev = EventConfig.at(now)
	if ev and ev.kind == "income" then
		mult = mult + (ev.incomeMult - 1)
	end
	return mult
end

-- moedas guardadas no pedestal desta criatura agora
function Income.pending(profile, creature, now)
	local since = creature.since or now
	if now <= since then
		return math.min(creature.banked or 0, Income.cap(profile, creature))
	end
	local rate = Income.rate(profile, creature)
	local storage = Income.storageSeconds(profile)
	local cap = rate * storage
	-- depois de `storage` segundos efetivos o cofre já está cheio: limita a janela
	local produced = (creature.banked or 0) + rate * Income.boostedSeconds(profile, since, math.min(now, since + storage))
	return math.min(cap, produced)
end

-- guarda o valor produzido até agora e recomeça a contagem (antes de mudar regras de renda)
function Income.bank(profile, creature, now)
	creature.banked = Income.pending(profile, creature, now)
	creature.since = now
end

function Income.cap(profile, creature)
	return Income.rate(profile, creature) * Income.storageSeconds(profile)
end

function Income.totalPending(profile, now)
	local sum = 0
	for _, c in pairs(profile.creatures) do
		sum = sum + Income.pending(profile, c, now)
	end
	return sum
end

-- renda por segundo (sem bônus temporários)
function Income.totalRate(profile)
	local sum = 0
	for _, c in pairs(profile.creatures) do
		sum = sum + Income.rate(profile, c)
	end
	return sum
end

function Income.netWorth(profile)
	local v = profile.coins
	for _, c in pairs(profile.creatures) do
		v = v + Income.value(c)
	end
	return v
end

return Income
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000008"><Properties><string name="Name">Odds</string><ProtectedString name="Source"><![CDATA[-- Odds: tabelas de chance de espécies e mutações (com sorte e eventos).
-- O servidor sorteia com estas funções; o cliente usa as MESMAS para exibir as chances.

local Shared = script.Parent.Parent
local GameConfig = require(Shared.Config.GameConfig)

local Odds = {}

local function clampLuck(luck)
	return math.max(0, math.min(luck or 0, GameConfig.Luck.Max))
end

-- rarityWeights = { Common = n, ... } (de um ovo ou da esteira)
-- Retorna lista { speciesId, rarity, p } (soma 1). O peso de uma raridade é dividido
-- igualmente entre as espécies daquela raridade.
function Odds.speciesTable(rarityWeights, luck)
	luck = clampLuck(luck)
	local byRarity = {}
	for _, s in ipairs(GameConfig.Species) do
		byRarity[s.rarity] = byRarity[s.rarity] or {}
		table.insert(byRarity[s.rarity], s)
	end
	local entries, total = {}, 0
	for _, rid in ipairs(GameConfig.RarityOrder) do
		local w = rarityWeights[rid]
		local list = byRarity[rid]
		if w and w > 0 and list then
			local tier = GameConfig.tier(rid)
			local scaled = w * (1 + luck * (GameConfig.Luck.RarityScale[tier] or 0))
			for _, s in ipairs(list) do
				local ew = scaled / #list
				total = total + ew
				table.insert(entries, { speciesId = s.id, rarity = rid, weight = ew, p = 0 })
			end
		end
	end
	assert(total > 0, "tabela de espécies vazia")
	for _, e in ipairs(entries) do
		e.p = e.weight / total
	end
	return entries
end

-- event (opcional) = evento ativo (EventConfig.at); kind "mutation" multiplica o peso de uma mutação
function Odds.mutationTable(luck, event)
	luck = clampLuck(luck)
	local entries, total = {}, 0
	for _, mid in ipairs(GameConfig.MutationOrder) do
		local m = GameConfig.Mutations[mid]
		local w = m.weight * (1 + luck * (GameConfig.Luck.MutationScale[m.tier] or 0))
		if event and event.kind == "mutation" and event.mutation == mid then
			w = w * event.weightMult
		end
		total = total + w
		table.insert(entries, { mutationId = mid, weight = w, p = 0 })
	end
	for _, e in ipairs(entries) do
		e.p = e.weight / total
	end
	return entries
end

function Odds.pick(entries, r)
	local acc = 0
	for _, e in ipairs(entries) do
		acc = acc + e.p
		if r < acc then
			return e
		end
	end
	return entries[#entries]
end

-- chance agregada por raridade
function Odds.byRarity(entries)
	local out = {}
	for _, e in ipairs(entries) do
		out[e.rarity] = (out[e.rarity] or 0) + e.p
	end
	return out
end

-- percentuais arredondados que somam exatamente 100 (método do maior resto)
function Odds.displayPercents(entries, decimals)
	decimals = decimals or 2
	local unit = 10 ^ decimals
	local totalUnits = math.floor(100 * unit + 0.5)
	local floors, rems, used = {}, {}, 0
	for i, e in ipairs(entries) do
		local exact = e.p * 100 * unit
		floors[i] = math.floor(exact)
		rems[i] = { i = i, r = exact - floors[i] }
		used = used + floors[i]
	end
	table.sort(rems, function(a, b)
		if a.r == b.r then
			return a.i < b.i
		end
		return a.r > b.r
	end)
	local k = 1
	while used < totalUnits and #rems > 0 do
		floors[rems[k].i] = floors[rems[k].i] + 1
		used = used + 1
		k = (k % #rems) + 1
	end
	local out = {}
	for i = 1, #entries do
		out[i] = floors[i] / unit
	end
	return out
end

-- valor esperado (em moedas) de um ovo, sem sorte
function Odds.expectedEggValue(egg, luck, event)
	local sp = Odds.speciesTable(egg.rarityWeights, luck)
	local mu = Odds.mutationTable(luck, event)
	local avgMult = 0
	for _, e in ipairs(mu) do
		avgMult = avgMult + e.p * GameConfig.Mutations[e.mutationId].mult
	end
	local ev = 0
	for _, e in ipairs(sp) do
		ev = ev + e.p * GameConfig.SpeciesById[e.speciesId].price
	end
	return ev * avgMult
end

return Odds
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000009"><Properties><string name="Name">ProfileOps</string><ProtectedString name="Source"><![CDATA[-- ProfileOps: TODAS as operações que alteram o perfil.
-- Regra: valida tudo antes de alterar qualquer coisa; nenhuma função espera (yield).
-- Retornam (true, dados) ou (false, códigoDeErro). Sorteios usam ctx.rng (servidor).
--
-- ctx = { now = horárioDoServidor, rng = function() -> [0,1), locked = { [uid] = true } }
-- `locked` marca criaturas que estão sendo carregadas por um ladrão neste momento.

local Shared = script.Parent.Parent
local GameConfig = require(Shared.Config.GameConfig)
local ProgressConfig = require(Shared.Config.ProgressConfig)
local EventConfig = require(Shared.Config.EventConfig)
local ProfileSchema = require(script.Parent.ProfileSchema)
local Income = require(script.Parent.Income)
local Odds = require(script.Parent.Odds)
local TimeUtil = require(Shared.Util.TimeUtil)

local ProfileOps = {}

ProfileOps.Messages = {
	insufficient_coins = "Moedas insuficientes.",
	base_full = "Sua base está cheia. Venda uma criatura ou compre mais pedestais.",
	invalid_creature = "Criatura não encontrada.",
	invalid_egg = "Ovo inválido.",
	egg_locked = "Esse ovo libera depois do primeiro renascimento.",
	invalid_upgrade = "Melhoria inválida.",
	max_level = "Já está no nível máximo.",
	valuable_locked = "Criatura valiosa: confirme a venda.",
	being_stolen = "Essa criatura está sendo carregada agora.",
	nothing_to_collect = "Nada para coletar ainda.",
	invalid_potion = "Poção inválida.",
	no_potion = "Você não tem essa poção.",
	potion_max = "Tempo máximo acumulado dessa poção.",
	already_claimed = "Já resgatado.",
	not_ready = "Ainda não concluído.",
	invalid_mission = "Missão inválida.",
	confirmation_required = "Digite a frase de confirmação.",
	rebirth_locked = "Moedas insuficientes para renascer.",
	rebirth_max = "Número máximo de renascimentos.",
	protected = "Essa criatura foi roubada há pouco e está protegida.",
	offer_gone = "Outra pessoa comprou essa criatura primeiro.",
	invalid_request = "Pedido inválido.",
}

local function fail(code)
	return false, code
end

local function addCoins(profile, n)
	profile.coins = math.max(0, math.min(GameConfig.MaxCoins, math.floor(profile.coins + n)))
end

---------------------------------------------------------------------------
-- missões (seleção diária determinística: todos recebem as mesmas no mesmo dia)
---------------------------------------------------------------------------

local function pickMissions(dayIndex)
	local pool = ProgressConfig.Missions
	local idx = {}
	for i = 1, #pool do
		idx[i] = i
	end
	local state = (math.floor(dayIndex) % 2147483646) + 1
	for i = #idx, 2, -1 do
		state = (state * 16807) % 2147483647
		local j = (state % i) + 1
		idx[i], idx[j] = idx[j], idx[i]
	end
	local out = {}
	for i = 1, math.min(ProgressConfig.DailyMissionCount, #idx) do
		table.insert(out, pool[idx[i]].id)
	end
	return out
end
ProfileOps.pickMissions = pickMissions

function ProfileOps.refreshPeriods(profile, now)
	local day = TimeUtil.dayIndex(now)
	local m = profile.missions
	if m.day ~= day then
		profile.missions = { day = day, list = pickMissions(day), progress = {}, claimed = {} }
	end
end

function ProfileOps.emit(profile, now, eventName, amount)
	ProfileOps.refreshPeriods(profile, now)
	local m = profile.missions
	for _, id in ipairs(m.list) do
		local def = ProgressConfig.MissionById[id]
		if def and def.event == eventName and not m.claimed[id] then
			m.progress[id] = math.min(def.target, (m.progress[id] or 0) + (amount or 1))
		end
	end
end

---------------------------------------------------------------------------
-- sorte
---------------------------------------------------------------------------

-- retorna (sorteTotal, fontes)
function ProfileOps.luck(profile, now)
	local list = {}
	local rb = math.min((profile.rebirths or 0) * GameConfig.Rebirth.LuckPer, GameConfig.Rebirth.LuckMax)
	if rb > 0 then
		table.insert(list, { name = "Renascimentos", luck = rb })
	end
	if (profile.activePotions.sorte or 0) > now then
		table.insert(list, { name = GameConfig.Potions.sorte.name, luck = GameConfig.Potions.sorte.luck, endsAt = profile.activePotions.sorte })
	end
	local ev = EventConfig.at(now)
	if ev and ev.kind == "luck" then
		table.insert(list, { name = ev.name, luck = ev.luck, endsAt = ev.endsAt })
	end
	local total = 0
	for _, e in ipairs(list) do
		total = total + e.luck
	end
	return math.min(total, GameConfig.Luck.Max), list
end

---------------------------------------------------------------------------
-- criaturas
---------------------------------------------------------------------------

local function indexKey(s, m)
	return s .. ":" .. m
end
ProfileOps.indexKey = indexKey

function ProfileOps.indexCount(profile)
	local n = 0
	for _ in pairs(profile.index) do
		n = n + 1
	end
	return n
end

-- adiciona uma criatura (a vaga já foi validada por quem chamou)
local function addCreature(profile, now, speciesId, mutationId, origin)
	local pad = ProfileSchema.freePad(profile)
	local uid = "c" .. tostring(profile.nextUid)
	profile.nextUid = profile.nextUid + 1
	local c = { uid = uid, s = speciesId, m = mutationId, pad = pad, since = now, at = now, origin = origin }
	profile.creatures[uid] = c
	local key = indexKey(speciesId, mutationId)
	local isNew = profile.index[key] == nil
	if isNew then
		profile.index[key] = now
		ProfileOps.emit(profile, now, "discover", 1)
	end
	if mutationId ~= "normal" then
		ProfileOps.emit(profile, now, "mutant", 1)
	end
	return c, isNew
end

function ProfileOps.canReceive(profile)
	return ProfileSchema.freePad(profile) ~= nil
end

-- compra uma criatura da esteira. offer = { speciesId, mutationId, price } (definido pelo SERVIDOR)
function ProfileOps.buyFromConveyor(profile, ctx, offer)
	if type(offer) ~= "table" or not GameConfig.SpeciesById[offer.speciesId] or not GameConfig.Mutations[offer.mutationId] then
		return fail("invalid_request")
	end
	if not ProfileOps.canReceive(profile) then
		return fail("base_full")
	end
	if profile.coins < offer.price then
		return fail("insufficient_coins")
	end
	addCoins(profile, -offer.price)
	local c, isNew = addCreature(profile, ctx.now, offer.speciesId, offer.mutationId, "conveyor")
	profile.stats.conveyorBought = profile.stats.conveyorBought + 1
	ProfileOps.emit(profile, ctx.now, "conveyorBuy", 1)
	return true, { creature = c, isNew = isNew, cost = offer.price }
end

-- sorteia uma criatura da esteira (sorte do evento; a esteira é de todos)
function ProfileOps.rollConveyor(now, r1, r2)
	local ev = EventConfig.at(now)
	local luck = 0
	if ev and (ev.kind == "luck" or ev.kind == "conveyor") then
		luck = ev.luck or 0
	end
	local sp = Odds.pick(Odds.speciesTable(GameConfig.Conveyor.RarityWeights, luck), r1)
	local mu = Odds.pick(Odds.mutationTable(luck, ev), r2)
	local s = GameConfig.SpeciesById[sp.speciesId]
	local mult = GameConfig.Mutations[mu.mutationId].mult
	return { speciesId = sp.speciesId, mutationId = mu.mutationId, price = s.price * mult }
end

-- tabelas de chance de um ovo para este jogador agora (usadas também pela interface)
function ProfileOps.eggOdds(profile, eggId, now)
	local egg = GameConfig.Eggs[eggId]
	local luck = ProfileOps.luck(profile, now)
	local ev = EventConfig.at(now)
	return Odds.speciesTable(egg.rarityWeights, luck), Odds.mutationTable(luck, ev), luck
end

function ProfileOps.hatchEgg(profile, ctx, eggId)
	local egg = GameConfig.Eggs[eggId]
	if not egg then
		return fail("invalid_egg")
	end
	if (profile.rebirths or 0) < egg.requiredRebirths then
		return fail("egg_locked")
	end
	if not ProfileOps.canReceive(profile) then
		return fail("base_full")
	end
	if profile.coins < egg.price then
		return fail("insufficient_coins")
	end
	local species, mutations, luck = ProfileOps.eggOdds(profile, eggId, ctx.now)
	local sp = Odds.pick(species, ctx.rng())
	local mu = Odds.pick(mutations, ctx.rng())
	addCoins(profile, -egg.price)
	local c, isNew = addCreature(profile, ctx.now, sp.speciesId, mu.mutationId, "egg")
	profile.stats.hatched = profile.stats.hatched + 1
	ProfileOps.emit(profile, ctx.now, "hatch", 1)
	return true, { creature = c, isNew = isNew, cost = egg.price, luck = luck }
end

-- vender: coleta o que estava guardado no pedestal e paga 50% do valor
function ProfileOps.sell(profile, ctx, uid, confirmValuable)
	local c = profile.creatures[uid]
	if not c then
		return fail("invalid_creature")
	end
	if ctx.locked and ctx.locked[uid] then
		return fail("being_stolen")
	end
	local s = GameConfig.SpeciesById[c.s]
	if GameConfig.tier(s.rarity) >= GameConfig.ValuableConfirmTier and confirmValuable ~= true then
		return fail("valuable_locked")
	end
	local pending = math.floor(Income.pending(profile, c, ctx.now))
	local price = Income.sellPrice(c)
	profile.creatures[uid] = nil
	addCoins(profile, price + pending)
	profile.stats.sold = profile.stats.sold + 1
	profile.stats.coinsCollected = profile.stats.coinsCollected + pending
	ProfileOps.emit(profile, ctx.now, "sell", 1)
	return true, { coins = price, collected = pending }
end

-- coleta o que todas as criaturas guardaram
function ProfileOps.collectAll(profile, ctx)
	local total = 0
	for _, c in pairs(profile.creatures) do
		total = total + Income.pending(profile, c, ctx.now)
	end
	local amount = math.floor(total)
	if amount <= 0 then
		return fail("nothing_to_collect")
	end
	for _, c in pairs(profile.creatures) do
		c.since = ctx.now
		c.banked = 0
	end
	addCoins(profile, amount)
	profile.stats.coinsCollected = profile.stats.coinsCollected + amount
	ProfileOps.emit(profile, ctx.now, "collect", amount)
	return true, { coins = amount }
end

-- move uma criatura para outro pedestal livre (organização da base)
function ProfileOps.movePad(profile, ctx, uid, pad)
	local c = profile.creatures[uid]
	if not c then
		return fail("invalid_creature")
	end
	if type(pad) ~= "number" or pad < 1 or pad > ProfileSchema.slots(profile) or pad ~= math.floor(pad) then
		return fail("invalid_request")
	end
	for _, other in pairs(profile.creatures) do
		if other.pad == pad and other ~= c then
			other.pad = c.pad -- troca de lugar
		end
	end
	c.pad = pad
	return true, {}
end

---------------------------------------------------------------------------
-- melhorias e poções
---------------------------------------------------------------------------

function ProfileOps.buyUpgrade(profile, ctx, id)
	local u = GameConfig.Upgrades[id]
	if not u then
		return fail("invalid_upgrade")
	end
	local level = profile.upgrades[id] or 0
	if level >= u.maxLevel then
		return fail("max_level")
	end
	local cost = GameConfig.upgradeCost(id, level)
	if profile.coins < cost then
		return fail("insufficient_coins")
	end
	if id == "storage" then
		-- guarda a produção com o cofre antigo antes de aumentar
		for _, c in pairs(profile.creatures) do
			Income.bank(profile, c, ctx.now)
		end
	end
	addCoins(profile, -cost)
	profile.upgrades[id] = level + 1
	ProfileOps.emit(profile, ctx.now, "upgrade", 1)
	return true, { id = id, level = level + 1, cost = cost }
end

function ProfileOps.shieldSeconds(profile)
	return GameConfig.Base.ShieldSeconds + (profile.upgrades.shield or 0) * GameConfig.Upgrades.shield.perLevel
end

function ProfileOps.walkSpeed(profile, now, carrying)
	local speed = GameConfig.Base.WalkSpeed + (profile.upgrades.speed or 0) * GameConfig.Upgrades.speed.perLevel
	if (profile.activePotions.velocidade or 0) > now then
		speed = speed + GameConfig.Potions.velocidade.speed
	end
	if carrying then
		speed = speed - GameConfig.Steal.CarrySpeedPenalty
	end
	return speed
end

function ProfileOps.buyPotion(profile, ctx, id)
	local p = GameConfig.Potions[id]
	if not p then
		return fail("invalid_potion")
	end
	if profile.coins < p.coinPrice then
		return fail("insufficient_coins")
	end
	addCoins(profile, -p.coinPrice)
	profile.potions[id] = (profile.potions[id] or 0) + 1
	return true, { id = id }
end

function ProfileOps.activatePotion(profile, ctx, id)
	local p = GameConfig.Potions[id]
	if not p then
		return fail("invalid_potion")
	end
	if (profile.potions[id] or 0) <= 0 then
		return fail("no_potion")
	end
	local current = math.max(ctx.now, profile.activePotions[id] or 0)
	if current - ctx.now >= p.maxStack then
		return fail("potion_max")
	end
	if id == "renda" then
		-- a poção vale a partir de agora: a produção anterior fica guardada como está
		for _, c in pairs(profile.creatures) do
			Income.bank(profile, c, ctx.now)
		end
	end
	if (profile.activePotions[id] or 0) <= ctx.now or not profile.potionStarts[id] then
		profile.potionStarts[id] = ctx.now
	end
	profile.potions[id] = profile.potions[id] - 1
	profile.activePotions[id] = math.min(current + p.duration, ctx.now + p.maxStack)
	return true, { id = id, endsAt = profile.activePotions[id] }
end

---------------------------------------------------------------------------
-- recompensas
---------------------------------------------------------------------------

function ProfileOps.rewardCoins(profile, reward)
	local coins = reward.coins or 0
	if reward.incomeMinutes then
		coins = math.max(coins, math.floor(Income.totalRate(profile) * 60 * reward.incomeMinutes))
	end
	return coins
end

function ProfileOps.grantReward(profile, reward)
	local summary = { coins = 0, potions = {} }
	local coins = ProfileOps.rewardCoins(profile, reward)
	if coins > 0 then
		addCoins(profile, coins)
		summary.coins = coins
	end
	for id, n in pairs(reward.potions or {}) do
		if GameConfig.Potions[id] then
			profile.potions[id] = (profile.potions[id] or 0) + n
			summary.potions[id] = n
		end
	end
	return summary
end

function ProfileOps.claimMission(profile, ctx, id)
	ProfileOps.refreshPeriods(profile, ctx.now)
	local m = profile.missions
	local def = ProgressConfig.MissionById[id]
	if not def or not table.find(m.list, id) then
		return fail("invalid_mission")
	end
	if m.claimed[id] then
		return fail("already_claimed")
	end
	if (m.progress[id] or 0) < def.target then
		return fail("not_ready")
	end
	m.claimed[id] = true
	return true, { reward = ProfileOps.grantReward(profile, def.reward) }
end

function ProfileOps.giftStatus(profile, now)
	local day = TimeUtil.dayIndex(now)
	local g = profile.gifts
	local nextStreak = 1
	if g.lastDay == day - 1 then
		nextStreak = (g.streak % #ProgressConfig.DailyGifts) + 1
	elseif g.lastDay == day then
		nextStreak = g.streak
	end
	return { available = g.lastDay ~= day, streak = g.streak, nextStreak = nextStreak, resetsIn = TimeUtil.secondsUntilNextDay(now) }
end

function ProfileOps.claimGift(profile, ctx)
	local st = ProfileOps.giftStatus(profile, ctx.now)
	if not st.available then
		return fail("already_claimed")
	end
	profile.gifts.lastDay = TimeUtil.dayIndex(ctx.now)
	profile.gifts.streak = st.nextStreak
	return true, { day = st.nextStreak, reward = ProfileOps.grantReward(profile, ProgressConfig.DailyGifts[st.nextStreak]) }
end

function ProfileOps.claimMilestone(profile, ctx, id)
	local def = ProgressConfig.MilestoneById[id]
	if not def then
		return fail("invalid_request")
	end
	if profile.milestones[id] then
		return fail("already_claimed")
	end
	if ProfileOps.indexCount(profile) < def.count then
		return fail("not_ready")
	end
	profile.milestones[id] = true
	return true, { reward = ProfileOps.grantReward(profile, def.reward) }
end

---------------------------------------------------------------------------
-- roubo (transferência atômica entre dois perfis no MESMO servidor)
---------------------------------------------------------------------------

-- pode pegar? (validação antes de começar a carregar)
function ProfileOps.canSteal(victim, thief, uid, now)
	local c = victim.creatures[uid]
	if not c then
		return false, "invalid_creature"
	end
	if (c.protectedUntil or 0) > now then
		return false, "protected"
	end
	if not ProfileOps.canReceive(thief) then
		return false, "base_full"
	end
	return true
end

-- entrega: remove da vítima (pagando a ela o que estava guardado) e entrega ao ladrão.
-- Valida tudo antes de alterar os dois perfis.
function ProfileOps.completeSteal(victim, thief, uid, now)
	local ok, code = ProfileOps.canSteal(victim, thief, uid, now)
	if not ok then
		return false, code
	end
	local c = victim.creatures[uid]
	local pending = math.floor(Income.pending(victim, c, now))
	victim.creatures[uid] = nil
	addCoins(victim, pending)
	victim.stats.lostToThieves = victim.stats.lostToThieves + 1
	local nc, isNew = addCreature(thief, now, c.s, c.m, "stolen")
	nc.protectedUntil = now + GameConfig.Steal.ProtectAfterSteal
	thief.stats.stolen = thief.stats.stolen + 1
	ProfileOps.emit(thief, now, "steal", 1)
	return true, { creature = nc, isNew = isNew, victimCollected = pending }
end

function ProfileOps.recordDefense(profile, now)
	profile.stats.defended = profile.stats.defended + 1
	ProfileOps.emit(profile, now, "defend", 1)
end

function ProfileOps.recordShield(profile, now)
	ProfileOps.emit(profile, now, "shield", 1)
end

---------------------------------------------------------------------------
-- renascimento: troca moedas e criaturas por bônus permanentes
---------------------------------------------------------------------------

function ProfileOps.rebirthInfo(profile)
	local n = (profile.rebirths or 0) + 1
	local R = GameConfig.Rebirth
	return {
		next = n,
		cost = GameConfig.rebirthCost(n),
		maxed = (profile.rebirths or 0) >= R.MaxRebirths,
		incomeAfter = 1 + n * R.IncomeBonusPer,
		luckAfter = math.min(n * R.LuckPer, R.LuckMax),
		creaturesLost = ProfileSchema.creatureCount(profile),
	}
end

function ProfileOps.rebirth(profile, ctx, phrase)
	if phrase ~= GameConfig.Rebirth.ConfirmPhrase then
		return fail("confirmation_required")
	end
	local info = ProfileOps.rebirthInfo(profile)
	if info.maxed then
		return fail("rebirth_max")
	end
	if profile.coins < info.cost then
		return fail("rebirth_locked")
	end
	for uid in pairs(profile.creatures) do
		if ctx.locked and ctx.locked[uid] then
			return fail("being_stolen")
		end
	end
	profile.creatures = {}
	profile.coins = GameConfig.StartingCoins
	profile.rebirths = info.next
	return true, { rebirths = info.next }
end

function ProfileOps.setSetting(profile, key, value)
	if key ~= "reduceEffects" or type(value) ~= "boolean" then
		return fail("invalid_request")
	end
	profile.settings[key] = value
	return true, {}
end

return ProfileOps
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000010"><Properties><string name="Name">ProfileSchema</string><ProtectedString name="Source"><![CDATA[-- ProfileSchema: formato do perfil salvo, migração e validação de integridade.
-- Um único documento por jogador => compra, venda, coleta e roubo são atômicos.

local Shared = script.Parent.Parent
local GameConfig = require(Shared.Config.GameConfig)

local ProfileSchema = {}

ProfileSchema.Version = 1

function ProfileSchema.new(now)
	return {
		version = ProfileSchema.Version,
		createdAt = now,
		coins = GameConfig.StartingCoins,
		creatures = {}, -- [uid] = { uid, s (espécie), m (mutação), pad, since, at, origin, protectedUntil }
		nextUid = 1,
		upgrades = { slots = 0, storage = 0, shield = 0, speed = 0 },
		potions = { sorte = 0, renda = 0, velocidade = 0 },
		activePotions = {}, -- [id] = horário em que termina
		potionStarts = {}, -- [id] = início da ativação contínua atual (renda exata por período)
		index = {}, -- ["especie:mutacao"] = horário da descoberta
		missions = { day = -1, list = {}, progress = {}, claimed = {} },
		gifts = { lastDay = -1, streak = 0 },
		milestones = {},
		rebirths = 0,
		stats = {
			conveyorBought = 0,
			hatched = 0,
			stolen = 0,
			defended = 0,
			lostToThieves = 0,
			coinsCollected = 0,
			sold = 0,
		},
		settings = { reduceEffects = false },
	}
end

local function isNumber(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- completa campos que faltam (perfis antigos ou corrompidos)
function ProfileSchema.migrate(profile, now)
	local fresh = ProfileSchema.new(now)
	for k, v in pairs(fresh) do
		if profile[k] == nil or type(profile[k]) ~= type(v) then
			profile[k] = v
		end
	end
	for _, group in ipairs({ "upgrades", "potions", "stats", "settings" }) do
		for k, v in pairs(fresh[group]) do
			if type(profile[group][k]) ~= type(v) then
				profile[group][k] = v
			end
		end
	end
	for _, k in ipairs({ "list", "progress", "claimed" }) do
		if type(profile.missions[k]) ~= "table" then
			profile.missions[k] = {}
		end
	end
	profile.version = ProfileSchema.Version
	return profile
end

function ProfileSchema.slots(profile)
	return GameConfig.Base.StartSlots + (profile.upgrades.slots or 0) * GameConfig.Upgrades.slots.perLevel
end

-- corrige valores impossíveis; retorna a lista de problemas encontrados
function ProfileSchema.validate(profile, now)
	local issues = {}
	if not isNumber(profile.coins) or profile.coins < 0 then
		table.insert(issues, "moedas inválidas")
		profile.coins = 0
	end
	profile.coins = math.min(math.floor(profile.coins), GameConfig.MaxCoins)
	for id, u in pairs(GameConfig.Upgrades) do
		local l = profile.upgrades[id]
		if not isNumber(l) or l < 0 or l > u.maxLevel then
			table.insert(issues, "melhoria " .. id)
			profile.upgrades[id] = math.max(0, math.min(u.maxLevel, math.floor(isNumber(l) and l or 0)))
		end
	end
	for id in pairs(GameConfig.Potions) do
		local n = profile.potions[id]
		if not isNumber(n) or n < 0 then
			profile.potions[id] = 0
			table.insert(issues, "poção " .. id)
		end
	end
	if not isNumber(profile.rebirths) or profile.rebirths < 0 then
		profile.rebirths = 0
		table.insert(issues, "renascimentos")
	end
	-- criaturas: espécie/mutação existentes, pedestal único dentro das vagas, horários válidos
	local slots = ProfileSchema.slots(profile)
	local usedPads = {}
	local list = {}
	for uid, c in pairs(profile.creatures) do
		if type(c) ~= "table" or not GameConfig.SpeciesById[c.s] or not GameConfig.Mutations[c.m] then
			table.insert(issues, "criatura inválida " .. tostring(uid))
			profile.creatures[uid] = nil
		else
			c.uid = uid
			if not isNumber(c.since) or c.since > now + 60 then
				c.since = now
			end
			if c.banked ~= nil and (not isNumber(c.banked) or c.banked < 0) then
				c.banked = 0
			end
			table.insert(list, c)
		end
	end
	table.sort(list, function(a, b)
		return (a.at or 0) < (b.at or 0)
	end)
	local overflow = {}
	for _, c in ipairs(list) do
		if isNumber(c.pad) and c.pad >= 1 and c.pad <= slots and not usedPads[c.pad] then
			usedPads[c.pad] = true
		else
			table.insert(overflow, c)
		end
	end
	for _, c in ipairs(overflow) do
		local free = nil
		for i = 1, slots do
			if not usedPads[i] then
				free = i
				break
			end
		end
		if free then
			c.pad = free
			usedPads[free] = true
		else
			-- mais criaturas que vagas (não deveria acontecer): vende pelo valor normal
			profile.creatures[c.uid] = nil
			local s = GameConfig.SpeciesById[c.s]
			profile.coins = profile.coins + math.floor(s.price * GameConfig.Mutations[c.m].mult * GameConfig.SellRate)
			table.insert(issues, "criatura sem vaga vendida " .. c.uid)
		end
	end
	if not isNumber(profile.nextUid) or profile.nextUid < 1 then
		profile.nextUid = 1
	end
	for uid in pairs(profile.creatures) do
		local n = tonumber(string.match(uid, "^c(%d+)$") or "")
		if n and n >= profile.nextUid then
			profile.nextUid = n + 1
		end
	end
	return issues
end

function ProfileSchema.creatureCount(profile)
	local n = 0
	for _ in pairs(profile.creatures) do
		n = n + 1
	end
	return n
end

function ProfileSchema.freePad(profile)
	local used = {}
	for _, c in pairs(profile.creatures) do
		used[c.pad] = true
	end
	for i = 1, ProfileSchema.slots(profile) do
		if not used[i] then
			return i
		end
	end
	return nil
end

return ProfileSchema
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX000013"><Properties><string name="Name">Net</string></Properties><Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">RemoteNames</string><ProtectedString name="Source"><![CDATA[-- RemoteNames: remotes criados pelo servidor em ReplicatedStorage.Remotes.

return {
	Functions = {
		"RequestData", -- fotografia completa do perfil
		"EggAction", -- abrir ovo, comprar/usar poção
		"BaseAction", -- coletar, vender, melhorias, escudo, mover criatura
		"ClaimAction", -- missões, presente diário, marcos do índice, renascer
		"SettingsAction", -- ajustes
		"RankingRequest", -- ranking do servidor
	},
	Events = {
		"DataUpdated", -- servidor -> cliente: nova fotografia
		"Notify", -- avisos (roubo em andamento, ladrão pego, compras na esteira, eventos)
	},
}
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX000016"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX000014"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[-- Format: formatação de números e tempo para a interface.

local Format = {}

local function groupDigits(intStr)
	local out = intStr
	local k
	repeat
		out, k = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1.%2")
	until k == 0
	return out
end

-- 1234567 -> "1.234.567"
function Format.int(n)
	n = math.floor((n or 0) + 0.5)
	return groupDigits(string.format("%.0f", n))
end

-- 1234567 -> "1,23 mi" (abreviado, padrão brasileiro)
function Format.short(n)
	n = n or 0
	local abs = math.abs(n)
	local suffixes = {
		{ 1e12, " tri" },
		{ 1e9, " bi" },
		{ 1e6, " mi" },
		{ 1e3, " mil" },
	}
	for _, s in ipairs(suffixes) do
		if abs >= s[1] then
			local v = n / s[1]
			local str = string.format("%.2f", v)
			str = string.gsub(str, "%.?0+$", "")
			str = string.gsub(str, "%.", ",")
			return str .. s[2]
		end
	end
	return Format.int(n)
end

function Format.credits(n)
	return "$ " .. Format.short(n)
end

-- 0.0123 -> "1,230%" (3 casas)
function Format.percent(p, decimals)
	decimals = decimals or 3
	local str = string.format("%." .. decimals .. "f", p * 100)
	str = string.gsub(str, "%.", ",")
	return str .. "%"
end

function Format.rate(perSecond)
	local str = string.format("%.2f", perSecond)
	str = string.gsub(str, "%.", ",")
	return str .. "/s"
end

function Format.duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	local d = math.floor(seconds / 86400)
	local h = math.floor((seconds % 86400) / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if d > 0 then
		return d .. "d " .. h .. "h"
	elseif h > 0 then
		return h .. "h " .. m .. "min"
	elseif m > 0 then
		return m .. "min " .. s .. "s"
	end
	return s .. "s"
end

return Format
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000015"><Properties><string name="Name">TimeUtil</string><ProtectedString name="Source"><![CDATA[-- TimeUtil: dias e semanas em UTC. Sempre alimentado pelo relógio do SERVIDOR.

local TimeUtil = {}

local DAY = 86400
local WEEK = 604800
local MONDAY_EPOCH = 345600 -- 1970-01-05 00:00 UTC (segunda-feira)

function TimeUtil.dayIndex(now)
	return math.floor(now / DAY)
end

function TimeUtil.weekIndex(now)
	return math.floor((now - MONDAY_EPOCH) / WEEK)
end

function TimeUtil.secondsUntilNextDay(now)
	return (TimeUtil.dayIndex(now) + 1) * DAY - now
end

function TimeUtil.secondsUntilNextWeek(now)
	return MONDAY_EPOCH + (TimeUtil.weekIndex(now) + 1) * WEEK - now
end

return TimeUtil
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX000018"><Properties><string name="Name">Visual</string></Properties><Item class="ModuleScript" referent="RBX000017"><Properties><string name="Name">CreatureModel</string><ProtectedString name="Source"><![CDATA[-- CreatureModel: monta cada criatura só com peças do Roblox (sem malhas, texturas ou IDs externos).
-- build(speciesId, mutationId, opts) -> Model com PrimaryPart "Body".
-- opts.anchored (padrão true). Para carregar na cabeça de um jogador use anchored = false:
-- as peças são soldadas ao corpo e o corpo pode ser soldado ao personagem.

local Shared = script.Parent.Parent
local GameConfig = require(Shared.Config.GameConfig)

local CreatureModel = {}

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function part(model, props)
	local p = Instance.new("Part")
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = true
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = model
	return p
end

-- posição relativa ao centro do corpo
local function at(body, x, y, z)
	return body.CFrame * CFrame.new(x, y, z)
end

local function eyes(model, body, r, spread, height, big)
	local size = big and r * 0.55 or r * 0.32
	for _, side in ipairs({ -1, 1 }) do
		part(model, { Name = "EyeWhite", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Color = Color3.new(1, 1, 1), CFrame = at(body, side * spread, height, -r * 0.42) })
		part(model, { Name = "Pupil", Shape = Enum.PartType.Ball, Size = Vector3.new(size * 0.5, size * 0.5, size * 0.5), Color = Color3.fromRGB(20, 20, 30), CFrame = at(body, side * spread, height, -r * 0.42 - size * 0.38) })
	end
end

local builders = {}

builders.blob = function(model, body, r, color)
	body.Size = Vector3.new(r * 1.15, r * 0.85, r * 1.15)
	eyes(model, body, r, r * 0.22, r * 0.12)
end

builders.drop = function(model, body, r, color)
	body.Size = Vector3.new(r, r, r)
	part(model, { Name = "Tip", Size = Vector3.new(r * 0.45, r * 0.6, r * 0.45), Color = color, CFrame = at(body, 0, r * 0.55, 0) * CFrame.Angles(0, math.rad(45), math.rad(45)) })
	eyes(model, body, r, r * 0.2, 0)
end

builders.spikes = function(model, body, r, color)
	body.Size = Vector3.new(r, r, r)
	for i = 0, 5 do
		local a = math.rad(i * 60)
		part(model, { Name = "Spike", Size = Vector3.new(r * 0.22, r * 0.55, r * 0.22), Color = color:Lerp(Color3.new(1, 1, 1), 0.35), CFrame = at(body, math.cos(a) * r * 0.42, r * 0.38, math.sin(a) * r * 0.42) * CFrame.Angles(math.sin(a) * 0.6, 0, -math.cos(a) * 0.6) })
	end
	eyes(model, body, r, r * 0.2, 0)
end

builders.tentacles = function(model, body, r, color)
	body.Size = Vector3.new(r, r * 0.9, r)
	for i = 0, 3 do
		local a = math.rad(45 + i * 90)
		part(model, { Name = "Tentacle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(r * 0.7, r * 0.2, r * 0.2), Color = color, CFrame = at(body, math.cos(a) * r * 0.4, -r * 0.45, math.sin(a) * r * 0.4) * CFrame.Angles(0, -a, math.rad(70)) })
	end
	eyes(model, body, r, r * 0.2, r * 0.1)
end

builders.ghost = function(model, body, r, color)
	body.Size = Vector3.new(r, r, r)
	part(model, { Name = "Tail", Size = Vector3.new(r * 0.9, r * 0.6, r * 0.9), Color = color, Transparency = 0.15, CFrame = at(body, 0, -r * 0.45, 0) })
	body.Transparency = 0.1
	eyes(model, body, r, r * 0.2, r * 0.1, true)
end

builders.mushroom = function(model, body, r, color)
	body.Size = Vector3.new(r * 0.8, r * 0.8, r * 0.8)
	body.Color = Color3.fromRGB(245, 235, 210)
	local cap = part(model, { Name = "Cap", Shape = Enum.PartType.Ball, Size = Vector3.new(r * 1.5, r * 0.8, r * 1.5), Color = color, CFrame = at(body, 0, r * 0.45, 0) })
	for i = 0, 3 do
		local a = math.rad(i * 90 + 20)
		part(model, { Name = "Dot", Shape = Enum.PartType.Ball, Size = Vector3.new(r * 0.22, r * 0.12, r * 0.22), Color = Color3.new(1, 1, 1), CFrame = cap.CFrame * CFrame.new(math.cos(a) * r * 0.42, r * 0.3, math.sin(a) * r * 0.42) })
	end
	eyes(model, body, r * 0.8, r * 0.16, 0)
end

builders.eye = function(model, body, r, color)
	body.Size = Vector3.new(r, r, r)
	part(model, { Name = "BigEye", Shape = Enum.PartType.Ball, Size = Vector3.new(r * 0.75, r * 0.75, r * 0.75), Color = Color3.new(1, 1, 1), CFrame = at(body, 0, r * 0.05, -r * 0.2) })
	part(model, { Name = "Iris", Shape = Enum.PartType.Ball, Size = Vector3.new(r * 0.38, r * 0.38, r * 0.38), Color = color:Lerp(Color3.new(0, 0, 0), 0.4), CFrame = at(body, 0, r * 0.05, -r * 0.5) })
end

builders.dragon = function(model, body, r, color)
	body.Size = Vector3.new(r, r * 0.9, r * 1.2)
	for _, side in ipairs({ -1, 1 }) do
		part(model, { Name = "Wing", Size = Vector3.new(r * 0.9, r * 0.08, r * 0.6), Color = color:Lerp(Color3.new(0, 0, 0), 0.25), CFrame = at(body, side * r * 0.7, r * 0.25, 0) * CFrame.Angles(0, 0, side * 0.5) })
		part(model, { Name = "Horn", Size = Vector3.new(r * 0.12, r * 0.4, r * 0.12), Color = Color3.fromRGB(250, 240, 210), CFrame = at(body, side * r * 0.22, r * 0.5, -r * 0.15) * CFrame.Angles(0, 0, -side * 0.3) })
	end
	part(model, { Name = "Tail", Size = Vector3.new(r * 0.2, r * 0.2, r * 0.8), Color = color, CFrame = at(body, 0, -r * 0.1, r * 0.8) * CFrame.Angles(0.4, 0, 0) })
	eyes(model, body, r, r * 0.2, r * 0.1)
end

builders.cyclops = function(model, body, r, color)
	body.Size = Vector3.new(r, r * 1.1, r)
	part(model, { Name = "BigEye", Shape = Enum.PartType.Ball, Size = Vector3.new(r * 0.5, r * 0.5, r * 0.5), Color = Color3.new(1, 1, 1), CFrame = at(body, 0, r * 0.15, -r * 0.33) })
	part(model, { Name = "Iris", Shape = Enum.PartType.Ball, Size = Vector3.new(r * 0.24, r * 0.24, r * 0.24), Color = Color3.fromRGB(20, 20, 30), CFrame = at(body, 0, r * 0.15, -r * 0.55) })
	part(model, { Name = "Horn", Size = Vector3.new(r * 0.16, r * 0.5, r * 0.16), Color = Color3.fromRGB(250, 240, 210), CFrame = at(body, 0, r * 0.65, 0) })
end

builders.octopus = function(model, body, r, color)
	body.Size = Vector3.new(r, r * 1.1, r)
	for i = 0, 7 do
		local a = math.rad(i * 45)
		part(model, { Name = "Arm", Shape = Enum.PartType.Cylinder, Size = Vector3.new(r * 0.8, r * 0.16, r * 0.16), Color = color, CFrame = at(body, math.cos(a) * r * 0.45, -r * 0.5, math.sin(a) * r * 0.45) * CFrame.Angles(0, -a, math.rad(60)) })
	end
	eyes(model, body, r, r * 0.22, r * 0.05, true)
end

builders.crown = function(model, body, r, color)
	body.Size = Vector3.new(r * 1.2, r * 0.95, r * 1.2)
	local gold = Color3.fromRGB(255, 205, 60)
	part(model, { Name = "CrownBand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(r * 0.25, r * 0.7, r * 0.7), Color = gold, Material = Enum.Material.Metal, CFrame = at(body, 0, r * 0.52, 0) * CFrame.Angles(0, 0, math.rad(90)) })
	for i = 0, 4 do
		local a = math.rad(i * 72)
		part(model, { Name = "CrownTip", Size = Vector3.new(r * 0.12, r * 0.28, r * 0.12), Color = gold, Material = Enum.Material.Metal, CFrame = at(body, math.cos(a) * r * 0.3, r * 0.72, math.sin(a) * r * 0.3) })
	end
	eyes(model, body, r, r * 0.24, r * 0.05)
end

builders.phoenix = function(model, body, r, color)
	body.Size = Vector3.new(r * 0.9, r, r * 0.9)
	for _, side in ipairs({ -1, 1 }) do
		for k = 0, 2 do
			part(model, { Name = "Feather", Size = Vector3.new(r * (0.9 - k * 0.2), r * 0.08, r * 0.3), Color = color:Lerp(Color3.fromRGB(255, 230, 80), k * 0.35), Material = Enum.Material.Neon, CFrame = at(body, side * r * (0.6 + k * 0.1), r * (0.1 + k * 0.18), k * r * 0.15) * CFrame.Angles(0, 0, side * (0.5 + k * 0.2)) })
		end
	end
	part(model, { Name = "Crest", Size = Vector3.new(r * 0.1, r * 0.45, r * 0.3), Color = Color3.fromRGB(255, 230, 80), Material = Enum.Material.Neon, CFrame = at(body, 0, r * 0.6, 0) })
	eyes(model, body, r, r * 0.18, r * 0.12)
end

builders.titan = function(model, body, r, color)
	body.Shape = Enum.PartType.Block
	body.Size = Vector3.new(r * 1.1, r * 1.1, r * 0.9)
	body.Material = Enum.Material.DiamondPlate
	for _, side in ipairs({ -1, 1 }) do
		part(model, { Name = "Arm", Size = Vector3.new(r * 0.35, r * 0.9, r * 0.35), Color = color:Lerp(Color3.new(0, 0, 0), 0.2), Material = Enum.Material.DiamondPlate, CFrame = at(body, side * r * 0.75, -r * 0.1, 0) })
	end
	part(model, { Name = "Visor", Size = Vector3.new(r * 0.8, r * 0.18, r * 0.1), Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.Neon, CFrame = at(body, 0, r * 0.2, -r * 0.47) })
end

builders.core = function(model, body, r, color)
	body.Size = Vector3.new(r * 0.8, r * 0.8, r * 0.8)
	body.Material = Enum.Material.Neon
	for i = 0, 2 do
		local ring = part(model, { Name = "Ring", Shape = Enum.PartType.Cylinder, Size = Vector3.new(r * 0.08, r * 1.3, r * 1.3), Color = color:Lerp(Color3.new(1, 1, 1), 0.3), Material = Enum.Material.Glass, Transparency = 0.3, CFrame = body.CFrame * CFrame.Angles(math.rad(i * 60), math.rad(i * 40), 0) })
		ring.CastShadow = false
	end
end

-- aplica a aparência da mutação ao corpo (e às partes coloridas)
local function applyMutation(model, body, mutationId)
	local m = GameConfig.Mutations[mutationId]
	if not m or mutationId == "normal" then
		return
	end
	local color = rgb(m.color)
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") and p.Name ~= "EyeWhite" and p.Name ~= "Pupil" and p.Name ~= "Iris" and p.Name ~= "BigEye" then
			if mutationId == "dourada" then
				p.Color = color
				p.Material = Enum.Material.Foil
				p.Reflectance = 0.25
			elseif mutationId == "diamante" then
				p.Color = color
				p.Material = Enum.Material.Glass
				p.Transparency = math.max(p.Transparency, 0.2)
				p.Reflectance = 0.35
			elseif mutationId == "radioativa" then
				p.Color = p.Color:Lerp(color, 0.7)
				p.Material = Enum.Material.Neon
			elseif mutationId == "vazio" then
				p.Color = Color3.fromRGB(40, 15, 70)
				p.Material = Enum.Material.Neon
			elseif mutationId == "arcoiris" then
				p.Material = Enum.Material.Neon
			end
		end
	end
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10
	light.Brightness = mutationId == "dourada" and 0.6 or 1.2
	light.Parent = body
	if mutationId == "arcoiris" then
		model:SetAttribute("Rainbow", true) -- o cliente anima as cores
	end
	if mutationId == "vazio" or mutationId == "arcoiris" or mutationId == "radioativa" then
		local sparkles = Instance.new("ParticleEmitter") -- textura padrão do Roblox, sem ID externo
		sparkles.Rate = 6
		sparkles.Lifetime = NumberRange.new(0.6, 1.2)
		sparkles.Speed = NumberRange.new(1, 2)
		sparkles.Size = NumberSequence.new(0.25)
		sparkles.Color = ColorSequence.new(color)
		sparkles.LightEmission = 0.8
		sparkles.Parent = body
	end
end

function CreatureModel.size(speciesId)
	local s = GameConfig.SpeciesById[speciesId]
	local tier = s and GameConfig.tier(s.rarity) or 1
	return 2.2 + tier * 0.55
end

function CreatureModel.build(speciesId, mutationId, opts)
	opts = opts or {}
	local s = GameConfig.SpeciesById[speciesId]
	local model = Instance.new("Model")
	model.Name = s and s.name or "Criatura"
	local r = CreatureModel.size(speciesId)
	local color = s and rgb(s.color) or Color3.new(0.5, 0.5, 0.5)
	local body = part(model, { Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.new(r, r, r), Color = color, CFrame = CFrame.new(0, 0, 0) })
	model.PrimaryPart = body
	local b = builders[s and s.shape or "blob"] or builders.blob
	b(model, body, r, color)
	applyMutation(model, body, mutationId)
	local anchored = opts.anchored ~= false
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") then
			p.Anchored = anchored
			p.Massless = true
			if not anchored and p ~= body then
				local w = Instance.new("WeldConstraint")
				w.Part0 = body
				w.Part1 = p
				w.Parent = p
			end
		end
	end
	model:SetAttribute("SpeciesId", speciesId)
	model:SetAttribute("MutationId", mutationId)
	return model
end

return CreatureModel
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX000035"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX000034"><Properties><string name="Name">Server</string></Properties><Item class="Folder" referent="RBX000024"><Properties><string name="Name">Core</string></Properties><Item class="ModuleScript" referent="RBX000021"><Properties><string name="Name">RateLimiter</string><ProtectedString name="Source"><![CDATA[-- RateLimiter: balde de fichas por jogador e por categoria de ação.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local RateLimiter = {}

local buckets = {} -- [player] = { [category] = { tokens, last } }

function RateLimiter.allow(player, category)
	local cfg = GameConfig.RateLimits[category]
	if not cfg then
		return true
	end
	local now = os.clock()
	local perPlayer = buckets[player]
	if not perPlayer then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local b = perPlayer[category]
	if not b then
		b = { tokens = cfg.capacity, last = now }
		perPlayer[category] = b
	end
	b.tokens = math.min(cfg.capacity, b.tokens + (now - b.last) * cfg.refillPerSecond)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens = b.tokens - 1
	return true
end

function RateLimiter.clear(player)
	buckets[player] = nil
end

return RateLimiter
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000022"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Remotes: cria os remotes e despacha as ações recebidas para os serviços.
-- Toda chamada passa por: validação do formato, limite de frequência, deduplicação
-- por requestId (pedidos repetidos recebem a mesma resposta sem reexecutar) e pcall.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RemoteNames = require(ReplicatedStorage.Shared.Net.RemoteNames)
local RateLimiter = require(script.Parent.RateLimiter)
local Validate = require(script.Parent.Validate)

local Remotes = {}

local folder
local handlers = {} -- [functionName][action] = { category, fn }
local recentRequests = {} -- [player] = { order = {}, responses = {} }
local MAX_RECENT = 40

function Remotes.init()
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in ipairs(RemoteNames.Functions) do
		local rf = Instance.new("RemoteFunction")
		rf.Name = name
		rf.Parent = folder
		handlers[name] = {}
		rf.OnServerInvoke = function(player, payload)
			return Remotes._dispatch(name, player, payload)
		end
	end
	for _, name in ipairs(RemoteNames.Events) do
		local re = Instance.new("RemoteEvent")
		re.Name = name
		re.Parent = folder
	end
	folder.Parent = ReplicatedStorage
end

function Remotes.event(name)
	return folder:FindFirstChild(name)
end

-- Registra o tratador de uma ação.
function Remotes.on(functionName, action, category, fn)
	assert(handlers[functionName], "remote desconhecido: " .. functionName)
	handlers[functionName][action] = { category = category, fn = fn }
end

function Remotes.fail(code, message)
	return { ok = false, error = code, message = message }
end

local function remember(player, requestId, response)
	local r = recentRequests[player]
	if not r then
		r = { order = {}, responses = {} }
		recentRequests[player] = r
	end
	r.responses[requestId] = response
	table.insert(r.order, requestId)
	if #r.order > MAX_RECENT then
		local old = table.remove(r.order, 1)
		r.responses[old] = nil
	end
end

function Remotes._dispatch(functionName, player, payload)
	if type(payload) ~= "table" or not Validate.id(payload.action, 32) then
		return Remotes.fail("invalid_request", "Pedido inválido.")
	end
	local h = handlers[functionName][payload.action]
	if not h then
		return Remotes.fail("invalid_request", "Ação desconhecida.")
	end
	local requestId = payload.requestId
	if requestId ~= nil then
		if not Validate.id(requestId, 40) then
			return Remotes.fail("invalid_request", "Pedido inválido.")
		end
		local r = recentRequests[player]
		if r and r.responses[requestId] then
			return r.responses[requestId] -- pedido repetido: não executa de novo
		end
	end
	if not RateLimiter.allow(player, h.category) then
		return Remotes.fail("rate_limited", "Calma! Muitas ações em sequência.")
	end
	local ok, result = pcall(h.fn, player, payload)
	if not ok then
		warn("[Remotes] erro em " .. functionName .. "/" .. payload.action .. ": " .. tostring(result))
		return Remotes.fail("server_error", "Erro no servidor. Nada foi alterado; tente novamente.")
	end
	if type(result) ~= "table" then
		result = Remotes.fail("server_error", "Resposta inválida.")
	end
	if requestId ~= nil then
		remember(player, requestId, result)
	end
	return result
end

function Remotes.clearPlayer(player)
	recentRequests[player] = nil
	RateLimiter.clear(player)
end

return Remotes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000023"><Properties><string name="Name">Validate</string><ProtectedString name="Source"><![CDATA[-- Validate: verificação de tipos dos dados recebidos do cliente.
-- Apenas ids, quantidades e flags são aceitos; nenhum valor econômico vem do cliente.

local Validate = {}

function Validate.id(v, maxLen)
	return type(v) == "string" and #v > 0 and #v <= (maxLen or 64) and not string.find(v, "[^%w_%-]")
end

function Validate.bool(v)
	return v == true
end

function Validate.int(v, min, max)
	return type(v) == "number" and v == v and v == math.floor(v) and v >= min and v <= max
end

function Validate.idList(v, maxCount)
	if type(v) ~= "table" then
		return false
	end
	local n = #v
	if n == 0 or n > maxCount then
		return false
	end
	local count = 0
	for k, item in pairs(v) do
		count = count + 1
		if type(k) ~= "number" or not Validate.id(item, 24) then
			return false
		end
	end
	return count == n
end

return Validate
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Script" referent="RBX000025"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Ponto de entrada do servidor do MUTANT FACTORY: cria os remotes e inicia os serviços em ordem.

local Services = script.Parent.Services
local Remotes = require(script.Parent.Core.Remotes)

Remotes.init()

local order = {
	"PlayerDataService",
	"MapService",
	"BaseService",
	"ConveyorService",
	"StealService",
	"EventService",
	"ActionService",
}

local loaded = {}
for _, name in ipairs(order) do
	loaded[name] = require(Services:WaitForChild(name))
end
for _, name in ipairs(order) do
	loaded[name].init()
end
-- PlayerDataService começa por último: todos os ouvintes já estão registrados quando o primeiro perfil carregar
for _, name in ipairs(order) do
	if name ~= "PlayerDataService" then
		loaded[name].start()
	end
end
loaded.PlayerDataService.start()

print("[MUTANT FACTORY] servidor pronto")
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX000033"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000026"><Properties><string name="Name">ActionService</string><ProtectedString name="Source"><![CDATA[-- ActionService: trata os pedidos dos remotes. O cliente só manda ids e escolhas;
-- preços, sorteios e quantidades vêm sempre do servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local ProfileOps = require(Shared.Logic.ProfileOps)
local Income = require(Shared.Logic.Income)

local Remotes = require(script.Parent.Parent.Core.Remotes)
local Validate = require(script.Parent.Parent.Core.Validate)
local PlayerDataService = require(script.Parent.PlayerDataService)
local BaseService = require(script.Parent.BaseService)
local EventService = require(script.Parent.EventService)

local ActionService = {}

local function bad()
	return Remotes.fail("invalid_request", "Pedido inválido.")
end

local function op(player, fn, important)
	return PlayerDataService.run(player, fn, { important = important })
end

function ActionService.init()
	-- ovos e poções
	Remotes.on("EggAction", "hatch", "Hatch", function(player, p)
		if not GameConfig.Eggs[p.eggId] then
			return bad()
		end
		local res = op(player, function(profile, ctx)
			return ProfileOps.hatchEgg(profile, ctx, p.eggId)
		end, true)
		if res.ok then
			local c = res.data.creature
			local s = GameConfig.SpeciesById[c.s]
			if GameConfig.tier(s.rarity) >= 5 or GameConfig.Mutations[c.m].tier >= 3 then
				local m = GameConfig.Mutations[c.m]
				BaseService.notifyAll("rare", "🥚 " .. player.DisplayName .. " chocou " .. (c.m ~= "normal" and (m.name .. " ") or "") .. s.name .. "!")
			end
			res.data = { speciesId = c.s, mutationId = c.m, uid = c.uid, isNew = res.data.isNew, cost = res.data.cost }
		end
		return res
	end)
	Remotes.on("EggAction", "buyPotion", "Base", function(player, p)
		if not GameConfig.Potions[p.potionId] then
			return bad()
		end
		return op(player, function(profile, ctx)
			return ProfileOps.buyPotion(profile, ctx, p.potionId)
		end)
	end)
	Remotes.on("EggAction", "usePotion", "Base", function(player, p)
		if not GameConfig.Potions[p.potionId] then
			return bad()
		end
		return op(player, function(profile, ctx)
			return ProfileOps.activatePotion(profile, ctx, p.potionId)
		end, true)
	end)

	-- base
	Remotes.on("BaseAction", "collect", "Base", function(player)
		return BaseService.collect(player)
	end)
	Remotes.on("BaseAction", "shield", "Base", function(player)
		return BaseService.activateShield(player)
	end)
	Remotes.on("BaseAction", "sell", "Base", function(player, p)
		if not Validate.id(p.uid, 24) then
			return bad()
		end
		return op(player, function(profile, ctx)
			return ProfileOps.sell(profile, ctx, p.uid, p.confirm == true)
		end, true)
	end)
	Remotes.on("BaseAction", "upgrade", "Base", function(player, p)
		if not GameConfig.Upgrades[p.upgradeId] then
			return bad()
		end
		return op(player, function(profile, ctx)
			return ProfileOps.buyUpgrade(profile, ctx, p.upgradeId)
		end, true)
	end)
	Remotes.on("BaseAction", "move", "Base", function(player, p)
		if not Validate.id(p.uid, 24) or not Validate.int(p.pad, 1, GameConfig.Base.MaxSlotsShown) then
			return bad()
		end
		return op(player, function(profile, ctx)
			return ProfileOps.movePad(profile, ctx, p.uid, p.pad)
		end)
	end)

	-- recompensas e renascimento
	Remotes.on("ClaimAction", "mission", "Claim", function(player, p)
		if not Validate.id(p.missionId, 32) then
			return bad()
		end
		return op(player, function(profile, ctx)
			return ProfileOps.claimMission(profile, ctx, p.missionId)
		end, true)
	end)
	Remotes.on("ClaimAction", "gift", "Claim", function(player)
		return op(player, function(profile, ctx)
			return ProfileOps.claimGift(profile, ctx)
		end, true)
	end)
	Remotes.on("ClaimAction", "milestone", "Claim", function(player, p)
		if not Validate.id(p.milestoneId, 16) then
			return bad()
		end
		return op(player, function(profile, ctx)
			return ProfileOps.claimMilestone(profile, ctx, p.milestoneId)
		end, true)
	end)
	Remotes.on("ClaimAction", "rebirth", "Claim", function(player, p)
		if type(p.phrase) ~= "string" or #p.phrase > 20 then
			return bad()
		end
		local res = op(player, function(profile, ctx)
			return ProfileOps.rebirth(profile, ctx, p.phrase)
		end, true)
		if res.ok then
			BaseService.notifyAll("rare", "♻️ " .. player.DisplayName .. " renasceu! (" .. res.data.rebirths .. "º)")
		end
		return res
	end)

	-- ajustes
	Remotes.on("SettingsAction", "set", "Settings", function(player, p)
		return op(player, function(profile)
			return ProfileOps.setSetting(profile, p.key, p.value)
		end)
	end)
	-- só no Studio: força um evento para testar (nunca em servidores publicados)
	Remotes.on("SettingsAction", "testEvent", "Settings", function(player, p)
		if not RunService:IsStudio() then
			return Remotes.fail("forbidden", "Disponível só no Studio.")
		end
		if not Validate.id(p.eventId, 32) then
			return bad()
		end
		local ev = EventService.force(p.eventId, 120)
		if not ev then
			return bad()
		end
		return { ok = true, data = { id = ev.id } }
	end)

	-- ranking do servidor
	Remotes.on("RankingRequest", "get", "Ranking", function()
		local rows = {}
		for _, pl in ipairs(Players:GetPlayers()) do
			local profile = PlayerDataService.getProfile(pl)
			if profile then
				table.insert(rows, {
					name = pl.DisplayName,
					coins = profile.coins,
					rate = Income.totalRate(profile),
					netWorth = Income.netWorth(profile),
					stolen = profile.stats.stolen,
					defended = profile.stats.defended,
					rebirths = profile.rebirths,
				})
			end
		end
		table.sort(rows, function(a, b)
			return a.netWorth > b.netWorth
		end)
		return { ok = true, data = rows }
	end)
end

function ActionService.start() end

return ActionService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000027"><Properties><string name="Name">BaseService</string><ProtectedString name="Source"><![CDATA[-- BaseService: bases dos jogadores.
-- * Distribui uma das 6 bases ao entrar e leva o personagem até ela.
-- * Mostra as criaturas nos pedestais (com o valor guardado atualizado a cada segundo).
-- * Coletar e travar a base só funcionam com o personagem DENTRO da própria base (o servidor confere).
-- * Escudo: lasers na entrada; quem não é dono e está dentro é empurrado para fora (sem dano).
-- * Velocidade de caminhada definida pelo servidor (melhorias, poção, carregando criatura).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local MapConfig = require(Shared.Config.MapConfig)
local ProfileOps = require(Shared.Logic.ProfileOps)
local ProfileSchema = require(Shared.Logic.ProfileSchema)
local Income = require(Shared.Logic.Income)
local Format = require(Shared.Util.Format)
local CreatureModel = require(Shared.Visual.CreatureModel)

local Remotes = require(script.Parent.Parent.Core.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local MapService = require(script.Parent.MapService)

local BaseService = {}

local owners = {} -- [baseIndex] = player
local baseOf = {} -- [player] = baseIndex
local shieldUntil = {} -- [baseIndex] = horário
local rendered = {} -- [player] = { [uid] = { model, label, pad, key } }
local hidden = {} -- [uid] = true (sendo carregada por alguém)
BaseService.promptHandlers = {} -- [nomeDoAtributo] = function(prompt, player)
BaseService.carryingProvider = nil -- function(player) -> info ou nil

local function rgbHex(t)
	return string.format("#%02X%02X%02X", t[1], t[2], t[3])
end

function BaseService.notify(player, kind, text, extra)
	local payload = { kind = kind, text = text }
	for k, v in pairs(extra or {}) do
		payload[k] = v
	end
	Remotes.event("Notify"):FireClient(player, payload)
end

function BaseService.notifyAll(kind, text)
	Remotes.event("Notify"):FireAllClients({ kind = kind, text = text })
end

---------------------------------------------------------------------------
-- posições
---------------------------------------------------------------------------

function BaseService.root(player)
	local char = player and player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

function BaseService.position(player)
	local r = BaseService.root(player)
	return r and r.Position
end

function BaseService.baseIndex(player)
	return baseOf[player]
end

function BaseService.owner(index)
	return owners[index]
end

function BaseService.isShielded(index, now)
	return (shieldUntil[index] or 0) > (now or PlayerDataService.now())
end

function BaseService.shieldUntil(index)
	return shieldUntil[index] or 0
end

function BaseService.inOwnBase(player)
	local pos = BaseService.position(player)
	local idx = baseOf[player]
	return pos ~= nil and idx ~= nil and MapConfig.baseAt(pos.X, pos.Z) == idx
end

local function teleportToBase(player)
	local idx = baseOf[player]
	local r = BaseService.root(player)
	if idx and r then
		r.CFrame = CFrame.new(MapService.bases[idx].spawn)
	end
end

---------------------------------------------------------------------------
-- criaturas nos pedestais
---------------------------------------------------------------------------

local function labelText(profile, c, now)
	local s = GameConfig.SpeciesById[c.s]
	local m = GameConfig.Mutations[c.m]
	local rarity = GameConfig.Rarities[s.rarity]
	local mut = c.m ~= "normal" and ("<font color='" .. rgbHex(m.color) .. "'>" .. m.name .. "</font> ") or ""
	local pending = math.floor(Income.pending(profile, c, now))
	return mut .. "<font color='" .. rgbHex(rarity.color) .. "'>" .. s.name .. "</font>\n"
		.. "<font color='#7CFF8A'>+$" .. Format.short(Income.rate(profile, c)) .. "/s</font>  "
		.. "<font color='#FFD84A'>$" .. Format.short(pending) .. "</font>"
end

local function padCFrame(index, pad, speciesId)
	local x, z = MapConfig.padPosition(index, pad)
	local h = CreatureModel.size(speciesId)
	return CFrame.new(x, 1.8 + h / 2, z)
end

local function buildCreature(player, index, c)
	local model = CreatureModel.build(c.s, c.m, { anchored = true })
	model.Name = c.uid
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("Uid", c.uid)
	model:SetAttribute("BaseIndex", index)
	model:PivotTo(padCFrame(index, c.pad, c.s))
	local body = model.PrimaryPart
	local label = MapService.billboard(body, "", UDim2.fromOffset(200, 54), CreatureModel.size(c.s) / 2 + 2)
	MapService.prompt(body, "Roubar", GameConfig.SpeciesById[c.s].name, {
		hold = GameConfig.Steal.HoldSeconds,
		distance = GameConfig.Steal.PromptDistance,
		attributes = { Steal = true, OwnerUserId = player.UserId, Uid = c.uid },
	})
	model.Parent = MapService.creatureFolder
	return { model = model, label = label, pad = c.pad, key = c.s .. c.m }
end

function BaseService.render(player)
	local index = baseOf[player]
	local profile = PlayerDataService.getProfile(player)
	if not index or not profile then
		return
	end
	local list = rendered[player]
	if not list then
		list = {}
		rendered[player] = list
	end
	-- remove as que saíram
	for uid, r in pairs(list) do
		local c = profile.creatures[uid]
		if not c or r.key ~= c.s .. c.m then
			r.model:Destroy()
			list[uid] = nil
		end
	end
	-- adiciona/move
	for uid, c in pairs(profile.creatures) do
		local r = list[uid]
		if not r then
			list[uid] = buildCreature(player, index, c)
		elseif r.pad ~= c.pad then
			r.model:PivotTo(padCFrame(index, c.pad, c.s))
			r.pad = c.pad
		end
		local m = list[uid].model
		if hidden[uid] then
			m.Parent = nil
		else
			m.Parent = MapService.creatureFolder
		end
	end
	-- pedestais disponíveis
	local slots = ProfileSchema.slots(profile)
	for i, pad in ipairs(MapService.bases[index].pads) do
		pad.Transparency = i <= slots and 0 or 0.75
		pad.Color = i <= slots and MapService.bases[index].color:Lerp(Color3.fromRGB(40, 40, 55), 0.6) or Color3.fromRGB(45, 48, 62)
	end
	BaseService.updateLabels(player)
end

function BaseService.updateLabels(player)
	local profile = PlayerDataService.getProfile(player)
	local list = rendered[player]
	if not profile or not list then
		return
	end
	local now = PlayerDataService.now()
	for uid, r in pairs(list) do
		local c = profile.creatures[uid]
		if c then
			r.label.Text = labelText(profile, c, now)
		end
	end
end

-- esconde/mostra a criatura do pedestal enquanto alguém a carrega
function BaseService.setHidden(ownerPlayer, uid, isHidden)
	hidden[uid] = isHidden or nil
	local list = rendered[ownerPlayer]
	local r = list and list[uid]
	if r then
		if isHidden then
			r.model.Parent = nil
		else
			r.model.Parent = MapService.creatureFolder
		end
	end
end

local function clearBase(player)
	for _, r in pairs(rendered[player] or {}) do
		r.model:Destroy()
	end
	rendered[player] = nil
	local idx = baseOf[player]
	if idx then
		owners[idx] = nil
		shieldUntil[idx] = nil
		local b = MapService.bases[idx]
		b.sign.Text = "Base livre"
		for _, l in ipairs(b.laser) do
			l.Transparency = 1
		end
		for _, pad in ipairs(b.pads) do
			pad.Transparency = 0.6
		end
	end
	baseOf[player] = nil
end

local function assign(player)
	for i = 1, #MapConfig.Bases do
		if not owners[i] then
			owners[i] = player
			baseOf[player] = i
			player:SetAttribute("BaseIndex", i)
			local b = MapService.bases[i]
			b.sign.Text = "Base de " .. player.DisplayName
			b.collectPrompt:SetAttribute("OwnerUserId", player.UserId)
			b.shieldPrompt:SetAttribute("OwnerUserId", player.UserId)
			shieldUntil[i] = PlayerDataService.now() + GameConfig.Base.NewcomerShield
			return i
		end
	end
	return nil
end

---------------------------------------------------------------------------
-- ações
---------------------------------------------------------------------------

function BaseService.collect(player)
	if not BaseService.inOwnBase(player) then
		return Remotes.fail("not_in_base", "Vá até a sua base para coletar.")
	end
	return PlayerDataService.run(player, function(profile, ctx)
		return ProfileOps.collectAll(profile, ctx)
	end)
end

function BaseService.activateShield(player)
	local idx = baseOf[player]
	if not idx or not BaseService.inOwnBase(player) then
		return Remotes.fail("not_in_base", "Vá até a sua base para travar.")
	end
	local now = PlayerDataService.now()
	if BaseService.isShielded(idx, now) then
		return Remotes.fail("shield_active", "O escudo já está ligado.")
	end
	local res = PlayerDataService.run(player, function(profile, ctx)
		ProfileOps.recordShield(profile, ctx.now)
		return true, { seconds = ProfileOps.shieldSeconds(profile) }
	end)
	if res.ok then
		shieldUntil[idx] = now + res.data.seconds
		if BaseService.shieldHook then
			BaseService.shieldHook(player, idx) -- ladrões ainda dentro da base devolvem a criatura
		end
		PlayerDataService.push(player)
	end
	return res
end

-- empurra para fora quem não é dono e está dentro de uma base com escudo
local function enforceShields(now)
	for idx, owner in pairs(owners) do
		local active = BaseService.isShielded(idx, now)
		local b = MapService.bases[idx]
		for _, l in ipairs(b.laser) do
			l.Transparency = active and 0.15 or 1
		end
		local left = math.max(0, math.ceil((shieldUntil[idx] or 0) - now))
		b.shieldLabel.Text = active and ("🛡️ TRAVADA " .. left .. "s") or "🛡️ TRAVAR BASE"
		if active then
			local base = MapConfig.Bases[idx]
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= owner then
					local r = BaseService.root(p)
					if r and MapConfig.baseAt(r.Position.X, r.Position.Z) == idx then
						local outZ = base.z + base.facing * (MapConfig.BaseSize / 2 + 8)
						r.CFrame = CFrame.new(base.x, 4, outZ)
						BaseService.notify(p, "info", "🛡️ Essa base está com o escudo ligado.")
					end
				end
			end
		end
	end
end

local function updateSpeeds(now)
	for player, _ in pairs(baseOf) do
		local profile = PlayerDataService.getProfile(player)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if profile and hum then
			local carrying = BaseService.carryingProvider and BaseService.carryingProvider(player) ~= nil
			hum.WalkSpeed = ProfileOps.walkSpeed(profile, now, carrying)
		end
	end
end

---------------------------------------------------------------------------
-- ciclo
---------------------------------------------------------------------------

function BaseService.init()
	PlayerDataService.setViewExtraProvider(function(player)
		local idx = baseOf[player]
		return {
			baseIndex = idx,
			shieldUntil = idx and shieldUntil[idx] or 0,
			carrying = BaseService.carryingProvider and BaseService.carryingProvider(player) or nil,
		}
	end)
	PlayerDataService.onLoaded(function(player)
		local idx = assign(player)
		if not idx then
			player:Kick("Servidor cheio (6 bases ocupadas). Entre em outro servidor.")
			return
		end
		BaseService.render(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.3)
			teleportToBase(player)
		end)
		teleportToBase(player)
		BaseService.notify(player, "good", "🏠 Esta é a sua base! Proteção de " .. GameConfig.Base.NewcomerShield .. "s ativa.")
	end)
	PlayerDataService.onChanged(function(player)
		BaseService.render(player)
	end)
	Players.PlayerRemoving:Connect(clearBase)

	BaseService.promptHandlers.Action = function(prompt, player)
		local idx = prompt:GetAttribute("BaseIndex")
		if idx ~= baseOf[player] then
			return
		end
		local res
		if prompt:GetAttribute("Action") == "collect" then
			res = BaseService.collect(player)
			if res.ok then
				BaseService.notify(player, "good", "💰 +$" .. Format.short(res.data.coins))
			end
		elseif prompt:GetAttribute("Action") == "shield" then
			res = BaseService.activateShield(player)
			if res.ok then
				BaseService.notify(player, "good", "🛡️ Base travada por " .. math.floor(res.data.seconds) .. "s!")
			end
		end
		if res and not res.ok then
			BaseService.notify(player, "error", res.message)
		end
	end
end

function BaseService.start()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		for attr, fn in pairs(BaseService.promptHandlers) do
			if prompt:GetAttribute(attr) ~= nil then
				fn(prompt, player)
				return
			end
		end
	end)
	task.spawn(function()
		local acc = 0
		while true do
			task.wait(0.25)
			local now = PlayerDataService.now()
			enforceShields(now)
			acc = acc + 0.25
			if acc >= 1 then
				acc = 0
				updateSpeeds(now)
				for player in pairs(baseOf) do
					BaseService.updateLabels(player)
				end
			end
		end
	end)
end

BaseService._owners = owners
BaseService._baseOf = baseOf
BaseService._rendered = rendered

return BaseService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000028"><Properties><string name="Name">ConveyorService</string><ProtectedString name="Source"><![CDATA[-- ConveyorService: a esteira da fábrica. Criaturas sorteadas pelo SERVIDOR atravessam a praça;
-- qualquer jogador pode comprar a que passar (quem chegar primeiro leva).
-- Preço = preço da espécie × mutação. Eventos podem acelerar a esteira e dar sorte extra.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local MapConfig = require(Shared.Config.MapConfig)
local EventConfig = require(Shared.Config.EventConfig)
local ProfileOps = require(Shared.Logic.ProfileOps)
local Format = require(Shared.Util.Format)
local CreatureModel = require(Shared.Visual.CreatureModel)

local PlayerDataService = require(script.Parent.PlayerDataService)
local MapService = require(script.Parent.MapService)
local BaseService = require(script.Parent.BaseService)

local ConveyorService = {}

local items = {} -- [id] = { model, offer, x, label }
local nextId = 0
local rng = Random.new()
local BUY_DISTANCE = 16

local function rgbHex(t)
	return string.format("#%02X%02X%02X", t[1], t[2], t[3])
end

local function isRare(offer)
	local s = GameConfig.SpeciesById[offer.speciesId]
	return GameConfig.tier(s.rarity) >= 5 or GameConfig.Mutations[offer.mutationId].tier >= 3
end

local function describe(offer)
	local s = GameConfig.SpeciesById[offer.speciesId]
	local m = GameConfig.Mutations[offer.mutationId]
	return (offer.mutationId ~= "normal" and (m.name .. " ") or "") .. s.name
end
ConveyorService.describe = describe

function ConveyorService.spawn(now)
	local count = 0
	for _ in pairs(items) do
		count = count + 1
	end
	if count >= GameConfig.Conveyor.MaxOnBelt then
		return nil
	end
	local offer = ProfileOps.rollConveyor(now, rng:NextNumber(), rng:NextNumber())
	nextId = nextId + 1
	local id = "b" .. nextId
	local c = MapConfig.Conveyor
	local model = CreatureModel.build(offer.speciesId, offer.mutationId, { anchored = true })
	model.Name = id
	model:SetAttribute("ConveyorId", id)
	local h = CreatureModel.size(offer.speciesId)
	model:PivotTo(CFrame.new(c.startX, c.y + h / 2, c.z))
	local s = GameConfig.SpeciesById[offer.speciesId]
	local m = GameConfig.Mutations[offer.mutationId]
	local rarity = GameConfig.Rarities[s.rarity]
	local text = (offer.mutationId ~= "normal" and ("<font color='" .. rgbHex(m.color) .. "'>" .. m.name .. "</font> ") or "")
		.. "<font color='" .. rgbHex(rarity.color) .. "'>" .. s.name .. "</font>\n"
		.. "<font color='#FFD84A'>$" .. Format.short(offer.price) .. "</font>  <font color='#7CFF8A'>+$" .. Format.short(s.income * m.mult) .. "/s</font>"
	local label = MapService.billboard(model.PrimaryPart, text, UDim2.fromOffset(210, 56), h / 2 + 2.5)
	MapService.prompt(model.PrimaryPart, "Comprar", "$" .. Format.short(offer.price), { distance = 12, attributes = { ConveyorId = id } })
	model.Parent = MapService.beltFolder
	items[id] = { model = model, offer = offer, x = c.startX, label = label, h = h }
	if isRare(offer) then
		BaseService.notifyAll("rare", "✨ Na esteira: " .. describe(offer) .. " (" .. rarity.displayName .. ")!")
	end
	return id
end

function ConveyorService.buy(player, id)
	local item = items[id]
	if not item then
		return { ok = false, error = "offer_gone", message = ProfileOps.Messages.offer_gone }
	end
	local pos = BaseService.position(player)
	if not pos then
		return { ok = false, error = "too_far", message = "Chegue mais perto da esteira." }
	end
	local dx = pos.X - item.x
	local dz = pos.Z - MapConfig.Conveyor.z
	if dx * dx + dz * dz > BUY_DISTANCE * BUY_DISTANCE then
		return { ok = false, error = "too_far", message = "Chegue mais perto da esteira." }
	end
	local offer = item.offer
	local res = PlayerDataService.run(player, function(profile, ctx)
		return ProfileOps.buyFromConveyor(profile, ctx, offer)
	end, { important = true })
	if res.ok then
		items[id] = nil
		item.model:Destroy()
		BaseService.notify(player, "good", "🛒 " .. describe(offer) .. " foi para a sua base!")
		if isRare(offer) then
			BaseService.notifyAll("rare", "🛒 " .. player.DisplayName .. " comprou " .. describe(offer) .. "!")
		end
	end
	return res
end

function ConveyorService.step(dt)
	local c = MapConfig.Conveyor
	local speed = (c.endX - c.startX) / GameConfig.Conveyor.TravelSeconds
	for id, item in pairs(items) do
		item.x = item.x + speed * dt
		if item.x >= c.endX then
			items[id] = nil
			item.model:Destroy()
		else
			item.model:PivotTo(CFrame.new(item.x, c.y + item.h / 2, c.z))
		end
	end
end

function ConveyorService.init()
	BaseService.promptHandlers.ConveyorId = function(prompt, player)
		local res = ConveyorService.buy(player, prompt:GetAttribute("ConveyorId"))
		if not res.ok then
			BaseService.notify(player, "error", res.message)
		end
	end
end

function ConveyorService.start()
	task.spawn(function()
		local sinceSpawn = 999
		while true do
			local dt = task.wait() -- um quadro: movimento suave
			local now = PlayerDataService.now()
			ConveyorService.step(dt)
			local ev = EventConfig.at(now)
			local interval = GameConfig.Conveyor.SpawnInterval
			if ev and ev.kind == "conveyor" then
				interval = interval * ev.intervalMult
			end
			sinceSpawn = sinceSpawn + dt
			if sinceSpawn >= interval then
				sinceSpawn = 0
				ConveyorService.spawn(now)
			end
		end
	end)
end

ConveyorService._items = items

return ConveyorService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000029"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[-- EventService: anuncia os eventos de mutação (agenda fixa em EventConfig) e atualiza a placa da praça.
-- O efeito dos eventos é aplicado pela lógica compartilhada (Odds/Income) usando o horário do servidor.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EventConfig = require(Shared.Config.EventConfig)
local Format = require(Shared.Util.Format)

local PlayerDataService = require(script.Parent.PlayerDataService)
local MapService = require(script.Parent.MapService)
local BaseService = require(script.Parent.BaseService)

local EventService = {}

local lastEventKey = nil

function EventService.update(now)
	local ev = EventConfig.at(now)
	local key = ev and (ev.id .. ":" .. ev.startsAt) or nil
	if key ~= lastEventKey then
		lastEventKey = key
		if ev then
			BaseService.notifyAll("event", ev.icon .. " EVENTO: " .. ev.name .. "! " .. ev.description)
			workspace:SetAttribute("EventId", ev.id)
		else
			workspace:SetAttribute("EventId", nil)
		end
		-- todos recebem a fotografia nova (chances e bônus mudam com o evento)
		for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
			PlayerDataService.push(p)
		end
	end
	if MapService.eventLabel then
		if ev then
			MapService.eventLabel.Text = ev.icon .. " " .. ev.name .. "\n<font color='#FFD84A'>termina em " .. Format.duration(ev.endsAt - now) .. "</font>"
		else
			local n = EventConfig.nextEvent(now)
			MapService.eventLabel.Text = "Próximo evento\n" .. n.icon .. " " .. n.name .. "\n<font color='#9FD8FF'>em " .. Format.duration(n.startsAt - now) .. "</font>"
		end
	end
end

-- usado em testes/Studio: força um evento agora
function EventService.force(id, seconds)
	local now = PlayerDataService.now()
	local ev = EventConfig.force(id, now, seconds)
	EventService.update(now)
	return ev
end

function EventService.init() end

function EventService.start()
	task.spawn(function()
		while true do
			EventService.update(PlayerDataService.now())
			task.wait(1)
		end
	end)
end

return EventService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000030"><Properties><string name="Name">MapService</string><ProtectedString name="Source"><![CDATA[-- MapService: constrói o mapa inteiro por código (sem modelos ou texturas externas):
-- chão, praça, esteira da fábrica, quiosques de ovos, loja de poções, placa de eventos,
-- 6 bases com pedestais, terminais (coletar / travar base) e as barreiras de laser.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local MapConfig = require(Shared.Config.MapConfig)

local MapService = {}

MapService.world = nil
MapService.bases = {} -- [index] = { folder, pads = {}, laser = {}, sign, collectPrompt, shieldPrompt }
MapService.eventLabel = nil

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

-- placa com texto (BillboardGui sempre virado para a câmera)
function MapService.billboard(adornee, text, size, offsetY, color)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = size or UDim2.fromOffset(220, 60)
	gui.StudsOffset = Vector3.new(0, offsetY or 4, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 140
	gui.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.RichText = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Text = text
	label.Parent = gui
	gui.Parent = adornee
	return label
end

local function prompt(parent, actionText, objectText, opts)
	opts = opts or {}
	local p = Instance.new("ProximityPrompt")
	p.ActionText = actionText
	p.ObjectText = objectText or ""
	p.HoldDuration = opts.hold or 0
	p.MaxActivationDistance = opts.distance or 10
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	for k, v in pairs(opts.attributes or {}) do
		p:SetAttribute(k, v)
	end
	p.Parent = parent
	return p
end
MapService.prompt = prompt

local function buildPlaza(world)
	part(world, { Name = "Ground", Size = Vector3.new(MapConfig.GroundSize, 2, MapConfig.GroundSize), Position = Vector3.new(0, -1, 0), Color = Color3.fromRGB(96, 178, 74), Material = Enum.Material.Grass })
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlazaSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 0.5, 30)
	spawn.Color = Color3.fromRGB(120, 255, 90)
	spawn.Material = Enum.Material.Neon
	spawn.Neutral = true
	spawn.Parent = world
	part(world, { Name = "Plaza", Size = Vector3.new(170, 0.4, 90), Position = Vector3.new(0, 0.2, 0), Color = Color3.fromRGB(200, 196, 186), Material = Enum.Material.Concrete })
	-- caminhos até as bases
	for _, b in ipairs(MapConfig.Bases) do
		local len = math.abs(b.z) - MapConfig.BaseSize / 2 - 45
		part(world, { Name = "Path", Size = Vector3.new(14, 0.3, len), Position = Vector3.new(b.x, 0.15, b.facing * -(45 + len / 2)), Color = Color3.fromRGB(214, 200, 160), Material = Enum.Material.Sand })
	end
	part(world, { Name = "Road", Size = Vector3.new(260, 0.3, 14), Position = Vector3.new(0, 0.15, -50), Color = Color3.fromRGB(214, 200, 160), Material = Enum.Material.Sand })
	part(world, { Name = "Road", Size = Vector3.new(260, 0.3, 14), Position = Vector3.new(0, 0.15, 50), Color = Color3.fromRGB(214, 200, 160), Material = Enum.Material.Sand })
	-- cerca
	local f = MapConfig.Fence
	for _, w in ipairs({ { 0, -f, f * 2, 1 }, { 0, f, f * 2, 1 }, { -f, 0, 1, f * 2 }, { f, 0, 1, f * 2 } }) do
		part(world, { Name = "Fence", Size = Vector3.new(w[3], 6, w[4]), Position = Vector3.new(w[1], 3, w[2]), Color = Color3.fromRGB(240, 230, 210), Material = Enum.Material.WoodPlanks })
	end
	-- árvores de enfeite nos cantos
	for _, t in ipairs({ { -185, -185 }, { 185, -185 }, { -185, 185 }, { 185, 185 }, { -185, 0 }, { 185, 0 }, { -60, -185 }, { 60, 185 } }) do
		part(world, { Name = "Trunk", Size = Vector3.new(2, 8, 2), Position = Vector3.new(t[1], 4, t[2]), Color = Color3.fromRGB(110, 75, 40), Material = Enum.Material.Wood })
		part(world, { Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(11, 11, 11), Position = Vector3.new(t[1], 11, t[2]), Color = Color3.fromRGB(60, 150, 70), Material = Enum.Material.Grass })
	end
end

local function buildConveyor(world)
	local c = MapConfig.Conveyor
	local len = c.endX - c.startX
	local belt = part(world, { Name = "ConveyorBelt", Size = Vector3.new(len + 8, 1.2, c.width), Position = Vector3.new((c.startX + c.endX) / 2, 0.8, c.z), Color = Color3.fromRGB(45, 48, 60), Material = Enum.Material.DiamondPlate })
	for x = c.startX, c.endX, 8 do
		part(world, { Name = "Arrow", Size = Vector3.new(3, 0.1, 1), Position = Vector3.new(x, 1.45, c.z), Color = Color3.fromRGB(255, 200, 60), Material = Enum.Material.Neon, CanCollide = false })
	end
	for _, side in ipairs({ -1, 1 }) do
		part(world, { Name = "Rail", Size = Vector3.new(len + 8, 1.6, 0.8), Position = Vector3.new((c.startX + c.endX) / 2, 1.6, c.z + side * (c.width / 2 + 0.4)), Color = Color3.fromRGB(255, 170, 40), Material = Enum.Material.Metal })
	end
	-- máquina da fábrica no início da esteira
	local machine = part(world, { Name = "FactoryMachine", Size = Vector3.new(16, 18, 18), Position = Vector3.new(c.startX - 12, 9, c.z), Color = Color3.fromRGB(70, 80, 110), Material = Enum.Material.Metal })
	part(world, { Name = "FactoryPipe", Shape = Enum.PartType.Cylinder, Size = Vector3.new(10, 4, 4), Position = Vector3.new(c.startX - 12, 22, c.z - 4), Orientation = Vector3.new(0, 0, 90), Color = Color3.fromRGB(120, 255, 90), Material = Enum.Material.Neon })
	part(world, { Name = "FactoryHatch", Size = Vector3.new(1, 8, 9), Position = Vector3.new(c.startX - 3.6, 5, c.z), Color = Color3.fromRGB(120, 255, 90), Material = Enum.Material.Neon })
	MapService.billboard(machine, "🧪 MUTANT FACTORY", UDim2.fromOffset(420, 80), 14, Color3.fromRGB(150, 255, 110))
	-- recolhedor no final
	part(world, { Name = "Recycler", Size = Vector3.new(10, 12, 14), Position = Vector3.new(c.endX + 9, 6, c.z), Color = Color3.fromRGB(90, 60, 60), Material = Enum.Material.Metal })
	return belt
end

local function buildKiosks(world)
	for _, id in ipairs(GameConfig.EggOrder) do
		local egg = GameConfig.Eggs[id]
		local k = MapConfig.EggKiosks[id]
		local stand = part(world, { Name = "EggKiosk_" .. id, Size = Vector3.new(10, 3, 10), Position = Vector3.new(k.x, 1.5, k.z), Color = Color3.fromRGB(60, 64, 84), Material = Enum.Material.Metal })
		local eggPart = part(world, { Name = "Egg_" .. id, Shape = Enum.PartType.Ball, Size = Vector3.new(5, 6.5, 5), Position = Vector3.new(k.x, 6.4, k.z), Color = rgb(egg.color), Material = Enum.Material.SmoothPlastic })
		MapService.billboard(eggPart, egg.name .. "\n<font color='#FFD84A'>$ " .. tostring(egg.price) .. "</font>", UDim2.fromOffset(220, 70), 6)
		prompt(stand, "Abrir", egg.name, { distance = 12, attributes = { Panel = "Eggs", EggId = id } })
	end
	local ps = MapConfig.PotionShop
	local shop = part(world, { Name = "PotionShop", Size = Vector3.new(12, 6, 8), Position = Vector3.new(ps.x, 3, ps.z), Color = Color3.fromRGB(120, 60, 170), Material = Enum.Material.WoodPlanks })
	part(world, { Name = "PotionBottle", Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3), Position = Vector3.new(ps.x, 7.6, ps.z), Color = Color3.fromRGB(120, 255, 120), Material = Enum.Material.Neon })
	MapService.billboard(shop, "🧪 POÇÕES", UDim2.fromOffset(200, 50), 7)
	prompt(shop, "Ver poções", "Loja de Poções", { distance = 12, attributes = { Panel = "Potions" } })

	local eb = MapConfig.EventBoard
	local board = part(world, { Name = "EventBoard", Size = Vector3.new(16, 9, 1), Position = Vector3.new(eb.x, 7, eb.z), Color = Color3.fromRGB(30, 34, 50) })
	part(world, { Name = "EventBoardPost", Size = Vector3.new(1, 4, 1), Position = Vector3.new(eb.x, 1.5, eb.z), Color = Color3.fromRGB(60, 60, 70) })
	MapService.eventLabel = MapService.billboard(board, "Eventos", UDim2.fromOffset(360, 110), 0)
	MapService.eventLabel.Parent.AlwaysOnTop = false
end

local function buildBase(world, index)
	local b = MapConfig.Bases[index]
	local color = rgb(MapConfig.BaseColors[index])
	local folder = Instance.new("Folder")
	folder.Name = "Base" .. index
	folder.Parent = world
	local size = MapConfig.BaseSize
	part(folder, { Name = "Floor", Size = Vector3.new(size, 1, size), Position = Vector3.new(b.x, 0.5, b.z), Color = Color3.fromRGB(70, 74, 92), Material = Enum.Material.Slate })
	part(folder, { Name = "Rim", Size = Vector3.new(size + 2, 0.6, size + 2), Position = Vector3.new(b.x, 0.3, b.z), Color = color, Material = Enum.Material.Neon })
	-- paredes (fundo e laterais) e entrada voltada para a praça
	local wallColor = color:Lerp(Color3.fromRGB(40, 40, 50), 0.55)
	part(folder, { Name = "WallBack", Size = Vector3.new(size, 10, 2), Position = Vector3.new(b.x, 5.5, b.z - b.facing * size / 2), Color = wallColor })
	part(folder, { Name = "WallLeft", Size = Vector3.new(2, 10, size), Position = Vector3.new(b.x - size / 2, 5.5, b.z), Color = wallColor })
	part(folder, { Name = "WallRight", Size = Vector3.new(2, 10, size), Position = Vector3.new(b.x + size / 2, 5.5, b.z), Color = wallColor })
	local frontZ = b.z + b.facing * size / 2
	part(folder, { Name = "WallFrontL", Size = Vector3.new(size / 2 - 9, 10, 2), Position = Vector3.new(b.x - size / 4 - 4.5, 5.5, frontZ), Color = wallColor })
	part(folder, { Name = "WallFrontR", Size = Vector3.new(size / 2 - 9, 10, 2), Position = Vector3.new(b.x + size / 4 + 4.5, 5.5, frontZ), Color = wallColor })
	-- laser da entrada (aparece com o escudo ligado)
	local laser = {}
	for i = 0, 3 do
		table.insert(laser, part(folder, { Name = "Laser", Size = Vector3.new(18, 0.4, 0.4), Position = Vector3.new(b.x, 1.5 + i * 2.2, frontZ), Color = Color3.fromRGB(255, 50, 60), Material = Enum.Material.Neon, CanCollide = false, Transparency = 1 }))
	end
	-- placa do dono
	local signPost = part(folder, { Name = "OwnerSign", Size = Vector3.new(20, 5, 1), Position = Vector3.new(b.x, 14, frontZ), Color = color })
	local sign = MapService.billboard(signPost, "Base livre", UDim2.fromOffset(320, 70), 2)
	-- pedestais
	local pads = {}
	for i = 1, GameConfig.Base.MaxSlotsShown do
		local x, z = MapConfig.padPosition(index, i)
		pads[i] = part(folder, { Name = "Pad" .. i, Size = Vector3.new(8, 1, 8), Position = Vector3.new(x, 1.3, z), Color = Color3.fromRGB(45, 48, 62), Material = Enum.Material.Metal, Transparency = 0.6 })
	end
	-- terminais
	local cx, cz = MapConfig.toWorld(index, MapConfig.Terminal.collect.lx, MapConfig.Terminal.collect.lz)
	local collect = part(folder, { Name = "CollectTerminal", Size = Vector3.new(6, 4, 3), Position = Vector3.new(cx, 3, cz), Color = Color3.fromRGB(255, 200, 60), Material = Enum.Material.Neon })
	MapService.billboard(collect, "💰 COLETAR", UDim2.fromOffset(160, 40), 4)
	local sx, sz = MapConfig.toWorld(index, MapConfig.Terminal.shield.lx, MapConfig.Terminal.shield.lz)
	local shield = part(folder, { Name = "ShieldTerminal", Size = Vector3.new(6, 4, 3), Position = Vector3.new(sx, 3, sz), Color = Color3.fromRGB(80, 170, 255), Material = Enum.Material.Neon })
	local shieldLabel = MapService.billboard(shield, "🛡️ TRAVAR BASE", UDim2.fromOffset(200, 40), 4)
	local spx, spz = MapConfig.toWorld(index, MapConfig.Terminal.spawn.lx, MapConfig.Terminal.spawn.lz)
	MapService.bases[index] = {
		folder = folder,
		pads = pads,
		laser = laser,
		sign = sign,
		shieldLabel = shieldLabel,
		collectPrompt = prompt(collect, "Coletar tudo", "Sua base", { distance = 12, attributes = { OwnerOnly = true, BaseIndex = index, Action = "collect" } }),
		shieldPrompt = prompt(shield, "Travar base", "Escudo", { distance = 12, attributes = { OwnerOnly = true, BaseIndex = index, Action = "shield" } }),
		spawn = Vector3.new(spx, 4, spz),
		color = color,
	}
end

function MapService.init()
	local world = Instance.new("Folder")
	world.Name = "MutantWorld"
	buildPlaza(world)
	MapService.belt = buildConveyor(world)
	buildKiosks(world)
	for i = 1, #MapConfig.Bases do
		buildBase(world, i)
	end
	local creatures = Instance.new("Folder")
	creatures.Name = "Creatures"
	creatures.Parent = world
	MapService.creatureFolder = creatures
	local belt = Instance.new("Folder")
	belt.Name = "ConveyorItems"
	belt.Parent = world
	MapService.beltFolder = belt
	world.Parent = workspace
	MapService.world = world
end

function MapService.start() end

return MapService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000031"><Properties><string name="Name">PlayerDataService</string><ProtectedString name="Source"><![CDATA[-- PlayerDataService: perfil persistente por jogador com trava de sessão.
--
-- * Um único documento por jogador (moedas, criaturas e progresso juntos) => operações atômicas.
-- * Trava de sessão via UpdateAsync: um servidor só grava se for o dono da trava,
--   evitando gravações conflitantes e duplicação de itens entre servidores.
-- * Salvamento automático periódico + salvamento rápido após operações importantes,
--   além do salvamento ao sair e no BindToClose (não depende só da saída).
-- * Toda alteração passa por PlayerDataService:Run, que faz cópia de segurança e
--   restaura o perfil se algo falhar no meio (nenhuma perda ou duplicação parcial).

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local ProfileSchema = require(Shared.Logic.ProfileSchema)
local ProfileOps = require(Shared.Logic.ProfileOps)
local ClientView = require(Shared.Logic.ClientView)
local Income = require(Shared.Logic.Income)

local Remotes = require(script.Parent.Parent.Core.Remotes)

local PlayerDataService = {}

local STORE_NAME = "MutantFactory_Profiles_v1"
local LOCK_STALE_SECONDS = 15 * 60 -- trava considerada abandonada após 15 min sem renovação
local AUTOSAVE_INTERVAL = 60
local SOON_SAVE_DELAY = 3
local LOAD_ATTEMPTS = 6

local store = nil
local memoryMode = false -- sem acesso a DataStore (ex.: Studio sem permissão de API)

local sessions = {} -- [player] = { profile, dirty, saving, soonScheduled, valid, key }
local releasing = {} -- [userId] = true enquanto a gravação final de saída está em andamento
local rng = Random.new()
local listeners = { loaded = {}, changed = {} }
local lockProvider = nil -- function(player) -> { [uid] = true } (criaturas sendo carregadas)
local viewExtraProvider = nil -- function(player) -> dados do mundo para a fotografia

local function now()
	return DateTime.now().UnixTimestamp
end

-- ctx de uma operação: horário e RNG do SERVIDOR e as criaturas travadas (sendo roubadas).
function PlayerDataService.newContext(player)
	return {
		now = now(),
		locked = (lockProvider and player) and lockProvider(player) or {},
		rng = function()
			return rng:NextNumber()
		end,
	}
end

function PlayerDataService.setLockProvider(fn)
	lockProvider = fn
end

function PlayerDataService.setViewExtraProvider(fn)
	viewExtraProvider = fn
end

function PlayerDataService.now()
	return now()
end

local function deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in pairs(t) do
		out[k] = deepCopy(v)
	end
	return out
end

local function keyFor(userId)
	return "p_" .. tostring(userId)
end

---------------------------------------------------------------------------
-- DataStore com tentativas
---------------------------------------------------------------------------

local function updateWithRetry(key, transform, attempts)
	attempts = attempts or 4
	local lastErr
	for i = 1, attempts do
		local ok, result = pcall(function()
			return store:UpdateAsync(key, transform)
		end)
		if ok then
			return true, result
		end
		lastErr = result
		warn(string.format("[PlayerData] UpdateAsync falhou (%d/%d) %s: %s", i, attempts, key, tostring(result)))
		task.wait(math.min(2 ^ i, 10))
	end
	return false, lastErr
end

---------------------------------------------------------------------------
-- carga
---------------------------------------------------------------------------

local function loadProfile(player)
	local key = keyFor(player.UserId)
	if memoryMode then
		return ProfileSchema.new(now()), nil
	end

	for attempt = 1, LOAD_ATTEMPTS do
		local lockedByOther = false
		local t = now()
		local ok, record = updateWithRetry(key, function(old)
			if old and old.lock and old.lock.jobId ~= game.JobId and (t - (old.lock.time or 0)) < LOCK_STALE_SECONDS then
				lockedByOther = true
				return nil -- cancela: outro servidor ainda é dono da sessão
			end
			old = old or {}
			old.lock = { jobId = game.JobId, time = t }
			return old
		end)
		if not ok then
			return nil, "datastore_error"
		end
		if not lockedByOther then
			local data = record and record.data
			if data == nil then
				data = ProfileSchema.new(t)
			end
			return data, nil
		end
		warn(string.format("[PlayerData] perfil de %s travado por outro servidor (tentativa %d)", player.Name, attempt))
		task.wait(5)
		if not player.Parent then
			return nil, "left"
		end
	end
	return nil, "locked"
end

---------------------------------------------------------------------------
-- gravação
---------------------------------------------------------------------------

local function saveSession(player, session, release)
	if memoryMode or not session.valid then
		return true
	end
	if session.saving then
		-- aguarda a gravação em andamento terminar
		local waited = 0
		while session.saving and waited < 30 do
			task.wait(0.25)
			waited = waited + 0.25
		end
	end
	session.saving = true
	local t = now()
	local snapshot = deepCopy(session.profile)
	session.dirty = false
	local lostLock = false
	local ok, err = updateWithRetry(session.key, function(old)
		if old and old.lock and old.lock.jobId ~= game.JobId then
			lostLock = true
			return nil -- outro servidor assumiu: não sobrescreve
		end
		return {
			data = snapshot,
			lock = (not release) and { jobId = game.JobId, time = t } or nil,
			savedAt = t,
			schema = ProfileSchema.Version,
		}
	end)
	session.saving = false
	if not ok then
		session.dirty = true
		warn("[PlayerData] não foi possível salvar " .. player.Name .. ": " .. tostring(err))
		return false
	end
	if lostLock then
		session.valid = false
		warn("[PlayerData] trava perdida para " .. player.Name .. "; sessão encerrada sem gravar")
		if player.Parent then
			player:Kick("Seus dados foram abertos em outro servidor. Entre novamente.")
		end
		return false
	end
	return true
end

function PlayerDataService.saveSoon(player)
	local session = sessions[player]
	if not session or session.soonScheduled then
		return
	end
	session.soonScheduled = true
	task.delay(SOON_SAVE_DELAY, function()
		session.soonScheduled = false
		if sessions[player] == session then
			saveSession(player, session, false)
		end
	end)
end

---------------------------------------------------------------------------
-- API para os serviços
---------------------------------------------------------------------------

function PlayerDataService.getProfile(player)
	local s = sessions[player]
	if s and s.valid then
		return s.profile
	end
	return nil
end

function PlayerDataService.isLoaded(player)
	return PlayerDataService.getProfile(player) ~= nil
end

function PlayerDataService.onLoaded(fn)
	table.insert(listeners.loaded, fn)
end

function PlayerDataService.onChanged(fn)
	table.insert(listeners.changed, fn)
end

-- Executa uma operação sobre o perfil. fn(profile, ctx) -> ok, dataOuCodigo
-- Retorna a resposta no formato do remote: { ok, data } ou { ok=false, error, message }.
-- opts = { important = bool (salva logo), silent = bool (não envia fotografia) }
function PlayerDataService.run(player, fn, opts)
	opts = opts or {}
	local session = sessions[player]
	if not session or not session.valid then
		return Remotes.fail("not_loaded", "Seus dados ainda estão carregando.")
	end
	local backup = deepCopy(session.profile)
	local ctx = PlayerDataService.newContext(player)
	local success, ok, data = pcall(fn, session.profile, ctx)
	if not success then
		session.profile = backup -- restaura tudo: falha parcial não altera nada
		warn("[PlayerData] operação falhou e foi revertida para " .. player.Name .. ": " .. tostring(ok))
		return Remotes.fail("server_error", "Erro no servidor. Nada foi alterado.")
	end
	if not ok then
		session.profile = backup -- validação falhou: garante que nada mudou
		return Remotes.fail(data, ProfileOps.Messages[data] or "Operação recusada.")
	end
	session.dirty = true
	if opts.important then
		PlayerDataService.saveSoon(player)
	end
	for _, l in ipairs(listeners.changed) do
		task.spawn(l, player, session.profile)
	end
	if not opts.silent then
		PlayerDataService.push(player)
	end
	return { ok = true, data = data }
end

-- Operação atômica sobre DOIS perfis do mesmo servidor (roubo).
-- fn(perfilA, perfilB, ctx) -> ok, dados. Se falhar, os dois perfis voltam como estavam.
-- Os dois são salvos logo em seguida (salvamento rápido).
function PlayerDataService.runPair(playerA, playerB, fn)
	local sa, sb = sessions[playerA], sessions[playerB]
	if not sa or not sa.valid or not sb or not sb.valid or sa == sb then
		return Remotes.fail("not_loaded", "Dados indisponíveis.")
	end
	local backupA, backupB = deepCopy(sa.profile), deepCopy(sb.profile)
	local ctx = PlayerDataService.newContext(nil)
	local success, ok, data = pcall(fn, sa.profile, sb.profile, ctx)
	if not success or not ok then
		sa.profile, sb.profile = backupA, backupB
		if not success then
			warn("[PlayerData] operação dupla revertida: " .. tostring(ok))
			return Remotes.fail("server_error", "Erro no servidor. Nada foi alterado.")
		end
		return Remotes.fail(data, ProfileOps.Messages[data] or "Operação recusada.")
	end
	for _, pair in ipairs({ { playerA, sa }, { playerB, sb } }) do
		pair[2].dirty = true
		PlayerDataService.saveSoon(pair[1])
		for _, l in ipairs(listeners.changed) do
			task.spawn(l, pair[1], pair[2].profile)
		end
		PlayerDataService.push(pair[1])
	end
	return { ok = true, data = data }
end

-- Envia a fotografia atualizada (agrupando várias alterações no mesmo quadro).
function PlayerDataService.push(player)
	local session = sessions[player]
	if not session or session.pushScheduled then
		return
	end
	session.pushScheduled = true
	task.defer(function()
		session.pushScheduled = false
		if sessions[player] ~= session or not session.valid or not player.Parent then
			return
		end
		Remotes.event("DataUpdated"):FireClient(player, PlayerDataService.buildView(player, session.profile))
	end)
end

function PlayerDataService.snapshot(player)
	local session = sessions[player]
	if not session or not session.valid then
		return nil
	end
	return PlayerDataService.buildView(player, session.profile)
end

function PlayerDataService.buildView(player, profile)
	local extra = viewExtraProvider and viewExtraProvider(player) or {}
	extra.name = player.DisplayName
	return ClientView.build(profile, now(), extra)
end

---------------------------------------------------------------------------
-- ciclo de vida
---------------------------------------------------------------------------

local function updateLeaderstats(player, profile)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		return
	end
	ls.Moedas.Value = math.floor(profile.coins)
	ls.Renda.Value = math.floor(Income.totalRate(profile))
	ls.Roubos.Value = profile.stats.stolen
end

local function onPlayerAdded(player)
	-- se o jogador acabou de sair deste servidor, espera a gravação final
	local waited = 0
	while releasing[player.UserId] and waited < 30 do
		task.wait(0.5)
		waited = waited + 0.5
	end

	local data, err = loadProfile(player)
	if not player.Parent then
		return
	end
	if not data then
		if err == "locked" then
			player:Kick("Seus dados ainda estão em uso em outro servidor. Tente novamente em alguns minutos.")
		elseif err ~= "left" then
			player:Kick("Não foi possível carregar seus dados (serviço indisponível). Nada foi perdido; tente novamente.")
		end
		return
	end

	local t = now()
	ProfileSchema.migrate(data, t)
	local issues = ProfileSchema.validate(data, t)
	if #issues > 0 then
		warn("[PlayerData] integridade corrigida para " .. player.Name .. ": " .. table.concat(issues, "; "))
	end
	ProfileOps.refreshPeriods(data, t) -- a produção offline já está nos horários de cada criatura

	local session = {
		profile = data,
		dirty = true,
		saving = false,
		valid = true,
		key = keyFor(player.UserId),
	}
	sessions[player] = session

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, def in ipairs({ { "Moedas", "NumberValue" }, { "Renda", "NumberValue" }, { "Roubos", "IntValue" } }) do
		local v = Instance.new(def[2])
		v.Name = def[1]
		v.Parent = ls
	end
	ls.Parent = player
	updateLeaderstats(player, data)

	player:SetAttribute("DataLoaded", true)
	for _, l in ipairs(listeners.loaded) do
		task.spawn(l, player, data)
	end
	PlayerDataService.push(player)
end

local function onPlayerRemoving(player)
	local session = sessions[player]
	Remotes.clearPlayer(player)
	if not session then
		return
	end
	releasing[player.UserId] = true
	saveSession(player, session, true)
	sessions[player] = nil
	releasing[player.UserId] = nil
end

function PlayerDataService.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
		if RunService:IsStudio() then
			-- testa permissão de API no Studio
			local okRead = pcall(function()
				store:GetAsync("__probe")
			end)
			if not okRead then
				memoryMode = true
				warn("[PlayerData] DataStore indisponível no Studio: usando MODO MEMÓRIA (nada será salvo). Ative 'Enable Studio Access to API Services'.")
			end
		end
	else
		memoryMode = true
		warn("[PlayerData] DataStore indisponível: MODO MEMÓRIA. " .. tostring(result))
	end

	PlayerDataService.onChanged(updateLeaderstats)
end

function PlayerDataService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
	end

	-- salvamento automático (também renova a trava de sessão)
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player, session in pairs(sessions) do
				if session.valid then
					task.spawn(saveSession, player, session, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player, session in pairs(sessions) do
			pending = pending + 1
			task.spawn(function()
				saveSession(player, session, true)
				pending = pending - 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)

	Remotes.on("RequestData", "get", "Data", function(player)
		local view = PlayerDataService.snapshot(player)
		if not view then
			return Remotes.fail("not_loaded", "Seus dados ainda estão carregando.")
		end
		return { ok = true, data = view }
	end)
end

PlayerDataService.isMemoryMode = function()
	return memoryMode
end

-- usado por testes no Studio
PlayerDataService._sessions = sessions
PlayerDataService._uuid = function()
	return HttpService:GenerateGUID(false)
end

return PlayerDataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000032"><Properties><string name="Name">StealService</string><ProtectedString name="Source"><![CDATA[-- StealService: roubo de criaturas entre jogadores (sem dano, sem PvP de combate).
--
-- Como funciona:
-- 1. Na base de outro jogador (sem escudo), segure o botão "Roubar" em uma criatura.
-- 2. A criatura vai para a cabeça de quem roubou (anda mais devagar) e o dono é avisado.
-- 3. Se o dono ENCOSTAR em quem está carregando, a criatura volta (defesa).
-- 4. Se quem rouba entrar na própria base, a criatura muda de dono (operação atômica
--    nos dois perfis + salvamento rápido dos dois).
-- 5. Tempo esgotado, personagem morto/reiniciado ou alguém saindo do servidor: ela volta.
--
-- Tudo é validado no servidor: posições, escudo, proteção pós-roubo e vagas livres.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local MapConfig = require(Shared.Config.MapConfig)
local ProfileOps = require(Shared.Logic.ProfileOps)
local CreatureModel = require(Shared.Visual.CreatureModel)

local Remotes = require(script.Parent.Parent.Core.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local BaseService = require(script.Parent.BaseService)

local StealService = {}

local carries = {} -- [thief] = { victim, uid, speciesId, mutationId, startedAt, endsAt, model }
local lockedBy = {} -- [victim] = { [uid] = thief }

local function creatureName(c)
	local s = GameConfig.SpeciesById[c.s or c.speciesId]
	local mId = c.m or c.mutationId
	local m = GameConfig.Mutations[mId]
	return (mId ~= "normal" and (m.name .. " ") or "") .. s.name
end

function StealService.carrying(player)
	local c = carries[player]
	if not c then
		return nil
	end
	return { victim = c.victim.DisplayName, speciesId = c.speciesId, mutationId = c.mutationId, endsAt = c.endsAt }
end

local function lockedFor(victim)
	local out = {}
	for uid in pairs(lockedBy[victim] or {}) do
		out[uid] = true
	end
	return out
end

local function attachModel(thief, c)
	local root = BaseService.root(thief)
	if not root then
		return nil
	end
	local model = CreatureModel.build(c.s, c.m, { anchored = false })
	model.Name = "CarriedCreature"
	local h = CreatureModel.size(c.s)
	model:PivotTo(root.CFrame * CFrame.new(0, 3 + h / 2, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = model.PrimaryPart
	weld.Parent = model.PrimaryPart
	model.Parent = thief.Character
	return model
end

-- encerra um roubo; reason = "delivered" | "tagged" | "timeout" | "cancel"
local function finish(thief, reason)
	local c = carries[thief]
	if not c then
		return
	end
	carries[thief] = nil
	if lockedBy[c.victim] then
		lockedBy[c.victim][c.uid] = nil
	end
	if c.model then
		c.model:Destroy()
	end
	BaseService.setHidden(c.victim, c.uid, false)
	if reason ~= "delivered" then
		BaseService.render(c.victim)
	end
	PlayerDataService.push(thief)
	PlayerDataService.push(c.victim)
end

function StealService.begin(thief, victim, uid)
	if not victim or not victim.Parent or victim == thief then
		return Remotes.fail("invalid_request", "Você não pode roubar da própria base.")
	end
	local thiefProfile = PlayerDataService.getProfile(thief)
	local victimProfile = PlayerDataService.getProfile(victim)
	if not thiefProfile or not victimProfile then
		return Remotes.fail("not_loaded", "Dados carregando.")
	end
	if carries[thief] then
		return Remotes.fail("already_carrying", "Você já está carregando uma criatura.")
	end
	if lockedBy[victim] and lockedBy[victim][uid] then
		return Remotes.fail("being_stolen", "Outra pessoa já está carregando essa criatura.")
	end
	local now = PlayerDataService.now()
	local victimBase = BaseService.baseIndex(victim)
	if not victimBase or BaseService.isShielded(victimBase, now) then
		return Remotes.fail("shielded", "Essa base está com o escudo ligado.")
	end
	-- quem rouba precisa estar dentro da base da vítima, perto da criatura
	local pos = BaseService.position(thief)
	local c = victimProfile.creatures[uid]
	if not pos or not c or MapConfig.baseAt(pos.X, pos.Z) ~= victimBase then
		return Remotes.fail("too_far", "Chegue mais perto da criatura.")
	end
	local px, pz = MapConfig.padPosition(victimBase, c.pad)
	local dx, dz = pos.X - px, pos.Z - pz
	local maxD = GameConfig.Steal.PromptDistance + 3
	if dx * dx + dz * dz > maxD * maxD then
		return Remotes.fail("too_far", "Chegue mais perto da criatura.")
	end
	local ok, code = ProfileOps.canSteal(victimProfile, thiefProfile, uid, now)
	if not ok then
		return Remotes.fail(code, ProfileOps.Messages[code])
	end
	local carry = {
		victim = victim,
		uid = uid,
		speciesId = c.s,
		mutationId = c.m,
		startedAt = now,
		endsAt = now + GameConfig.Steal.MaxCarrySeconds,
	}
	carries[thief] = carry
	lockedBy[victim] = lockedBy[victim] or {}
	lockedBy[victim][uid] = thief
	BaseService.setHidden(victim, uid, true)
	carry.model = attachModel(thief, c)
	local name = creatureName(c)
	BaseService.notify(victim, "theft", "🚨 " .. thief.DisplayName .. " pegou seu " .. name .. "! Encoste nele para recuperar!", { thief = thief.DisplayName })
	BaseService.notify(thief, "carry", "🏃 Leve " .. name .. " para a SUA base em " .. GameConfig.Steal.MaxCarrySeconds .. "s!")
	PlayerDataService.push(thief)
	PlayerDataService.push(victim)
	return { ok = true, data = { uid = uid } }
end

local function deliver(thief, c)
	local res = PlayerDataService.runPair(c.victim, thief, function(victimProfile, thiefProfile, ctx)
		return ProfileOps.completeSteal(victimProfile, thiefProfile, c.uid, ctx.now)
	end)
	finish(thief, "delivered")
	if res.ok then
		local name = creatureName(res.data.creature)
		BaseService.notify(thief, "good", "😈 Você roubou " .. name .. "!")
		BaseService.notify(c.victim, "theft", "😭 " .. thief.DisplayName .. " levou seu " .. name .. ". Você recebeu o que ele tinha guardado.")
	else
		BaseService.notify(thief, "error", res.message or "Não foi possível concluir o roubo.")
	end
	return res
end

-- verificação periódica de todos os roubos em andamento
function StealService.tick(now)
	for thief, c in pairs(carries) do
		local tpos = BaseService.position(thief)
		local char = thief.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not thief.Parent or not c.victim.Parent or not tpos or (hum and hum.Health <= 0) then
			finish(thief, "cancel")
			if c.victim.Parent then
				BaseService.notify(c.victim, "good", "✅ Sua criatura voltou para a base.")
			end
		elseif now >= c.endsAt then
			finish(thief, "timeout")
			BaseService.notify(thief, "error", "⌛ Tempo esgotado! A criatura voltou para a base do dono.")
			BaseService.notify(c.victim, "good", "✅ O ladrão demorou demais. Sua criatura voltou!")
		else
			local vpos = BaseService.position(c.victim)
			local tag = GameConfig.Steal.TagDistance
			if vpos and ((vpos.X - tpos.X) ^ 2 + (vpos.Z - tpos.Z) ^ 2) <= tag * tag then
				finish(thief, "tagged")
				PlayerDataService.run(c.victim, function(profile, ctx)
					ProfileOps.recordDefense(profile, ctx.now)
					return true, {}
				end)
				BaseService.notify(c.victim, "good", "🛡️ Você pegou " .. thief.DisplayName .. "! A criatura voltou.")
				BaseService.notify(thief, "error", "🙀 " .. c.victim.DisplayName .. " te pegou! A criatura voltou para a base dele.")
			elseif MapConfig.inDelivery(BaseService.baseIndex(thief), tpos.X, tpos.Z) then
				deliver(thief, c)
			end
		end
	end
end

function StealService.init()
	BaseService.carryingProvider = StealService.carrying
	BaseService.shieldHook = function(owner, baseIndex)
		for thief, c in pairs(carries) do
			local pos = BaseService.position(thief)
			if c.victim == owner and pos and MapConfig.baseAt(pos.X, pos.Z) == baseIndex then
				finish(thief, "cancel")
				BaseService.notify(thief, "error", "🛡️ O escudo ligou com você dentro! A criatura voltou.")
				BaseService.notify(owner, "good", "🛡️ Escudo ligado a tempo: sua criatura voltou!")
			end
		end
	end
	PlayerDataService.setLockProvider(lockedFor)
	BaseService.promptHandlers.Steal = function(prompt, player)
		local ownerId = prompt:GetAttribute("OwnerUserId")
		local victim = Players:GetPlayerByUserId(ownerId)
		local res = StealService.begin(player, victim, prompt:GetAttribute("Uid"))
		if not res.ok then
			BaseService.notify(player, "error", res.message)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		-- quem sai no meio de um roubo: a criatura volta; quem é roubado e sai: o roubo é cancelado
		finish(player, "cancel")
		for thief, c in pairs(carries) do
			if c.victim == player then
				finish(thief, "cancel")
				BaseService.notify(thief, "error", "O dono saiu do servidor. A criatura voltou.")
			end
		end
		lockedBy[player] = nil
	end)
end

function StealService.start()
	task.spawn(function()
		while true do
			task.wait(0.2)
			StealService.tick(PlayerDataService.now())
		end
	end)
end

StealService._carries = carries

return StealService
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX000051"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX000050"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX000049"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX000043"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX000036"><Properties><string name="Name">BaseController</string><ProtectedString name="Source"><![CDATA[-- BaseController: painel da Base — criaturas nos pedestais (renda, guardado, valor, vender)
-- e melhorias (pedestais, cofre, escudo, velocidade).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Format = require(Shared.Util.Format)

local UI = require(script.Parent.UIController)
local Net = require(script.Parent.Parent.Util.Net)
local Store = require(script.Parent.Parent.Util.Store)

local Base = {}

local function sell(c)
	local s = GameConfig.SpeciesById[c.speciesId]
	local valuable = GameConfig.tier(s.rarity) >= GameConfig.ValuableConfirmTier
	local function doSell()
		local res = Net.call("BaseAction", { action = "sell", uid = c.uid, confirm = valuable })
		UI.handle(res, res.ok and ("Vendida por $" .. Format.short(res.data.coins + res.data.collected)) or nil)
	end
	if valuable then
		UI.confirm({
			title = "Vender criatura valiosa?",
			message = "Vender " .. UI.creatureName(c.speciesId, c.mutationId) .. " por $" .. Format.short(c.sellPrice) .. " (50% do valor) + o que estiver guardado. Não dá para desfazer.",
			confirmText = "Vender",
			danger = true,
			onConfirm = doSell,
		})
	else
		doSell()
	end
end

local function build()
	local p = UI.createPanel("🏠 Minha base", 900, 580, "BaseManager")
	local summary = UI.text({ Text = "", TextSize = 15, Size = UDim2.new(1, 0, 0, 44), Parent = p.content })
	local left = UI.scroll({ Position = UDim2.fromOffset(0, 50), Size = UDim2.new(0.6, -8, 1, -50), Parent = p.content })
	UI.list(left, 6)
	local right = UI.scroll({ Position = UDim2.new(0.6, 8, 0, 50), Size = UDim2.new(0.4, -8, 1, -50), Parent = p.content })
	UI.list(right, 8)

	local function refresh(view)
		summary.Text = string.format(
			"Renda: <font color='#7CFF8A'>+$%s/s</font>  •  Guardado: <font color='#FFD84A'>$%s</font>  •  Pedestais: %d/%d  •  Cofre: %s por criatura  •  Escudo: %ds",
			Format.short(view.rate * (view.boost or 1)),
			Format.short(Store.pendingLive()),
			#view.creatures,
			view.slots,
			Format.duration(view.storageSeconds),
			view.shieldSeconds
		) .. "\n<font color='#9FB5A8'>Colete no terminal amarelo da base (ou no botão COLETAR estando dentro dela).</font>"
		UI.clear(left)
		if #view.creatures == 0 then
			UI.text({ Text = "Sua base está vazia. Compre criaturas na esteira da praça ou abra ovos nos quiosques!", TextSize = 16, TextColor3 = UI.Theme.muted, Size = UDim2.new(1, -8, 0, 60), Parent = left })
		end
		for i, c in ipairs(view.creatures) do
			local s = GameConfig.SpeciesById[c.speciesId]
			local row = UI.frame({ Size = UDim2.new(1, -8, 0, 64), LayoutOrder = i, Parent = left })
			UI.corner(row, 10)
			UI.stroke(row, UI.rarityColor(s.rarity), 2, 0.4)
			local vp = UI.creatureViewport(c.speciesId, c.mutationId, UDim2.fromOffset(60, 60))
			vp.Position = UDim2.fromOffset(2, 2)
			vp.Parent = row
			local protected = (c.protectedUntil or 0) > Store.serverNow()
			UI.text({ Text = "#" .. c.pad .. "  " .. UI.creatureName(c.speciesId, c.mutationId, true) .. (protected and "  🛡️" or ""), Font = UI.Fonts.bold, TextSize = 16, Size = UDim2.new(1, -200, 0, 24), Position = UDim2.fromOffset(68, 6), Parent = row })
			UI.text({ Text = "+$" .. Format.short(c.rate) .. "/s  •  guardado $" .. Format.short(c.pending) .. "  •  valor $" .. Format.short(c.value), TextSize = 13, TextColor3 = UI.Theme.muted, Size = UDim2.new(1, -200, 0, 22), Position = UDim2.fromOffset(68, 32), Parent = row })
			UI.button({ Text = "Vender $" .. Format.short(c.sellPrice), TextSize = 14, color = UI.Theme.bad, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(120, 40), Parent = row, onClick = function()
				sell(c)
			end })
		end
		UI.clear(right)
		UI.text({ Text = "Melhorias", Font = UI.Fonts.title, TextSize = 22, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 0, Parent = right })
		for i, u in ipairs(view.upgrades) do
			local row = UI.frame({ Size = UDim2.new(1, -8, 0, 96), LayoutOrder = i, Parent = right })
			UI.corner(row, 10)
			UI.text({ Text = "<b>" .. u.name .. "</b>  " .. u.level .. "/" .. u.maxLevel, TextSize = 16, Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(10, 6), Parent = row })
			UI.text({ Text = u.description, TextSize = 13, TextColor3 = UI.Theme.muted, Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(10, 28), Parent = row })
			local maxed = u.cost == nil
			local b = UI.button({
				Text = maxed and "MÁXIMO" or (u.name .. " • $" .. Format.short(u.cost)),
				TextSize = 14,
				color = UI.Theme.accent,
				Position = UDim2.fromOffset(10, 52),
				Size = UDim2.new(1, -20, 0, 36),
				Parent = row,
				onClick = function()
					UI.handle(Net.call("BaseAction", { action = "upgrade", upgradeId = u.id }), u.name .. " melhorado!")
				end,
			})
			UI.setEnabled(b, not maxed and view.coins >= (u.cost or 0), UI.Theme.accent)
		end
	end
	return { frame = p.frame, refresh = refresh }
end

function Base.init()
	UI.register("Base", build)
end

return Base
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000037"><Properties><string name="Name">EggController</string><ProtectedString name="Source"><![CDATA[-- EggController: painel de Ovos (chances exibidas com sorte e evento), animação de chocar
-- e painel de Poções (comprar com moedas, usar e ver as fontes de sorte).

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local EventConfig = require(Shared.Config.EventConfig)
local Odds = require(Shared.Logic.Odds)
local Format = require(Shared.Util.Format)

local UI = require(script.Parent.UIController)
local Net = require(script.Parent.Parent.Util.Net)
local Store = require(script.Parent.Parent.Util.Store)

local Eggs = {}

local selected = "basico"
local hatching = false

local function eventDef(view)
	if not view.event then
		return nil
	end
	for _, t in ipairs(EventConfig.Types) do
		if t.id == view.event.id then
			return t
		end
	end
	return nil
end

local function pctText(p)
	if p >= 0.1 then
		return string.format("%.1f%%", p * 100):gsub("%.", ",")
	end
	return (string.format("%.2f%%", p * 100):gsub("%.", ","))
end

---------------------------------------------------------------------------
-- animação de chocar
---------------------------------------------------------------------------

local function reveal(data, eggId)
	local overlay = UI.layers.Overlay
	UI.clear(overlay)
	local shade = UI.frame({ BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, Size = UDim2.fromScale(1, 1), Parent = overlay })
	local egg = GameConfig.Eggs[eggId]
	local eggFrame = UI.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(170, 220), BackgroundColor3 = UI.rgb(egg.color), Parent = shade })
	UI.corner(eggFrame, 85)
	UI.stroke(eggFrame, Color3.new(1, 1, 1), 4, 0.3)
	local reduce = Store.view and Store.view.settings and Store.view.settings.reduceEffects
	if not reduce then
		for i = 1, 6 do
			TweenService:Create(eggFrame, TweenInfo.new(0.1), { Rotation = (i % 2 == 0) and 12 or -12 }):Play()
			task.wait(0.12)
		end
	else
		task.wait(0.3)
	end
	eggFrame:Destroy()
	local s = GameConfig.SpeciesById[data.speciesId]
	local card = UI.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromOffset(420, 420), BackgroundColor3 = UI.Theme.panel, Parent = shade })
	UI.corner(card, 18)
	UI.stroke(card, UI.rarityColor(s.rarity), 4, 0)
	local vp = UI.creatureViewport(data.speciesId, data.mutationId, UDim2.new(1, -40, 0, 230), { spin = true, zoom = 1.3 })
	vp.Position = UDim2.fromOffset(20, 14)
	vp.Parent = card
	UI.text({ Text = UI.creatureName(data.speciesId, data.mutationId, true), Font = UI.Fonts.title, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 248), Parent = card })
	local m = GameConfig.Mutations[data.mutationId]
	UI.text({
		Text = GameConfig.Rarities[s.rarity].displayName .. "  •  +$" .. Format.short(s.income * m.mult) .. "/s" .. (data.isNew and "  •  <font color='#FFD84A'>NOVO NO ÍNDICE!</font>" or ""),
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -20, 0, 26),
		Position = UDim2.fromOffset(10, 290),
		Parent = card,
	})
	local row = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -40, 0, 50), Position = UDim2.fromOffset(20, 340), Parent = card })
	UI.list(row, 12, true, Enum.HorizontalAlignment.Center)
	UI.button({ Text = "OK", color = UI.Theme.panel2, Size = UDim2.fromOffset(150, 46), Parent = row, onClick = function()
		UI.clear(overlay)
	end })
	UI.button({ Text = "ABRIR OUTRO", color = UI.Theme.good, Size = UDim2.fromOffset(200, 46), Parent = row, onClick = function()
		UI.clear(overlay)
		Eggs.hatch(eggId)
	end })
	if GameConfig.tier(s.rarity) >= 5 or m.tier >= 3 then
		UI.toast("✨ " .. UI.creatureName(data.speciesId, data.mutationId) .. "!", "rare")
	end
end

function Eggs.hatch(eggId)
	if hatching then
		return
	end
	hatching = true
	local res = Net.call("EggAction", { action = "hatch", eggId = eggId })
	if UI.handle(res) then
		UI.close(true)
		task.spawn(function()
			reveal(res.data, eggId)
		end)
	end
	hatching = false
end

---------------------------------------------------------------------------
-- painel de ovos
---------------------------------------------------------------------------

local function buildEggs()
	local p = UI.createPanel("🥚 Ovos", 860, 560, "EggShop")
	local tabs = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(0, 220, 1, 0), Parent = p.content })
	UI.list(tabs, 8)
	local detail = UI.frame({ BackgroundTransparency = 1, Position = UDim2.fromOffset(236, 0), Size = UDim2.new(1, -236, 1, 0), Parent = p.content })
	local header = UI.text({ Text = "", Font = UI.Fonts.title, TextSize = 24, Size = UDim2.new(1, 0, 0, 30), Parent = detail })
	local info = UI.text({ Text = "", TextSize = 14, TextColor3 = UI.Theme.muted, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 32), Parent = detail })
	local list = UI.scroll({ Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 1, -140), Parent = detail })
	UI.list(list, 4)
	local openBtn = UI.button({ Text = "ABRIR", color = UI.Theme.good, TextSize = 20, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 54), Parent = detail, onClick = function()
		Eggs.hatch(selected)
	end })

	local function refresh(view)
		UI.clear(tabs)
		for i, id in ipairs(GameConfig.EggOrder) do
			local egg = GameConfig.Eggs[id]
			local locked = view.rebirths < egg.requiredRebirths
			UI.button({
				Text = egg.name .. "\n$" .. Format.short(egg.price) .. (locked and "  🔒" or ""),
				TextSize = 16,
				LayoutOrder = i,
				color = id == selected and UI.rgb(egg.color) or UI.Theme.panel2,
				Size = UDim2.new(1, 0, 0, 64),
				Parent = tabs,
				onClick = function()
					selected = id
					refresh(Store.view)
				end,
			})
		end
		local egg = GameConfig.Eggs[selected]
		local ev = eventDef(view)
		local species = Odds.speciesTable(egg.rarityWeights, view.luck)
		local mutations = Odds.mutationTable(view.luck, ev)
		header.Text = egg.name .. " — $" .. Format.int(egg.price)
		info.Text = "Sorte +" .. math.floor(view.luck * 100 + 0.5) .. "%" .. (ev and ("  •  " .. ev.icon .. " " .. ev.name) or "") .. "  •  Vagas: " .. #view.creatures .. "/" .. view.slots .. "\nAs chances abaixo já incluem sua sorte e o evento ativo."
		UI.clear(list)
		local shown = Odds.displayPercents(species, 2)
		for i, e in ipairs(species) do
			local s = GameConfig.SpeciesById[e.speciesId]
			local row = UI.frame({ BackgroundColor3 = UI.Theme.panel2, Size = UDim2.new(1, -8, 0, 30), LayoutOrder = i, Parent = list })
			UI.corner(row, 8)
			UI.text({ Text = UI.creatureName(e.speciesId, "normal", true) .. "  <font color='#9FB5A8'>" .. GameConfig.Rarities[s.rarity].displayName .. " • +$" .. Format.short(s.income) .. "/s</font>", TextSize = 15, Size = UDim2.new(1, -100, 1, 0), Position = UDim2.fromOffset(10, 0), Parent = row })
			UI.text({ Text = string.gsub(string.format("%.2f%%", shown[i]), "%.", ","), Font = UI.Fonts.bold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0, 90, 1, 0), Position = UDim2.new(1, -96, 0, 0), Parent = row })
		end
		local mutText = {}
		for _, e in ipairs(mutations) do
			local m = GameConfig.Mutations[e.mutationId]
			table.insert(mutText, m.name .. " ×" .. m.mult .. ": " .. pctText(e.p))
		end
		UI.text({ Text = "<b>Mutações:</b> " .. table.concat(mutText, "  •  "), TextSize = 14, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -8, 0, 0), LayoutOrder = 100, Parent = list })
		local locked = view.rebirths < egg.requiredRebirths
		local full = #view.creatures >= view.slots
		openBtn.Text = locked and "🔒 Libera depois do 1º renascimento" or (full and "Base cheia — venda ou compre pedestais" or ("ABRIR $" .. Format.short(egg.price)))
		UI.setEnabled(openBtn, not locked and not full and view.coins >= egg.price, UI.Theme.good)
	end

	return {
		frame = p.frame,
		refresh = refresh,
		onOpen = function(args)
			if args and args.eggId and GameConfig.Eggs[args.eggId] then
				selected = args.eggId
			end
		end,
	}
end

---------------------------------------------------------------------------
-- painel de poções
---------------------------------------------------------------------------

local function buildPotions()
	local p = UI.createPanel("🧪 Poções e sorte", 760, 520, "PotionShop")
	local list = UI.scroll({ Size = UDim2.fromScale(1, 1), Parent = p.content })
	UI.list(list, 8)
	return {
		frame = p.frame,
		refresh = function(view)
			UI.clear(list)
			local now = Store.serverNow()
			for i, id in ipairs(GameConfig.PotionOrder) do
				local def = GameConfig.Potions[id]
				local row = UI.frame({ Size = UDim2.new(1, -8, 0, 84), LayoutOrder = i, Parent = list })
				UI.corner(row, 12)
				local active = (view.activePotions[id] or 0) - now
				UI.text({ Text = def.icon .. " <b>" .. def.name .. "</b>  (" .. (view.potions[id] or 0) .. " guardadas)" .. (active > 0 and ("  <font color='#7CFF8A'>ativa " .. Format.duration(active) .. "</font>") or ""), TextSize = 17, Size = UDim2.new(1, -330, 0, 28), Position = UDim2.fromOffset(12, 8), Parent = row })
				UI.text({ Text = def.description .. " Dura " .. Format.duration(def.duration) .. " (acumula até " .. Format.duration(def.maxStack) .. ").", TextSize = 13, TextColor3 = UI.Theme.muted, Size = UDim2.new(1, -330, 0, 40), Position = UDim2.fromOffset(12, 36), Parent = row })
				local use = UI.button({ Text = "USAR", color = UI.Theme.good, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -170, 0.5, 0), Size = UDim2.fromOffset(140, 44), Parent = row, onClick = function()
					UI.handle(Net.call("EggAction", { action = "usePotion", potionId = id }), def.name .. " ativada!")
				end })
				UI.setEnabled(use, (view.potions[id] or 0) > 0, UI.Theme.good)
				local buy = UI.button({ Text = "COMPRAR $" .. Format.short(def.coinPrice), TextSize = 14, color = UI.Theme.accent, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(150, 44), Parent = row, onClick = function()
					UI.handle(Net.call("EggAction", { action = "buyPotion", potionId = id }), "Comprada!")
				end })
				UI.setEnabled(buy, view.coins >= def.coinPrice, UI.Theme.accent)
			end
			local sources = {}
			for _, s in ipairs(view.luckSources or {}) do
				table.insert(sources, s.name .. " +" .. math.floor(s.luck * 100 + 0.5) .. "%")
			end
			UI.text({
				Text = "<b>Sua sorte agora: +" .. math.floor(view.luck * 100 + 0.5) .. "%</b> (máximo +" .. math.floor(GameConfig.Luck.Max * 100) .. "%)\n" .. (#sources > 0 and table.concat(sources, "  •  ") or "Nenhuma fonte ativa: use uma Poção da Sorte, renasça ou espere a Hora da Sorte.") .. "\nPoções só se ganham jogando ou com moedas do jogo — nunca com Robux.",
				TextSize = 14,
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = UDim2.new(1, -8, 0, 0),
				LayoutOrder = 10,
				Parent = list,
			})
		end,
	}
end

function Eggs.init()
	UI.register("Eggs", buildEggs)
	UI.register("Potions", buildPotions)
end

return Eggs
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000038"><Properties><string name="Name">HUDController</string><ProtectedString name="Source"><![CDATA[-- HUDController: moedas, renda, evento atual, sorte, poções ativas, menu lateral,
-- estado do escudo e botões rápidos (COLETAR / TRAVAR BASE) e a faixa de quem está carregando.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Format = require(Shared.Util.Format)

local UI = require(script.Parent.UIController)
local Net = require(script.Parent.Parent.Util.Net)
local Store = require(script.Parent.Parent.Util.Store)

local HUD = {}

local refs = {}

local MENU = {
	{ panel = "Eggs", icon = "🥚", label = "OVOS" },
	{ panel = "Base", icon = "🏠", label = "BASE" },
	{ panel = "Index", icon = "📖", label = "ÍNDICE" },
	{ panel = "Missions", icon = "🎯", label = "MISSÕES" },
	{ panel = "Gifts", icon = "🎁", label = "PRESENTES" },
	{ panel = "Potions", icon = "🧪", label = "POÇÕES" },
	{ panel = "Rebirth", icon = "♻️", label = "RENASCER" },
	{ panel = "Ranking", icon = "🏆", label = "RANKING" },
	{ panel = "Settings", icon = "⚙️", label = "AJUSTES" },
}

local function chip(parent, props)
	local f = UI.text(props)
	f.BackgroundTransparency = 0.25
	f.BackgroundColor3 = UI.Theme.panel
	f.TextXAlignment = Enum.TextXAlignment.Center
	f.Font = UI.Fonts.bold
	f.Parent = parent
	UI.corner(f, 10)
	return f
end

local function build()
	local root = UI.layers.HUD

	-- moedas
	local money = UI.frame({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(300, 64), BackgroundColor3 = UI.Theme.panel, BackgroundTransparency = 0.15, Parent = root })
	UI.corner(money, 14)
	UI.stroke(money, UI.Theme.toxic, 2, 0.4)
	refs.coins = UI.text({ Text = "$0", Font = UI.Fonts.title, TextSize = 32, TextColor3 = UI.Theme.accent, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 38), Position = UDim2.fromOffset(0, 2), Parent = money })
	refs.rate = UI.text({ Text = "+$0/s", Font = UI.Fonts.bold, TextSize = 16, TextColor3 = UI.Theme.toxic, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 40), Parent = money })

	-- evento
	refs.event = chip(root, { Text = "", TextSize = 17, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 78), Size = UDim2.fromOffset(460, 32) })
	-- faixa de quem está carregando uma criatura
	refs.carry = chip(root, { Text = "", TextSize = 18, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 116), Size = UDim2.fromOffset(560, 40), Visible = false })
	refs.carry.BackgroundColor3 = Color3.fromRGB(150, 40, 200)
	refs.carry.BackgroundTransparency = 0.05

	-- sorte e poções
	local right = UI.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 8), Size = UDim2.fromOffset(220, 200), Parent = root })
	UI.list(right, 6, false, Enum.HorizontalAlignment.Right)
	refs.luck = UI.button({ Text = "🍀 Sorte +0%", TextSize = 15, color = UI.Theme.panel, Size = UDim2.fromOffset(200, 34), LayoutOrder = 1, Parent = right, onClick = function()
		UI.open("Potions")
	end })
	refs.potions = UI.text({ Text = "", TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromOffset(210, 0), LayoutOrder = 2, Parent = right })

	-- menu lateral
	local side = UI.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(150, 600), Parent = root })
	UI.make("UIGridLayout", { CellSize = UDim2.fromOffset(70, 62), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = side })
	refs.menu = {}
	for i, item in ipairs(MENU) do
		local b = UI.button({
			Name = "Menu_" .. item.panel,
			Text = item.icon .. "\n" .. item.label,
			TextSize = 13,
			color = UI.Theme.panel2,
			LayoutOrder = i,
			Parent = side,
			onClick = function()
				UI.toggle(item.panel)
			end,
		})
		local dot = UI.text({ Text = "!", Font = UI.Fonts.title, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0, BackgroundColor3 = UI.Theme.bad, Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, -14, 0, -6), Visible = false, Parent = b })
		UI.corner(dot, 10)
		refs.menu[item.panel] = { button = b, dot = dot }
	end

	-- base: escudo e coleta
	local bar = UI.frame({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.fromOffset(520, 56), BackgroundTransparency = 1, Parent = root })
	UI.list(bar, 10, true, Enum.HorizontalAlignment.Center)
	refs.shield = UI.button({
		Name = "ShieldButton",
		Text = "🛡️ TRAVAR BASE",
		TextSize = 17,
		color = UI.Theme.blue,
		Size = UDim2.fromOffset(240, 52),
		Parent = bar,
		onClick = function()
			local res = Net.call("BaseAction", { action = "shield" })
			UI.handle(res, res.ok and ("🛡️ Base travada por " .. math.floor(res.data.seconds) .. "s!") or nil)
		end,
	})
	refs.collect = UI.button({
		Name = "CollectButton",
		Text = "💰 COLETAR",
		TextSize = 17,
		color = UI.Theme.good,
		Size = UDim2.fromOffset(240, 52),
		Parent = bar,
		onClick = function()
			local res = Net.call("BaseAction", { action = "collect" })
			UI.handle(res, res.ok and ("💰 +$" .. Format.short(res.data.coins)) or nil)
		end,
	})
end

local function fmtTime(s)
	s = math.max(0, math.floor(s))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

local function tick()
	local v = Store.view
	if not v then
		return
	end
	local now = Store.serverNow()
	refs.coins.Text = "$" .. Format.short(v.coins)
	refs.rate.Text = "+$" .. Format.short(v.rate * (v.boost or 1)) .. "/s" .. ((v.boost or 1) > 1 and ("  (×" .. string.gsub(tostring(v.boost), "%.", ",") .. ")") or "")
	if v.event and v.event.endsAt > now then
		refs.event.Text = v.event.icon .. " " .. v.event.name .. " • " .. fmtTime(v.event.endsAt - now)
		refs.event.BackgroundColor3 = Color3.fromRGB(60, 130, 50)
	elseif v.nextEvent then
		refs.event.Text = "Próximo: " .. v.nextEvent.icon .. " " .. v.nextEvent.name .. " em " .. fmtTime(v.nextEvent.startsAt - now)
		refs.event.BackgroundColor3 = UI.Theme.panel
	end
	refs.luck.Text = "🍀 Sorte +" .. math.floor((v.luck or 0) * 100 + 0.5) .. "%"
	local buffs = {}
	for _, id in ipairs(GameConfig.PotionOrder) do
		local e = v.activePotions and v.activePotions[id] or 0
		if e > now then
			table.insert(buffs, GameConfig.Potions[id].icon .. " " .. fmtTime(e - now))
		end
	end
	refs.potions.Text = table.concat(buffs, "   ")
	-- escudo
	local left = (v.shieldUntil or 0) - now
	if left > 0 then
		refs.shield.Text = "🛡️ TRAVADA " .. math.ceil(left) .. "s"
		UI.setEnabled(refs.shield, false, UI.Theme.blue)
	else
		refs.shield.Text = "🛡️ TRAVAR BASE"
		UI.setEnabled(refs.shield, true, UI.Theme.blue)
	end
	refs.collect.Text = "💰 COLETAR $" .. Format.short(Store.pendingLive())
	-- carregando
	if v.carrying then
		refs.carry.Visible = true
		refs.carry.Text = "🏃 " .. UI.creatureName(v.carrying.speciesId, v.carrying.mutationId) .. " — corra para a SUA base! " .. math.max(0, math.ceil(v.carrying.endsAt - now)) .. "s"
	else
		refs.carry.Visible = false
	end
	-- avisos no menu
	local missionsReady = 0
	for _, m in ipairs(v.missions or {}) do
		if not m.claimed and m.progress >= m.target then
			missionsReady = missionsReady + 1
		end
	end
	refs.menu.Missions.dot.Visible = missionsReady > 0
	refs.menu.Gifts.dot.Visible = v.gifts and v.gifts.available or false
	local milestoneReady = false
	for _, m in ipairs(v.milestones or {}) do
		if m.ready and not m.claimed then
			milestoneReady = true
		end
	end
	refs.menu.Index.dot.Visible = milestoneReady
	refs.menu.Rebirth.dot.Visible = v.rebirth and not v.rebirth.maxed and v.coins >= v.rebirth.cost or false
end

function HUD.init()
	build()
	Store.changed:Connect(tick)
	task.spawn(function()
		while true do
			task.wait(0.5)
			tick()
		end
	end)
end

return HUD
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000039"><Properties><string name="Name">IndexController</string><ProtectedString name="Source"><![CDATA[-- IndexController: índice de criaturas (16 espécies × 6 mutações = 96 combinações)
-- e marcos com recompensa.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Format = require(Shared.Util.Format)

local UI = require(script.Parent.UIController)
local Net = require(script.Parent.Parent.Util.Net)

local Index = {}

local function build()
	local p = UI.createPanel("📖 Índice de mutantes", 920, 590, "IndexBook")
	local header = UI.text({ Text = "", TextSize = 15, Size = UDim2.new(1, 0, 0, 24), Parent = p.content })
	local milestones = UI.scroll({ Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 58), ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X, Parent = p.content })
	UI.list(milestones, 8, true)
	local grid = UI.scroll({ Position = UDim2.fromOffset(0, 94), Size = UDim2.new(1, 0, 1, -94), Parent = p.content })
	UI.list(grid, 4)

	local function refresh(view)
		header.Text = "Descobertas: <b>" .. view.indexCount .. "/" .. view.indexTotal .. "</b> combinações. Cada espécie em cada mutação conta uma vez."
		UI.clear(milestones)
		for i, m in ipairs(view.milestones) do
			local b = UI.button({
				Text = m.count .. " descobertas\n" .. (m.claimed and "✔ resgatado" or UI.rewardText(m.rewardCoins, m.rewardPotions)),
				TextSize = 13,
				LayoutOrder = i,
				color = m.claimed and UI.Theme.panel2 or (m.ready and UI.Theme.good or UI.Theme.locked),
				Size = UDim2.fromOffset(150, 52),
				Parent = milestones,
				onClick = function()
					UI.handle(Net.call("ClaimAction", { action = "milestone", milestoneId = m.id }), "Marco resgatado!")
				end,
			})
			UI.setEnabled(b, m.ready and not m.claimed)
		end
		UI.clear(grid)
		local head = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 22), LayoutOrder = 0, Parent = grid })
		UI.text({ Text = "Espécie", Font = UI.Fonts.bold, TextSize = 13, Size = UDim2.fromOffset(200, 22), Parent = head })
		for j, mid in ipairs(GameConfig.MutationOrder) do
			UI.text({ Text = GameConfig.Mutations[mid].name, Font = UI.Fonts.bold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(100, 22), Position = UDim2.fromOffset(200 + (j - 1) * 106, 0), Parent = head })
		end
		for i, s in ipairs(GameConfig.Species) do
			local row = UI.frame({ Size = UDim2.new(1, -8, 0, 40), LayoutOrder = i, BackgroundTransparency = 0.4, Parent = grid })
			UI.corner(row, 8)
			local anySeen = false
			for _, mid in ipairs(GameConfig.MutationOrder) do
				if view.index[s.id .. ":" .. mid] then
					anySeen = true
				end
			end
			UI.text({ Text = anySeen and UI.creatureName(s.id, "normal", true) or "???", Font = UI.Fonts.bold, TextSize = 15, Size = UDim2.fromOffset(190, 40), Position = UDim2.fromOffset(8, 0), Parent = row })
			for j, mid in ipairs(GameConfig.MutationOrder) do
				local seen = view.index[s.id .. ":" .. mid]
				local cell = UI.frame({ Size = UDim2.fromOffset(100, 32), Position = UDim2.fromOffset(200 + (j - 1) * 106, 4), BackgroundColor3 = seen and UI.rarityColor(s.rarity):Lerp(UI.Theme.panel, 0.35) or UI.Theme.panel, Parent = row })
				UI.corner(cell, 6)
				UI.text({ Text = seen and ("✔ $" .. Format.short(s.income * GameConfig.Mutations[mid].mult) .. "/s") or "—", TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = cell })
			end
		end
	end
	return { frame = p.frame, refresh = refresh }
end

function Index.init()
	UI.register("Index", build)
end

return Index
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000040"><Properties><string name="Name">ProgressPanels</string><ProtectedString name="Source"><![CDATA[-- ProgressPanels: Missões diárias, Presentes, Renascer, Ranking do servidor e Ajustes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Format = require(Shared.Util.Format)

local UI = require(script.Parent.UIController)
local Net = require(script.Parent.Parent.Util.Net)
local Store = require(script.Parent.Parent.Util.Store)

local Panels = {}

local function buildMissions()
	local p = UI.createPanel("🎯 Missões de hoje", 760, 480, "Missions")
	local info = UI.text({ Text = "", TextSize = 14, TextColor3 = UI.Theme.muted, Size = UDim2.new(1, 0, 0, 22), Parent = p.content })
	local list = UI.scroll({ Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 1, -28), Parent = p.content })
	UI.list(list, 8)
	return {
		frame = p.frame,
		refresh = function(view)
			info.Text = "Novas missões em " .. Format.duration(view.missionsResetIn - (Store.serverNow() - view.serverTime)) .. ". As recompensas crescem com a sua renda."
			UI.clear(list)
			for i, m in ipairs(view.missions) do
				local row = UI.frame({ Size = UDim2.new(1, -8, 0, 76), LayoutOrder = i, Parent = list })
				UI.corner(row, 10)
				UI.text({ Text = "<b>" .. m.description .. "</b>", TextSize = 16, Size = UDim2.new(1, -200, 0, 24), Position = UDim2.fromOffset(12, 8), Parent = row })
				UI.text({ Text = Format.int(math.min(m.progress, m.target)) .. "/" .. Format.int(m.target) .. "  •  Prêmio: " .. UI.rewardText(m.rewardCoins, m.rewardPotions), TextSize = 14, TextColor3 = UI.Theme.muted, Size = UDim2.new(1, -200, 0, 20), Position = UDim2.fromOffset(12, 34), Parent = row })
				local bar = UI.frame({ BackgroundColor3 = UI.Theme.bg, Size = UDim2.new(1, -210, 0, 8), Position = UDim2.fromOffset(12, 60), Parent = row })
				UI.corner(bar, 4)
				UI.frame({ BackgroundColor3 = UI.Theme.toxic, Size = UDim2.fromScale(math.min(1, m.progress / m.target), 1), Parent = bar })
				local ready = m.progress >= m.target and not m.claimed
				local b = UI.button({ Text = m.claimed and "✔ Feito" or (ready and "RESGATAR" or "Em andamento"), color = UI.Theme.good, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(160, 44), Parent = row, onClick = function()
					UI.handle(Net.call("ClaimAction", { action = "mission", missionId = m.id }), "Missão concluída!")
				end })
				UI.setEnabled(b, ready, UI.Theme.good)
			end
		end,
	}
end

local function buildGifts()
	local p = UI.createPanel("🎁 Presente diário", 800, 400, "Gifts")
	local row = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 170), Parent = p.content })
	UI.list(row, 8, true, Enum.HorizontalAlignment.Center)
	local info = UI.text({ Text = "", TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 180), Parent = p.content })
	local claim = UI.button({ Text = "RESGATAR", color = UI.Theme.good, TextSize = 20, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 230), Size = UDim2.fromOffset(280, 54), Parent = p.content, onClick = function()
		local res = Net.call("ClaimAction", { action = "gift" })
		UI.handle(res, res.ok and ("🎁 Dia " .. res.data.day .. ": " .. UI.rewardText(res.data.reward.coins, res.data.reward.potions)) or nil)
	end })
	return {
		frame = p.frame,
		refresh = function(view)
			UI.clear(row)
			local g = view.gifts
			for i, r in ipairs(view.giftRewards) do
				local done = i <= g.streak and not (g.available and i >= g.nextStreak)
				local isNext = g.available and i == g.nextStreak
				local cell = UI.frame({ Size = UDim2.fromOffset(98, 160), LayoutOrder = i, BackgroundColor3 = isNext and UI.Theme.good or UI.Theme.panel2, BackgroundTransparency = done and 0.5 or 0, Parent = row })
				UI.corner(cell, 10)
				UI.text({ Text = "Dia " .. i, Font = UI.Fonts.title, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 8), Parent = cell })
				UI.text({ Text = UI.rewardText(r.coins, r.potions) .. (done and "\n✔" or ""), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, -8, 0, 100), Position = UDim2.fromOffset(4, 44), Parent = cell })
			end
			info.Text = g.available and "Seu presente de hoje está pronto! Volte todos os dias para aumentar a sequência." or ("Próximo presente em " .. Format.duration(g.resetsIn - (Store.serverNow() - view.serverTime)) .. ". Perder um dia recomeça a sequência.")
			UI.setEnabled(claim, g.available, UI.Theme.good)
			claim.Text = g.available and "RESGATAR" or "Volte amanhã"
		end,
	}
end

local function buildRebirth()
	local p = UI.createPanel("♻️ Renascer", 680, 440, "Rebirth")
	local text = UI.text({ Text = "", TextSize = 16, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), Parent = p.content })
	local btn = UI.button({ Text = "RENASCER", color = UI.Theme.purple, TextSize = 20, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Size = UDim2.fromOffset(300, 54), Parent = p.content, onClick = function()
		local r = Store.view.rebirth
		UI.confirm({
			title = "Renascer?",
			message = "Você perde TODAS as moedas e as " .. r.creaturesLost .. " criaturas da base. Mantém índice, melhorias e poções. Ganha renda ×" .. string.gsub(tostring(r.incomeAfter), "%.", ",") .. " e sorte +" .. math.floor(r.luckAfter * 100 + 0.5) .. "% para sempre.",
			confirmText = "Renascer",
			danger = true,
			phrase = GameConfig.Rebirth.ConfirmPhrase,
			onConfirm = function(phrase)
				UI.handle(Net.call("ClaimAction", { action = "rebirth", phrase = phrase }), "♻️ Você renasceu!")
			end,
		})
	end })
	return {
		frame = p.frame,
		refresh = function(view)
			local r = view.rebirth
			text.Text = string.format(
				"Renascimentos: <b>%d</b>  •  Renda atual ×%s\n\nPróximo renascimento custa <font color='#FFD84A'><b>$%s</b></font> (você tem $%s).\n\nDepois de renascer:\n• Renda de todas as criaturas ×%s para sempre\n• Sorte +%d%% para sempre\n• Libera o Ovo Lendário\n\nVocê perde as moedas e as criaturas da base. O índice, as melhorias e as poções ficam.",
				view.rebirths,
				string.gsub(tostring(view.incomeMultiplier), "%.", ","),
				Format.short(r.cost),
				Format.short(view.coins),
				string.gsub(tostring(r.incomeAfter), "%.", ","),
				math.floor(r.luckAfter * 100 + 0.5)
			)
			UI.setEnabled(btn, not r.maxed and view.coins >= r.cost, UI.Theme.purple)
			btn.Text = r.maxed and "Máximo atingido" or "RENASCER"
		end,
	}
end

local function buildRanking()
	local p = UI.createPanel("🏆 Ranking do servidor", 720, 480, "Ranking")
	local list = UI.scroll({ Size = UDim2.fromScale(1, 1), Parent = p.content })
	UI.list(list, 6)
	local function load()
		local res = Net.call("RankingRequest", { action = "get" })
		if not res.ok then
			return
		end
		UI.clear(list)
		for i, r in ipairs(res.data) do
			local row = UI.frame({ Size = UDim2.new(1, -8, 0, 46), LayoutOrder = i, Parent = list })
			UI.corner(row, 8)
			UI.text({ Text = "<b>#" .. i .. "  " .. r.name .. "</b>", TextSize = 16, Size = UDim2.new(0.4, 0, 1, 0), Position = UDim2.fromOffset(12, 0), Parent = row })
			UI.text({ Text = "Patrimônio $" .. Format.short(r.netWorth) .. "  •  +$" .. Format.short(r.rate) .. "/s  •  😈 " .. r.stolen .. "  🛡️ " .. r.defended .. "  ♻️ " .. r.rebirths, TextSize = 14, TextColor3 = UI.Theme.muted, Size = UDim2.new(0.6, -12, 1, 0), Position = UDim2.new(0.4, 0, 0, 0), Parent = row })
		end
	end
	return { frame = p.frame, onOpen = function()
		task.spawn(load)
	end }
end

local function buildSettings()
	local p = UI.createPanel("⚙️ Ajustes", 620, 360, "Settings")
	local box = UI.frame({ BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = p.content })
	UI.list(box, 10)
	local reduce = UI.button({ Text = "", color = UI.Theme.panel2, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 1, Parent = box, onClick = function()
		local v = Store.view
		UI.handle(Net.call("SettingsAction", { action = "set", key = "reduceEffects", value = not v.settings.reduceEffects }))
	end })
	UI.text({
		Text = "<b>Como jogar</b>\n• Compre criaturas na esteira (tecla E) ou abra ovos.\n• Elas produzem moedas no pedestal: colete na sua base.\n• Entre em bases sem escudo e segure E para roubar; leve para a SUA base.\n• Encoste em quem está roubando você para pegar de volta.\n• Trave a base no terminal azul quando for sair dela.",
		TextSize = 14,
		TextColor3 = UI.Theme.muted,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 2,
		Parent = box,
	})
	return {
		frame = p.frame,
		refresh = function(view)
			reduce.Text = (view.settings.reduceEffects and "✔ " or "") .. "Reduzir efeitos (animações e brilhos)"
		end,
	}
end

function Panels.init()
	UI.register("Missions", buildMissions)
	UI.register("Gifts", buildGifts)
	UI.register("Rebirth", buildRebirth)
	UI.register("Ranking", buildRanking)
	UI.register("Settings", buildSettings)
end

return Panels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000041"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[-- UIController: tema, componentes reutilizáveis, escala responsiva (PC/celular),
-- gerenciador de painéis (apenas um aberto por vez), avisos e diálogos de confirmação.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local CreatureModel = require(Shared.Visual.CreatureModel)
local Format = require(Shared.Util.Format)

local UI = {}

local player = Players.LocalPlayer

UI.Theme = {
	bg = Color3.fromRGB(14, 18, 24),
	panel = Color3.fromRGB(22, 28, 38),
	panel2 = Color3.fromRGB(33, 42, 56),
	stroke = Color3.fromRGB(255, 255, 255),
	text = Color3.fromRGB(240, 248, 240),
	muted = Color3.fromRGB(160, 178, 170),
	accent = Color3.fromRGB(255, 190, 50),
	toxic = Color3.fromRGB(120, 240, 80),
	good = Color3.fromRGB(70, 205, 110),
	bad = Color3.fromRGB(235, 70, 80),
	blue = Color3.fromRGB(70, 140, 255),
	purple = Color3.fromRGB(160, 90, 245),
	locked = Color3.fromRGB(90, 92, 105),
}
UI.Fonts = {
	title = Enum.Font.FredokaOne,
	body = Enum.Font.GothamMedium,
	bold = Enum.Font.GothamBold,
}
UI.DesignSize = Vector2.new(1280, 720)

---------------------------------------------------------------------------
-- construção básica
---------------------------------------------------------------------------

function UI.make(className, props, children)
	local inst = Instance.new(className)
	local parent = nil
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(inst, radius)
	UI.make("UICorner", { CornerRadius = UDim.new(0, radius or 10), Parent = inst })
	return inst
end

function UI.stroke(inst, color, thickness, transparency)
	UI.make("UIStroke", {
		Color = color or UI.Theme.stroke,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0.82,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = inst,
	})
	return inst
end

function UI.padding(inst, px)
	UI.make("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = inst,
	})
	return inst
end

function UI.list(inst, padding, horizontal, align)
	UI.make("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		Parent = inst,
	})
	return inst
end

function UI.frame(props)
	props = props or {}
	if props.BackgroundColor3 == nil then
		props.BackgroundColor3 = UI.Theme.panel2
	end
	if props.BorderSizePixel == nil then
		props.BorderSizePixel = 0
	end
	local f = UI.make("Frame", props)
	return f
end

function UI.text(props)
	local defaults = {
		BackgroundTransparency = 1,
		TextColor3 = UI.Theme.text,
		Font = UI.Fonts.body,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		RichText = true,
	}
	for k, v in pairs(defaults) do
		if props[k] == nil then
			props[k] = v
		end
	end
	return UI.make("TextLabel", props)
end

-- botão com cor, cantos e efeito de toque; props.onClick
function UI.button(props)
	local onClick = props.onClick
	props.onClick = nil
	local color = props.color or UI.Theme.accent
	props.color = nil
	local defaults = {
		BackgroundColor3 = color,
		AutoButtonColor = true,
		TextColor3 = Color3.new(1, 1, 1),
		Font = UI.Fonts.bold,
		TextSize = 16,
		TextWrapped = true,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(140, 40),
	}
	for k, v in pairs(defaults) do
		if props[k] == nil then
			props[k] = v
		end
	end
	local b = UI.make("TextButton", props)
	UI.corner(b, 10)
	UI.make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1.5, Transparency = 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, Parent = b })
	if onClick then
		b.Activated:Connect(function()
			if b:GetAttribute("Disabled") then
				return
			end
			onClick(b)
		end)
	end
	return b
end

function UI.setEnabled(button, enabled, color)
	button:SetAttribute("Disabled", not enabled)
	button.AutoButtonColor = enabled
	if color then
		button.BackgroundColor3 = enabled and color or UI.Theme.locked
	end
	button.TextTransparency = enabled and 0 or 0.35
end

function UI.scroll(props)
	local defaults = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = UI.Theme.muted,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}
	for k, v in pairs(defaults) do
		if props[k] == nil then
			props[k] = v
		end
	end
	return UI.make("ScrollingFrame", props)
end

function UI.clear(container)
	for _, c in ipairs(container:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

function UI.rarityColor(rarityId)
	local r = GameConfig.Rarities[rarityId]
	if not r then
		return UI.Theme.muted
	end
	return Color3.fromRGB(r.color[1], r.color[2], r.color[3])
end

function UI.rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

---------------------------------------------------------------------------
-- prévias 3D (ViewportFrame)
---------------------------------------------------------------------------

local spinning = {} -- [viewport] = { model, speed, wobble, t }

local function fitCamera(viewport, model, zoom)
	local cam = viewport.CurrentCamera or Instance.new("Camera")
	cam.FieldOfView = 30
	cam.Parent = viewport
	viewport.CurrentCamera = cam
	local cf, size = model:GetBoundingBox()
	local radius = size.Magnitude / 2
	local dist = radius / math.tan(math.rad(cam.FieldOfView / 2)) * (zoom or 1.05)
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, radius * 0.15, dist), cf.Position)
	return cf.Position, radius
end

local function isShown(gui)
	local g = gui
	while g and g:IsA("GuiObject") do
		if not g.Visible then
			return false
		end
		g = g.Parent
	end
	return g ~= nil
end

-- Mostra um modelo em um ViewportFrame. opts = { spin = bool, inspect = bool (animação especial), zoom }
function UI.viewport(model, size, opts)
	opts = opts or {}
	local vp = UI.make("ViewportFrame", {
		Size = size or UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(170, 170, 185),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-1, -1.2, -1),
	})
	model:PivotTo(CFrame.new(0, 0, 0) * (opts.baseRotation or CFrame.Angles(0, 0, 0)))
	model.Parent = vp
	local center, radius = fitCamera(vp, model, opts.zoom)
	if opts.interactive then
		-- inspeção: arrastar gira a arma; roda do mouse/pinça ou botões aproximam e afastam
		local state = { yaw = 0, pitch = 0, zoom = opts.zoom or 1.05, dragging = false, last = nil, auto = true }
		local base = model:GetPivot()
		local function apply()
			model:PivotTo(base * CFrame.Angles(state.pitch, state.yaw, 0))
			local cam = vp.CurrentCamera
			local dist = radius / math.tan(math.rad(cam.FieldOfView / 2)) * state.zoom
			cam.CFrame = CFrame.lookAt(center + Vector3.new(0, radius * 0.15 * state.zoom, dist), center)
		end
		vp.Active = true
		vp.InputBegan:Connect(function(input)
			local t = input.UserInputType
			if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
				state.dragging = true
				state.auto = false
				state.last = input.Position
			end
		end)
		vp.InputEnded:Connect(function(input)
			local t = input.UserInputType
			if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
				state.dragging = false
			end
		end)
		vp.InputChanged:Connect(function(input)
			local t = input.UserInputType
			if state.dragging and (t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch) and state.last then
				local d = input.Position - state.last
				state.last = input.Position
				state.yaw = state.yaw + d.X * 0.012
				state.pitch = math.clamp(state.pitch + d.Y * 0.008, -1.1, 1.1)
				apply()
			elseif t == Enum.UserInputType.MouseWheel then
				state.zoom = math.clamp(state.zoom - input.Position.Z * 0.08, 0.45, 2.2)
				apply()
			end
		end)
		local controller = {
			zoomBy = function(delta)
				state.zoom = math.clamp(state.zoom + delta, 0.45, 2.2)
				apply()
			end,
			reset = function()
				state.yaw, state.pitch, state.zoom, state.auto = 0, 0, opts.zoom or 1.05, true
				apply()
			end,
		}
		-- giro automático (com balanço extra se a skin tiver a "Animação de inspeção") até o jogador tocar
		spinning[vp] = { model = model, speed = opts.inspect and 1.4 or 0.6, wobble = opts.inspect, t = 0, base = base, until_ = function()
			return state.auto
		end }
		vp.Destroying:Connect(function()
			spinning[vp] = nil
		end)
		return vp, controller
	end
	if opts.spin then
		spinning[vp] = { model = model, speed = opts.inspect and 1.4 or 0.6, wobble = opts.inspect, t = 0, base = model:GetPivot() }
		vp.Destroying:Connect(function()
			spinning[vp] = nil
		end)
	end
	return vp
end

function UI.creatureViewport(speciesId, mutationId, size, opts)
	opts = opts or {}
	opts.baseRotation = opts.baseRotation or CFrame.Angles(0, math.rad(180), 0)
	local model = CreatureModel.build(speciesId, mutationId, { anchored = true })
	return UI.viewport(model, size, opts)
end

-- nome completo: "Dourada Gosminha" (mutação + espécie), com cores
function UI.creatureName(speciesId, mutationId, rich)
	local s = GameConfig.SpeciesById[speciesId]
	local m = GameConfig.Mutations[mutationId]
	if not s then
		return "?"
	end
	if not rich then
		return (mutationId ~= "normal" and (m.name .. " ") or "") .. s.name
	end
	local function hex(t)
		return string.format("#%02X%02X%02X", t[1], t[2], t[3])
	end
	local out = ""
	if mutationId ~= "normal" then
		out = "<font color='" .. hex(m.color) .. "'>" .. m.name .. "</font> "
	end
	return out .. "<font color='" .. hex(GameConfig.Rarities[s.rarity].color) .. "'>" .. s.name .. "</font>"
end

RunService.RenderStepped:Connect(function(dt)
	for vp, s in pairs(spinning) do
		if s.until_ and not s.until_() then
			-- inspeção manual: o jogador assumiu o controle
		elseif vp.Parent and isShown(vp) then
			s.t = s.t + dt
			local rot = CFrame.Angles(0, s.t * s.speed, 0)
			if s.wobble then
				rot = rot * CFrame.Angles(math.sin(s.t * 2.2) * 0.25, 0, math.sin(s.t * 1.3) * 0.15)
			end
			s.model:PivotTo(s.base * rot)
		elseif not vp.Parent then
			spinning[vp] = nil
		end
	end
end)

---------------------------------------------------------------------------
-- raiz, escala e camadas
---------------------------------------------------------------------------

-- Cada interface principal é uma ScreenGui própria (MainHUD, EggShop, Hatch, BaseManager,
-- Bank, UpgradeWorkshop, Collections, Missions, Rewards, Rankings...), todas com a mesma escala
-- responsiva: o layout é feito em 1280×720 e uma UIScale ajusta para PC, tablet e celular.
local screens = {} -- [nome] = { gui, root, scale }
UI.layers = {}
UI.scale = 1

local function scaleValue()
	local cam = workspace.CurrentCamera
	local vs = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local s = math.min(vs.X / UI.DesignSize.X, vs.Y / UI.DesignSize.Y)
	UI.isCompact = vs.X < 900 or vs.Y < 500
	return math.clamp(s, 0.42, 1.35)
end

local function applyScale(entry, s)
	entry.scale.Scale = s
	entry.root.Size = UDim2.fromScale(1 / s, 1 / s)
end

local function updateScale()
	local s = scaleValue()
	UI.scale = s
	for _, entry in pairs(screens) do
		applyScale(entry, s)
	end
end

-- retorna a raiz (já escalada) da ScreenGui com esse nome, criando-a se necessário
function UI.screen(name, displayOrder)
	local entry = screens[name]
	if entry then
		return entry.root
	end
	local gui = UI.make("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = displayOrder or 10,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local root = UI.make("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
	local scale = UI.make("UIScale", { Parent = root })
	entry = { gui = gui, root = root, scale = scale }
	screens[name] = entry
	applyScale(entry, UI.scale)
	return root
end

function UI.init()
	UI.scale = scaleValue()
	UI.layers.HUD = UI.screen("MainHUD", 1)
	UI.layers.Panels = UI.screen("Panels", 10)
	UI.layers.Overlay = UI.screen("Hatch", 20)
	UI.layers.Modal = UI.screen("Dialogs", 30)
	UI.layers.Toast = UI.screen("Toasts", 40)
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

	-- indicador de carregamento enquanto há pedidos ao servidor
	UI.loadingLabel = UI.text({
		Name = "Loading",
		Text = "⏳ Carregando...",
		Font = UI.Fonts.bold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundTransparency = 0.15,
		BackgroundColor3 = UI.Theme.panel,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -100),
		Size = UDim2.fromOffset(150, 30),
		Visible = false,
		Parent = UI.layers.Toast,
	})
	UI.corner(UI.loadingLabel, 8)
end

function UI.setLoading(on)
	if UI.loadingLabel then
		UI.loadingLabel.Visible = on
	end
end

---------------------------------------------------------------------------
-- painéis
---------------------------------------------------------------------------

local panels = {} -- [name] = { build = fn, instance = table }
UI.current = nil
UI.panelListeners = {} -- funções chamadas com (nomeDoPainel ou nil) quando o painel aberto muda

function UI.onPanelChanged(fn)
	table.insert(UI.panelListeners, fn)
end

local function notifyPanel()
	for _, fn in ipairs(UI.panelListeners) do
		task.spawn(fn, UI.current)
	end
end

-- cria a moldura padrão de painel
function UI.createPanel(title, width, height, guiName)
	local frame = UI.frame({
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width or 820, height or 540),
		BackgroundColor3 = UI.Theme.panel,
		BackgroundTransparency = 0.08,
		Visible = false,
		Parent = guiName and UI.screen(guiName, 10) or UI.layers.Panels,
	})
	UI.corner(frame, 16)
	UI.stroke(frame, UI.Theme.stroke, 2, 0.8)
	local header = UI.frame({ Name = "Header", Size = UDim2.new(1, 0, 0, 52), BackgroundTransparency = 1, Parent = frame })
	local titleLabel = UI.text({
		Name = "Title",
		Text = title,
		Font = UI.Fonts.title,
		TextSize = 26,
		Size = UDim2.new(1, -120, 1, 0),
		Position = UDim2.fromOffset(20, 0),
		Parent = header,
	})
	UI.button({
		Name = "Close",
		Text = "✕",
		TextSize = 20,
		color = UI.Theme.bad,
		Size = UDim2.fromOffset(40, 40),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Parent = header,
		onClick = function()
			UI.close()
		end,
	})
	local content = UI.frame({
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 56),
		Size = UDim2.new(1, -32, 1, -70),
		Parent = frame,
	})
	return { frame = frame, content = content, title = titleLabel }
end

-- registra um painel. build() -> { frame, refresh(view), onOpen(args), onClose() }
function UI.register(name, build)
	panels[name] = { build = build }
end

function UI.get(name)
	local p = panels[name]
	if not p then
		return nil
	end
	if not p.instance then
		p.instance = p.build()
	end
	return p.instance
end

function UI.open(name, args)
	local inst = UI.get(name)
	if not inst then
		return
	end
	if UI.current and UI.current ~= name then
		UI.close(true)
	end
	local wasOpen = UI.current == name
	UI.current = name
	inst.frame.Visible = true
	local scale = inst.frame:FindFirstChild("PopScale") or UI.make("UIScale", { Name = "PopScale", Parent = inst.frame })
	if not wasOpen then
		scale.Scale = 0.92
		TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	if inst.onOpen then
		inst.onOpen(args)
	end
	if inst.refresh and UI.store and UI.store.view then
		inst.refresh(UI.store.view)
	end
	if not wasOpen then
		notifyPanel()
	end
end

-- fecha o painel aberto; com immediate = true não anima (troca direta entre painéis)
function UI.close(immediate)
	if not UI.current then
		return
	end
	local name = UI.current
	local inst = panels[name] and panels[name].instance
	UI.current = nil
	if inst then
		if inst.onClose then
			inst.onClose()
		end
		local scale = inst.frame:FindFirstChild("PopScale")
		if immediate or not scale then
			inst.frame.Visible = false
		else
			TweenService:Create(scale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.9 }):Play()
			task.delay(0.1, function()
				if UI.current ~= name then
					inst.frame.Visible = false
				end
			end)
		end
	end
	notifyPanel()
end

function UI.toggle(name, args)
	if UI.current == name then
		UI.close()
	else
		UI.open(name, args)
	end
end

function UI.isOpen(name)
	return UI.current == name
end

-- atualiza o painel aberto quando chega uma nova fotografia
function UI.refreshCurrent(view)
	if not UI.current then
		return
	end
	local inst = panels[UI.current].instance
	if inst and inst.refresh then
		inst.refresh(view)
	end
end

---------------------------------------------------------------------------
-- avisos e diálogos
---------------------------------------------------------------------------

local toastList
function UI.toast(message, kind)
	if not toastList then
		toastList = UI.frame({
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 70),
			Size = UDim2.fromOffset(520, 300),
			Parent = UI.layers.Toast,
		})
		UI.list(toastList, 6, false, Enum.HorizontalAlignment.Center)
	end
	local color = UI.Theme.panel2
	if kind == "error" then
		color = UI.Theme.bad
	elseif kind == "good" then
		color = UI.Theme.good
	elseif kind == "rare" then
		color = UI.Theme.purple
	end
	local t = UI.text({
		Text = message,
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = UI.Fonts.bold,
		TextSize = 17,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.fromOffset(500, 0),
		BackgroundTransparency = 0.1,
		BackgroundColor3 = color,
		Parent = toastList,
	})
	UI.corner(t, 10)
	UI.padding(t, 10)
	task.delay(3.2, function()
		TweenService:Create(t, TweenInfo.new(0.3), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
		task.wait(0.32)
		t:Destroy()
	end)
end

-- Resposta padrão de uma chamada ao servidor: mostra o erro (se houver) e retorna ok.
function UI.handle(response, successMessage)
	if response.ok then
		if successMessage then
			UI.toast(successMessage, "good")
		end
		return true
	end
	if response.error ~= "busy" then
		UI.toast(response.message or "Não foi possível concluir.", "error")
	end
	return false
end

-- opts = { title, message, confirmText, cancelText, danger, phrase (texto que precisa ser digitado), onConfirm }
function UI.confirm(opts)
	local shade = UI.make("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Size = UDim2.fromScale(1, 1),
		Parent = UI.layers.Modal,
	})
	local box = UI.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(500, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = UI.Theme.panel,
		Parent = shade,
	})
	UI.corner(box, 14)
	UI.stroke(box, opts.danger and UI.Theme.bad or UI.Theme.stroke, 2, opts.danger and 0.2 or 0.8)
	UI.padding(box, 18)
	UI.list(box, 12)
	UI.text({ Text = opts.title or "Confirmar", Font = UI.Fonts.title, TextSize = 24, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 1, Parent = box })
	UI.text({ Text = opts.message or "", TextSize = 16, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), TextColor3 = UI.Theme.muted, LayoutOrder = 2, Parent = box })
	local input
	if opts.phrase then
		input = UI.make("TextBox", {
			PlaceholderText = "Digite " .. opts.phrase,
			Text = "",
			ClearTextOnFocus = false,
			Font = UI.Fonts.bold,
			TextSize = 18,
			TextColor3 = UI.Theme.text,
			BackgroundColor3 = UI.Theme.panel2,
			Size = UDim2.new(1, 0, 0, 40),
			LayoutOrder = 3,
			Parent = box,
		})
		UI.corner(input, 8)
	end
	local row = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 4, Parent = box })
	UI.list(row, 10, true, Enum.HorizontalAlignment.Right)
	local function closeDialog()
		shade:Destroy()
	end
	UI.button({
		Text = opts.cancelText or "Cancelar",
		color = UI.Theme.panel2,
		Size = UDim2.fromOffset(150, 42),
		Parent = row,
		onClick = closeDialog,
	})
	local okBtn = UI.button({
		Text = opts.confirmText or "Confirmar",
		color = opts.danger and UI.Theme.bad or UI.Theme.good,
		Size = UDim2.fromOffset(180, 42),
		Parent = row,
		onClick = function()
			if opts.phrase and input.Text ~= opts.phrase then
				UI.toast("Digite exatamente: " .. opts.phrase, "error")
				return
			end
			closeDialog()
			if opts.onConfirm then
				task.spawn(opts.onConfirm, input and input.Text or nil)
			end
		end,
	})
	if opts.phrase then
		UI.setEnabled(okBtn, false, opts.danger and UI.Theme.bad or UI.Theme.good)
		input:GetPropertyChangedSignal("Text"):Connect(function()
			UI.setEnabled(okBtn, input.Text == opts.phrase, opts.danger and UI.Theme.bad or UI.Theme.good)
		end)
	end
	return shade
end

-- resumo de recompensa em texto: { coins, potions = { id = n } }
function UI.rewardText(coins, potions)
	local parts = {}
	if coins and coins > 0 then
		table.insert(parts, "$" .. Format.short(coins))
	end
	for _, id in ipairs(GameConfig.PotionOrder) do
		local n = potions and potions[id]
		if n and n > 0 then
			table.insert(parts, n .. "× " .. GameConfig.Potions[id].icon)
		end
	end
	return table.concat(parts, " · ")
end

return UI
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000042"><Properties><string name="Name">WorldController</string><ProtectedString name="Source"><![CDATA[-- WorldController: liga o mundo 3D à interface.
-- * Botões de proximidade (E) que abrem painéis (ovos, poções).
-- * Esconde "Roubar" nas próprias criaturas e os terminais das bases dos outros.
-- * Anima as criaturas Arco-íris (só visual, no cliente).
-- * Avisos do servidor: roubo em andamento (faixa vermelha), defesa, eventos, compras raras.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local UI = require(script.Parent.UIController)
local Net = require(script.Parent.Parent.Util.Net)
local Store = require(script.Parent.Parent.Util.Store)

local World = {}

local player = Players.LocalPlayer
local rainbow = {} -- [model] = true
local alertBanner

local function setupPrompt(p)
	local function apply()
		local owner = p:GetAttribute("OwnerUserId")
		if p:GetAttribute("Steal") then
			p.Enabled = owner ~= player.UserId
		elseif p:GetAttribute("OwnerOnly") then
			p.Enabled = owner == player.UserId
		end
	end
	apply()
	p:GetAttributeChangedSignal("OwnerUserId"):Connect(apply)
end

local function watch(inst)
	if inst:IsA("ProximityPrompt") then
		setupPrompt(inst)
	elseif inst:IsA("Model") and inst:GetAttribute("Rainbow") then
		rainbow[inst] = true
	end
end

local function showAlert(text)
	alertBanner.Text = text
	alertBanner.Visible = true
	local token = {}
	World._alertToken = token
	task.delay(5, function()
		if World._alertToken == token then
			alertBanner.Visible = false
		end
	end)
end

local function onNotify(data)
	if type(data) ~= "table" or type(data.text) ~= "string" then
		return
	end
	if data.kind == "theft" then
		showAlert(data.text)
		UI.toast(data.text, "error")
	elseif data.kind == "error" then
		UI.toast(data.text, "error")
	elseif data.kind == "good" then
		UI.toast(data.text, "good")
	elseif data.kind == "rare" or data.kind == "event" or data.kind == "carry" then
		UI.toast(data.text, "rare")
	else
		UI.toast(data.text)
	end
end

function World.init()
	alertBanner = UI.text({
		Name = "TheftAlert",
		Text = "",
		Font = UI.Fonts.title,
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundTransparency = 0.05,
		BackgroundColor3 = Color3.fromRGB(200, 30, 45),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 164),
		Size = UDim2.fromOffset(720, 56),
		Visible = false,
		Parent = UI.layers.Toast,
	})
	UI.corner(alertBanner, 12)

	Net.on("Notify", onNotify)

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local panel = prompt:GetAttribute("Panel")
		if panel then
			UI.open(panel, { eggId = prompt:GetAttribute("EggId") })
		end
	end)

	local world = workspace:FindFirstChild("MutantWorld") or workspace:WaitForChild("MutantWorld")
	for _, d in ipairs(world:GetDescendants()) do
		watch(d)
	end
	world.DescendantAdded:Connect(watch)

	-- cores do Arco-íris (10 vezes por segundo, desligado com "Reduzir efeitos")
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		acc = acc + dt
		if acc < 0.1 then
			return
		end
		acc = 0
		local v = Store.view
		if v and v.settings and v.settings.reduceEffects then
			return
		end
		local h = (os.clock() * 0.25) % 1
		for model in pairs(rainbow) do
			if not model.Parent then
				rainbow[model] = nil
			else
				for _, part in ipairs(model:GetChildren()) do
					if part:IsA("BasePart") and part.Name ~= "EyeWhite" and part.Name ~= "Pupil" then
						part.Color = Color3.fromHSV(h, 0.75, 1)
					end
				end
			end
		end
	end)
end

return World
]]></ProtectedString></Properties></Item>
</Item>
<Item class="LocalScript" referent="RBX000044"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Ponto de entrada do cliente do MUTANT FACTORY: interface (somente exibição; o servidor decide tudo).

local Controllers = script.Parent.Controllers
local UI = require(Controllers.UIController)
local Net = require(script.Parent.Util.Net)
local Store = require(script.Parent.Util.Store)

UI.init()
UI.store = Store
Net.setBusyHandler(UI.setLoading)

for _, name in ipairs({ "HUDController", "EggController", "BaseController", "IndexController", "ProgressPanels", "WorldController" }) do
	require(Controllers[name]).init()
end

Store.changed:Connect(function(view)
	UI.refreshCurrent(view)
end)
Store.init()
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX000048"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX000045"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Net: chamadas ao servidor com requestId único (o servidor ignora repetições do mesmo pedido)
-- e trava local por ação para evitar cliques duplos.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Net = {}

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local busy = {} -- [remote .. action] = true
local pending = 0
local busyHandler = nil

-- função chamada com true/false quando há (ou não) pedidos em andamento (indicador de carregamento)
function Net.setBusyHandler(fn)
	busyHandler = fn
end

local function setPending(delta)
	pending = pending + delta
	if busyHandler then
		busyHandler(pending > 0)
	end
end

function Net.remote(name)
	return remotes:WaitForChild(name)
end

-- Retorna a resposta { ok, data } ou { ok = false, error, message }.
-- Se a mesma ação já estiver em andamento, retorna erro "busy" sem chamar o servidor.
function Net.call(remoteName, payload)
	local key = remoteName .. ":" .. tostring(payload.action)
	if busy[key] then
		return { ok = false, error = "busy", message = "Aguarde..." }
	end
	busy[key] = true
	payload.requestId = string.sub(HttpService:GenerateGUID(false), 1, 36)
	setPending(1)
	local okCall, response = pcall(function()
		return Net.remote(remoteName):InvokeServer(payload)
	end)
	setPending(-1)
	busy[key] = nil
	if not okCall or type(response) ~= "table" then
		return { ok = false, error = "network", message = "Falha de conexão. Tente novamente." }
	end
	return response
end

function Net.on(eventName, fn)
	return Net.remote(eventName).OnClientEvent:Connect(fn)
end

return Net
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000046"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[-- Signal: eventos simples entre controladores do cliente.

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local entry = { fn = fn, connected = true }
	table.insert(self.handlers, entry)
	return {
		Disconnect = function()
			entry.connected = false
			for i, h in ipairs(self.handlers) do
				if h == entry then
					table.remove(self.handlers, i)
					break
				end
			end
		end,
	}
end

function Signal:Fire(...)
	local list = {}
	for i, h in ipairs(self.handlers) do
		list[i] = h
	end
	for _, h in ipairs(list) do
		if h.connected then
			task.spawn(h.fn, ...)
		end
	end
end

return Signal
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000047"><Properties><string name="Name">Store</string><ProtectedString name="Source"><![CDATA[-- Store: última fotografia do perfil recebida do servidor (somente leitura no cliente).

local Signal = require(script.Parent.Signal)
local Net = require(script.Parent.Net)

local Store = {}

Store.view = nil
Store.receivedAt = 0 -- os.clock() quando a fotografia chegou
Store.changed = Signal.new()

local function set(view)
	if type(view) ~= "table" then
		return
	end
	Store.view = view
	Store.receivedAt = os.clock()
	Store.changed:Fire(view)
end

function Store.creature(uid)
	for _, c in ipairs(Store.view and Store.view.creatures or {}) do
		if c.uid == uid then
			return c
		end
	end
	return nil
end

-- horário do servidor estimado (para contagens de tempo reais)
function Store.serverNow()
	if not Store.view then
		return 0
	end
	return Store.view.serverTime + (os.clock() - Store.receivedAt)
end

-- moedas guardadas na base, estimadas para exibição (o valor real é sempre do servidor)
function Store.pendingLive()
	local v = Store.view
	if not v then
		return 0
	end
	local elapsed = os.clock() - Store.receivedAt
	local total = 0
	for _, c in ipairs(v.creatures) do
		total = total + math.min(c.cap, c.pending + c.rate * (v.boost or 1) * elapsed)
	end
	return total
end

function Store.init()
	Net.on("DataUpdated", set)
	task.spawn(function()
		while not Store.view do
			local res = Net.call("RequestData", { action = "get" })
			if res.ok then
				set(res.data)
			else
				task.wait(1.5)
			end
		end
	end)
end

return Store
]]></ProtectedString></Properties></Item>
